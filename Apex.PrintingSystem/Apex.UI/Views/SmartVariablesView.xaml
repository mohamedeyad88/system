<UserControl x:Class="Apex.UI.Views.SmartVariablesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Apex.UI.ViewModels"
             xmlns:converters="clr-namespace:Apex.UI.Converters"
             xmlns:controls="clr-namespace:Apex.UI.Controls"
             xmlns:svc="clr-namespace:Apex.UI.Services"
             FlowDirection="{Binding Source={x:Static svc:LocalizationService.Instance},
                                     Path=FlowDirection, Mode=OneWay}"
             Loaded="SmartVariablesView_Loaded"
             Background="#FAF9F7">

    <UserControl.Resources>
        <!-- Local converter instances (Converters.xaml merged in App.xaml already,
             but we redefine here so the view is self-contained) -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolConverter    x:Key="InverseBool"/>
        <converters:NullToVisibilityConverter x:Key="NullToCollapsed"/>
        <converters:NullToBoolConverter x:Key="NotNullToBool"/>
        <converters:NullToVisibleConverter x:Key="NullToVisible"/>
        <converters:NonEmptyStringToVisibilityConverter x:Key="EmptyToCollapsed"/>

        <!-- ── Shared styles ─────────────────────────────────────────────────── -->

        <Style x:Key="DarkBox" TargetType="TextBox">
            <Setter Property="Background"      Value="#FFFFFF"/>
            <Setter Property="Foreground"      Value="#14181D"/>
            <Setter Property="BorderBrush"     Value="#DDD9D3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,5"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="CaretBrush"      Value="White"/>
            <Setter Property="SelectionBrush"  Value="#0891B2"/>
        </Style>

        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Background"      Value="#FFFFFF"/>
            <Setter Property="Foreground"      Value="#14181D"/>
            <Setter Property="BorderBrush"     Value="#DDD9D3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="FontSize"        Value="12"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background"   Value="#0891B2"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"      Value="14,7"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0E7490"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background"   Value="#DDD9D3"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background"   Value="#B42318"/>
        </Style>

        <Style x:Key="SuccessBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background"   Value="#1B7F4C"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="#6B6864"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="Margin"      Value="0,0,0,3"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="#14181D"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Margin"      Value="0,0,0,10"/>
        </Style>

        <Style x:Key="CheckStyle" TargetType="CheckBox">
            <Setter Property="Foreground"  Value="#14181D"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="Margin"      Value="0,4"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header bar -->
            <RowDefinition Height="*"/>     <!-- Tab content -->
            <RowDefinition Height="Auto"/>  <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════════════════
             HEADER BAR
        ══════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#DDD9D3"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="المتغيرات الذكية — دمج البيانات"
                               Foreground="#14181D" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <!-- Data summary badge -->
                    <Border Background="#E6F3F6" CornerRadius="4" Padding="8,3" Margin="16,0,0,0"
                            Visibility="{Binding HasPastedData, Converter={StaticResource BoolToVis}}">
                        <TextBlock Foreground="#0891B2" FontSize="11"
                                   Text="{Binding TotalRowCount, StringFormat='{}{0} سجل'}"/>
                    </Border>
                </StackPanel>

                <!-- Save button
                     AncestorLevel=2 climbs past SmartVariablesView (level 1, DataContext=SmartVars)
                     up to TemplateDesignerView (level 2, DataContext=TemplateDesignerViewModel)
                     which owns SaveWithSmartDataCommand. -->
                <Button Grid.Column="1" Content="💾 حفظ المشروع"
                        Style="{StaticResource GhostBtn}"
                        Command="{Binding DataContext.SaveWithSmartDataCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl,
                                                          AncestorLevel=2}}"
                        Margin="0,0,0,0"/>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════════════
             MAIN TAB CONTROL
        ══════════════════════════════════════════════════════════════════════ -->
        <TabControl Grid.Row="1"
                    SelectedIndex="{Binding ActiveTabIndex}"
                    Background="#FAF9F7"
                    BorderBrush="#DDD9D3">

            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background"       Value="#FFFFFF"/>
                    <Setter Property="Foreground"       Value="#6B6864"/>
                    <Setter Property="FontSize"         Value="12"/>
                    <Setter Property="Padding"          Value="14,8"/>
                    <Setter Property="BorderThickness"  Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#FAF9F7"/>
                            <Setter Property="Foreground" Value="#0891B2"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#14181D"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Resources>

            <!-- ═══════════════════════════════════════════════════════════════
                 TAB 0 — SMART PASTE
            ═══════════════════════════════════════════════════════════════ -->
            <TabItem Header="📋 لصق البيانات">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="200"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Instructions -->
                    <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                        <TextBlock Foreground="#6B6864" FontSize="11" TextWrapping="Wrap"
                                   Text="انسخ الجدول من Excel أو Google Sheets (Ctrl+C) ثم اضغط 'لصق من الحافظة' أو الصق مباشرة في الحقل أدناه. يتم اكتشاف الفاصل تلقائياً."/>
                    </Border>

                    <!-- Paste area -->
                    <TextBox Grid.Row="1"
                             Style="{StaticResource DarkBox}"
                             Text="{Binding RawPasteText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" AcceptsTab="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap"
                             Padding="10"
                             FontFamily="Consolas"
                             FontSize="11"
                             Height="Auto"/>

                    <!-- Action buttons + status -->
                    <Grid Grid.Row="2" Margin="0,10,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="📋 لصق من الحافظة"
                                Style="{StaticResource ActionBtn}"
                                Command="{Binding PasteFromClipboardCommand}"
                                Margin="0,0,8,0"/>

                        <Button Grid.Column="1" Content="🧹 تطبيق التنظيف"
                                Style="{StaticResource GhostBtn}"
                                Command="{Binding ApplyCleaningCommand}"
                                IsEnabled="{Binding HasPastedData}"
                                Margin="0,0,8,0"/>

                        <Button Grid.Column="2" Content="✕ مسح"
                                Style="{StaticResource DangerBtn}"
                                Command="{Binding ClearDataCommand}"
                                IsEnabled="{Binding HasPastedData}"/>

                        <!-- Status -->
                        <Border Grid.Column="3" Margin="12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PasteStatus}"
                                       Foreground="{Binding PasteStatusColor}"
                                       FontSize="12" FontWeight="SemiBold"/>
                        </Border>

                        <!-- Separator label -->
                        <TextBlock Grid.Column="4"
                                   Text="{Binding DetectedSeparatorLabel, StringFormat='فاصل: {0}'}"
                                   Foreground="#6B6864" FontSize="11"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding HasPastedData, Converter={StaticResource BoolToVis}}"/>
                    </Grid>

                    <!-- Cleaning options -->
                    <Expander Grid.Row="3"
                              Header="⚙ خيارات التنظيف"
                              Foreground="#6B6864"
                              Margin="0,0,0,10">
                        <Border Background="#FFFFFF" CornerRadius="6" Padding="12,8">
                            <WrapPanel>
                                <CheckBox Content="حذف المسافات الزائدة"    Style="{StaticResource CheckStyle}" IsChecked="{Binding CleanTrimWhitespace}"   Margin="0,4,16,4"/>
                                <CheckBox Content="توحيد الأرقام العربية"    Style="{StaticResource CheckStyle}" IsChecked="{Binding CleanNormalizeNumbers}"  Margin="0,4,16,4"/>
                                <CheckBox Content="توحيد الألف (أإآ → ا)"   Style="{StaticResource CheckStyle}" IsChecked="{Binding CleanNormalizeArabic}"   Margin="0,4,16,4"/>
                                <CheckBox Content="حذف مسافات متعددة"       Style="{StaticResource CheckStyle}" IsChecked="{Binding CleanRemoveExtraSpaces}" Margin="0,4,16,4"/>
                                <CheckBox Content="حذف التشكيل"             Style="{StaticResource CheckStyle}" IsChecked="{Binding CleanRemoveDiacritics}"  Margin="0,4,16,4"/>
                            </WrapPanel>
                        </Border>
                    </Expander>

                    <!-- Data preview grid
                         ItemsSource bound to DataTableView (System.Data.DataView).
                         AutoGenerateColumns=True on a DataView creates columns from the
                         REAL pasted headers (الاسم, الصف, رقم الجلوس…), not from
                         DataRowItem reflection properties like Cells / StatusIcon.
                    -->
                    <Border Grid.Row="4" BorderBrush="#DDD9D3" BorderThickness="1" CornerRadius="6">
                        <DataGrid x:Name="DataPreviewGrid"
                                  AutoGenerateColumns="True"
                                  IsReadOnly="True"
                                  Background="#FAF9F7"
                                  Foreground="#14181D"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#FFFFFF"
                                  RowBackground="#FAF9F7"
                                  AlternatingRowBackground="#FAF9F7"
                                  HeadersVisibility="Column"
                                  FontSize="12"
                                  CanUserResizeColumns="True"
                                  SelectionMode="Single"
                                  BorderThickness="0"
                                  ItemsSource="{Binding DataTableView}">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background"      Value="#FFFFFF"/>
                                    <Setter Property="Foreground"      Value="#0891B2"/>
                                    <Setter Property="FontWeight"      Value="SemiBold"/>
                                    <Setter Property="Padding"         Value="8,6"/>
                                    <Setter Property="BorderBrush"     Value="#DDD9D3"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══════════════════════════════════════════════════════════════
                 TAB 1 — VARIABLE MAPPING
            ═══════════════════════════════════════════════════════════════ -->
            <TabItem Header="🔗 ربط المتغيرات">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="✨ ربط تلقائي"
                                Style="{StaticResource ActionBtn}"
                                Command="{Binding AutoMapCommand}"
                                Margin="0,0,8,0"/>
                        <Button Content="✕ مسح الربط"
                                Style="{StaticResource GhostBtn}"
                                Command="{Binding ClearMappingsCommand}"/>

                        <Border Margin="16,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding MappingStatus}"
                                       Foreground="{Binding MappingStatusColor}"
                                       FontSize="12" FontWeight="SemiBold"/>
                        </Border>

                        <Border Background="#FFFFFF" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding MappedCount}"   Foreground="#1B7F4C" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text=" مربوط · " Foreground="#6B6864" FontSize="12"/>
                                <TextBlock Text="{Binding UnmappedRequiredCount}" Foreground="#B42318" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text=" مطلوب غير مربوط" Foreground="#6B6864" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Column headers -->
                    <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="6,6,0,0" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="⚑"  Foreground="#6B6864" FontSize="11"/>
                            <TextBlock Grid.Column="1" Text="الحقل في القالب"         Foreground="#6B6864" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="عمود البيانات"            Foreground="#6B6864" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Text="القيمة الافتراضية"        Foreground="#6B6864" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="4" Text="ثقة الربط"                Foreground="#6B6864" FontSize="11" FontWeight="SemiBold"/>
                        </Grid>
                    </Border>

                    <!-- Mapping rows -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding MappingRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:MappingRowItem}">
                                    <Border BorderBrush="#FFFFFF" BorderThickness="0,0,0,1" Padding="12,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Required badge -->
                                            <Ellipse Grid.Column="0" Width="8" Height="8"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding StatusColor}"/>

                                            <!-- Field label -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FieldLabel}"
                                                           Foreground="#14181D" FontSize="12"/>
                                                <Border Background="#E6F3F6" CornerRadius="3" Padding="4,1" Margin="8,0,0,0"
                                                        Visibility="{Binding IsRequired, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="مطلوب" Foreground="#0891B2" FontSize="10"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Column selector -->
                                            <ComboBox Grid.Column="2"
                                                      Style="{StaticResource DarkCombo}"
                                                      ItemsSource="{Binding AvailableColumns}"
                                                      SelectedItem="{Binding SelectedColumn}"
                                                      Margin="0,0,8,0"/>

                                            <!-- Default value -->
                                            <TextBox Grid.Column="3"
                                                     Style="{StaticResource DarkBox}"
                                                     Text="{Binding DefaultValue, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,8,0"
                                                     Height="28" FontSize="11"/>

                                            <!-- Confidence badge -->
                                            <Border Grid.Column="4"
                                                    Background="#FFFFFF" CornerRadius="4" Padding="5,2"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ConfidenceLabel}"
                                                           Foreground="#6B6864" FontSize="11"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ═══════════════════════════════════════════════════════════════
                 TAB 2 — IMAGE MANAGER
            ═══════════════════════════════════════════════════════════════ -->
            <TabItem Header="🖼 مدير الصور">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Folder row -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Style="{StaticResource DarkBox}"
                                 Text="{Binding ImageFolderPath, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="True"
                                 Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="📂 اختيار مجلد"
                                Style="{StaticResource GhostBtn}"
                                Command="{Binding BrowseImageFolderCommand}"
                                Margin="0,0,8,0"/>
                        <Button Grid.Column="2" Content="🔄 مسح"
                                Style="{StaticResource ActionBtn}"
                                Command="{Binding ScanImageFolderAsyncCommand}"
                                IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}"/>
                    </Grid>

                    <!-- Matching mode row -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="طريقة المطابقة:"
                                   Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1"
                                  Style="{StaticResource DarkCombo}"
                                  ItemsSource="{Binding AllMatchModes}"
                                  SelectedItem="{Binding SelectedMatchMode}"
                                  Margin="0,0,12,0"/>

                        <TextBlock Grid.Column="2" Text="عمود المفتاح:"
                                   Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="3"
                                  Style="{StaticResource DarkCombo}"
                                  ItemsSource="{Binding DataContext.DataColumns,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  SelectedItem="{Binding ImageKeyColumn}"
                                  Margin="0,0,12,0"/>

                        <Button Grid.Column="5" Content="🔍 مطابقة"
                                Style="{StaticResource ActionBtn}"
                                Command="{Binding ResolveImageMatchesCommand}"
                                IsEnabled="{Binding HasPastedData}"/>
                    </Grid>

                    <!-- Progress + status -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <ProgressBar Height="4" Value="{Binding ScanProgress}"
                                     Background="#FFFFFF" Foreground="#0891B2"
                                     Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"
                                     Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding ImageStatusText}"
                                   Foreground="{Binding ImageStatusColor}"
                                   FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- Image asset grid -->
                    <Border Grid.Row="3" BorderBrush="#DDD9D3" BorderThickness="1" CornerRadius="6">
                        <ScrollViewer>
                            <WrapPanel x:Name="ImageGrid" Margin="8">
                                <ItemsControl ItemsSource="{Binding ImageAssets}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ImageAssetItem}">
                                            <Border Width="100" Height="120" Margin="6"
                                                    Background="#FFFFFF" CornerRadius="6"
                                                    BorderBrush="#DDD9D3" BorderThickness="1">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="72"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Thumbnail -->
                                                    <Border Grid.Row="0" CornerRadius="6,6,0,0" ClipToBounds="True">
                                                        <Image x:Name="Thumb" Stretch="UniformToFill">
                                                            <!-- ThumbnailBase64 → BitmapImage via converter in code-behind -->
                                                        </Image>
                                                    </Border>

                                                    <!-- Status indicator -->
                                                    <TextBlock Grid.Row="0"
                                                               Text="{Binding StatusIcon}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Top"
                                                               Margin="0,4,4,0"
                                                               FontSize="14"/>

                                                    <!-- Used badge -->
                                                    <Border Grid.Row="0"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Top"
                                                            Background="#1B7F4C" CornerRadius="3" Padding="3,1" Margin="4"
                                                            Visibility="{Binding IsUsed, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="✓" Foreground="White" FontSize="10"/>
                                                    </Border>

                                                    <!-- File info -->
                                                    <StackPanel Grid.Row="1" Margin="6,4">
                                                        <TextBlock Text="{Binding FileName}"
                                                                   Foreground="#14181D" FontSize="10"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding FileName}"/>
                                                        <TextBlock Text="{Binding SizeLabel}"
                                                                   Foreground="#6B6864" FontSize="10"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </WrapPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══════════════════════════════════════════════════════════════
                 TAB 3 — PREVIEW
            ═══════════════════════════════════════════════════════════════ -->
            <TabItem Header="👁 معاينة">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: navigation + field values -->
                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Navigation bar -->
                        <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Content="⏮" Style="{StaticResource GhostBtn}"
                                        Padding="8,4" Command="{Binding PreviewFirstCommand}"
                                        IsEnabled="{Binding CanPreviewPrev}"/>
                                <Button Grid.Column="1" Content="◀" Style="{StaticResource GhostBtn}"
                                        Padding="8,4" Command="{Binding PreviewPrevCommand}"
                                        IsEnabled="{Binding CanPreviewPrev}" Margin="4,0,0,0"/>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding PreviewRowInfo}"
                                           Foreground="#6B6864" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                <Button Grid.Column="3" Content="▶" Style="{StaticResource GhostBtn}"
                                        Padding="8,4" Command="{Binding PreviewNextCommand}"
                                        IsEnabled="{Binding CanPreviewNext}" Margin="0,0,4,0"/>
                                <Button Grid.Column="4" Content="⏭" Style="{StaticResource GhostBtn}"
                                        Padding="8,4" Command="{Binding PreviewLastCommand}"
                                        IsEnabled="{Binding CanPreviewNext}"/>
                            </Grid>
                        </Border>

                        <!-- Image preview -->
                        <Border Grid.Row="1" Height="140" Background="#FFFFFF" CornerRadius="6" Margin="0,0,0,10"
                                Visibility="{Binding PreviewImagePath, Converter={StaticResource NullToCollapsed}}">
                            <TextBlock Text="[صورة السجل]" Foreground="#6B6864" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Field values list -->
                        <Border Grid.Row="2" BorderBrush="#DDD9D3" BorderThickness="1" CornerRadius="6">
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding PreviewFields}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:PreviewFieldItem}">
                                            <Grid Margin="10,6">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0"
                                                           Text="{Binding FieldLabel}"
                                                           Foreground="#6B6864" FontSize="10"/>
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding Value}"
                                                           Foreground="#14181D" FontSize="12"
                                                           TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- RIGHT: live template preview.
                         TemplatePreviewControl paints through TemplatePainter — the
                         same code path the PNG/PDF export uses — so what is shown here
                         is the output itself, not a XAML look-alike of it. -->
                    <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="8" BorderBrush="#DDD9D3" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- The rendered record -->
                            <Viewbox Grid.Row="0" Margin="16" Stretch="Uniform" StretchDirection="DownOnly"
                                     Visibility="{Binding CurrentRenderedTemplate,
                                                  Converter={StaticResource NullToCollapsed}}">
                                <controls:TemplatePreviewControl
                                    x:Name="TemplatePreviewRoot"
                                    TemplateSource="{Binding CurrentRenderedTemplate}"/>
                            </Viewbox>

                            <!-- Shown until there is something to preview -->
                            <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding CurrentRenderedTemplate,
                                                     Converter={StaticResource NullToVisible}}">
                                <TextBlock Text="👁" FontSize="48" HorizontalAlignment="Center" Opacity="0.3"/>
                                <TextBlock Text="معاينة القالب مع بيانات السجل الحالي"
                                           Foreground="#6B6864" FontSize="13"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Text="(يتطلب ربط المتغيرات أولاً)"
                                           Foreground="#6B6864" FontSize="11"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Export the record on screen -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal"
                                        HorizontalAlignment="Center" Margin="0,0,0,12">
                                <Button x:Name="BtnExportPng"
                                        Content="🖼 حفظ السجل الحالي PNG"
                                        Style="{StaticResource ActionBtn}"
                                        IsEnabled="{Binding CurrentRenderedTemplate,
                                                    Converter={StaticResource NotNullToBool}}"/>
                                <TextBlock Text="{Binding ExportPreviewStatus}"
                                           Foreground="{Binding ExportPreviewStatusColor}"
                                           FontSize="11" VerticalAlignment="Center"
                                           Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="260"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══════════════════════════════════════════════════════════════
                 TAB 4 — PREFLIGHT
            ═══════════════════════════════════════════════════════════════ -->
            <TabItem Header="✅ الفحص المسبق">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Run button + summary -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="🔍 تشغيل الفحص"
                                Style="{StaticResource ActionBtn}"
                                Command="{Binding RunPreflightCommand}"
                                Margin="0,0,12,0"/>

                        <Border Background="#FFFFFF" CornerRadius="6" Padding="12,8" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PreflightSummary}"
                                       Foreground="{Binding PreflightSummaryColor}"
                                       FontSize="13" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <!-- Summary counters -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Background="#FFFFFF" CornerRadius="6" Padding="12,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ErrorCount}" Foreground="#B42318" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text=" خطأ" Foreground="#6B6864" FontSize="12" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#FFFFFF" CornerRadius="6" Padding="12,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding WarningCount}" Foreground="#E08A00" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text=" تحذير" Foreground="#6B6864" FontSize="12" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#FFFFFF" CornerRadius="6" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding InfoCount}" Foreground="#0891B2" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text=" ملاحظة" Foreground="#6B6864" FontSize="12" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Issues list -->
                    <Border Grid.Row="2" BorderBrush="#DDD9D3" BorderThickness="1" CornerRadius="6">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding PreflightIssues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PreflightIssueItem}">
                                        <Border BorderBrush="#FFFFFF" BorderThickness="0,0,0,1" Padding="12,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding LevelIcon}"
                                                           Foreground="{Binding LevelColor}"
                                                           FontSize="14" VerticalAlignment="Top"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding RowLabel}"
                                                           Foreground="#6B6864" FontSize="11"
                                                           VerticalAlignment="Top"/>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{Binding Message}"
                                                               Foreground="#14181D" FontSize="12"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Suggestion}"
                                                               Foreground="#6B6864" FontSize="11"
                                                               TextWrapping="Wrap"
                                                               Margin="0,2,0,0"
                                                               Visibility="{Binding Suggestion,
                                                                   Converter={StaticResource EmptyToCollapsed}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══════════════════════════════════════════════════════════════
                 TAB 5 — EXPORT
            ═══════════════════════════════════════════════════════════════ -->
            <TabItem Header="📤 التصدير">
                <ScrollViewer Margin="16" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Scope + Format -->
                        <TextBlock Text="نطاق التصدير" Style="{StaticResource SectionTitle}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="نطاق السجلات" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Style="{StaticResource DarkCombo}"
                                          ItemsSource="{Binding AllScopes}"
                                          SelectedItem="{Binding ExportSettings.Scope}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="تنسيق الملف" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Style="{StaticResource DarkCombo}"
                                          ItemsSource="{Binding AllFormats}"
                                          SelectedItem="{Binding ExportSettings.Format}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Output folder -->
                        <TextBlock Text="مجلد الحفظ" Style="{StaticResource SectionTitle}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Style="{StaticResource DarkBox}"
                                     Text="{Binding ExportSettings.OutputFolder}"
                                     IsReadOnly="True"
                                     Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="📂 اختيار"
                                    Style="{StaticResource GhostBtn}"
                                    Command="{Binding BrowseOutputFolderCommand}"/>
                        </Grid>

                        <!-- Naming mode -->
                        <TextBlock Text="تسمية الملفات" Style="{StaticResource SectionTitle}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="طريقة التسمية" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Style="{StaticResource DarkCombo}"
                                          ItemsSource="{Binding AllNamingModes}"
                                          SelectedItem="{Binding ExportSettings.NamingMode}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="صيغة المعادلة (للوضع ByFormula)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource DarkBox}"
                                         Text="{Binding ExportSettings.NamingFormula, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Quality -->
                        <TextBlock Text="الجودة" Style="{StaticResource SectionTitle}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="دقة DPI" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource DarkBox}"
                                         Text="{Binding ExportSettings.DpiResolution, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                                <CheckBox Content="تجاهل التحذيرات وتصدير فقط" Style="{StaticResource CheckStyle}"
                                          IsChecked="{Binding ExportSettings.IgnoreWarnings}"/>
                                <CheckBox Content="تصدير السجلات الصحيحة فقط" Style="{StaticResource CheckStyle}"
                                          IsChecked="{Binding ExportSettings.ExportOnlyValid}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Grid layout for multi-item -->
                        <Expander Header="📐 تخطيط متعدد على الصفحة (بطاقات وملصقات)"
                                  Foreground="#6B6864" Margin="0,0,0,16">
                            <Border Background="#FFFFFF" CornerRadius="6" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="عدد الأعمدة" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Style="{StaticResource DarkBox}"
                                                 Text="{Binding ExportSettings.GridColumns, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="عدد الصفوف" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Style="{StaticResource DarkBox}"
                                                 Text="{Binding ExportSettings.GridRows, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                        <TextBlock Text="مسافة أفقية (mm)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Style="{StaticResource DarkBox}"
                                                 Text="{Binding ExportSettings.SpacingHMm, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="مسافة رأسية (mm)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Style="{StaticResource DarkBox}"
                                                 Text="{Binding ExportSettings.SpacingVMm, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <CheckBox Grid.Row="1" Grid.ColumnSpan="4"
                                              Content="إظهار علامات القطع"
                                              Style="{StaticResource CheckStyle}"
                                              IsChecked="{Binding ExportSettings.ShowCutMarks}"
                                              Margin="0,8,0,0"/>
                                </Grid>
                            </Border>
                        </Expander>

                        <!-- Export button + progress -->
                        <Border Background="#FFFFFF" CornerRadius="8" Padding="16,14">
                            <StackPanel>
                                <ProgressBar Height="6" Value="{Binding ExportProgress}"
                                             Background="#DDD9D3" Foreground="#1B7F4C"
                                             Visibility="{Binding IsExporting, Converter={StaticResource BoolToVis}}"
                                             Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="🚀 بدء التصدير"
                                            Style="{StaticResource SuccessBtn}"
                                            Command="{Binding StartExportAsyncCommand}"
                                            IsEnabled="{Binding IsExporting, Converter={StaticResource InverseBool}}"
                                            Padding="20,9" FontSize="14" FontWeight="SemiBold"
                                            Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding ExportStatusText}"
                                               Foreground="{Binding ExportStatusColor}"
                                               FontSize="13" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- ══════════════════════════════════════════════════════════════════════
             STATUS BAR
        ══════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="#FFFFFF"
                BorderBrush="#DDD9D3"
                BorderThickness="0,1,0,0"
                Padding="16,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding GlobalStatusMessage}"
                           Foreground="{Binding GlobalStatusColor}"
                           FontSize="11"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
