<UserControl x:Class="Apex.UI.Views.DistributionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1200"
             Background="#F8FAFC">
    
    <UserControl.Resources>
        <!-- Card Style -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.08" Color="#000"/>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Status Badge -->
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!-- Primary Button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#475569"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <!-- Main Layout: visible when not printing -->
        <Grid x:Name="MainLayout" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- File Selector -->
                <RowDefinition Height="*"/>    <!-- Printers Grid + Settings -->
                <RowDefinition Height="Auto"/> <!-- Action Buttons -->
            </Grid.RowDefinitions>
            
            <!-- 1️⃣ TOP: File Selector -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="24" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,8">
                            <Run Text="📄 "/><Run Text="{DynamicResource Distribution_SelectFile}"/>
                        </TextBlock>
                        <Button Command="{Binding ChooseFileCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left">
                            <TextBlock Text="{DynamicResource Distribution_ChooseFile}"/>
                        </Button>
                        <TextBlock Text="{Binding FileName, TargetNullValue='No file selected'}" FontSize="14" Foreground="#64748B" Margin="0,12,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding SelectedFilePath, Converter={StaticResource NullToVisConverter}}">
                            <Border Background="#F0FDF4" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                                <TextBlock Text="{Binding FileType}" FontWeight="SemiBold" FontSize="11" Foreground="#166534"/>
                            </Border>
                            <Border Background="#F1F5F9" CornerRadius="6" Padding="8,4">
                                <TextBlock Text="{Binding FileSize}" FontSize="11" Foreground="#475569"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- Preview Thumbnail (placeholder) -->
                    <Border Grid.Column="1" Width="100" Height="100" Background="#EFF6FF" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1">
                        <TextBlock Text="📄" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 2️⃣ MIDDLE: Printers Grid + Settings -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <!-- Printers Grid -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="24" Margin="0,0,16,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" FontSize="18" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,16">
                            <Run Text="🖨️ "/><Run Text="{DynamicResource Distribution_SelectPrinters}"/>
                        </TextBlock>
                        
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding AvailablePrinters}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC" CornerRadius="8" Padding="16" Margin="0,0,12,12" BorderThickness="2" BorderBrush="#E2E8F0" Cursor="Hand">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="#FEF2F8"/>
                                                            <Setter Property="BorderBrush" Value="#3B82F6"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                
                                                <CheckBox Grid.Row="0" IsChecked="{Binding IsSelected}" Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#1E293B" FontSize="13"/>
                                                </CheckBox>
                                                
                                                <Border Grid.Row="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource StatusBadge}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Online">
                                                                    <Setter Property="Background" Value="#D1FAE5"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Offline">
                                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Busy">
                                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Medium">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Online">
                                                                        <Setter Property="Foreground" Value="#047857"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Offline">
                                                                        <Setter Property="Foreground" Value="#B91C1C"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Busy">
                                                                        <Setter Property="Foreground" Value="#92400E"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- 3️⃣ SIDEBAR: Settings -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,16">
                            <Run Text="⚙️ "/><Run Text="{DynamicResource Distribution_PrintSettings}"/>
                        </TextBlock>
                        
                        <!-- Copies -->
                        <TextBlock Text="{DynamicResource Distribution_Copies}" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Copies}" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10,8" Margin="0,0,0,12"/>
                        
                        <!-- Color -->
                        <TextBlock Text="{DynamicResource Distribution_ColorMode}" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                        <CheckBox IsChecked="{Binding ColorMode}" Content="{DynamicResource Distribution_PrintInColor}" Margin="0,0,0,12"/>
                        
                        <!-- Duplex -->
                        <TextBlock Text="{DynamicResource Distribution_Duplex}" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                        <CheckBox IsChecked="{Binding DuplexEnabled}" Content="{DynamicResource Distribution_TwoSided}" Margin="0,0,0,12"/>
                        
                        <!-- Page Range -->
                        <TextBlock Text="{DynamicResource Distribution_PageRange}" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding PageRange}" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10,8" Margin="0,0,0,12"/>
                        
                        <!-- Timeout -->
                        <TextBlock Text="{DynamicResource Distribution_Timeout}" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="10" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10,8" Margin="0,0,0,12"/>
                        
                        <!-- Retry -->
                        <TextBlock Text="{DynamicResource Distribution_RetryAttempts}" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10,8"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 4️⃣ BOTTOM: Action Buttons -->
            <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="20" Margin="0,16,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Command="{Binding SelectAllPrintersCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0">
                            <TextBlock Text="{DynamicResource Distribution_SelectAll}"/>
                        </Button>
                        <Button Command="{Binding DeselectAllPrintersCommand}" Style="{StaticResource SecondaryButton}">
                            <TextBlock Text="{DynamicResource Distribution_Reset}"/>
                        </Button>
                    </StackPanel>
                    
                    <Button Command="{Binding PrintToSelectedCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Padding="32,12" FontSize="14">
                        <TextBlock><Run Text="🚀 "/><Run Text="{DynamicResource Distribution_StartPrinting}"/></TextBlock>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- 5️⃣ MONITOR: Live Printing Monitor (shown after start) -->
        <Border x:Name="MonitorLayout" Style="{StaticResource Card}" Padding="24" Visibility="{Binding IsPrinting, Converter={StaticResource BoolToVisConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock Grid.Row="0" FontSize="20" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,16">
                    <Run Text="📊 "/><Run Text="{DynamicResource Distribution_LiveMonitor}"/>
                </TextBlock>

                <!-- Counters -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Background="#D1FAE5" CornerRadius="8" Padding="16,8" Margin="0,0,12,0">
                        <TextBlock FontWeight="SemiBold">
                            <Run Text="✅ "/><Run Text="{DynamicResource Distribution_Success}"/><Run Text=":"/>
                            <Run Text="{Binding SuccessCount}" Foreground="#047857" FontSize="16"/>
                        </TextBlock>
                    </Border>
                    <Border Background="#FEE2E2" CornerRadius="8" Padding="16,8" Margin="0,0,12,0">
                        <TextBlock FontWeight="SemiBold">
                            <Run Text="❌ "/><Run Text="{DynamicResource Distribution_Failed}"/><Run Text=":"/>
                            <Run Text="{Binding FailedCount}" Foreground="#B91C1C" FontSize="16"/>
                        </TextBlock>
                    </Border>
                    <Border Background="#DBEAFE" CornerRadius="8" Padding="16,8">
                        <TextBlock FontWeight="SemiBold">
                            <Run Text="⏳ PRINTING:" Foreground="#1E40AF"/>
                            <Run Text="{Binding PendingCount}" Foreground="#1E40AF" FontSize="16"/>
                        </TextBlock>
                    </Border>
                </StackPanel>

                <!-- Results Table -->
                <DataGrid Grid.Row="2" ItemsSource="{Binding LiveResults}" AutoGenerateColumns="False" IsReadOnly="True"
                          BorderThickness="0" Background="White" RowHeight="48"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Foreground" Value="#64748B"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="16,12"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Distribution_PrinterName}" Binding="{Binding PrinterName}" Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource Distribution_StatusText}" Binding="{Binding StatusText}" Width="120"/>
                        <DataGridTextColumn Header="{DynamicResource Distribution_JobId}" Binding="{Binding JobId}" Width="100"/>
                        <DataGridTextColumn Header="{DynamicResource Distribution_Time}" Binding="{Binding DurationText}" Width="80"/>
                        <DataGridTextColumn Header="{DynamicResource Distribution_Error}" Binding="{Binding ErrorMessage}" Width="200"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Command="{Binding CancelAllCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0">
                        <TextBlock Text="{DynamicResource Distribution_CancelAll}"/>
                    </Button>
                    <Button Command="{Binding RetryFailedCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0">
                        <TextBlock Text="{DynamicResource Distribution_RetryFailed}"/>
                    </Button>
                    <Button Command="{Binding ExportReportCommand}" Style="{StaticResource PrimaryButton}">
                        <TextBlock Text="{DynamicResource Distribution_ExportReport}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
