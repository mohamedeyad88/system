<UserControl x:Class="Apex.UI.Views.DistributionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1200"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Dark Modern Card Style -->
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stat Card Style -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="MinWidth" Value="140"/>
        </Style>

        <!-- Primary Action Button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button - Dark -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Printer Card Button Style -->
        <Style x:Key="PrinterActionButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="12,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Stats Row -->
            <RowDefinition Height="*"/>      <!-- Printers Grid -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════════
             1️⃣ HEADER SECTION
             ═══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title & Subtitle -->
            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <Border Background="#1E3A5F" CornerRadius="10" Padding="10" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="🖨️" FontSize="24"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Monitor_Title}"
                                   FontSize="28" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{DynamicResource Monitor_Subtitle}"
                                   FontSize="14" Foreground="#94A3B8" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Refresh Area -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="آخر تحديث" FontSize="11" Foreground="#64748B"/>
                    <TextBlock Text="{Binding LastUpdated, StringFormat='{}{0:HH:mm:ss}'}"
                               FontSize="14" FontWeight="SemiBold" Foreground="#CBD5E1"/>
                </StackPanel>
                <Button Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Monitor_Refresh}" FontSize="14"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════════
             2️⃣ STATISTICS CARDS
             ═══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Printers Card -->
            <Border Grid.Column="0" Style="{StaticResource StatCard}" Margin="0,0,12,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1E3A5F" Offset="0"/>
                        <GradientStop Color="#1E40AF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#2563EB" CornerRadius="10"
                            Width="48" Height="48" Margin="0,0,16,0">
                        <TextBlock Text="📊" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Monitor_Total}" FontSize="13" Foreground="#93C5FD"/>
                        <TextBlock Text="{Binding TotalPrinters}" FontSize="32" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Online Printers Card -->
            <Border Grid.Column="1" Style="{StaticResource StatCard}" Margin="6,0,12,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#064E3B" Offset="0"/>
                        <GradientStop Color="#065F46" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#10B981" CornerRadius="10"
                            Width="48" Height="48" Margin="0,0,16,0">
                        <TextBlock Text="✓" FontSize="24" Foreground="White" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Monitor_Online}" FontSize="13" Foreground="#6EE7B7"/>
                        <TextBlock Text="{Binding OnlinePrinters}" FontSize="32" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Offline Printers Card -->
            <Border Grid.Column="2" Style="{StaticResource StatCard}" Margin="6,0,12,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#450A0A" Offset="0"/>
                        <GradientStop Color="#7F1D1D" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#EF4444" CornerRadius="10"
                            Width="48" Height="48" Margin="0,0,16,0">
                        <TextBlock Text="✕" FontSize="24" Foreground="White" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Monitor_Offline}" FontSize="13" Foreground="#FCA5A5"/>
                        <TextBlock Text="{Binding OfflinePrinters}" FontSize="32" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Busy Printers Card -->
            <Border Grid.Column="3" Style="{StaticResource StatCard}" Margin="6,0,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#451A03" Offset="0"/>
                        <GradientStop Color="#78350F" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#F59E0B" CornerRadius="10"
                            Width="48" Height="48" Margin="0,0,16,0">
                        <TextBlock Text="⏳" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Monitor_Busy}" FontSize="13" Foreground="#FDE68A"/>
                        <TextBlock Text="{Binding BusyPrinters}" FontSize="32" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════════
             3️⃣ PRINTERS GRID
             ═══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Style="{StaticResource ModernCard}" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Section Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                    <Border Background="#334155" CornerRadius="8" Padding="8" Margin="0,0,12,0">
                        <TextBlock Text="📋" FontSize="18"/>
                    </Border>
                    <TextBlock Text="{DynamicResource Monitor_PrinterStatus}"
                               FontSize="18" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Printers Cards Grid -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <ItemsControl ItemsSource="{Binding AvailablePrinters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Individual Printer Card - Neutral Dark, colored left-border only -->
                                <Border Margin="0,0,16,16" CornerRadius="14" Padding="20"
                                        Background="#1E293B" BorderThickness="0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.25" Color="#000000"/>
                                    </Border.Effect>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4"/>   <!-- Status accent bar -->
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Colored left-accent bar -->
                                        <Border Grid.Column="0" CornerRadius="4,0,0,4" Margin="-20,-20,12,-20">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#334155"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Ready">
                                                            <Setter Property="Background" Value="#10B981"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Offline">
                                                            <Setter Property="Background" Value="#EF4444"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Error">
                                                            <Setter Property="Background" Value="#EF4444"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Not Available">
                                                            <Setter Property="Background" Value="#EF4444"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Busy">
                                                            <Setter Property="Background" Value="#F59E0B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Printing">
                                                            <Setter Property="Background" Value="#F59E0B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Paper Jam">
                                                            <Setter Property="Background" Value="#F87171"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Out of Paper">
                                                            <Setter Property="Background" Value="#F87171"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Toner Low">
                                                            <Setter Property="Background" Value="#F59E0B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <!-- Card Content -->
                                        <Grid Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>  <!-- Header: Icon + Name -->
                                            <RowDefinition Height="Auto"/>  <!-- Status Badge -->
                                            <RowDefinition Height="Auto"/>  <!-- Info Row -->
                                            <RowDefinition Height="Auto"/>  <!-- Print Jobs -->
                                            <RowDefinition Height="*"/>     <!-- Spacer -->
                                            <RowDefinition Height="Auto"/>  <!-- Action Buttons -->
                                        </Grid.RowDefinitions>

                                        <!-- Header: Large Icon + Printer Name -->
                                        <Grid Grid.Row="0" Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Printer Icon — always neutral -->
                                            <Border Grid.Column="0" CornerRadius="12" Width="48" Height="48"
                                                    Background="#334155" Margin="0,0,14,0" VerticalAlignment="Center">
                                                <TextBlock FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="🖨️"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Type}" Value="Network">
                                                                    <Setter Property="Text" Value="🌐"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Type}" Value="Virtual">
                                                                    <Setter Property="Text" Value="💻"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Type}" Value="USB">
                                                                    <Setter Property="Text" Value="🔌"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- Printer Name & Type -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"
                                                           Foreground="#F1F5F9" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Name}"/>
                                                <Border Background="#0F172A" CornerRadius="4" Padding="6,2"
                                                        HorizontalAlignment="Left" Margin="0,5,0,0">
                                                    <TextBlock Text="{Binding Type}" FontSize="10" Foreground="#64748B" FontWeight="Medium"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Status Badge — small pill only -->
                                        <Border Grid.Row="1" CornerRadius="6" Padding="10,6"
                                                HorizontalAlignment="Left" Margin="0,0,0,12"
                                                Background="#0F172A">
                                            <StackPanel Orientation="Horizontal">
                                                <!-- Status Indicator Dot -->
                                                <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#94A3B8"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Ready">
                                                                    <Setter Property="Fill" Value="#10B981"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Offline">
                                                                    <Setter Property="Fill" Value="#EF4444"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Busy">
                                                                    <Setter Property="Fill" Value="#F59E0B"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Printing">
                                                                    <Setter Property="Fill" Value="#F59E0B"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Error">
                                                                    <Setter Property="Fill" Value="#EF4444"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="13">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Ready">
                                                                    <Setter Property="Foreground" Value="#34D399"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Offline">
                                                                    <Setter Property="Foreground" Value="#F87171"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Busy">
                                                                    <Setter Property="Foreground" Value="#FCD34D"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Printing">
                                                                    <Setter Property="Foreground" Value="#FCD34D"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Error">
                                                                    <Setter Property="Foreground" Value="#F87171"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>

                                        <!-- Queue Info -->
                                        <Border Grid.Row="2" Background="#0F172A" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📋" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <TextBlock FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center">
                                                    <Run Text="{DynamicResource Monitor_Queue}"/>
                                                    <Run Text=": "/>
                                                    <Run Text="{Binding QueueLength}" FontWeight="Bold" Foreground="#CBD5E1"/>
                                                    <Run Text=" "/>
                                                    <Run Text="{DynamicResource Monitor_Jobs}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>

                                        <!-- Print Jobs for this Printer -->
                                        <Border Grid.Row="3" Background="#0F172A" CornerRadius="8" Padding="12,10" Margin="0,0,0,16"
                                                Visibility="{Binding HasPrintJobs, Converter={StaticResource BoolToVisConverter}}">
                                            <StackPanel>
                                                <TextBlock Text="مهام الطباعة النشطة" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="#94A3B8" Margin="0,0,0,8"/>
                                                <ItemsControl ItemsSource="{Binding PrintJobs}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="6"
                                                                    BorderThickness="1" BorderBrush="#334155" Background="#1E293B">
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                    </Grid.RowDefinitions>
                                                                    <Grid Grid.Row="0">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0">
                                                                            <TextBlock Text="{Binding FileName}"
                                                                                       FontSize="11" FontWeight="Medium"
                                                                                       Foreground="#F1F5F9" TextTrimming="CharacterEllipsis"/>
                                                                            <TextBlock Text="{Binding ScaleMode}"
                                                                                       FontSize="9"
                                                                                       Foreground="#94A3B8"
                                                                                       Margin="0,2,0,0"
                                                                                       Visibility="{Binding ScaleMode, Converter={StaticResource NullToVisConverter}}"/>
                                                                        </StackPanel>
                                                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                                                                   FontSize="10" FontWeight="Medium"
                                                                                   Foreground="{Binding StatusColor}"/>
                                                                    </Grid>
                                                                    <ProgressBar Grid.Row="1" Value="{Binding Progress}"
                                                                                 Maximum="100" Height="4" Margin="0,6,0,0"
                                                                                 Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisConverter}}">
                                                                        <ProgressBar.Style>
                                                                            <Style TargetType="ProgressBar">
                                                                                <Setter Property="Background" Value="#334155"/>
                                                                                <Setter Property="Foreground" Value="#2563EB"/>
                                                                            </Style>
                                                                        </ProgressBar.Style>
                                                                    </ProgressBar>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- Action Buttons -->
                                        <Grid Grid.Row="5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Properties Button -->
                                            <Button Grid.Column="0" Background="#2563EB"
                                                    Style="{StaticResource PrinterActionButton}"
                                                    Command="{Binding DataContext.OpenPropertiesCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Name}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="⚙️" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{DynamicResource Monitor_Properties}"
                                                               Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Preferences Button -->
                                            <Button Grid.Column="2" Background="#7C3AED"
                                                    Style="{StaticResource PrinterActionButton}"
                                                    Command="{Binding DataContext.OpenPreferencesCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Name}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="🔧" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{DynamicResource Monitor_Preferences}"
                                                               Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        </Grid>  <!-- /inner content grid -->
                                    </Grid>      <!-- /outer 2-col grid -->
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty State -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasNoPrinters, Converter={StaticResource BoolToVisConverter}}">
                    <Border Background="#1E293B" CornerRadius="50" Width="100" Height="100" Margin="0,0,0,24">
                        <TextBlock Text="🖨️" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{DynamicResource Monitor_NoPrinters}" FontSize="20" FontWeight="SemiBold"
                               Foreground="#CBD5E1" HorizontalAlignment="Center"/>
                    <TextBlock Text="لم يتم العثور على أي طابعات متصلة بالنظام" FontSize="14"
                               Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,8,0,24"/>
                    <Button Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Monitor_ScanAgain}" FontSize="14"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
