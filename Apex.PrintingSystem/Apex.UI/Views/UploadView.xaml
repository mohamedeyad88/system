<UserControl x:Class="Apex.UI.Views.UploadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:viewmodels="clr-namespace:Apex.UI.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="{DynamicResource Brush.Background}">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border.Light}" BorderThickness="0,0,1,0">
            <StackPanel>
                
                <!-- Action Buttons Row -->
                <Grid Margin="15,15,15,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Add Files Button -->
                    <Button Grid.Column="0" Height="70" Margin="0,0,5,0" Cursor="Hand"
                            Command="{Binding BrowseFilesCommand}" ToolTip="Add Files">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="8" Background="#EA580C">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="📄" FontSize="24" HorizontalAlignment="Center" Foreground="White"/>
                                        <TextBlock Text="{DynamicResource Upload_AddFiles}" FontSize="11" HorizontalAlignment="Center" Foreground="White" Margin="0,4,0,0" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#C2410C"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <!-- Add Folder Button -->
                    <Button Grid.Column="1" Height="70" Margin="5,0,0,0" Cursor="Hand"
                            Command="{Binding BrowseFolderCommand}" ToolTip="Add Folder">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="8" Background="#F97316">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="📁" FontSize="24" HorizontalAlignment="Center" Foreground="White"/>
                                        <TextBlock Text="{DynamicResource Upload_AddFolder}" FontSize="11" HorizontalAlignment="Center" Foreground="White" Margin="0,4,0,0" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#EA580C"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
                
                <!-- Select Printer Section -->
                <Border Margin="15,5,15,10" CornerRadius="8" Padding="12" Background="#EA580C">
                    <StackPanel>
                        <TextBlock Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,10">
                            <Run Text="🖨️ "/><Run Text="{DynamicResource Upload_SelectPrinter}"/>
                        </TextBlock>
                        <Border Background="White" CornerRadius="6" Padding="2">
                            <ComboBox ItemsSource="{Binding AvailablePrinters}" 
                                      SelectedItem="{Binding SelectedPrinter}"
                                      Background="Transparent" Padding="8,6" FontSize="12"
                                      BorderThickness="0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Padding="2"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Border>
                        <Button Margin="0,12,0,0"
                                Command="{Binding OpenPrinterPropertiesCommand}"
                                Background="Transparent" Foreground="White" 
                                BorderThickness="1" BorderBrush="#FFFFFF50" 
                                HorizontalAlignment="Stretch" Padding="8,6"
                                Cursor="Hand" FontSize="12">
                            <TextBlock><Run Text="⚙️ "/><Run Text="{DynamicResource Upload_PrinterProperties}"/></TextBlock>
                        </Button>
                    </StackPanel>
                </Border>
                
                <!-- Settings Section -->
                <Border Margin="15,5,15,10" CornerRadius="8" Padding="12" Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Upload_PrintSettings}" FontWeight="Bold" FontSize="14" Margin="0,0,0,12" Foreground="#333"/>
                        
                        <!-- Copies -->
                        <TextBlock Text="{DynamicResource Upload_DefaultCopies}" Foreground="#666" FontSize="11" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Value="{Binding DefaultCopies}" Minimum="1" Maximum="100" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1"/>
                            <TextBlock Grid.Column="1" Text="{Binding DefaultCopies}" FontWeight="Bold" Foreground="#EA580C" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                        
                        <!-- Orientation -->
                        <TextBlock Text="{DynamicResource Upload_Orientation}" Foreground="#666" FontSize="11" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Orientations}" SelectedItem="{Binding Orientation}" Margin="0,0,0,12" Padding="6,4" Background="#F9FAFB" BorderBrush="#E5E7EB"/>

                        <!-- Quality -->
                        <TextBlock Text="{DynamicResource Upload_PrintQuality}" Foreground="#666" FontSize="11" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding PrintQualities}" SelectedItem="{Binding PrintQuality}" Margin="0,0,0,12" Padding="6,4" Background="#F9FAFB" BorderBrush="#E5E7EB"/>
                        
                        <!-- Toggles -->
                        <StackPanel Orientation="Vertical">
                            <CheckBox Content="{DynamicResource Upload_ColorPrinting}" IsChecked="{Binding IsColorEnabled}" Margin="0,0,0,8" FontSize="12" Foreground="#374151"/>
                            <CheckBox Content="{DynamicResource Upload_Duplex}" IsChecked="{Binding IsDuplexEnabled}" Margin="0,0,0,0" FontSize="12" Foreground="#374151"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- Status Section -->
                <Border Background="White" Margin="15,5,15,10" CornerRadius="8" Padding="12" 
                        BorderBrush="#3B82F6" BorderThickness="0,0,0,3">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" FontSize="13" Foreground="#333" Margin="0,0,0,8">
                            <Run Text="📋 "/><Run Text="{DynamicResource Upload_Status}"/>
                        </TextBlock>
                        <TextBlock Text="{DynamicResource Upload_PleaseAdd}" 
                                   TextWrapping="Wrap" FontSize="12" Foreground="#666"/>
                        <Border Background="#FFF0F6" CornerRadius="4" Padding="8" Margin="0,10,0,0">
                            <TextBlock Text="{Binding StatusMessage, FallbackValue={StaticResource Upload_ListEmpty}}" 
                                       Foreground="#EA580C" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Border>
                
            </StackPanel>
        </Border>
        
        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Header Bar -->
            <Border Grid.Row="0" Padding="15,12" Background="#EA580C">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📋" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Upload_ListOfDocuments}" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Toolbar Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Width="36" Height="32" Background="#FFFFFF20" Foreground="White" 
                                BorderThickness="0" ToolTip="Refresh" Command="{Binding RefreshCommand}" Margin="3,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#FFFFFF20" CornerRadius="4">
                                        <TextBlock Text="🔄" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FFFFFF40"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="36" Height="32" Background="#FFFFFF20" Foreground="White" 
                                BorderThickness="0" ToolTip="Clear All" Command="{Binding ClearListCommand}" Margin="3,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#FFFFFF20" CornerRadius="4">
                                        <TextBlock Text="✖️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FFFFFF40"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="36" Height="32" Background="#FFFFFF20" Foreground="White" 
                                BorderThickness="0" ToolTip="Copy to Clipboard" Margin="3,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#FFFFFF20" CornerRadius="4">
                                        <TextBlock Text="📋" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FFFFFF40"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="36" Height="32" Background="#09A603" Foreground="White" 
                                BorderThickness="0" ToolTip="Print All" Command="{Binding CreateJobsCommand}" Margin="3,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#09A603" CornerRadius="4">
                                        <TextBlock Text="🖨️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#0BC904"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Document List Area -->
            <Border Grid.Row="1" Background="White" AllowDrop="True" Drop="Border_Drop" Margin="0">
                <Grid>
                    <!-- DataGrid -->
                    <DataGrid ItemsSource="{Binding IngestedFiles}" AutoGenerateColumns="False" 
                              CanUserAddRows="False" BorderThickness="0" Background="White"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              RowHeight="40" ColumnHeaderHeight="36"
                              AlternatingRowBackground="#FAFAFA">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8F8F8"/>
                                <Setter Property="Foreground" Value="#333"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="BorderBrush" Value="#F0F0F0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#FFF0F6"/>
                                        <Setter Property="BorderBrush" Value="#3B82F6"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFF5F9"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="45"/>
                            <DataGridCheckBoxColumn Header="✓" Width="35"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding OriginalName}" Width="*"/>
                            <DataGridTextColumn Header="Date Modified" Binding="{Binding ModifiedDate, StringFormat='yyyy-MM-dd'}" Width="110"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding FileType}" Width="70"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="80"/>
                            <DataGridTextColumn Header="Folder Path" Binding="{Binding FolderPath}" Width="150"/>
                            <DataGridTextColumn Header="Copies" Binding="{Binding Copies}" Width="60"/>
                            <DataGridTextColumn Header="Pages" Binding="{Binding PageRange}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    
                    <!-- Drop Zone Placeholder (when empty) -->
                    <Border Visibility="{Binding IngestedFiles.Count, Converter={StaticResource InverseCountToVisibilityConverter}}"
                            Margin="60" BorderThickness="3" CornerRadius="16"
                            Background="#FFFBFD" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding BrowseFilesCommand}"/>
                        </Border.InputBindings>
                        <Border.BorderBrush>
                            <DrawingBrush Viewport="0,0,12,12" ViewportUnits="Absolute" TileMode="Tile">
                                <DrawingBrush.Drawing>
                                    <GeometryDrawing>
                                        <GeometryDrawing.Pen>
                                            <Pen Brush="#EA580C" Thickness="2" DashStyle="{x:Static DashStyles.Dash}"/>
                                        </GeometryDrawing.Pen>
                                        <GeometryDrawing.Geometry>
                                            <RectangleGeometry Rect="0,0,12,12"/>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Border.BorderBrush>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="📁" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                            <TextBlock Text="{DynamicResource Upload_DropFiles}" FontSize="20" Foreground="#EA580C" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Upload_AddFromMenu}" FontSize="14" Foreground="#999" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        

    </Grid>
</UserControl>
