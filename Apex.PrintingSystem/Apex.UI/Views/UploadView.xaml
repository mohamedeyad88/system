<UserControl x:Class="Apex.UI.Views.UploadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Apex.UI.ViewModels"
             xmlns:converters="clr-namespace:Apex.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200"
             Background="Transparent">

    <UserControl.Resources>

        <!-- Shows the search placeholder only while the box is empty. The shared
             dictionary registers the NON-empty variant, which is the opposite. -->
        <converters:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>

        <!-- ── Shared flat button template ──────────────────────────── -->
        <ControlTemplate x:Key="FlatBtn" TargetType="Button">
            <Border x:Name="bg"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding Tag}"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bg" Property="Opacity" Value="0.82"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="bg" Property="Opacity" Value="0.65"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="bg" Property="Opacity" Value="0.35"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ── ComboBox toggle button ────────────────────────────────── -->
        <ControlTemplate x:Key="DarkComboToggle" TargetType="ToggleButton">
            <Border x:Name="bg"
                    Background="{TemplateBinding Background}"
                    BorderBrush="#DDD9D3" BorderThickness="1"
                    CornerRadius="7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Grid.Column="0" Margin="10,0,0,0"
                                      VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <Path Grid.Column="1" x:Name="arrow"
                          Data="M 0 0 L 4 4 L 8 0"
                          Stroke="#6B6864" StrokeThickness="1.5"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bg" Property="BorderBrush" Value="#6B6864"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="bg" Property="BorderBrush" Value="#0891B2"/>
                    <Setter TargetName="arrow" Property="Stroke"   Value="#0891B2"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ── ComboBox dark style ───────────────────────────────────── -->
        <Style TargetType="ComboBox">
            <Setter Property="Background"              Value="#FAF9F7"/>
            <Setter Property="Foreground"              Value="#14181D"/>
            <Setter Property="BorderBrush"             Value="#DDD9D3"/>
            <Setter Property="BorderThickness"         Value="1"/>
            <Setter Property="FontSize"                Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource DarkComboToggle}"
                                          Background="{TemplateBinding Background}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"/>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="12,0,28,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <Popup x:Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDown"
                                        Background="#FFFFFF"
                                        BorderBrush="#DDD9D3" BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="220" SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000" Opacity="0.4"
                                                          BlurRadius="16" ShadowDepth="4"/>
                                    </Border.Effect>
                                    <ScrollViewer Margin="0,4" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="Foreground"                 Value="#14181D"/>
            <Setter Property="FontSize"                   Value="12"/>
            <Setter Property="Padding"                    Value="12,7"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="5" Margin="4,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E6F3F6"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E6F3F6"/>
                                <Setter Property="Foreground" Value="#0891B2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── TextBox dark style (editable DataGrid cells) ─────────── -->
        <Style x:Key="CellEditBox" TargetType="TextBox">
            <Setter Property="Background"   Value="#FAF9F7"/>
            <Setter Property="Foreground"   Value="#14181D"/>
            <Setter Property="BorderBrush"  Value="#0891B2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"      Value="4,2"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ── DataGrid column header ────────────────────────────────── -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="#FFFFFF"/>
            <Setter Property="Foreground"      Value="#6B6864"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="10,10"/>
            <Setter Property="BorderBrush"     Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsSelected"  Value="True">
                    <Setter Property="Background" Value="#E6F3F6"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E6F3F6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Flat toggle used by the printer picker: the ToggleButton default chrome
             would fight the dark theme, and we only need a bordered surface. -->
        <ControlTemplate x:Key="PickerToggle" TargetType="ToggleButton">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6">
                <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#0891B2"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Field caption in the settings rail -->
        <Style x:Key="RailLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="Foreground" Value="#6B6864"/>
            <Setter Property="Margin"     Value="0,14,0,5"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#14181D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <!-- ═══════════════════ ROOT GRID ══════════════════════════════════
         Print settings live in a fixed side rail rather than a wide strip
         across the top: as a horizontal bar they competed with the queue for
         width, wrapped awkwardly, and read as if they belonged to the toolbar
         buttons next to them. In a rail they stay put, stay grouped, and the
         queue gets the full height it needs.
         ═══════════════════════════════════════════════════════════════════ -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>     <!-- Queue + its own toolbar -->
            <ColumnDefinition Width="Auto"/>  <!-- Settings rail           -->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- ① Printer bar      -->
            <RowDefinition Height="Auto"/>   <!-- ② Queue toolbar    -->
            <RowDefinition Height="Auto"/>   <!-- ③ Presets bar      -->
            <RowDefinition Height="Auto"/>   <!-- ④ Printer alert    -->
            <RowDefinition Height="Auto"/>   <!-- ⑤ Progress bar     -->
            <RowDefinition Height="*"/>      <!-- ⑥ File list        -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════════
             ①  TOP: Printer selector + Start Printing
             ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Grid.ColumnSpan="2"
                Background="#FFFFFF"
                BorderBrush="#DDD9D3" BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,24,0">
                    <Border Background="#0891B2" CornerRadius="9"
                            Width="36" Height="36" Margin="0,0,10,0">
                        <TextBlock Text="⚡" FontSize="17"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Upload_Title}"
                                   FontSize="15" FontWeight="Bold" Foreground="#14181D"/>
                        <TextBlock Text="{DynamicResource Upload_Description}"
                                   FontSize="10" Foreground="#6B6864"/>
                        <!-- What this run will actually do, before it starts -->
                        <TextBlock Text="{Binding RoutingSummary}"
                                   FontSize="10" FontWeight="Medium" Foreground="#0891B2"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Printer selector, with the multi-printer panel stacked UNDER it.
                     (Both must live in a StackPanel: placing the panel directly in
                     the selector Grid put it in column 0, overlapping the title.) -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <Grid Visibility="{Binding IsSinglePrinterMode,
                                   Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#FAF9F7"
                            CornerRadius="9" Width="36" Height="36" Margin="0,0,10,0">
                        <TextBlock Text="🖨️" FontSize="17"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailablePrinters}"
                              SelectedItem="{Binding SelectedPrinter}"
                              Height="36" FontSize="13"/>

                    <Button Grid.Column="2"
                            Command="{Binding OpenPrinterPropertiesCommand}"
                            Background="#DDD9D3" Width="36" Height="36"
                            Margin="8,0,0,0" Cursor="Hand" Tag="9"
                            ToolTip="{DynamicResource Upload_PrinterProperties}"
                            Template="{StaticResource FlatBtn}">
                        <TextBlock Text="⚙️" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <!-- Multi-printer: send the whole file queue to several printers at
                     once — either spread across them, or the same files on each. -->
                <CheckBox IsChecked="{Binding IsMultiPrinterMode}"
                          Content="{DynamicResource PM_MultiPrinter}"
                          Foreground="#14181D" FontSize="12" Margin="0,10,0,0"/>

                <!-- Printer picker. The header must not grow with the printer count:
                     a shop with 50 devices would push the queue toolbar off screen,
                     and picking 3 of 50 from a cramped checkbox box is unworkable.
                     The bar shows only the outcome; selection happens in a popup of
                     fixed height with a search field. -->
                <Grid Margin="0,8,0,0"
                      Visibility="{Binding IsMultiPrinterMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <!-- Auto so the mode label fits. At a fixed 180 it truncated to
                             "Load balance — each file o…", which hides exactly the part
                             that distinguishes the two modes. -->
                        <ColumnDefinition Width="Auto" MinWidth="180"/>
                    </Grid.ColumnDefinitions>

                    <ToggleButton x:Name="PrinterPickerButton" Grid.Column="0"
                                  IsChecked="{Binding IsPrinterPickerOpen, Mode=TwoWay}"
                                  Height="32" Cursor="Hand"
                                  Background="#FAF9F7" BorderBrush="#DDD9D3" BorderThickness="1"
                                  Template="{StaticResource PickerToggle}">
                        <Grid>
                            <TextBlock Text="{Binding SelectedPrintersSummary}"
                                       Foreground="#14181D" FontSize="12"
                                       VerticalAlignment="Center" Margin="12,0,26,0"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="▾" Foreground="#6B6864" FontSize="11"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                        </Grid>
                    </ToggleButton>

                    <Popup IsOpen="{Binding IsPrinterPickerOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=PrinterPickerButton}"
                           Placement="Bottom" StaysOpen="False"
                           AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="#FFFFFF" BorderBrush="#DDD9D3" BorderThickness="1"
                                CornerRadius="8" Padding="10"
                                Width="{Binding ActualWidth, ElementName=PrinterPickerButton}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000" Opacity="0.45"
                                                  BlurRadius="18" ShadowDepth="5"/>
                            </Border.Effect>
                            <StackPanel>
                                <!-- Search: the only way 50 printers stay navigable -->
                                <Border Background="#FAF9F7" BorderBrush="#DDD9D3"
                                        BorderThickness="1" CornerRadius="6" Height="30">
                                    <Grid>
                                        <TextBox Background="Transparent" BorderThickness="0"
                                                 Foreground="#14181D" FontSize="12" Padding="8,0"
                                                 VerticalContentAlignment="Center"
                                                 Text="{Binding PrinterFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="{DynamicResource PM_SearchPrinter}"
                                                   Foreground="#6B6864" FontSize="12"
                                                   IsHitTestVisible="False"
                                                   Margin="9,0,0,0" VerticalAlignment="Center"
                                                   Visibility="{Binding PrinterFilter,
                                                                Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>

                                <!-- Fixed height: the popup never grows with the list -->
                                <ScrollViewer MaxHeight="220" Margin="0,8,0,0"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding FilteredPrinterChoices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected}"
                                                          Content="{Binding Name}"
                                                          Foreground="#14181D" FontSize="12"
                                                          Margin="0,0,0,6"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock Text="{DynamicResource PM_NoPrinterMatch}"
                                           Foreground="#6B6864" FontSize="11"
                                           Margin="2,6,0,0"
                                           Visibility="{Binding HasNoPrinterMatches,
                                                        Converter={StaticResource BoolToVisibility}}"/>

                                <Border Height="1" Background="#DDD9D3" Margin="0,8"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding SelectAllPrintersCommand}"
                                            Background="#0E7490" Tag="5"
                                            Padding="10,4" Cursor="Hand" Margin="0,0,6,0"
                                            Template="{StaticResource FlatBtn}">
                                        <TextBlock Text="{DynamicResource PM_SelectAllShown}"
                                                   FontSize="11" Foreground="White"/>
                                    </Button>
                                    <Button Command="{Binding ClearPrinterSelectionCommand}"
                                            Background="#DDD9D3" Tag="5"
                                            Padding="10,4" Cursor="Hand"
                                            Template="{StaticResource FlatBtn}">
                                        <TextBlock Text="{DynamicResource PM_ClearSelection}"
                                                   FontSize="11" Foreground="#14181D"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding AvailableDistributionModes}"
                              SelectedIndex="{Binding DistributionModeIndex}"
                              ToolTip="{DynamicResource PM_DistributionMode}"
                              Height="32" FontSize="12"/>
                </Grid>
                </StackPanel>

                <!-- Start / Stop -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            Margin="20,0,0,0">
                    <!-- Stop (visible only when printing) -->
                    <Button Command="{Binding StopPrintingCommand}"
                            Visibility="{Binding IsPrinting,
                                         Converter={StaticResource BoolToVisibility}}"
                            Background="#F6E4E2" Tag="10"
                            Padding="14,0" Height="36" Margin="0,0,8,0"
                            Cursor="Hand" Template="{StaticResource FlatBtn}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="■" FontSize="12" Foreground="#B42318"
                                       Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource UPL_001}" FontSize="13" FontWeight="Bold"
                                       Foreground="#B42318"/>
                        </StackPanel>
                    </Button>

                    <!-- Start -->
                    <Button Command="{Binding CreateJobsCommand}"
                            IsEnabled="{Binding CanStartPrinting}"
                            Background="#0891B2" Tag="10"
                            Padding="20,0" Height="36" Cursor="Hand"
                            Template="{StaticResource FlatBtn}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🖨️" FontSize="14" Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Distribution_StartPrinting}"
                                           FontSize="13" FontWeight="Bold" Foreground="White"/>
                                <TextBlock FontSize="9" Foreground="#0E7490">
                                    <Run Text="{Binding IngestedFiles.Count, Mode=OneWay}"/>
                                    <Run Text="{DynamicResource UPL_002}"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════
             ②  QUEUE TOOLBAR — things you do TO the list, not print settings
             ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="#FFFFFF"
                BorderBrush="#FFFFFF" BorderThickness="0,0,0,1"
                Padding="20,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>   <!-- + Files      -->
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>   <!-- Folder       -->
                    <ColumnDefinition Width="*"/>      <!-- Spacer       -->
                    <ColumnDefinition Width="Auto"/>   <!-- Preset btn   -->
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>   <!-- Refresh/Del  -->
                </Grid.ColumnDefinitions>

                <!-- Add Files -->
                <Button Grid.Column="0"
                        Command="{Binding BrowseFilesCommand}"
                        Background="#0891B2" Tag="7"
                        Padding="12,6" Cursor="Hand"
                        Template="{StaticResource FlatBtn}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="＋" FontSize="13" Foreground="White"
                                   Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Upload_AddFiles}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                    </StackPanel>
                </Button>

                <!-- Add Folder -->
                <Button Grid.Column="2"
                        Command="{Binding BrowseFolderCommand}"
                        Background="#DDD9D3" Tag="7"
                        Padding="10,6" Cursor="Hand"
                        Template="{StaticResource FlatBtn}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📁" FontSize="12" Margin="0,0,4,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Upload_AddFolder}"
                                   FontSize="12" FontWeight="Medium" Foreground="#14181D"/>
                    </StackPanel>
                </Button>

                <!-- Preset toggle -->
                <Button Grid.Column="4"
                        Command="{Binding TogglePresetPanelCommand}"
                        Background="#E6F3F6" Tag="7"
                        Padding="10,6" Cursor="Hand"
                        ToolTip="{DynamicResource UPL_003}"
                        Template="{StaticResource FlatBtn}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📋" FontSize="12" Margin="0,0,4,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource UPL_004}" FontSize="12" FontWeight="Medium"
                                   Foreground="#0E7490" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Refresh / Clear -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding RefreshCommand}"
                            Background="#DDD9D3" Tag="6"
                            Width="30" Height="30" Cursor="Hand"
                            ToolTip="{DynamicResource CC_002}" Margin="0,0,6,0"
                            Template="{StaticResource FlatBtn}">
                        <TextBlock Text="🔄" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Command="{Binding ClearListCommand}"
                            Background="#DDD9D3" Tag="6"
                            Width="30" Height="30" Cursor="Hand"
                            ToolTip="{DynamicResource UPL_005}"
                            Template="{StaticResource FlatBtn}">
                        <TextBlock Text="🗑️" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════
             ③  PRESETS BAR (collapsed by default)
             ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Grid.Column="0"
                Background="#FAF9F7"
                BorderBrush="#E6F3F6" BorderThickness="0,0,0,1"
                Padding="20,10"
                Visibility="{Binding IsPresetPanelOpen,
                             Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{DynamicResource UPL_006}"
                           FontSize="12" Foreground="#6B6864"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>

                <!-- Preset name input -->
                <Border Grid.Column="1"
                        Background="#FAF9F7" BorderBrush="#DDD9D3"
                        BorderThickness="1" CornerRadius="6" Height="30">
                    <TextBox Background="Transparent"
                             Foreground="#14181D" BorderThickness="0"
                             FontSize="12" Padding="8,0"
                             VerticalContentAlignment="Center"
                             Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}"/>
                </Border>

                <Button Grid.Column="3"
                        Command="{Binding SavePresetCommand}"
                        Background="#0E7490" Tag="6"
                        Padding="12,5" Cursor="Hand" Height="30"
                        Template="{StaticResource FlatBtn}">
                    <TextBlock Text="{DynamicResource UPL_007}" FontSize="12" FontWeight="SemiBold"
                               Foreground="White"/>
                </Button>

                <!-- Separator -->
                <Border Grid.Column="4" Width="1" Background="#E6F3F6" Margin="0,3"/>

                <!-- Saved presets list -->
                <ItemsControl Grid.Column="5"
                              ItemsSource="{Binding SavedPresets}"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PrintPreset}">
                            <Border Background="#FFFFFF" CornerRadius="5"
                                    Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding DataContext.ApplyPresetCommand,
                                                     RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" Tag="5"
                                            Padding="10,5" Cursor="Hand" Height="28"
                                            Template="{StaticResource FlatBtn}">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12" Foreground="#0E7490"/>
                                    </Button>
                                    <Button Command="{Binding DataContext.DeletePresetCommand,
                                                     RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" Tag="5"
                                            Width="22" Height="28" Cursor="Hand"
                                            Template="{StaticResource FlatBtn}">
                                        <TextBlock Text="✕" FontSize="10" Foreground="#6B6864"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Column="6"
                           Text="{DynamicResource UPL_008}"
                           FontSize="11" Foreground="#6B6864"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SavedPresets.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════
             ④  PRINTER ALERT — a station is waiting for somebody

             A banner, not a dialog: with eight or nine printers the faults arrive
             together, and stacked modal windows would bury the screen and teach the
             operator to dismiss them unread. Amber, because the run has not failed —
             it is paused until a tray is filled or a cover closed.
             ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Grid.Column="0"
                Background="#FDF1DC"
                BorderBrush="#E08A00" BorderThickness="0,0,0,2"
                Padding="20,10"
                Visibility="{Binding HasAlert, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="⚠" FontSize="18"
                           Foreground="#E08A00" VerticalAlignment="Center"
                           Margin="0,0,12,0"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource PM_HeldBannerTitle}"
                               FontSize="11" FontWeight="Bold" Foreground="#E08A00"/>
                    <TextBlock Text="{Binding AlertMessage, Mode=OneWay}"
                               FontSize="12" Foreground="#8A5A00"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{DynamicResource PM_HeldPurge}"
                            Command="{Binding PurgeHeldPrintersCommand}"
                            Padding="12,5" FontSize="11" Margin="0,0,6,0"
                            Background="#FBE3E1" Foreground="#8A2018"
                            BorderBrush="#B42318" BorderThickness="1"/>
                    <Button Content="{DynamicResource PM_HeldSkip}"
                            Command="{Binding AbandonHeldPrintersCommand}"
                            Padding="12,5" FontSize="11"
                            Background="#FDF1DC" Foreground="#8A5A00"
                            BorderBrush="#E08A00" BorderThickness="1"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════
             ⑤  PROGRESS BAR (visible when printing)
             ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="4" Grid.Column="0"
                Background="#FAF9F7"
                BorderBrush="#E6F3F6" BorderThickness="0,0,0,1"
                Padding="20,8"
                Visibility="{Binding IsPrinting,
                             Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <!-- File name -->
                    <TextBlock Margin="0,0,0,4" FontSize="11">
                        <Run Text="🖨️ " Foreground="#0891B2"/>
                        <Run Text="{Binding CurrentPrintingFile, Mode=OneWay}"
                             Foreground="#14181D"/>
                    </TextBlock>

                    <!-- Progress track -->
                    <ProgressBar Height="6"
                                 Value="{Binding ProgressValue, Mode=OneWay}"
                                 Minimum="0" Maximum="100"
                                 Background="#FFFFFF"
                                 Foreground="#0891B2"
                                 BorderThickness="0"/>
                </StackPanel>

                <!-- Percent -->
                <TextBlock Grid.Column="1"
                           Margin="16,0,12,0" FontSize="13" FontWeight="Bold"
                           Foreground="#0891B2" VerticalAlignment="Center">
                    <Run Text="{Binding ProgressValue, Mode=OneWay}"/>
                    <Run Text="%"/>
                </TextBlock>

                <!-- Status -->
                <TextBlock Grid.Column="2"
                           Text="{Binding StatusMessage, Mode=OneWay}"
                           FontSize="11" Foreground="#6B6864"
                           VerticalAlignment="Center" MaxWidth="200"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════
             ⑥  FILE LIST  — full height
             ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="5" Grid.Column="0" Background="#FAF9F7"
                AllowDrop="True" Drop="Border_Drop">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Status bar -->
                <Border Grid.Row="0" Background="#FFFFFF" Padding="16,6">
                    <Grid>
                        <TextBlock VerticalAlignment="Center" FontSize="11">
                            <Run Text="{DynamicResource Upload_ListOfDocuments}"
                                 Foreground="#6B6864"/>
                            <Run Text=" · " Foreground="#6B6864"/>
                            <Run Text="{Binding IngestedFiles.Count, Mode=OneWay}"
                                 Foreground="#0891B2" FontWeight="Bold"/>
                            <Run Text="{DynamicResource UPL_002}" Foreground="#6B6864"/>
                        </TextBlock>
                        <TextBlock HorizontalAlignment="Right"
                                   FontSize="11" Foreground="#6B6864"
                                   VerticalAlignment="Center"
                                   Text="{Binding StatusMessage}"/>
                    </Grid>
                </Border>

                <!-- DataGrid -->
                <DataGrid Grid.Row="1"
                          x:Name="FilesGrid"
                          ItemsSource="{Binding IngestedFiles}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          BorderThickness="0"
                          Background="#FAF9F7"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          RowHeight="40"
                          AlternatingRowBackground="#F4F2EF"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          SelectionMode="Extended"
                          MouseDoubleClick="DataGrid_MouseDoubleClick">

                    <DataGrid.Columns>

                        <!-- # -->
                        <DataGridTextColumn Header="#" Binding="{Binding Index}"
                                            Width="42" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground"        Value="#DDD9D3"/>
                                    <Setter Property="Margin"            Value="10,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- File Name -->
                        <!-- Headers go through HeaderTemplate, not Header={DynamicResource}:
                             a DataGridColumn is not in the visual tree, so a DynamicResource
                             set directly on Header resolves once at load and stays in the
                             startup language. The TextBlock below lives inside the column
                             header control, so it re-resolves when the language changes. -->
                        <DataGridTextColumn Binding="{Binding OriginalName}"
                                            Width="*" IsReadOnly="True">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{DynamicResource UPL_009}"/>
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground"        Value="#14181D"/>
                                    <Setter Property="FontWeight"        Value="Medium"/>
                                    <Setter Property="Margin"            Value="10,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextTrimming"      Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Target printer — where this file will actually come out.
                             Colour is stable per printer so the routing reads at a
                             glance instead of being discovered at the device. -->
                        <DataGridTemplateColumn Width="120" IsReadOnly="True">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{DynamicResource PM_ColPrinter}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="7,2" Margin="6,0"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Background="#FFFFFF"
                                            BorderBrush="{Binding TargetPrinterColor}"
                                            BorderThickness="0,0,3,0"
                                            Visibility="{Binding HasTargetPrinter,
                                                         Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding TargetPrinter}"
                                                   Foreground="{Binding TargetPrinterColor}"
                                                   FontSize="11" FontWeight="Medium"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Type -->
                        <DataGridTextColumn Binding="{Binding FileType}"
                                            Width="54" IsReadOnly="True">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{DynamicResource UPL_010}"/>
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground"        Value="#6B6864"/>
                                    <Setter Property="FontSize"          Value="11"/>
                                    <Setter Property="Margin"            Value="6,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Size -->
                        <DataGridTextColumn Binding="{Binding SizeDisplay}"
                                            Width="68" IsReadOnly="True">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{DynamicResource UPL_011}"/>
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground"        Value="#6B6864"/>
                                    <Setter Property="Margin"            Value="6,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Copies (editable per-file) -->
                        <DataGridTextColumn Binding="{Binding Copies, UpdateSourceTrigger=LostFocus}"
                                            Width="52" IsReadOnly="False">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{DynamicResource UPL_012}"/>
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground"          Value="#0891B2"/>
                                    <Setter Property="FontWeight"          Value="Bold"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment"   Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox" BasedOn="{StaticResource CellEditBox}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>

                        <!-- Page Range (editable per-file) -->
                        <DataGridTextColumn Binding="{Binding PageRange, UpdateSourceTrigger=LostFocus}"
                                            Width="80" IsReadOnly="False">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{DynamicResource UPL_013}"/>
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground"          Value="#6B6864"/>
                                    <Setter Property="FontSize"            Value="11"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment"   Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox" BasedOn="{StaticResource CellEditBox}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>

                        <!-- Actions: ↑ ↓ 👁 ✕ -->
                        <DataGridTemplateColumn Header="" Width="120" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:IngestedFileItem}">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">

                                        <!-- Move Up -->
                                        <Button Command="{Binding DataContext.MoveUpCommand,
                                                         RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" Tag="4"
                                                Width="26" Height="26" Cursor="Hand"
                                                ToolTip="{DynamicResource UPL_014}" Margin="0,0,2,0"
                                                Template="{StaticResource FlatBtn}">
                                            <TextBlock Text="↑" FontSize="13" Foreground="#6B6864"/>
                                        </Button>

                                        <!-- Move Down -->
                                        <Button Command="{Binding DataContext.MoveDownCommand,
                                                         RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" Tag="4"
                                                Width="26" Height="26" Cursor="Hand"
                                                ToolTip="{DynamicResource UPL_015}" Margin="0,0,2,0"
                                                Template="{StaticResource FlatBtn}">
                                            <TextBlock Text="↓" FontSize="13" Foreground="#6B6864"/>
                                        </Button>

                                        <!-- Preview -->
                                        <Button Command="{Binding DataContext.PreviewFileCommand,
                                                         RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" Tag="4"
                                                Width="26" Height="26" Cursor="Hand"
                                                ToolTip="{DynamicResource UPL_016}" Margin="0,0,2,0"
                                                Template="{StaticResource FlatBtn}">
                                            <TextBlock Text="👁" FontSize="12"/>
                                        </Button>

                                        <!-- Remove -->
                                        <Button Command="{Binding DataContext.RemoveItemCommand,
                                                         RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" Tag="4"
                                                Width="26" Height="26" Cursor="Hand"
                                                ToolTip="{DynamicResource UPL_017}"
                                                Template="{StaticResource FlatBtn}">
                                            <TextBlock Text="✕" FontSize="11" Foreground="#B42318"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                    <!-- Right-click context menu -->
                    <DataGrid.ContextMenu>
                        <ContextMenu Background="#FFFFFF" BorderBrush="#DDD9D3">
                            <MenuItem Header="{DynamicResource UPL_018}"
                                      Command="{Binding PreviewFileCommand}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      Foreground="#14181D" Background="Transparent"/>
                            <Separator Background="#DDD9D3"/>
                            <MenuItem Header="{DynamicResource UPL_019}"
                                      Command="{Binding MoveUpCommand}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      Foreground="#14181D" Background="Transparent"/>
                            <MenuItem Header="{DynamicResource UPL_020}"
                                      Command="{Binding MoveDownCommand}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      Foreground="#14181D" Background="Transparent"/>
                            <Separator Background="#DDD9D3"/>
                            <MenuItem Header="{DynamicResource UPL_021}"
                                      Command="{Binding RemoveItemCommand}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      Foreground="#B42318" Background="Transparent"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>

                <!-- DROP ZONE (shown when list is empty) -->
                <Border Grid.Row="1"
                        Visibility="{Binding IngestedFiles.Count, Mode=OneWay,
                                     Converter={StaticResource InverseCountToVisibilityConverter}}"
                        Cursor="Hand">
                    <Border.InputBindings>
                        <MouseBinding Gesture="LeftClick"
                                      Command="{Binding BrowseFilesCommand}"/>
                    </Border.InputBindings>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Background="#FFFFFF" CornerRadius="36"
                                Width="72" Height="72"
                                HorizontalAlignment="Center" Margin="0,0,0,20">
                            <TextBlock Text="📂" FontSize="32"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{DynamicResource Upload_DropFiles}"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="#0891B2" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Upload_AddFromMenu}"
                                   FontSize="13" Foreground="#6B6864"
                                   HorizontalAlignment="Center" Margin="0,6,0,20"/>
                        <Border Background="#FFFFFF" CornerRadius="16"
                                Padding="16,5" HorizontalAlignment="Center">
                            <TextBlock Text="PDF · DOCX · XLSX · Images"
                                       FontSize="11" Foreground="#6B6864"/>
                        </Border>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════
             ⑥  SETTINGS RAIL — how the job prints, always in view
             ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Grid.RowSpan="5" Grid.Column="1"
                Width="230"
                Background="#FFFFFF"
                BorderBrush="#FFFFFF" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,14,16,20">

                    <TextBlock Text="{DynamicResource PM_PrintSettings}"
                               FontSize="12" FontWeight="Bold" Foreground="#6B6864"
                               Margin="0,0,0,14"/>

                    <!-- Copies -->
                    <TextBlock Text="{DynamicResource PM_LblCopies}" Style="{StaticResource RailLabel}"/>
                    <Border Background="#FAF9F7" CornerRadius="7" Height="32">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="34"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding DecreaseCopiesCommand}"
                                    Background="Transparent" Tag="7" Cursor="Hand"
                                    Foreground="#6B6864" FontSize="16" FontWeight="Bold"
                                    Content="−" Template="{StaticResource FlatBtn}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DefaultCopies}"
                                       FontSize="13" FontWeight="Bold" Foreground="#14181D"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Command="{Binding IncreaseCopiesCommand}"
                                    Background="Transparent" Tag="7" Cursor="Hand"
                                    Foreground="#0891B2" FontSize="16" FontWeight="Bold"
                                    Content="+" Template="{StaticResource FlatBtn}"/>
                        </Grid>
                    </Border>
                    <!-- The queue can override this per row, so say so rather than
                         letting the two numbers look like a contradiction. -->
                    <TextBlock Text="{DynamicResource PM_CopiesHint}"
                               FontSize="9" Foreground="#6B6864"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>

                    <!-- Orientation. SelectedValuePath keeps the invariant value in the
                         ViewModel while the list shows the translated label. -->
                    <TextBlock Text="{DynamicResource PM_LblOrientation}" Style="{StaticResource RailLabel}"/>
                    <ComboBox ItemsSource="{Binding Orientations}"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding Orientation}"
                              Height="32" FontSize="12">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Paper size -->
                    <TextBlock Text="{DynamicResource PM_LblPaperSize}" Style="{StaticResource RailLabel}"/>
                    <ComboBox ItemsSource="{Binding PaperSizes}"
                              SelectedItem="{Binding PaperSize}"
                              Height="32" FontSize="12"/>

                    <!-- Quality -->
                    <TextBlock Text="{DynamicResource PM_LblQuality}" Style="{StaticResource RailLabel}"/>
                    <ComboBox ItemsSource="{Binding PrintQualities}"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding PrintQuality}"
                              Height="32" FontSize="12">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Border Height="1" Background="#FFFFFF" Margin="0,18,0,14"/>

                    <!-- Colour -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <CheckBox IsChecked="{Binding IsColorEnabled}"
                                  VerticalAlignment="Center" Margin="0,0,8,0">
                            <CheckBox.LayoutTransform>
                                <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                            </CheckBox.LayoutTransform>
                        </CheckBox>
                        <TextBlock Text="{DynamicResource Upload_ColorPrinting}"
                                   FontSize="12" Foreground="#14181D"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Duplex -->
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding IsDuplexEnabled}"
                                  VerticalAlignment="Center" Margin="0,0,8,0">
                            <CheckBox.LayoutTransform>
                                <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                            </CheckBox.LayoutTransform>
                        </CheckBox>
                        <TextBlock Text="{DynamicResource Upload_Duplex}"
                                   FontSize="12" Foreground="#14181D"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
