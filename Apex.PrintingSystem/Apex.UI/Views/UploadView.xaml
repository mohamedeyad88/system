<UserControl x:Class="Apex.UI.Views.UploadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:viewmodels="clr-namespace:Apex.UI.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="{DynamicResource Brush.Background}">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border.Light}" BorderThickness="0,0,1,0">
            <StackPanel>
                
                <!-- Action Buttons Row -->
                <Grid Margin="15,15,15,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Add Files Button -->
                    <Button Grid.Column="0" Height="70" Margin="0,0,5,0" Cursor="Hand"
                            Command="{Binding BrowseFilesCommand}" ToolTip="Add Files">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="8">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#3B82F6" Offset="0"/>
                                            <GradientStop Color="#2563EB" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="📄" FontSize="24" HorizontalAlignment="Center" Foreground="White"/>
                                        <TextBlock Text="➕ Files" FontSize="11" HorizontalAlignment="Center" Foreground="White" Margin="0,4,0,0" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#2563EB" Offset="0"/>
                                                    <GradientStop Color="#3B82F6" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <!-- Add Folder Button -->
                    <Button Grid.Column="1" Height="70" Margin="5,0,0,0" Cursor="Hand"
                            Command="{Binding BrowseFolderCommand}" ToolTip="Add Folder">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="8">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#A65A3F" Offset="0"/>
                                            <GradientStop Color="#C47256" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="📁" FontSize="24" HorizontalAlignment="Center" Foreground="White"/>
                                        <TextBlock Text="📂 Folder" FontSize="11" HorizontalAlignment="Center" Foreground="White" Margin="0,4,0,0" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#C47256" Offset="0"/>
                                                    <GradientStop Color="#A65A3F" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
                
                <!-- Select Printer Section -->
                <Border Margin="15,5,15,10" CornerRadius="8" Padding="12">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#3B82F6" Offset="0"/>
                            <GradientStop Color="#2563EB" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,10">
                            <Run Text="🖨️ "/><Run Text="{DynamicResource Upload_SelectPrinter}"/>
                        </TextBlock>
                        <Border Background="White" CornerRadius="6" Padding="2">
                            <ComboBox ItemsSource="{Binding AvailablePrinters}" 
                                      SelectedItem="{Binding SelectedPrinter}"
                                      Background="Transparent" Padding="8,6" FontSize="12"
                                      BorderThickness="0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Padding="2"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Border>
                        <Button Margin="0,12,0,0"
                                Command="{Binding OpenPrinterPropertiesCommand}"
                                Background="Transparent" Foreground="White" 
                                BorderThickness="1" BorderBrush="#FFFFFF50" 
                                HorizontalAlignment="Stretch" Padding="8,6"
                                Cursor="Hand" FontSize="12">
                            <TextBlock><Run Text="⚙️ "/><Run Text="{DynamicResource Upload_PrinterProperties}"/></TextBlock>
                        </Button>
                    </StackPanel>
                </Border>
                
                <!-- Quick Actions Row -->
                <Grid Margin="15,5,15,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Settings Button -->
                    <Button Grid.Column="0" Height="60" Margin="0,0,5,0" Cursor="Hand"
                            Command="{Binding OpenSettingsCommand}" ToolTip="Print Settings">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="#F5F5F5" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="⚙️" FontSize="24" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Settings" FontSize="10" Foreground="#666" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#EAEAEA"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <!-- Print Button -->
                    <Button Grid.Column="1" Height="60" Margin="5,0,0,0" Cursor="Hand"
                            Command="{Binding CreateJobsCommand}" ToolTip="Start Printing">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="8">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#09A603" Offset="0"/>
                                            <GradientStop Color="#0BC904" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="🖨️" FontSize="24" HorizontalAlignment="Center"/>
                                        <TextBlock Text="PRINT" FontSize="10" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#0BC904" Offset="0"/>
                                                    <GradientStop Color="#09A603" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
                
                <!-- Status Section -->
                <Border Background="White" Margin="15,5,15,10" CornerRadius="8" Padding="12" 
                        BorderBrush="#3B82F6" BorderThickness="0,0,0,3">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" FontSize="13" Foreground="#333" Margin="0,0,0,8">
                            <Run Text="📋 "/><Run Text="{DynamicResource Upload_Status}"/>
                        </TextBlock>
                        <TextBlock Text="{DynamicResource Upload_PleaseAdd}" 
                                   TextWrapping="Wrap" FontSize="12" Foreground="#666"/>
                        <Border Background="#FFF0F6" CornerRadius="4" Padding="8" Margin="0,10,0,0">
                            <TextBlock Text="{Binding StatusMessage, FallbackValue={StaticResource Upload_ListEmpty}}" 
                                       Foreground="#3B82F6" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Border>
                
            </StackPanel>
        </Border>
        
        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Header Bar -->
            <Border Grid.Row="0" Padding="15,12">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#3B82F6" Offset="0"/>
                        <GradientStop Color="#2563EB" Offset="0.5"/>
                        <GradientStop Color="#A65A3F" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📋" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Upload_ListOfDocuments}" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Toolbar Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Width="36" Height="32" Background="#FFFFFF20" Foreground="White" 
                                BorderThickness="0" ToolTip="Refresh" Command="{Binding RefreshCommand}" Margin="3,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#FFFFFF20" CornerRadius="4">
                                        <TextBlock Text="🔄" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FFFFFF40"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="36" Height="32" Background="#FFFFFF20" Foreground="White" 
                                BorderThickness="0" ToolTip="Clear All" Command="{Binding ClearListCommand}" Margin="3,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#FFFFFF20" CornerRadius="4">
                                        <TextBlock Text="✖️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FFFFFF40"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="36" Height="32" Background="#FFFFFF20" Foreground="White" 
                                BorderThickness="0" ToolTip="Copy to Clipboard" Margin="3,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#FFFFFF20" CornerRadius="4">
                                        <TextBlock Text="📋" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FFFFFF40"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="36" Height="32" Background="#09A603" Foreground="White" 
                                BorderThickness="0" ToolTip="Print All" Command="{Binding CreateJobsCommand}" Margin="3,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#09A603" CornerRadius="4">
                                        <TextBlock Text="🖨️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#0BC904"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Document List Area -->
            <Border Grid.Row="1" Background="White" AllowDrop="True" Drop="Border_Drop" Margin="0">
                <Grid>
                    <!-- DataGrid -->
                    <DataGrid ItemsSource="{Binding IngestedFiles}" AutoGenerateColumns="False" 
                              CanUserAddRows="False" BorderThickness="0" Background="White"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              RowHeight="40" ColumnHeaderHeight="36"
                              AlternatingRowBackground="#FAFAFA">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8F8F8"/>
                                <Setter Property="Foreground" Value="#333"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="BorderBrush" Value="#F0F0F0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#FFF0F6"/>
                                        <Setter Property="BorderBrush" Value="#3B82F6"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFF5F9"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="45"/>
                            <DataGridCheckBoxColumn Header="✓" Width="35"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding OriginalName}" Width="*"/>
                            <DataGridTextColumn Header="Date Modified" Binding="{Binding ModifiedDate, StringFormat='yyyy-MM-dd'}" Width="110"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding FileType}" Width="70"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="80"/>
                            <DataGridTextColumn Header="Folder Path" Binding="{Binding FolderPath}" Width="150"/>
                            <DataGridTextColumn Header="Copies" Binding="{Binding Copies}" Width="60"/>
                            <DataGridTextColumn Header="Pages" Binding="{Binding PageRange}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    
                    <!-- Drop Zone Placeholder (when empty) -->
                    <Border Visibility="{Binding IngestedFiles.Count, Converter={StaticResource InverseCountToVisibilityConverter}}"
                            Margin="60" BorderThickness="3" CornerRadius="16"
                            Background="#FFFBFD">
                        <Border.BorderBrush>
                            <DrawingBrush Viewport="0,0,12,12" ViewportUnits="Absolute" TileMode="Tile">
                                <DrawingBrush.Drawing>
                                    <GeometryDrawing>
                                        <GeometryDrawing.Pen>
                                            <Pen Brush="#3B82F6" Thickness="2" DashStyle="{x:Static DashStyles.Dash}"/>
                                        </GeometryDrawing.Pen>
                                        <GeometryDrawing.Geometry>
                                            <RectangleGeometry Rect="0,0,12,12"/>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Border.BorderBrush>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="📁" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                            <TextBlock Text="{DynamicResource Upload_DropFiles}" FontSize="20" Foreground="#3B82F6" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Upload_AddFromMenu}" FontSize="14" Foreground="#999" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        
        <!-- Settings Popup Overlay -->
        <Border Grid.ColumnSpan="2" Background="#80000000" 
                Visibility="{Binding IsSettingsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="White" CornerRadius="12" Width="400" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="5" Opacity="0.3" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Header -->
                    <Border Background="#3B82F6" CornerRadius="12,12,0,0" Padding="20,15">
                        <Grid>
                            <TextBlock Text="{DynamicResource Upload_PrintSettings}" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                            <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" Foreground="White"
                                    BorderThickness="0" FontSize="16" Cursor="Hand" Command="{Binding CloseSettingsCommand}"/>
                        </Grid>
                    </Border>
                    
                    <!-- Settings Content -->
                    <Border Padding="20">
                    <StackPanel>
                        <!-- Copies -->
                        <TextBlock Text="{DynamicResource Upload_DefaultCopies}" Foreground="#333" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider Value="{Binding DefaultCopies}" Minimum="1" Maximum="100" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding DefaultCopies}" FontWeight="Bold" Foreground="#3B82F6" 
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                        
                        <!-- Orientation -->
                        <TextBlock Text="{DynamicResource Upload_Orientation}" Foreground="#333" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding Orientations}" SelectedItem="{Binding Orientation}" 
                                  Background="White" Foreground="#333" Padding="10" Margin="0,0,0,15"/>
                        
                        <!-- Quality -->
                        <TextBlock Text="{DynamicResource Upload_PrintQuality}" Foreground="#333" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding PrintQualities}" SelectedItem="{Binding PrintQuality}" 
                                  Background="White" Foreground="#333" Padding="10" Margin="0,0,0,15"/>
                        
                        <!-- Checkboxes -->
                        <CheckBox Content="{DynamicResource Upload_ColorPrinting}" IsChecked="{Binding IsColorEnabled}" 
                                  Foreground="#333" Margin="0,0,0,10"/>
                        <CheckBox Content="{DynamicResource Upload_Duplex}" IsChecked="{Binding IsDuplexEnabled}" 
                                  Foreground="#333" Margin="0,0,0,20"/>
                        
                        <!-- Actions -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="Cancel" Grid.Column="0" Margin="0,0,5,0" Padding="15,12"
                                    Background="#F5F5F5" Foreground="#666" BorderThickness="1" BorderBrush="#E0E0E0"
                                    Command="{Binding CloseSettingsCommand}" Cursor="Hand"/>
                            <Button Grid.Column="1" Margin="5,0,0,0" Padding="15,12"
                                    Background="#3B82F6" Foreground="White" BorderThickness="0"
                                    Command="{Binding ApplySettingsCommand}" Cursor="Hand">
                                <TextBlock Text="{DynamicResource Upload_Apply}"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
