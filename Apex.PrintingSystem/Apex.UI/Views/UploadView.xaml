<UserControl x:Class="Apex.UI.Views.UploadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Apex.UI.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200"
             Background="Transparent">

    <UserControl.Resources>

        <!-- ── Shared flat button template ──────────────────────────── -->
        <ControlTemplate x:Key="FlatBtn" TargetType="Button">
            <Border x:Name="bg"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding Tag}"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bg" Property="Opacity" Value="0.82"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="bg" Property="Opacity" Value="0.65"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="bg" Property="Opacity" Value="0.35"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ── ComboBox toggle button ────────────────────────────────── -->
        <ControlTemplate x:Key="DarkComboToggle" TargetType="ToggleButton">
            <Border x:Name="bg"
                    Background="{TemplateBinding Background}"
                    BorderBrush="#334155" BorderThickness="1"
                    CornerRadius="7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Grid.Column="0" Margin="10,0,0,0"
                                      VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <Path Grid.Column="1" x:Name="arrow"
                          Data="M 0 0 L 4 4 L 8 0"
                          Stroke="#64748B" StrokeThickness="1.5"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bg" Property="BorderBrush" Value="#475569"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="bg" Property="BorderBrush" Value="#3B82F6"/>
                    <Setter TargetName="arrow" Property="Stroke"   Value="#3B82F6"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ── ComboBox dark style ───────────────────────────────────── -->
        <Style TargetType="ComboBox">
            <Setter Property="Background"              Value="#0F172A"/>
            <Setter Property="Foreground"              Value="#E2E8F0"/>
            <Setter Property="BorderBrush"             Value="#334155"/>
            <Setter Property="BorderThickness"         Value="1"/>
            <Setter Property="FontSize"                Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource DarkComboToggle}"
                                          Background="{TemplateBinding Background}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"/>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="12,0,28,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <Popup x:Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDown"
                                        Background="#1E293B"
                                        BorderBrush="#334155" BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="220" SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000" Opacity="0.4"
                                                          BlurRadius="16" ShadowDepth="4"/>
                                    </Border.Effect>
                                    <ScrollViewer Margin="0,4" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="Foreground"                 Value="#CBD5E1"/>
            <Setter Property="FontSize"                   Value="12"/>
            <Setter Property="Padding"                    Value="12,7"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="5" Margin="4,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#2D3F55"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1E3A5F"/>
                                <Setter Property="Foreground" Value="#60A5FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── TextBox dark style (editable DataGrid cells) ─────────── -->
        <Style x:Key="CellEditBox" TargetType="TextBox">
            <Setter Property="Background"   Value="#0F172A"/>
            <Setter Property="Foreground"   Value="#E2E8F0"/>
            <Setter Property="BorderBrush"  Value="#3B82F6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"      Value="4,2"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ── DataGrid column header ────────────────────────────────── -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="#161F2E"/>
            <Setter Property="Foreground"      Value="#475569"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="10,10"/>
            <Setter Property="BorderBrush"     Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsSelected"  Value="True">
                    <Setter Property="Background" Value="#1E3A5F"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A2640"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#F1F5F9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <!-- ═══════════════════ ROOT GRID ══════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- ① Printer bar      -->
            <RowDefinition Height="Auto"/>   <!-- ② Settings bar     -->
            <RowDefinition Height="Auto"/>   <!-- ③ Presets bar      -->
            <RowDefinition Height="Auto"/>   <!-- ④ Progress bar     -->
            <RowDefinition Height="*"/>      <!-- ⑤ File list        -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════════
             ①  TOP: Printer selector + Start Printing
             ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="#1E293B"
                BorderBrush="#334155" BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,24,0">
                    <Border Background="#2563EB" CornerRadius="9"
                            Width="36" Height="36" Margin="0,0,10,0">
                        <TextBlock Text="⚡" FontSize="17"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Upload_Title}"
                                   FontSize="15" FontWeight="Bold" Foreground="#F1F5F9"/>
                        <TextBlock Text="{DynamicResource Upload_Description}"
                                   FontSize="10" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>

                <!-- Printer selector -->
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#0F172A"
                            CornerRadius="9" Width="36" Height="36" Margin="0,0,10,0">
                        <TextBlock Text="🖨️" FontSize="17"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailablePrinters}"
                              SelectedItem="{Binding SelectedPrinter}"
                              Height="36" FontSize="13"/>

                    <Button Grid.Column="2"
                            Command="{Binding OpenPrinterPropertiesCommand}"
                            Background="#334155" Width="36" Height="36"
                            Margin="8,0,0,0" Cursor="Hand" Tag="9"
                            ToolTip="{DynamicResource Upload_PrinterProperties}"
                            Template="{StaticResource FlatBtn}">
                        <TextBlock Text="⚙️" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <!-- Start / Stop -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            Margin="20,0,0,0">
                    <!-- Stop (visible only when printing) -->
                    <Button Command="{Binding StopPrintingCommand}"
                            Visibility="{Binding IsPrinting,
                                         Converter={StaticResource BoolToVisibility}}"
                            Background="#7F1D1D" Tag="10"
                            Padding="14,0" Height="36" Margin="0,0,8,0"
                            Cursor="Hand" Template="{StaticResource FlatBtn}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="■" FontSize="12" Foreground="#FCA5A5"
                                       Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="إيقاف" FontSize="13" FontWeight="Bold"
                                       Foreground="#FCA5A5"/>
                        </StackPanel>
                    </Button>

                    <!-- Start -->
                    <Button Command="{Binding CreateJobsCommand}"
                            IsEnabled="{Binding IsPrinting,
                                        Converter={StaticResource InverseBoolConverter}}"
                            Background="#2563EB" Tag="10"
                            Padding="20,0" Height="36" Cursor="Hand"
                            Template="{StaticResource FlatBtn}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🖨️" FontSize="14" Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Distribution_StartPrinting}"
                                           FontSize="13" FontWeight="Bold" Foreground="White"/>
                                <TextBlock FontSize="9" Foreground="#93C5FD">
                                    <Run Text="{Binding IngestedFiles.Count, Mode=OneWay}"/>
                                    <Run Text=" ملف"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════
             ②  SETTINGS BAR
             ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="#161F2E"
                BorderBrush="#1E293B" BorderThickness="0,0,0,1"
                Padding="20,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>   <!-- + Files      -->
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>   <!-- Folder       -->
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>   <!-- Copies       -->
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="120"/>    <!-- Orientation  -->
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="100"/>    <!-- Paper size   -->
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="110"/>    <!-- Quality      -->
                    <ColumnDefinition Width="*"/>      <!-- Spacer       -->
                    <ColumnDefinition Width="Auto"/>   <!-- Color        -->
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>   <!-- Duplex       -->
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>   <!-- Preset btn   -->
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>   <!-- Refresh/Del  -->
                </Grid.ColumnDefinitions>

                <!-- Add Files -->
                <Button Grid.Column="0"
                        Command="{Binding BrowseFilesCommand}"
                        Background="#2563EB" Tag="7"
                        Padding="12,6" Cursor="Hand"
                        Template="{StaticResource FlatBtn}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="＋" FontSize="13" Foreground="White"
                                   Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Upload_AddFiles}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                    </StackPanel>
                </Button>

                <!-- Add Folder -->
                <Button Grid.Column="2"
                        Command="{Binding BrowseFolderCommand}"
                        Background="#334155" Tag="7"
                        Padding="10,6" Cursor="Hand"
                        Template="{StaticResource FlatBtn}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📁" FontSize="12" Margin="0,0,4,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Upload_AddFolder}"
                                   FontSize="12" FontWeight="Medium" Foreground="#CBD5E1"/>
                    </StackPanel>
                </Button>

                <!-- Copies: − value + -->
                <Border Grid.Column="4" Background="#0F172A" CornerRadius="7" Height="30">
                    <Grid Width="90">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding DecreaseCopiesCommand}"
                                Background="Transparent" Tag="7" Cursor="Hand"
                                Foreground="#94A3B8" FontSize="16" FontWeight="Bold"
                                Content="−" Template="{StaticResource FlatBtn}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding DefaultCopies}"
                                   FontSize="13" FontWeight="Bold" Foreground="#F1F5F9"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Command="{Binding IncreaseCopiesCommand}"
                                Background="Transparent" Tag="7" Cursor="Hand"
                                Foreground="#60A5FA" FontSize="16" FontWeight="Bold"
                                Content="+" Template="{StaticResource FlatBtn}"/>
                    </Grid>
                </Border>

                <!-- Orientation -->
                <ComboBox Grid.Column="6"
                          ItemsSource="{Binding Orientations}"
                          SelectedItem="{Binding Orientation}"
                          Height="30" FontSize="12"/>

                <!-- Paper Size -->
                <ComboBox Grid.Column="8"
                          ItemsSource="{Binding PaperSizes}"
                          SelectedItem="{Binding PaperSize}"
                          Height="30" FontSize="12"/>

                <!-- Quality -->
                <ComboBox Grid.Column="10"
                          ItemsSource="{Binding PrintQualities}"
                          SelectedItem="{Binding PrintQuality}"
                          Height="30" FontSize="12"/>

                <!-- Color -->
                <StackPanel Grid.Column="12" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox IsChecked="{Binding IsColorEnabled}"
                              VerticalAlignment="Center" Margin="0,0,5,0">
                        <CheckBox.LayoutTransform>
                            <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                        </CheckBox.LayoutTransform>
                    </CheckBox>
                    <TextBlock Text="{DynamicResource Upload_ColorPrinting}"
                               FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Duplex -->
                <StackPanel Grid.Column="14" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox IsChecked="{Binding IsDuplexEnabled}"
                              VerticalAlignment="Center" Margin="0,0,5,0">
                        <CheckBox.LayoutTransform>
                            <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                        </CheckBox.LayoutTransform>
                    </CheckBox>
                    <TextBlock Text="{DynamicResource Upload_Duplex}"
                               FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Preset toggle -->
                <Button Grid.Column="16"
                        Command="{Binding TogglePresetPanelCommand}"
                        Background="#1E3A5F" Tag="7"
                        Padding="10,6" Cursor="Hand"
                        ToolTip="قوالب الطباعة"
                        Template="{StaticResource FlatBtn}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📋" FontSize="12" Margin="0,0,4,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="قوالب" FontSize="12" FontWeight="Medium"
                                   Foreground="#93C5FD" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Refresh / Clear -->
                <StackPanel Grid.Column="18" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding RefreshCommand}"
                            Background="#334155" Tag="6"
                            Width="30" Height="30" Cursor="Hand"
                            ToolTip="تحديث الطابعات" Margin="0,0,6,0"
                            Template="{StaticResource FlatBtn}">
                        <TextBlock Text="🔄" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Command="{Binding ClearListCommand}"
                            Background="#334155" Tag="6"
                            Width="30" Height="30" Cursor="Hand"
                            ToolTip="مسح القائمة"
                            Template="{StaticResource FlatBtn}">
                        <TextBlock Text="🗑️" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════
             ③  PRESETS BAR (collapsed by default)
             ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="#0D1829"
                BorderBrush="#1E3A5F" BorderThickness="0,0,0,1"
                Padding="20,10"
                Visibility="{Binding IsPresetPanelOpen,
                             Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="💾 حفظ قالب:"
                           FontSize="12" Foreground="#64748B"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>

                <!-- Preset name input -->
                <Border Grid.Column="1"
                        Background="#0F172A" BorderBrush="#334155"
                        BorderThickness="1" CornerRadius="6" Height="30">
                    <TextBox Background="Transparent"
                             Foreground="#E2E8F0" BorderThickness="0"
                             FontSize="12" Padding="8,0"
                             VerticalContentAlignment="Center"
                             Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}"/>
                </Border>

                <Button Grid.Column="3"
                        Command="{Binding SavePresetCommand}"
                        Background="#1D4ED8" Tag="6"
                        Padding="12,5" Cursor="Hand" Height="30"
                        Template="{StaticResource FlatBtn}">
                    <TextBlock Text="حفظ" FontSize="12" FontWeight="SemiBold"
                               Foreground="White"/>
                </Button>

                <!-- Separator -->
                <Border Grid.Column="4" Width="1" Background="#1E3A5F" Margin="0,3"/>

                <!-- Saved presets list -->
                <ItemsControl Grid.Column="5"
                              ItemsSource="{Binding SavedPresets}"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PrintPreset}">
                            <Border Background="#1E293B" CornerRadius="5"
                                    Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding DataContext.ApplyPresetCommand,
                                                     RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" Tag="5"
                                            Padding="10,5" Cursor="Hand" Height="28"
                                            Template="{StaticResource FlatBtn}">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12" Foreground="#93C5FD"/>
                                    </Button>
                                    <Button Command="{Binding DataContext.DeletePresetCommand,
                                                     RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" Tag="5"
                                            Width="22" Height="28" Cursor="Hand"
                                            Template="{StaticResource FlatBtn}">
                                        <TextBlock Text="✕" FontSize="10" Foreground="#475569"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Column="6"
                           Text="لا توجد قوالب محفوظة"
                           FontSize="11" Foreground="#334155"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SavedPresets.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════
             ④  PROGRESS BAR (visible when printing)
             ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3"
                Background="#0A1628"
                BorderBrush="#1E3A5F" BorderThickness="0,0,0,1"
                Padding="20,8"
                Visibility="{Binding IsPrinting,
                             Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <!-- File name -->
                    <TextBlock Margin="0,0,0,4" FontSize="11">
                        <Run Text="🖨️ " Foreground="#60A5FA"/>
                        <Run Text="{Binding CurrentPrintingFile, Mode=OneWay}"
                             Foreground="#CBD5E1"/>
                    </TextBlock>

                    <!-- Progress track -->
                    <ProgressBar Height="6"
                                 Value="{Binding ProgressValue, Mode=OneWay}"
                                 Minimum="0" Maximum="100"
                                 Background="#1E293B"
                                 Foreground="#3B82F6"
                                 BorderThickness="0"/>
                </StackPanel>

                <!-- Percent -->
                <TextBlock Grid.Column="1"
                           Margin="16,0,12,0" FontSize="13" FontWeight="Bold"
                           Foreground="#60A5FA" VerticalAlignment="Center">
                    <Run Text="{Binding ProgressValue, Mode=OneWay}"/>
                    <Run Text="%"/>
                </TextBlock>

                <!-- Status -->
                <TextBlock Grid.Column="2"
                           Text="{Binding StatusMessage, Mode=OneWay}"
                           FontSize="11" Foreground="#475569"
                           VerticalAlignment="Center" MaxWidth="200"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════
             ⑤  FILE LIST  — full height
             ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="4" Background="#0F172A"
                AllowDrop="True" Drop="Border_Drop">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Status bar -->
                <Border Grid.Row="0" Background="#1A2233" Padding="16,6">
                    <Grid>
                        <TextBlock VerticalAlignment="Center" FontSize="11">
                            <Run Text="{DynamicResource Upload_ListOfDocuments}"
                                 Foreground="#64748B"/>
                            <Run Text=" · " Foreground="#334155"/>
                            <Run Text="{Binding IngestedFiles.Count, Mode=OneWay}"
                                 Foreground="#60A5FA" FontWeight="Bold"/>
                            <Run Text=" ملف" Foreground="#475569"/>
                        </TextBlock>
                        <TextBlock HorizontalAlignment="Right"
                                   FontSize="11" Foreground="#475569"
                                   VerticalAlignment="Center"
                                   Text="{Binding StatusMessage}"/>
                    </Grid>
                </Border>

                <!-- DataGrid -->
                <DataGrid Grid.Row="1"
                          x:Name="FilesGrid"
                          ItemsSource="{Binding IngestedFiles}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          BorderThickness="0"
                          Background="#0F172A"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          RowHeight="40"
                          AlternatingRowBackground="#131C2B"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          SelectionMode="Extended"
                          MouseDoubleClick="DataGrid_MouseDoubleClick">

                    <DataGrid.Columns>

                        <!-- # -->
                        <DataGridTextColumn Header="#" Binding="{Binding Index}"
                                            Width="42" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground"        Value="#334155"/>
                                    <Setter Property="Margin"            Value="10,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- File Name -->
                        <DataGridTextColumn Header="اسم الملف"
                                            Binding="{Binding OriginalName}"
                                            Width="*" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground"        Value="#E2E8F0"/>
                                    <Setter Property="FontWeight"        Value="Medium"/>
                                    <Setter Property="Margin"            Value="10,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextTrimming"      Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Type -->
                        <DataGridTextColumn Header="النوع"
                                            Binding="{Binding FileType}"
                                            Width="54" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground"        Value="#475569"/>
                                    <Setter Property="FontSize"          Value="11"/>
                                    <Setter Property="Margin"            Value="6,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Size -->
                        <DataGridTextColumn Header="الحجم"
                                            Binding="{Binding SizeDisplay}"
                                            Width="68" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground"        Value="#475569"/>
                                    <Setter Property="Margin"            Value="6,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Copies (editable per-file) -->
                        <DataGridTextColumn Header="نسخ"
                                            Binding="{Binding Copies, UpdateSourceTrigger=LostFocus}"
                                            Width="52" IsReadOnly="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground"          Value="#3B82F6"/>
                                    <Setter Property="FontWeight"          Value="Bold"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment"   Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox" BasedOn="{StaticResource CellEditBox}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>

                        <!-- Page Range (editable per-file) -->
                        <DataGridTextColumn Header="الصفحات"
                                            Binding="{Binding PageRange, UpdateSourceTrigger=LostFocus}"
                                            Width="80" IsReadOnly="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground"          Value="#64748B"/>
                                    <Setter Property="FontSize"            Value="11"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment"   Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox" BasedOn="{StaticResource CellEditBox}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>

                        <!-- Actions: ↑ ↓ 👁 ✕ -->
                        <DataGridTemplateColumn Header="" Width="120" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:IngestedFileItem}">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">

                                        <!-- Move Up -->
                                        <Button Command="{Binding DataContext.MoveUpCommand,
                                                         RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" Tag="4"
                                                Width="26" Height="26" Cursor="Hand"
                                                ToolTip="تحريك لأعلى" Margin="0,0,2,0"
                                                Template="{StaticResource FlatBtn}">
                                            <TextBlock Text="↑" FontSize="13" Foreground="#64748B"/>
                                        </Button>

                                        <!-- Move Down -->
                                        <Button Command="{Binding DataContext.MoveDownCommand,
                                                         RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" Tag="4"
                                                Width="26" Height="26" Cursor="Hand"
                                                ToolTip="تحريك لأسفل" Margin="0,0,2,0"
                                                Template="{StaticResource FlatBtn}">
                                            <TextBlock Text="↓" FontSize="13" Foreground="#64748B"/>
                                        </Button>

                                        <!-- Preview -->
                                        <Button Command="{Binding DataContext.PreviewFileCommand,
                                                         RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" Tag="4"
                                                Width="26" Height="26" Cursor="Hand"
                                                ToolTip="معاينة الملف" Margin="0,0,2,0"
                                                Template="{StaticResource FlatBtn}">
                                            <TextBlock Text="👁" FontSize="12"/>
                                        </Button>

                                        <!-- Remove -->
                                        <Button Command="{Binding DataContext.RemoveItemCommand,
                                                         RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" Tag="4"
                                                Width="26" Height="26" Cursor="Hand"
                                                ToolTip="إزالة الملف"
                                                Template="{StaticResource FlatBtn}">
                                            <TextBlock Text="✕" FontSize="11" Foreground="#EF4444"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                    <!-- Right-click context menu -->
                    <DataGrid.ContextMenu>
                        <ContextMenu Background="#1E293B" BorderBrush="#334155">
                            <MenuItem Header="👁  معاينة الملف"
                                      Command="{Binding PreviewFileCommand}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      Foreground="#E2E8F0" Background="Transparent"/>
                            <Separator Background="#334155"/>
                            <MenuItem Header="↑  تحريك لأعلى"
                                      Command="{Binding MoveUpCommand}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      Foreground="#E2E8F0" Background="Transparent"/>
                            <MenuItem Header="↓  تحريك لأسفل"
                                      Command="{Binding MoveDownCommand}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      Foreground="#E2E8F0" Background="Transparent"/>
                            <Separator Background="#334155"/>
                            <MenuItem Header="✕  إزالة الملف"
                                      Command="{Binding RemoveItemCommand}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      Foreground="#EF4444" Background="Transparent"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>

                <!-- DROP ZONE (shown when list is empty) -->
                <Border Grid.Row="1"
                        Visibility="{Binding IngestedFiles.Count, Mode=OneWay,
                                     Converter={StaticResource InverseCountToVisibilityConverter}}"
                        Cursor="Hand">
                    <Border.InputBindings>
                        <MouseBinding Gesture="LeftClick"
                                      Command="{Binding BrowseFilesCommand}"/>
                    </Border.InputBindings>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Background="#1E293B" CornerRadius="36"
                                Width="72" Height="72"
                                HorizontalAlignment="Center" Margin="0,0,0,20">
                            <TextBlock Text="📂" FontSize="32"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{DynamicResource Upload_DropFiles}"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="#3B82F6" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Upload_AddFromMenu}"
                                   FontSize="13" Foreground="#334155"
                                   HorizontalAlignment="Center" Margin="0,6,0,20"/>
                        <Border Background="#1E293B" CornerRadius="16"
                                Padding="16,5" HorizontalAlignment="Center">
                            <TextBlock Text="PDF · DOCX · XLSX · Images"
                                       FontSize="11" Foreground="#475569"/>
                        </Border>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>
    </Grid>
</UserControl>
