<Window x:Class="Apex.UI.Views.Dialogs.EulaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Eula_Title}"
        Width="720" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Paper}"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource Panel}" Padding="24,18">
            <TextBlock Text="{DynamicResource Eula_Title}"
                       FontSize="18" FontWeight="Bold" Foreground="{DynamicResource OnAction}"/>
        </Border>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,18">
            <TextBlock Text="{DynamicResource Eula_Body}"
                       Foreground="{DynamicResource Ink}" FontSize="13" LineHeight="21"
                       TextWrapping="Wrap"/>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource Panel}" Padding="24,14">
            <Button Content="{DynamicResource Eula_Close}"
                    Click="CloseButton_Click"
                    HorizontalAlignment="Right"
                    Padding="26,9" FontSize="14" FontWeight="SemiBold"
                    Foreground="{DynamicResource OnAction}" Background="{DynamicResource Action}" BorderThickness="0"
                    Cursor="Hand"/>
        </Border>
    </Grid>
</Window>
