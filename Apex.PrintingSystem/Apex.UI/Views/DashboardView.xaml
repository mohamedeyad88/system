<UserControl x:Class="Apex.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1200"
             Background="{DynamicResource Paper}">

    <!-- ══════════════════════════════════════════════════════════════════════════
         APEX PRINT — Dashboard, new light identity.
         Calm surfaces, ONE cyan accent, status colours reserved for real status,
         and every NUMBER set in the mono face so figures line up and read fast.
         ══════════════════════════════════════════════════════════════════════════ -->
    <UserControl.Resources>
        <!-- Light card surface: a hair of depth lifts the card off the paper so the
             screen reads layered, not flat — without adding any colour. -->
        <Style x:Key="LightCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Panel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#B7B2A8" Opacity="0.45" BlurRadius="16" ShadowDepth="3" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Section header text -->
        <Style x:Key="SectionHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <!-- A big hero number, mono. Language=en-US forces Latin digits (8, not ٨) so the
             mono face can actually render them and columns stay tabular. -->
        <Style x:Key="StatNumber" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Data}"/>
            <Setter Property="FontSize" Value="40"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Language" Value="en-US"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="40,32,40,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 0: Header -->
                <RowDefinition Height="28"/>
                <RowDefinition Height="Auto"/>  <!-- 2: Stat Cards -->
                <RowDefinition Height="28"/>
                <RowDefinition Height="Auto"/>  <!-- 4: Main Content -->
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>  <!-- 6: Health Strip -->
            </Grid.RowDefinitions>

            <!-- ═══ 0 · HEADER ═══ -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Dashboard}"
                               FontSize="28" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <!-- Live system status pill: tinted background + status dot -->
                        <Border CornerRadius="20" Padding="12,5" Margin="0,0,12,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#E7F3EC"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSystemOnline}" Value="False">
                                            <Setter Property="Background" Value="#F6E4E2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,7,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource Done}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSystemOnline}" Value="False">
                                                    <Setter Property="Fill" Value="{DynamicResource Stopped}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding SystemStatus}" FontSize="12" FontWeight="Medium"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Done}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSystemOnline}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource Stopped}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{DynamicResource Welcome}" FontSize="13"
                                   Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: clock badge + refresh -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="14,10" Margin="0,0,12,0"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🕐" FontSize="12" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding LastRefreshTime}" FontSize="12"
                                       FontFamily="{DynamicResource Font.Data}"
                                       FontWeight="Medium" Foreground="{DynamicResource Muted}"/>
                        </StackPanel>
                    </Border>
                    <Button Command="{Binding RefreshDataCommand}" Cursor="Hand"
                            Background="{DynamicResource Brand}" Foreground="White" BorderThickness="0"
                            Padding="16,10">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Refresh}" Foreground="White" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ═══ 2 · STAT CARDS — four identical calm cards, the number is the hero ═══ -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Card 1: Total Printers -->
                <Border Grid.Column="0" Style="{StaticResource LightCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" CornerRadius="13" Background="{DynamicResource BrandSoft}" Margin="0,0,16,0">
                            <TextBlock Text="🖨️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Dashboard_TotalPrinters}" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding TotalPrinters}" Style="{StaticResource StatNumber}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding BusyPrinters}" FontSize="10"
                                           FontFamily="{DynamicResource Font.Data}" Foreground="{DynamicResource Muted}"/>
                                <TextBlock Text=" " FontSize="10"/>
                                <TextBlock Text="{DynamicResource Dashboard_BusyPrinters}" FontSize="10" Foreground="{DynamicResource Muted}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card 2: Online Printers -->
                <Border Grid.Column="2" Style="{StaticResource LightCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" CornerRadius="13" Background="{DynamicResource BrandSoft}" Margin="0,0,16,0">
                            <TextBlock Text="✓" FontSize="26" FontWeight="Bold"
                                       Foreground="{DynamicResource Done}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Dashboard_Online}" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding OnlinePrinters}" Style="{StaticResource StatNumber}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding OfflinePrinters}" FontSize="10"
                                           FontFamily="{DynamicResource Font.Data}" Foreground="{DynamicResource Muted}"/>
                                <TextBlock Text=" " FontSize="10"/>
                                <TextBlock Text="{DynamicResource Dashboard_Offline}" FontSize="10" Foreground="{DynamicResource Muted}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card 3: Jobs Today -->
                <Border Grid.Column="4" Style="{StaticResource LightCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" CornerRadius="13" Background="{DynamicResource BrandSoft}" Margin="0,0,16,0">
                            <TextBlock Text="📋" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Dashboard_JobsToday}" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding TodayJobs}" Style="{StaticResource StatNumber}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding PendingJobs}" FontSize="10"
                                           FontFamily="{DynamicResource Font.Data}" Foreground="{DynamicResource Muted}"/>
                                <TextBlock Text=" " FontSize="10"/>
                                <TextBlock Text="{DynamicResource Dashboard_PendingJobs}" FontSize="10" Foreground="{DynamicResource Muted}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card 4: Success Rate -->
                <Border Grid.Column="6" Style="{StaticResource LightCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" CornerRadius="13" Background="{DynamicResource BrandSoft}" Margin="0,0,16,0">
                            <TextBlock Text="📈" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Dashboard_SuccessRate}" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding SuccessRateText}" Style="{StaticResource StatNumber}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding CompletedJobs}" FontSize="10"
                                           FontFamily="{DynamicResource Font.Data}" Foreground="{DynamicResource Muted}"/>
                                <TextBlock Text=" " FontSize="10"/>
                                <TextBlock Text="{DynamicResource Dashboard_CompletedJobs}" FontSize="10" Foreground="{DynamicResource Muted}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══ 4 · MAIN CONTENT ═══ -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- LEFT TOP: Printers Overview -->
                <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource LightCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖨️" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="{DynamicResource Dashboard_PrintersOverview}" Style="{StaticResource SectionHead}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                    Command="{Binding DataContext.NavigateToPrintManagerCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                <TextBlock Text="{DynamicResource Dashboard_ViewAll}" FontSize="12" Foreground="{DynamicResource Brand}"/>
                            </Button>
                        </Grid>

                        <ItemsControl Grid.Row="2" ItemsSource="{Binding Printers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" Rows="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,12,12" Padding="14" CornerRadius="12" Cursor="Hand"
                                            Background="{DynamicResource Paper}" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource BrandSoft}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brand}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Icon + online dot -->
                                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="🖨️" FontSize="22"/>
                                                <Ellipse Grid.Column="1" Width="10" Height="10" VerticalAlignment="Top">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource Stopped}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                    <Setter Property="Fill" Value="{DynamicResource Done}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                            </Grid>

                                            <TextBlock Grid.Row="1" Text="{Binding Name}"
                                                       FontWeight="SemiBold" FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource Ink}" ToolTip="{Binding Name}"/>

                                            <!-- Status pill: tinted background, status text -->
                                            <Border Grid.Row="2" CornerRadius="6" Padding="7,3"
                                                    HorizontalAlignment="Right" Margin="0,6,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#F6E4E2"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                <Setter Property="Background" Value="#E7F3EC"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusText}" FontSize="10"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="80">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Stopped}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Done}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <StackPanel Grid.Row="3" Orientation="Horizontal"
                                                        Margin="0,6,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding HealthScore, StringFormat='{}{0}%'}"
                                                           FontSize="10" FontWeight="Medium"
                                                           FontFamily="{DynamicResource Font.Data}"
                                                           Foreground="{Binding HealthColor}"/>
                                                <TextBlock Text=" · " FontSize="10" Foreground="{DynamicResource Border}"
                                                           Visibility="{Binding QueueLength, Converter={StaticResource GreaterThanZeroToVisibility}}"/>
                                                <TextBlock FontSize="10" Foreground="{DynamicResource Muted}"
                                                           FontFamily="{DynamicResource Font.Data}"
                                                           Visibility="{Binding QueueLength, Converter={StaticResource GreaterThanZeroToVisibility}}">
                                                    <TextBlock.Text>
                                                        <Binding Path="QueueLength" StringFormat="{}{0} ↑"/>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- LEFT BOTTOM: Quick Actions — calm tiles, single accent -->
                <Border Grid.Column="0" Grid.Row="2" Style="{StaticResource LightCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <TextBlock Text="⚡" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource Dashboard_QuickActions}" Style="{StaticResource SectionHead}"/>
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Reusable calm quick-action tile via a shared template -->
                            <Button Grid.Column="0" Cursor="Hand"
                                    Command="{Binding DataContext.NavigateToImpositionCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="card" Padding="14,20" CornerRadius="14"
                                                Background="{DynamicResource Paper}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Border Width="40" Height="40" CornerRadius="10"
                                                        Background="{DynamicResource BrandSoft}" Margin="0,0,0,10" HorizontalAlignment="Center">
                                                    <TextBlock Text="📐" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{DynamicResource Dashboard_QuickActions_Imposition_Title}"
                                                           FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Ink}"
                                                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="card" Property="Background" Value="{DynamicResource BrandSoft}"/>
                                                <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource Brand}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Grid.Column="2" Cursor="Hand"
                                    Command="{Binding DataContext.NavigateToNumberedBooksCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="card" Padding="14,20" CornerRadius="14"
                                                Background="{DynamicResource Paper}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Border Width="40" Height="40" CornerRadius="10"
                                                        Background="{DynamicResource BrandSoft}" Margin="0,0,0,10" HorizontalAlignment="Center">
                                                    <TextBlock Text="📚" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{DynamicResource Dashboard_QuickActions_NumberedBooks_Title}"
                                                           FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Ink}"
                                                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="card" Property="Background" Value="{DynamicResource BrandSoft}"/>
                                                <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource Brand}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Grid.Column="4" Cursor="Hand"
                                    Command="{Binding DataContext.NavigateToTemplateDesignerCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="card" Padding="14,20" CornerRadius="14"
                                                Background="{DynamicResource Paper}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Border Width="40" Height="40" CornerRadius="10"
                                                        Background="{DynamicResource BrandSoft}" Margin="0,0,0,10" HorizontalAlignment="Center">
                                                    <TextBlock Text="🎨" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{DynamicResource Nav_TemplateDesigner}"
                                                           FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Ink}"
                                                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="card" Property="Background" Value="{DynamicResource BrandSoft}"/>
                                                <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource Brand}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- RIGHT TOP: System Status -->
                <Border Grid.Column="2" Grid.Row="0" Style="{StaticResource LightCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <TextBlock Text="📈" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource Dashboard_SystemStatus}" Style="{StaticResource SectionHead}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <!-- Connection banner -->
                            <Border CornerRadius="12" Padding="14,11" Margin="0,0,0,14">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#E7F3EC"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSystemOnline}" Value="False">
                                                <Setter Property="Background" Value="#F6E4E2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource Done}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSystemOnline}" Value="False">
                                                        <Setter Property="Fill" Value="{DynamicResource Stopped}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding SystemStatus}" FontWeight="SemiBold"
                                               FontSize="13" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Done}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSystemOnline}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource Stopped}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- 2×3 metrics grid — mono numbers, muted labels -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Column="0" Grid.Row="0" Background="{DynamicResource Paper}"
                                        CornerRadius="10" Padding="12" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Dashboard_PendingJobs}" FontSize="10" Foreground="{DynamicResource Muted}"/>
                                        <TextBlock Text="{Binding PendingJobs}" FontSize="24" FontWeight="Bold"
                                                   FontFamily="{DynamicResource Font.Data}" Foreground="{DynamicResource Ink}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Grid.Row="0" Background="{DynamicResource Paper}"
                                        CornerRadius="10" Padding="12" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Dashboard_CompletedJobs}" FontSize="10" Foreground="{DynamicResource Muted}"/>
                                        <TextBlock Text="{Binding CompletedJobs}" FontSize="24" FontWeight="Bold"
                                                   FontFamily="{DynamicResource Font.Data}" Foreground="{DynamicResource Ink}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="0" Grid.Row="2" Background="{DynamicResource Paper}"
                                        CornerRadius="10" Padding="12" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Dashboard_FailedJobs}" FontSize="10" Foreground="{DynamicResource Muted}"/>
                                        <TextBlock Text="{Binding FailedJobs}" FontSize="24" FontWeight="Bold"
                                                   FontFamily="{DynamicResource Font.Data}" Foreground="{DynamicResource Ink}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Grid.Row="2" Background="{DynamicResource Paper}"
                                        CornerRadius="10" Padding="12" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Dashboard_SuccessRate}" FontSize="10" Foreground="{DynamicResource Muted}"/>
                                        <TextBlock Text="{Binding SuccessRateText}" FontSize="24" FontWeight="Bold"
                                                   FontFamily="{DynamicResource Font.Data}" Foreground="{DynamicResource Ink}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="0" Grid.Row="4" Background="{DynamicResource Paper}"
                                        CornerRadius="10" Padding="12" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Dashboard_BusyPrinters}" FontSize="10" Foreground="{DynamicResource Muted}"/>
                                        <TextBlock Text="{Binding BusyPrinters}" FontSize="24" FontWeight="Bold"
                                                   FontFamily="{DynamicResource Font.Data}" Foreground="{DynamicResource Ink}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Grid.Row="4" Background="{DynamicResource Paper}"
                                        CornerRadius="10" Padding="12" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Dashboard_ActiveJobs}" FontSize="10" Foreground="{DynamicResource Muted}"/>
                                        <TextBlock Text="{Binding ActiveJobs}" FontSize="24" FontWeight="Bold"
                                                   FontFamily="{DynamicResource Font.Data}" Foreground="{DynamicResource Ink}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- RIGHT BOTTOM: Recent Activity -->
                <Border Grid.Column="2" Grid.Row="2" Style="{StaticResource LightCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource Dashboard_RecentActivity}" Style="{StaticResource SectionHead}"/>
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <!-- Empty state -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RecentActivity.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="📭" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="{DynamicResource Dashboard_NoActivity}" FontSize="12"
                                           Foreground="{DynamicResource Muted}" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding RecentActivity}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Left status strip carries the colour; card stays calm -->
                                        <Border Padding="12,10" Margin="0,0,0,8" CornerRadius="10"
                                                Background="{DynamicResource Paper}" BorderThickness="1,1,1,1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource BrandSoft}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Icon badge — neutral tint, status via dot below -->
                                                <Border Width="32" Height="32" CornerRadius="8"
                                                        Margin="0,0,10,0" VerticalAlignment="Center"
                                                        Background="{DynamicResource BrandSoft}">
                                                    <TextBlock Text="{Binding Icon}" FontSize="15"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Subject}" FontSize="12"
                                                               FontWeight="Medium" Foreground="{DynamicResource Ink}"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Subject}"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="10"
                                                               Foreground="{DynamicResource Muted}" Margin="0,2,0,0"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="2" Text="{Binding Time}"
                                                           FontSize="10" Foreground="{DynamicResource Muted}"
                                                           FontFamily="{DynamicResource Font.Data}"
                                                           VerticalAlignment="Top" Margin="8,2,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══ 6 · HEALTH STRIP ═══ -->
            <Border Grid.Row="6" Style="{StaticResource LightCard}" Padding="28,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="{DynamicResource Dashboard_PrintersOverview}"
                                   FontSize="10" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock Text="{Binding OnlinePrinters}" FontSize="22" FontWeight="Bold"
                                       FontFamily="{DynamicResource Font.Data}" Foreground="{DynamicResource Done}"/>
                            <TextBlock Text=" / " FontSize="22" FontFamily="{DynamicResource Font.Data}" Foreground="{DynamicResource Border}"/>
                            <TextBlock Text="{Binding TotalPrinters}" FontSize="22" FontWeight="Bold"
                                       FontFamily="{DynamicResource Font.Data}" Foreground="{DynamicResource Ink}"/>
                        </StackPanel>
                    </StackPanel>
                    <Rectangle Grid.Column="1" Fill="{DynamicResource Border}"/>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="{DynamicResource Dashboard_AvgJobsDay}"
                                   FontSize="10" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding AverageJobsPerDay, StringFormat='{}{0:F1}'}"
                                   FontSize="22" FontWeight="Bold" FontFamily="{DynamicResource Font.Data}"
                                   Foreground="{DynamicResource Ink}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Rectangle Grid.Column="3" Fill="{DynamicResource Border}"/>

                    <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                        <TextBlock Text="{DynamicResource Dashboard_SuccessRate}"
                                   FontSize="10" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding SuccessRateText}"
                                   FontSize="22" FontWeight="Bold" FontFamily="{DynamicResource Font.Data}"
                                   Foreground="{DynamicResource Ink}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Rectangle Grid.Column="5" Fill="{DynamicResource Border}"/>

                    <StackPanel Grid.Column="6" HorizontalAlignment="Center">
                        <TextBlock Text="{DynamicResource Dashboard_TopPrinter}"
                                   FontSize="10" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TopPrinter}"
                                   FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Ink}"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   MaxWidth="160" Margin="0,5,0,0" ToolTip="{Binding TopPrinter}"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>
