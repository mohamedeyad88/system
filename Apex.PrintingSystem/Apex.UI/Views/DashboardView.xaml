<UserControl x:Class="Apex.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1200"
             Background="#0F172A">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="40,32,40,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 0: Header -->
                <RowDefinition Height="28"/>    <!-- 1: Gap -->
                <RowDefinition Height="Auto"/>  <!-- 2: Stat Cards -->
                <RowDefinition Height="28"/>    <!-- 3: Gap -->
                <RowDefinition Height="Auto"/>  <!-- 4: Main Content -->
                <RowDefinition Height="24"/>    <!-- 5: Gap -->
                <RowDefinition Height="Auto"/>  <!-- 6: Health Strip -->
            </Grid.RowDefinitions>

            <!-- ════════════════════════════════════════════════════════════════
                 0️⃣  HEADER
                 ════════════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title + system status pill -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Dashboard}"
                               FontSize="30" FontWeight="Bold" Foreground="White"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <!-- Live system status pill -->
                        <Border CornerRadius="20" Padding="12,5" Margin="0,0,12,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#14532D"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSystemOnline}" Value="False">
                                            <Setter Property="Background" Value="#7F1D1D"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,7,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#22C55E"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSystemOnline}" Value="False">
                                                    <Setter Property="Fill" Value="#EF4444"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding SystemStatus}" FontSize="12" FontWeight="Medium"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#86EFAC"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSystemOnline}" Value="False">
                                                    <Setter Property="Foreground" Value="#FCA5A5"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{DynamicResource Welcome}" FontSize="13"
                                   Foreground="#64748B" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: clock badge + refresh button -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="10" Padding="14,10" Margin="0,0,12,0"
                            BorderBrush="#334155" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🕐" FontSize="12" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding LastRefreshTime}" FontSize="12"
                                       FontWeight="Medium" Foreground="#94A3B8"/>
                        </StackPanel>
                    </Border>
                    <Button Command="{Binding RefreshDataCommand}" Style="{DynamicResource Button.Dark.Primary}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Refresh}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ════════════════════════════════════════════════════════════════
                 2️⃣  STAT CARDS — colored top-accent + dark gradient background
                 ════════════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Card 1: Total Printers — blue -->
                <Border Grid.Column="0" CornerRadius="16"
                        BorderThickness="0,3,0,0" BorderBrush="#3B82F6"
                        Background="{StaticResource Gradient.Card.Blue.Dark}" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" CornerRadius="13" Background="#1E3A5F" Margin="0,0,16,0">
                            <TextBlock Text="🖨️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Dashboard_TotalPrinters}"
                                       FontSize="11" Foreground="#64748B"/>
                            <TextBlock Text="{Binding TotalPrinters}"
                                       FontSize="34" FontWeight="Bold" Foreground="#60A5FA" LineHeight="42"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding BusyPrinters}" FontSize="10" Foreground="#475569"/>
                                <TextBlock Text=" " FontSize="10"/>
                                <TextBlock Text="{DynamicResource Dashboard_BusyPrinters}"
                                           FontSize="10" Foreground="#475569"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card 2: Online Printers — green -->
                <Border Grid.Column="2" CornerRadius="16"
                        BorderThickness="0,3,0,0" BorderBrush="#22C55E"
                        Background="{StaticResource Gradient.Card.Green.Dark}" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" CornerRadius="13" Background="#14532D" Margin="0,0,16,0">
                            <TextBlock Text="✓" FontSize="26" FontWeight="Bold"
                                       Foreground="#4ADE80" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Dashboard_Online}"
                                       FontSize="11" Foreground="#64748B"/>
                            <TextBlock Text="{Binding OnlinePrinters}"
                                       FontSize="34" FontWeight="Bold" Foreground="#4ADE80" LineHeight="42"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding OfflinePrinters}" FontSize="10" Foreground="#475569"/>
                                <TextBlock Text=" " FontSize="10"/>
                                <TextBlock Text="{DynamicResource Dashboard_Offline}"
                                           FontSize="10" Foreground="#475569"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card 3: Jobs Today — purple -->
                <Border Grid.Column="4" CornerRadius="16"
                        BorderThickness="0,3,0,0" BorderBrush="#8B5CF6"
                        Background="{StaticResource Gradient.Card.Purple.Dark}" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" CornerRadius="13" Background="#2D1B4E" Margin="0,0,16,0">
                            <TextBlock Text="📋" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Dashboard_JobsToday}"
                                       FontSize="11" Foreground="#64748B"/>
                            <TextBlock Text="{Binding TodayJobs}"
                                       FontSize="34" FontWeight="Bold" Foreground="#A78BFA" LineHeight="42"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding PendingJobs}" FontSize="10" Foreground="#475569"/>
                                <TextBlock Text=" " FontSize="10"/>
                                <TextBlock Text="{DynamicResource Dashboard_PendingJobs}"
                                           FontSize="10" Foreground="#475569"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card 4: Success Rate — cyan -->
                <Border Grid.Column="6" CornerRadius="16"
                        BorderThickness="0,3,0,0" BorderBrush="#06B6D4"
                        Background="{StaticResource Gradient.Card.Cyan.Dark}" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" CornerRadius="13" Background="#0F2E35" Margin="0,0,16,0">
                            <TextBlock Text="📈" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Dashboard_SuccessRate}"
                                       FontSize="11" Foreground="#64748B"/>
                            <TextBlock Text="{Binding SuccessRateText}"
                                       FontSize="34" FontWeight="Bold" Foreground="#22D3EE" LineHeight="42"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding CompletedJobs}" FontSize="10" Foreground="#475569"/>
                                <TextBlock Text=" " FontSize="10"/>
                                <TextBlock Text="{DynamicResource Dashboard_CompletedJobs}"
                                           FontSize="10" Foreground="#475569"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ════════════════════════════════════════════════════════════════
                 4️⃣  MAIN CONTENT (Left: overview + actions  |  Right: status + activity)
                 ════════════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ── LEFT TOP: Printers Overview ─────────────────────────── -->
                <Border Grid.Column="0" Grid.Row="0" Style="{DynamicResource Card.Dark}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Section header -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖨️" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="{DynamicResource Dashboard_PrintersOverview}"
                                           FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{DynamicResource Button.Dark.Ghost}"
                                    Command="{Binding DataContext.NavigateToPrintManagerCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                <TextBlock Text="{DynamicResource Dashboard_ViewAll}" FontSize="12" Foreground="#3B82F6"/>
                            </Button>
                        </Grid>

                        <!-- Printer mini-cards grid -->
                        <ItemsControl Grid.Row="2" ItemsSource="{Binding Printers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" Rows="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,12,12" Padding="14" CornerRadius="12" Cursor="Hand"
                                            Background="#0F172A" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="#334155"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#1E3A5F"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#1E293B"/>
                                                        <Setter Property="BorderBrush" Value="#3B82F6"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Icon + online dot -->
                                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="🖨️" FontSize="22"/>
                                                <Ellipse Grid.Column="1" Width="10" Height="10" VerticalAlignment="Top">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#EF4444"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                    <Setter Property="Fill" Value="#22C55E"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                            </Grid>

                                            <!-- Printer name -->
                                            <TextBlock Grid.Row="1" Text="{Binding Name}"
                                                       FontWeight="SemiBold" FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="White" ToolTip="{Binding Name}"/>

                                            <!-- Status badge pill -->
                                            <Border Grid.Row="2" CornerRadius="6" Padding="7,3"
                                                    HorizontalAlignment="Right" Margin="0,6,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#7F1D1D"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                <Setter Property="Background" Value="#14532D"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusText}" FontSize="10"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="80">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#FCA5A5"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                    <Setter Property="Foreground" Value="#86EFAC"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- Health score + queue -->
                                            <StackPanel Grid.Row="3" Orientation="Horizontal"
                                                        Margin="0,6,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding HealthScore, StringFormat='{}{0}%'}"
                                                           FontSize="10" FontWeight="Medium"
                                                           Foreground="{Binding HealthColor}"/>
                                                <TextBlock Text=" · " FontSize="10" Foreground="#334155"
                                                           Visibility="{Binding QueueLength, Converter={StaticResource GreaterThanZeroToVisibility}}"/>
                                                <TextBlock FontSize="10" Foreground="#64748B"
                                                           Visibility="{Binding QueueLength, Converter={StaticResource GreaterThanZeroToVisibility}}">
                                                    <TextBlock.Text>
                                                        <Binding Path="QueueLength" StringFormat="{}{0} ↑"/>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- ── LEFT BOTTOM: Quick Actions (4 buttons) ──────────────── -->
                <Border Grid.Column="0" Grid.Row="2" Style="{DynamicResource Card.Dark}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <TextBlock Text="⚡" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource Dashboard_QuickActions}"
                                       FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <!-- 3 tiles (cols 0/2/4) with 14px gutters -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 1. Imposition — green -->
                            <Button Grid.Column="0"
                                    Command="{Binding DataContext.NavigateToImpositionCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="card" Padding="14,20" CornerRadius="14" Cursor="Hand"
                                                Background="#16A34A">
                                            <Border.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform x:Name="sc" ScaleX="1" ScaleY="1"/>
                                                    <TranslateTransform x:Name="tr" Y="0"/>
                                                </TransformGroup>
                                            </Border.RenderTransform>
                                            <StackPanel HorizontalAlignment="Center">
                                                <Border Width="40" Height="40" CornerRadius="10"
                                                        Background="#FFFFFF25" Margin="0,0,0,10"
                                                        HorizontalAlignment="Center">
                                                    <TextBlock Text="📐" FontSize="20"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{DynamicResource Dashboard_QuickActions_Imposition_Title}"
                                                           FontSize="11" FontWeight="Bold" Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           TextAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.12"/>
                                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0:0:0.12"/>
                                                            <DoubleAnimation Storyboard.TargetName="tr" Storyboard.TargetProperty="Y" To="-3" Duration="0:0:0.12"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/>
                                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/>
                                                            <DoubleAnimation Storyboard.TargetName="tr" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.12"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- 2. Numbered Books — amber -->
                            <Button Grid.Column="2"
                                    Command="{Binding DataContext.NavigateToNumberedBooksCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="card" Padding="14,20" CornerRadius="14" Cursor="Hand"
                                                Background="#D97706">
                                            <Border.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform x:Name="sc" ScaleX="1" ScaleY="1"/>
                                                    <TranslateTransform x:Name="tr" Y="0"/>
                                                </TransformGroup>
                                            </Border.RenderTransform>
                                            <StackPanel HorizontalAlignment="Center">
                                                <Border Width="40" Height="40" CornerRadius="10"
                                                        Background="#FFFFFF25" Margin="0,0,0,10"
                                                        HorizontalAlignment="Center">
                                                    <TextBlock Text="📚" FontSize="20"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{DynamicResource Dashboard_QuickActions_NumberedBooks_Title}"
                                                           FontSize="11" FontWeight="Bold" Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           TextAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.12"/>
                                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0:0:0.12"/>
                                                            <DoubleAnimation Storyboard.TargetName="tr" Storyboard.TargetProperty="Y" To="-3" Duration="0:0:0.12"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/>
                                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/>
                                                            <DoubleAnimation Storyboard.TargetName="tr" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.12"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- 3. Template Designer — violet -->
                            <Button Grid.Column="4"
                                    Command="{Binding DataContext.NavigateToTemplateDesignerCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="card" Padding="14,20" CornerRadius="14" Cursor="Hand"
                                                Background="#7C3AED">
                                            <Border.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform x:Name="sc" ScaleX="1" ScaleY="1"/>
                                                    <TranslateTransform x:Name="tr" Y="0"/>
                                                </TransformGroup>
                                            </Border.RenderTransform>
                                            <StackPanel HorizontalAlignment="Center">
                                                <Border Width="40" Height="40" CornerRadius="10"
                                                        Background="#FFFFFF25" Margin="0,0,0,10"
                                                        HorizontalAlignment="Center">
                                                    <TextBlock Text="🎨" FontSize="20"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{DynamicResource Nav_TemplateDesigner}"
                                                           FontSize="11" FontWeight="Bold" Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           TextAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.12"/>
                                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0:0:0.12"/>
                                                            <DoubleAnimation Storyboard.TargetName="tr" Storyboard.TargetProperty="Y" To="-3" Duration="0:0:0.12"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/>
                                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/>
                                                            <DoubleAnimation Storyboard.TargetName="tr" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.12"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ── RIGHT TOP: System Status ─────────────────────────────── -->
                <Border Grid.Column="2" Grid.Row="0" Style="{DynamicResource Card.Dark}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <TextBlock Text="📈" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource Dashboard_SystemStatus}"
                                       FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <!-- Connection status banner -->
                            <Border CornerRadius="12" Padding="14,11" Margin="0,0,0,14">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#14532D"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSystemOnline}" Value="False">
                                                <Setter Property="Background" Value="#7F1D1D"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#22C55E"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSystemOnline}" Value="False">
                                                        <Setter Property="Fill" Value="#EF4444"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding SystemStatus}" FontWeight="SemiBold"
                                               FontSize="13" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#86EFAC"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSystemOnline}" Value="False">
                                                        <Setter Property="Foreground" Value="#FCA5A5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- 2×3 metrics grid -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Column="0" Grid.Row="0" Background="#0F172A"
                                        CornerRadius="10" Padding="12" BorderBrush="#334155" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Dashboard_PendingJobs}"
                                                   FontSize="10" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding PendingJobs}"
                                                   FontSize="24" FontWeight="Bold" Foreground="#F59E0B"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Grid.Row="0" Background="#0F172A"
                                        CornerRadius="10" Padding="12" BorderBrush="#334155" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Dashboard_CompletedJobs}"
                                                   FontSize="10" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding CompletedJobs}"
                                                   FontSize="24" FontWeight="Bold" Foreground="#22C55E"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="0" Grid.Row="2" Background="#0F172A"
                                        CornerRadius="10" Padding="12" BorderBrush="#334155" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Dashboard_FailedJobs}"
                                                   FontSize="10" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding FailedJobs}"
                                                   FontSize="24" FontWeight="Bold" Foreground="#EF4444"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Grid.Row="2" Background="#0F172A"
                                        CornerRadius="10" Padding="12" BorderBrush="#334155" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Dashboard_SuccessRate}"
                                                   FontSize="10" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding SuccessRateText}"
                                                   FontSize="24" FontWeight="Bold" Foreground="#3B82F6"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="0" Grid.Row="4" Background="#0F172A"
                                        CornerRadius="10" Padding="12" BorderBrush="#334155" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Dashboard_BusyPrinters}"
                                                   FontSize="10" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding BusyPrinters}"
                                                   FontSize="24" FontWeight="Bold" Foreground="#F97316"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Grid.Row="4" Background="#0F172A"
                                        CornerRadius="10" Padding="12" BorderBrush="#334155" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Dashboard_ActiveJobs}"
                                                   FontSize="10" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding ActiveJobs}"
                                                   FontSize="24" FontWeight="Bold" Foreground="#A78BFA"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── RIGHT BOTTOM: Recent Activity ───────────────────────── -->
                <Border Grid.Column="2" Grid.Row="2" Style="{DynamicResource Card.Dark}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource Dashboard_RecentActivity}"
                                       FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <!-- Empty-state (visible when list is empty via converter trick) -->
                            <Border Padding="0,24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RecentActivity.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📭" FontSize="28"
                                               HorizontalAlignment="Center" Margin="0,0,0,8">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RecentActivity.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{DynamicResource Dashboard_NoActivity}"
                                               FontSize="12" Foreground="#475569"
                                               HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RecentActivity.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding RecentActivity}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12,10" Margin="0,0,0,8" CornerRadius="10"
                                                Background="#0F172A" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="#334155"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="Success">
                                                            <Setter Property="BorderBrush" Value="#166534"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Error">
                                                            <Setter Property="BorderBrush" Value="#991B1B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Warning">
                                                            <Setter Property="BorderBrush" Value="#92400E"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#1E293B"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Colored icon badge -->
                                                <Border Width="32" Height="32" CornerRadius="8"
                                                        Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#1E3A5F"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Type}" Value="Success">
                                                                    <Setter Property="Background" Value="#14532D"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Type}" Value="Error">
                                                                    <Setter Property="Background" Value="#7F1D1D"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Type}" Value="Warning">
                                                                    <Setter Property="Background" Value="#78350F"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Icon}" FontSize="15"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Subject + description -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Subject}" FontSize="12"
                                                               FontWeight="Medium" Foreground="#E2E8F0"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Subject}"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="10"
                                                               Foreground="#64748B" Margin="0,2,0,0"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <!-- Timestamp -->
                                                <TextBlock Grid.Column="2" Text="{Binding Time}"
                                                           FontSize="10" Foreground="#475569"
                                                           VerticalAlignment="Top" Margin="8,2,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ════════════════════════════════════════════════════════════════
                 6️⃣  HEALTH STRIP — 4 live metrics in a single bar
                 ════════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="6" Background="#1E293B" CornerRadius="14" Padding="28,16"
                    BorderBrush="#334155" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Online / Total printers -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="{DynamicResource Dashboard_PrintersOverview}"
                                   FontSize="10" Foreground="#64748B" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock Text="{Binding OnlinePrinters}"
                                       FontSize="22" FontWeight="Bold" Foreground="#22C55E"/>
                            <TextBlock Text=" / " FontSize="22" Foreground="#334155"/>
                            <TextBlock Text="{Binding TotalPrinters}"
                                       FontSize="22" FontWeight="Bold" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>
                    <Rectangle Grid.Column="1" Fill="#334155"/>

                    <!-- Average jobs / day -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="{DynamicResource Dashboard_AvgJobsDay}"
                                   FontSize="10" Foreground="#64748B" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding AverageJobsPerDay, StringFormat='{}{0:F1}'}"
                                   FontSize="22" FontWeight="Bold" Foreground="#60A5FA"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Rectangle Grid.Column="3" Fill="#334155"/>

                    <!-- Success rate -->
                    <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                        <TextBlock Text="{DynamicResource Dashboard_SuccessRate}"
                                   FontSize="10" Foreground="#64748B" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding SuccessRateText}"
                                   FontSize="22" FontWeight="Bold" Foreground="#A78BFA"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Rectangle Grid.Column="5" Fill="#334155"/>

                    <!-- Top printer -->
                    <StackPanel Grid.Column="6" HorizontalAlignment="Center">
                        <TextBlock Text="{DynamicResource Dashboard_TopPrinter}"
                                   FontSize="10" Foreground="#64748B" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TopPrinter}"
                                   FontSize="13" FontWeight="Bold" Foreground="#F59E0B"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   MaxWidth="160" Margin="0,5,0,0"
                                   ToolTip="{Binding TopPrinter}"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>
