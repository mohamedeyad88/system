<UserControl x:Class="Apex.UI.Views.ColorCalibrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Apex.UI.ViewModels"
             xmlns:svc="clr-namespace:Apex.UI.Services"
             FlowDirection="{Binding Source={x:Static svc:LocalizationService.Instance},
                                     Path=FlowDirection, Mode=OneWay}"
             Background="#FAF9F7">

    <UserControl.Resources>
        <Style x:Key="SliderStyle" TargetType="Slider">
            <Setter Property="Minimum"       Value="-1"/>
            <Setter Property="Maximum"       Value="1"/>
            <Setter Property="SmallChange"   Value="0.01"/>
            <Setter Property="LargeChange"   Value="0.1"/>
            <Setter Property="Height"        Value="20"/>
        </Style>
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize"      Value="12"/>
            <Setter Property="FontWeight"    Value="SemiBold"/>
            <Setter Property="Foreground"    Value="#6B6864"/>
            <Setter Property="Margin"        Value="0,12,0,8"/>
        </Style>
        <Style x:Key="SliderLabel" TargetType="TextBlock">
            <Setter Property="FontSize"      Value="11"/>
            <Setter Property="Foreground"    Value="#6B6864"/>
            <Setter Property="Width"         Value="80"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ValueLabel" TargetType="TextBlock">
            <Setter Property="FontSize"      Value="11"/>
            <Setter Property="Foreground"    Value="#0891B2"/>
            <Setter Property="Width"         Value="44"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FFFFFF" Padding="24,0">
            <!-- Two columns. The title and the button used to share one cell, so the
                 button drew over the heading and it read "ة الألوان" — the first word
                 gone. Both strings were hardcoded Arabic too, so the header stayed in
                 Arabic with the app in English. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Foreground="White"
                           FontSize="20" FontWeight="Bold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis">
                    <Run Text="🎨 "/><Run Text="{DynamicResource CC_001}"/>
                </TextBlock>

                <Button Grid.Column="1" Command="{Binding LoadPrintersCommand}"
                        VerticalAlignment="Center"
                        Height="32" Padding="12,0" Margin="12,0,0,0"
                        Background="#DDD9D3" Foreground="#6B6864" BorderThickness="0"
                        FontSize="12" Cursor="Hand">
                    <TextBlock>
                        <Run Text="🔄 "/><Run Text="{DynamicResource Common_Refresh}"/>
                    </TextBlock>
                </Button>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Printer List -->
            <Border Grid.Column="0" Background="#FFFFFF"
                    BorderBrush="#DDD9D3" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="الطابعات" Foreground="White"
                               FontSize="13" FontWeight="SemiBold" Margin="16,16,16,8"/>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding PrinterNames}"
                             SelectedItem="{Binding SelectedPrinterName}"
                             Background="Transparent" BorderThickness="0"
                             Margin="8,0,8,8">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground"  Value="#14181D"/>
                                <Setter Property="Padding"     Value="12,10"/>
                                <Setter Property="FontSize"    Value="12"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="b" Background="Transparent"
                                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="#DDD9D3"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="#0891B2"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- ICC Profile -->
                    <Border Grid.Row="2" Padding="16,12"
                            BorderBrush="#DDD9D3" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <TextBlock Text="ملف ICC:" Foreground="#6B6864" FontSize="10"/>
                            <TextBlock Foreground="#6B6864" FontSize="11" TextWrapping="Wrap"
                                       Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="لا يوجد"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IccProfilePath}" Value="{x:Null}">
                                                <Setter Property="Text" Value="لا يوجد"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Right: Calibration Controls -->
            <Grid Grid.Column="1">
                <!-- No printer selected -->
                <TextBlock Text="← اختر طابعة من القائمة"
                           Foreground="#6B6864" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPrinterSelected}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Calibration form -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPrinterSelected}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>

                        <!-- Title -->
                        <TextBlock Text="إعدادات الضبط اللوني" Foreground="White"
                                   FontSize="15" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock Foreground="#6B6864" FontSize="11" Margin="0,0,0,16">
                            <Run Text="الطابعة: "/>
                            <Run Text="{Binding SelectedPrinterName}" Foreground="#6B6864"/>
                        </TextBlock>

                        <!-- RGB Adjustments -->
                        <TextBlock Text="— ضبط الصورة" Style="{StaticResource GroupTitle}"
                                   Foreground="#0891B2"/>

                        <!-- Brightness -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="السطوع"
                                       Style="{StaticResource SliderLabel}"/>
                            <Slider Grid.Column="1" Value="{Binding Brightness}"
                                    Style="{StaticResource SliderStyle}" Margin="8,0"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Brightness, StringFormat={}{0:+0.00;-0.00;0.00}}"
                                       Style="{StaticResource ValueLabel}"/>
                        </Grid>

                        <!-- Contrast -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="التباين"
                                       Style="{StaticResource SliderLabel}"/>
                            <Slider Grid.Column="1" Value="{Binding Contrast}"
                                    Style="{StaticResource SliderStyle}" Margin="8,0"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Contrast, StringFormat={}{0:+0.00;-0.00;0.00}}"
                                       Style="{StaticResource ValueLabel}"/>
                        </Grid>

                        <!-- Saturation -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="التشبع"
                                       Style="{StaticResource SliderLabel}"/>
                            <Slider Grid.Column="1" Value="{Binding Saturation}"
                                    Style="{StaticResource SliderStyle}" Margin="8,0"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Saturation, StringFormat={}{0:+0.00;-0.00;0.00}}"
                                       Style="{StaticResource ValueLabel}"/>
                        </Grid>

                        <!-- CMYK -->
                        <TextBlock Text="— إزاحة CMYK" Style="{StaticResource GroupTitle}"
                                   Foreground="#FB923C"/>

                        <!-- Cyan -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="سيان"
                                       Style="{StaticResource SliderLabel}"/>
                            <Slider Grid.Column="1" Value="{Binding CyanOffset}"
                                    Style="{StaticResource SliderStyle}" Margin="8,0"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding CyanOffset, StringFormat={}{0:+0.00;-0.00;0.00}}"
                                       Style="{StaticResource ValueLabel}"/>
                        </Grid>

                        <!-- Magenta -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ماجنتا"
                                       Style="{StaticResource SliderLabel}"/>
                            <Slider Grid.Column="1" Value="{Binding MagentaOffset}"
                                    Style="{StaticResource SliderStyle}" Margin="8,0"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding MagentaOffset, StringFormat={}{0:+0.00;-0.00;0.00}}"
                                       Style="{StaticResource ValueLabel}"/>
                        </Grid>

                        <!-- Yellow -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="أصفر"
                                       Style="{StaticResource SliderLabel}"/>
                            <Slider Grid.Column="1" Value="{Binding YellowOffset}"
                                    Style="{StaticResource SliderStyle}" Margin="8,0"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding YellowOffset, StringFormat={}{0:+0.00;-0.00;0.00}}"
                                       Style="{StaticResource ValueLabel}"/>
                        </Grid>

                        <!-- Black -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="أسود"
                                       Style="{StaticResource SliderLabel}"/>
                            <Slider Grid.Column="1" Value="{Binding BlackOffset}"
                                    Style="{StaticResource SliderStyle}" Margin="8,0"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding BlackOffset, StringFormat={}{0:+0.00;-0.00;0.00}}"
                                       Style="{StaticResource ValueLabel}"/>
                        </Grid>

                        <!-- Action Buttons -->
                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Command="{Binding SaveCalibrationCommand}"
                                    Height="40" Background="#0891B2"
                                    Foreground="White" BorderThickness="0"
                                    FontSize="13" FontWeight="SemiBold"
                                    Content="💾 حفظ الإعدادات" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" Background="#0891B2" CornerRadius="8"
                                                Height="40">
                                            <TextBlock Text="{TemplateBinding Content}"
                                                       Foreground="White" FontSize="13" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#0E7490"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Grid.Column="2"
                                    Command="{Binding ResetCalibrationCommand}"
                                    Height="40" Content="↺ إعادة ضبط" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" Background="Transparent" CornerRadius="8"
                                                BorderBrush="#6B6864" BorderThickness="1" Height="40">
                                            <TextBlock Text="{TemplateBinding Content}"
                                                       Foreground="#6B6864" FontSize="13"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Status -->
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="#1B7F4C" FontSize="12"
                                   Margin="0,12,0,0" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
