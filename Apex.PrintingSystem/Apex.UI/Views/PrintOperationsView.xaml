<UserControl x:Class="Apex.UI.Views.PrintOperationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:Apex.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="#0F172A">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <converters:NonEmptyStringToVisibilityConverter x:Key="NonEmptyToVis"/>
        
        <!-- ═══════════════════════════════════════════════════════════════════
             🎨 MODERN DARK THEME - Inspired by Vercel/Linear
             ═══════════════════════════════════════════════════════════════════ -->
        
        <!-- Glass Card -->
        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        
        <!-- Accent Button -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="10" Padding="20,12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#475569"/>
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Ghost Button -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Stepper Button -->
        <Style x:Key="StepperButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#334155" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Gradient Progress Bar -->
        <Style x:Key="GradientProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="10"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <!-- Track -->
                            <Border Background="#334155" CornerRadius="5"/>
                            <!-- Indicator -->
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="5">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#3B82F6" Offset="0"/>
                                        <GradientStop Color="#8B5CF6" Offset="0.6"/>
                                        <GradientStop Color="#EC4899" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Chip (On/Off pill button) -->
        <Style x:Key="ToggleChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Cancel Button -->
        <Style x:Key="CancelButton" TargetType="Button">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="16,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DC2626"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>      <!-- Main Content -->
            <RowDefinition Height="Auto"/>   <!-- Print Progress Bar -->
            <RowDefinition Height="Auto"/>   <!-- Action Bar -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════════
             📄 MAIN CONTENT AREA  — two-column layout
             Left  : options sidebar (scrollable, fixed 280px)
             Right : file + printers (fills remaining space)
             ═══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>   <!-- Options Sidebar -->
                <ColumnDefinition Width="*"/>     <!-- Main Area -->
            </Grid.ColumnDefinitions>

            <!-- ── LEFT SIDEBAR ─────────────────────────────────────────── -->
            <Border Grid.Column="0" Background="#1A2235"
                    BorderBrush="#1E293B" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,24,16,16">

                        <!-- Copies stepper -->
                        <TextBlock Text="Copies" FontSize="11" FontWeight="Medium"
                                   Foreground="#64748B" Margin="0,0,0,8"/>
                        <Border Background="#0F172A" CornerRadius="12" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="−" Style="{StaticResource StepperButton}"
                                        Foreground="#94A3B8" Click="DecreaseCopies_Click"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding NewJobCopies, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0"
                                         FontSize="36" FontWeight="Bold" Foreground="White"
                                         TextAlignment="Center" VerticalAlignment="Center"
                                         HorizontalAlignment="Center"
                                         MaxLength="3" MinWidth="60"
                                         PreviewTextInput="CopiesTextBox_PreviewTextInput"/>
                                <Button Grid.Column="2" Content="+" Style="{StaticResource StepperButton}"
                                        Foreground="White" Background="#3B82F6"
                                        Click="IncreaseCopies_Click"/>
                            </Grid>
                        </Border>

                        <Border Height="1" Background="#1E293B" Margin="0,14,0,14"/>

                        <!-- All the options from the old Copies card go here -->
                        <!-- Sides -->
                        <TextBlock Text="Sides" FontSize="11" Foreground="#64748B" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="8" Padding="10,7" Cursor="Hand" MouseLeftButtonUp="SingleSided_Click">
                                <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#334155"/><Style.Triggers><DataTrigger Binding="{Binding IsSingleSided}" Value="True"><Setter Property="Background" Value="#1E3A5F"/><Setter Property="BorderBrush" Value="#3B82F6"/><Setter Property="BorderThickness" Value="1"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                <TextBlock Text="◻ Single" FontSize="12" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#94A3B8"/><Style.Triggers><DataTrigger Binding="{Binding IsSingleSided}" Value="True"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            </Border>
                            <Border Grid.Column="2" CornerRadius="8" Padding="10,7" Cursor="Hand" MouseLeftButtonUp="DoubleSided_Click">
                                <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#334155"/><Style.Triggers><DataTrigger Binding="{Binding IsDoubleSided}" Value="True"><Setter Property="Background" Value="#1E3A5F"/><Setter Property="BorderBrush" Value="#3B82F6"/><Setter Property="BorderThickness" Value="1"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                <TextBlock Text="⧉ Duplex" FontSize="12" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#94A3B8"/><Style.Triggers><DataTrigger Binding="{Binding IsDoubleSided}" Value="True"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            </Border>
                        </Grid>

                        <!-- Color -->
                        <TextBlock Text="Color" FontSize="11" Foreground="#64748B" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="8" Padding="10,7" Cursor="Hand" MouseLeftButtonUp="ColorPrint_Click">
                                <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#334155"/><Style.Triggers><DataTrigger Binding="{Binding IsColorPrint}" Value="True"><Setter Property="Background" Value="#1E3A5F"/><Setter Property="BorderBrush" Value="#3B82F6"/><Setter Property="BorderThickness" Value="1"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                <TextBlock Text="🎨 Color" FontSize="12" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#94A3B8"/><Style.Triggers><DataTrigger Binding="{Binding IsColorPrint}" Value="True"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            </Border>
                            <Border Grid.Column="2" CornerRadius="8" Padding="10,7" Cursor="Hand" MouseLeftButtonUp="BwPrint_Click">
                                <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#334155"/><Style.Triggers><DataTrigger Binding="{Binding IsColorPrint}" Value="False"><Setter Property="Background" Value="#1E293B"/><Setter Property="BorderBrush" Value="#475569"/><Setter Property="BorderThickness" Value="1"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                <TextBlock Text="⬜ B&amp;W" FontSize="12" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#94A3B8"/><Style.Triggers><DataTrigger Binding="{Binding IsColorPrint}" Value="False"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            </Border>
                        </Grid>

                        <!-- Quality -->
                        <TextBlock Text="Quality" FontSize="11" Foreground="#64748B" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="7" Padding="4,7" Cursor="Hand" MouseLeftButtonUp="QualityDraft_Click"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#334155"/><Style.Triggers><DataTrigger Binding="{Binding PrintQuality}" Value="Draft"><Setter Property="Background" Value="#1E3A5F"/><Setter Property="BorderBrush" Value="#3B82F6"/><Setter Property="BorderThickness" Value="1"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="Draft" FontSize="11" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#94A3B8"/><Style.Triggers><DataTrigger Binding="{Binding PrintQuality}" Value="Draft"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border>
                            <Border Grid.Column="2" CornerRadius="7" Padding="4,7" Cursor="Hand" MouseLeftButtonUp="QualityNormal_Click"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#334155"/><Style.Triggers><DataTrigger Binding="{Binding PrintQuality}" Value="Normal"><Setter Property="Background" Value="#1E3A5F"/><Setter Property="BorderBrush" Value="#3B82F6"/><Setter Property="BorderThickness" Value="1"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="Normal" FontSize="11" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#94A3B8"/><Style.Triggers><DataTrigger Binding="{Binding PrintQuality}" Value="Normal"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border>
                            <Border Grid.Column="4" CornerRadius="7" Padding="4,7" Cursor="Hand" MouseLeftButtonUp="QualityHigh_Click"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#334155"/><Style.Triggers><DataTrigger Binding="{Binding PrintQuality}" Value="High"><Setter Property="Background" Value="#1E3A5F"/><Setter Property="BorderBrush" Value="#3B82F6"/><Setter Property="BorderThickness" Value="1"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="High" FontSize="11" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#94A3B8"/><Style.Triggers><DataTrigger Binding="{Binding PrintQuality}" Value="High"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border>
                        </Grid>

                        <!-- Paper Size -->
                        <TextBlock Text="Paper Size" FontSize="11" Foreground="#64748B" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="7" Padding="4,6" Cursor="Hand" MouseLeftButtonUp="PaperA4_Click"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#334155"/><Style.Triggers><DataTrigger Binding="{Binding PaperSize}" Value="A4"><Setter Property="Background" Value="#1E3A5F"/><Setter Property="BorderBrush" Value="#3B82F6"/><Setter Property="BorderThickness" Value="1"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="A4" FontSize="11" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#94A3B8"/><Style.Triggers><DataTrigger Binding="{Binding PaperSize}" Value="A4"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border>
                            <Border Grid.Column="2" CornerRadius="7" Padding="4,6" Cursor="Hand" MouseLeftButtonUp="PaperA3_Click"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#334155"/><Style.Triggers><DataTrigger Binding="{Binding PaperSize}" Value="A3"><Setter Property="Background" Value="#1E3A5F"/><Setter Property="BorderBrush" Value="#3B82F6"/><Setter Property="BorderThickness" Value="1"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="A3" FontSize="11" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#94A3B8"/><Style.Triggers><DataTrigger Binding="{Binding PaperSize}" Value="A3"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border>
                            <Border Grid.Column="4" CornerRadius="7" Padding="4,6" Cursor="Hand" MouseLeftButtonUp="PaperLetter_Click"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#334155"/><Style.Triggers><DataTrigger Binding="{Binding PaperSize}" Value="Letter"><Setter Property="Background" Value="#1E3A5F"/><Setter Property="BorderBrush" Value="#3B82F6"/><Setter Property="BorderThickness" Value="1"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="Ltr" FontSize="11" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#94A3B8"/><Style.Triggers><DataTrigger Binding="{Binding PaperSize}" Value="Letter"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border>
                            <Border Grid.Column="6" CornerRadius="7" Padding="4,6" Cursor="Hand" MouseLeftButtonUp="PaperLegal_Click"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#334155"/><Style.Triggers><DataTrigger Binding="{Binding PaperSize}" Value="Legal"><Setter Property="Background" Value="#1E3A5F"/><Setter Property="BorderBrush" Value="#3B82F6"/><Setter Property="BorderThickness" Value="1"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="Lgl" FontSize="11" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#94A3B8"/><Style.Triggers><DataTrigger Binding="{Binding PaperSize}" Value="Legal"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border>
                        </Grid>

                        <!-- Orientation -->
                        <TextBlock Text="Orientation" FontSize="11" Foreground="#64748B" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="8" Padding="8,7" Cursor="Hand" MouseLeftButtonUp="Portrait_Click"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#334155"/><Style.Triggers><DataTrigger Binding="{Binding IsPortrait}" Value="True"><Setter Property="Background" Value="#1E3A5F"/><Setter Property="BorderBrush" Value="#3B82F6"/><Setter Property="BorderThickness" Value="1"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="▯ Portrait" FontSize="12" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#94A3B8"/><Style.Triggers><DataTrigger Binding="{Binding IsPortrait}" Value="True"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border>
                            <Border Grid.Column="2" CornerRadius="8" Padding="8,7" Cursor="Hand" MouseLeftButtonUp="Landscape_Click"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#334155"/><Style.Triggers><DataTrigger Binding="{Binding IsLandscape}" Value="True"><Setter Property="Background" Value="#1E3A5F"/><Setter Property="BorderBrush" Value="#3B82F6"/><Setter Property="BorderThickness" Value="1"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="▭ Landscape" FontSize="12" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#94A3B8"/><Style.Triggers><DataTrigger Binding="{Binding IsLandscape}" Value="True"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border>
                        </Grid>

                        <!-- Collate -->
                        <TextBlock Text="Collate" FontSize="11" Foreground="#64748B" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="8" Padding="8,7" Cursor="Hand" MouseLeftButtonUp="CollateOn_Click"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#334155"/><Style.Triggers><DataTrigger Binding="{Binding Collate}" Value="True"><Setter Property="Background" Value="#1E3A5F"/><Setter Property="BorderBrush" Value="#3B82F6"/><Setter Property="BorderThickness" Value="1"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="1,2,3 / 1,2,3" FontSize="11" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#94A3B8"/><Style.Triggers><DataTrigger Binding="{Binding Collate}" Value="True"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border>
                            <Border Grid.Column="2" CornerRadius="8" Padding="8,7" Cursor="Hand" MouseLeftButtonUp="CollateOff_Click"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#334155"/><Style.Triggers><DataTrigger Binding="{Binding Collate}" Value="False"><Setter Property="Background" Value="#1E3A5F"/><Setter Property="BorderBrush" Value="#3B82F6"/><Setter Property="BorderThickness" Value="1"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="1,1,1 / 2,2,2" FontSize="11" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#94A3B8"/><Style.Triggers><DataTrigger Binding="{Binding Collate}" Value="False"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border>
                        </Grid>

                        <!-- Fit to Page -->
                        <TextBlock Text="Fit to Page" FontSize="11" Foreground="#64748B" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="7" Padding="4,7" Cursor="Hand" MouseLeftButtonUp="FitActual_Click"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#334155"/><Style.Triggers><DataTrigger Binding="{Binding FitMode}" Value="Actual"><Setter Property="Background" Value="#1E3A5F"/><Setter Property="BorderBrush" Value="#3B82F6"/><Setter Property="BorderThickness" Value="1"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="1:1" FontSize="11" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#94A3B8"/><Style.Triggers><DataTrigger Binding="{Binding FitMode}" Value="Actual"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border>
                            <Border Grid.Column="2" CornerRadius="7" Padding="4,7" Cursor="Hand" MouseLeftButtonUp="FitFit_Click"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#334155"/><Style.Triggers><DataTrigger Binding="{Binding FitMode}" Value="Fit"><Setter Property="Background" Value="#1E3A5F"/><Setter Property="BorderBrush" Value="#3B82F6"/><Setter Property="BorderThickness" Value="1"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="Fit" FontSize="11" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#94A3B8"/><Style.Triggers><DataTrigger Binding="{Binding FitMode}" Value="Fit"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border>
                            <Border Grid.Column="4" CornerRadius="7" Padding="4,7" Cursor="Hand" MouseLeftButtonUp="FitCustom_Click"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#334155"/><Style.Triggers><DataTrigger Binding="{Binding FitMode}" Value="Custom"><Setter Property="Background" Value="#1E3A5F"/><Setter Property="BorderBrush" Value="#3B82F6"/><Setter Property="BorderThickness" Value="1"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="%" FontSize="11" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#94A3B8"/><Style.Triggers><DataTrigger Binding="{Binding FitMode}" Value="Custom"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border>
                        </Grid>
                        <Border CornerRadius="8" Padding="10,7" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding FitMode}" Value="Custom"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBox Text="{Binding FitCustomPercent, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" FontSize="18" FontWeight="Bold" Foreground="White" Width="50" TextAlignment="Center" PreviewTextInput="PageRangeTextBox_PreviewTextInput"/>
                                <TextBlock Text=" %" FontSize="18" Foreground="#64748B" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>


                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ── RIGHT MAIN AREA ───────────────────────────────────────── -->
            <Grid Grid.Column="1" Margin="24,24,24,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Header -->
                    <RowDefinition Height="Auto"/>  <!-- File card + page range -->
                    <RowDefinition Height="*"/>     <!-- Printers (fills space) -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="{DynamicResource PrintExecution_Title}"
                               FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{DynamicResource PrintExecution_Subtitle}"
                               FontSize="13" Foreground="#64748B" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- File card -->
                <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="20" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- File zone -->
                        <Border Grid.Row="0" x:Name="DropZoneBorder" Background="#0F172A" CornerRadius="12"
                                Padding="20" MinHeight="72"
                                BorderBrush="#334155" BorderThickness="2"
                                AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZone_Drop">
                            <Grid>
                                <StackPanel Visibility="{Binding HasFile, Converter={StaticResource InverseBoolToVis}}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="📂" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="Drop a file here or click to browse"
                                               FontSize="13" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    <Button Command="{Binding BrowseFileCommand}"
                                            Style="{StaticResource AccentButton}" Margin="0,12,0,0"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="{DynamicResource PrintExecution_ChooseFile}" FontWeight="Medium"/>
                                    </Button>
                                </StackPanel>
                                <Grid Visibility="{Binding HasFile, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="52" Height="52" Background="#3B82F6" CornerRadius="12" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding FileTypeIcon, FallbackValue='📄'}" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayFileName}" FontSize="15" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <Border Background="#334155" CornerRadius="4" Padding="7,3" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding FileTypeDisplay}" FontSize="11" Foreground="#94A3B8"/>
                                            </Border>
                                            <Border Background="#334155" CornerRadius="4" Padding="7,3" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding FileSizeDisplay}" FontSize="11" Foreground="#94A3B8"/>
                                            </Border>
                                            <Border Background="#334155" CornerRadius="4" Padding="7,3"
                                                    Visibility="{Binding HasFile, Converter={StaticResource BoolToVis}}">
                                                <TextBlock FontSize="11" Foreground="#94A3B8">
                                                    <Run Text="{Binding FilePageCount, Mode=OneWay}"/>
                                                    <Run Text=" pages"/>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="2" Command="{Binding BrowseFileCommand}" Style="{StaticResource GhostButton}">
                                        <TextBlock Text="Change" Foreground="#3B82F6"/>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                        <!-- Page Range row -->
                        <Border Grid.Row="1" Margin="0,10,0,0"
                                Visibility="{Binding HasFile, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" MouseLeftButtonUp="PageRangeToggle_Click">
                                    <Border.Style><Style TargetType="Border" BasedOn="{StaticResource ToggleChip}"><Style.Triggers><DataTrigger Binding="{Binding UsePageRange}" Value="True"><Setter Property="Background" Value="#1E3A5F"/><Setter Property="BorderBrush" Value="#3B82F6"/><Setter Property="BorderThickness" Value="1"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📄 " FontSize="11"/>
                                        <TextBlock Text="Page Range" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                            Visibility="{Binding UsePageRange, Converter={StaticResource BoolToVis}}">
                                    <Border Background="#0F172A" CornerRadius="6" Padding="10,6" Margin="0,0,8,0" BorderBrush="#334155" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="From " FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding PageRangeFrom, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" FontSize="13" FontWeight="Bold" Foreground="White" Width="36" TextAlignment="Center" PreviewTextInput="PageRangeTextBox_PreviewTextInput"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#0F172A" CornerRadius="6" Padding="10,6" BorderBrush="#334155" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="To " FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding PageRangeTo, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" FontSize="13" FontWeight="Bold" Foreground="White" Width="36" TextAlignment="Center" PreviewTextInput="PageRangeTextBox_PreviewTextInput"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ══ PRINTERS ════════════════════════════════════════════ -->
                <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- Header Row -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🖨️ Select Printers" FontSize="12" FontWeight="Medium" Foreground="#64748B"/>
                                <Border Background="#3B82F6" CornerRadius="10" Padding="10,4" Margin="12,0,0,0"
                                        Visibility="{Binding HasSelectedPrinters, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding SelectedPrintersCount}" FontSize="12" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#0F172A" CornerRadius="8" Padding="12,8" Margin="16,0" HorizontalAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="🔍" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#475569"/>
                                    <TextBox Grid.Column="1" Text="{Binding PrinterSearchQuery, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" FontSize="13" Foreground="White" VerticalContentAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Button Grid.Column="2" Command="{Binding LoadPrintersCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0">
                                <TextBlock Text="🔄" FontSize="13"/>
                            </Button>
                            <Button Grid.Column="3" Command="{Binding SelectAllPrintersCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0">
                                <TextBlock Text="All" FontSize="12"/>
                            </Button>
                            <Button Grid.Column="4" Command="{Binding DeselectAllPrintersCommand}" Style="{StaticResource GhostButton}">
                                <TextBlock Text="Clear" FontSize="12"/>
                            </Button>
                        </Grid>
                        <!-- Printer cards -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FilteredPrinters}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Cursor="Hand" Margin="4" CornerRadius="12" Padding="14" Background="#0F172A" BorderThickness="2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="#334155"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#3B82F6"/>
                                                            <Setter Property="Background" Value="#1E3A5F"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush" Value="#475569"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftClick"
                                                              Command="{Binding DataContext.TogglePrinterSelectionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,4,10,0" VerticalAlignment="Top">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#EF4444"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                    <Setter Property="Fill" Value="#22C55E"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <TextBlock FontSize="10" Foreground="#64748B">
                                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Offline"/><Style.Triggers><DataTrigger Binding="{Binding IsOnline}" Value="True"><Setter Property="Text" Value="Ready"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                        </TextBlock>
                                                        <Border Background="#334155" CornerRadius="4" Padding="5,2" Margin="6,0,0,0"
                                                                Visibility="{Binding QueueLength, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock FontSize="10" Foreground="#94A3B8">
                                                                <Run Text="{Binding QueueLength, Mode=OneWay}"/>
                                                                <Run Text=" in queue"/>
                                                            </TextBlock>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Border Grid.Column="2" Width="22" Height="22" CornerRadius="11" VerticalAlignment="Center">
                                                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#334155"/><Style.Triggers><DataTrigger Binding="{Binding IsChecked}" Value="True"><Setter Property="Background" Value="#3B82F6"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                    <TextBlock Text="✓" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding IsChecked, Converter={StaticResource BoolToVis}}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════════
             ⏳ PRINT PROGRESS BAR (visible only while printing)
             ═══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="#0F172A" Padding="32,16"
                BorderBrush="#1E3A5F" BorderThickness="0,1,0,0"
                Visibility="{Binding IsPrinting, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top row: file name + elapsed time + cancel -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Spinner dot -->
                    <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5"
                            Margin="0,0,12,0" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#3B82F6" Offset="0"/>
                                <GradientStop Color="#8B5CF6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- File name + status -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PrintProgress, FallbackValue='Printing...'}"
                                   FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="{Binding DisplayFileName}"
                                   FontSize="11" Foreground="#64748B" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                    </StackPanel>

                    <!-- Elapsed time -->
                    <Border Grid.Column="2" Background="#1E293B" CornerRadius="6"
                            Padding="10,6" Margin="16,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏱ " FontSize="11" Foreground="#64748B"/>
                            <TextBlock Text="{Binding PrintElapsedTime}"
                                       FontSize="13" FontWeight="Bold" Foreground="#94A3B8"
                                       FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>

                    <!-- Cancel button -->
                    <Button Grid.Column="3" Command="{Binding CancelPrintCommand}"
                            Style="{StaticResource CancelButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✕ " FontSize="12"/>
                            <TextBlock Text="Cancel"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Progress bar -->
                <ProgressBar Grid.Row="1"
                             Value="{Binding PrintProgressPercent, Mode=OneWay}"
                             Minimum="0" Maximum="100"
                             Style="{StaticResource GradientProgressBar}"
                             Margin="0,0,0,8"/>

                <!-- Bottom row: percent + ETA + printers count -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" FontSize="11" Foreground="#64748B">
                        <Run Text="{Binding PrintProgressPercent, Mode=OneWay}"/>
                        <Run Text="% complete"/>
                    </TextBlock>

                    <!-- ETA -->
                    <TextBlock Grid.Column="2" FontSize="11" Foreground="#475569"
                               Text="{Binding EstimatedTimeRemaining}"
                               Margin="0,0,16,0"
                               Visibility="{Binding EstimatedTimeRemaining, Converter={StaticResource NonEmptyToVis}}"/>

                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <TextBlock Text="🖨️ " FontSize="11" Foreground="#475569"/>
                        <TextBlock FontSize="11" Foreground="#64748B">
                            <Run Text="{Binding SelectedPrintersCount, Mode=OneWay}"/>
                            <Run Text=" printer(s) active"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════
             📋 PRESETS OVERLAY PANEL
             ═══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Grid.RowSpan="3"
                Panel.ZIndex="50"
                VerticalAlignment="Bottom" HorizontalAlignment="Right"
                Width="340" Margin="0,0,32,90"
                Background="#1E293B" CornerRadius="16"
                BorderBrush="#334155" BorderThickness="1"
                Visibility="{Binding IsPresetsOpen, Converter={StaticResource BoolToVis}}">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="⚡ Presets" FontSize="15" FontWeight="Bold" Foreground="White"/>
                    <Button HorizontalAlignment="Right" Command="{Binding TogglePresetsCommand}"
                            Style="{StaticResource GhostButton}" Padding="6,4">
                        <TextBlock Text="✕" FontSize="13" Foreground="#94A3B8"/>
                    </Button>
                </Grid>

                <!-- Save new preset row -->
                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#0F172A" CornerRadius="8"
                            Padding="10,8" BorderBrush="#334155" BorderThickness="1">
                        <TextBox Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0"
                                 FontSize="13" Foreground="White"
                                 VerticalContentAlignment="Center">
                            <TextBox.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                            </TextBox.Resources>
                        </TextBox>
                    </Border>
                    <Button Grid.Column="2" Command="{Binding SavePresetCommand}"
                            Style="{StaticResource AccentButton}" Padding="14,8">
                        <TextBlock Text="Save" FontSize="12"/>
                    </Button>
                </Grid>

                <!-- Preset list -->
                <ScrollViewer Grid.Row="2" MaxHeight="260" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Presets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0F172A" CornerRadius="10"
                                        Padding="14,10" Margin="0,0,0,8"
                                        BorderBrush="#334155" BorderThickness="1"
                                        Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Preset info -->
                                        <StackPanel Grid.Column="0"
                                                    MouseLeftButtonUp="PresetItem_Click">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                            <TextBlock FontSize="11" Foreground="#64748B" Margin="0,4,0,0">
                                                <Run Text="{Binding Copies, Mode=OneWay}"/>
                                                <Run Text="x •"/>
                                                <Run Text="{Binding PaperSize, Mode=OneWay}"/>
                                                <Run Text="•"/>
                                                <Run Text="{Binding PrintQuality, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <!-- Delete -->
                                        <Button Grid.Column="1"
                                                Command="{Binding DataContext.DeletePresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource GhostButton}" Padding="8,6">
                                            <TextBlock Text="🗑" FontSize="13"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════
             🚀 FIXED ACTION BAR
             ═══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#1E293B" Padding="32,20"
                BorderBrush="#334155" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Status Summary -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- File Status -->
                    <Border CornerRadius="8" Padding="12,8" Margin="0,0,16,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#334155"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasFile}" Value="True">
                                        <Setter Property="Background" Value="#14532D"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="12" Margin="0,0,6,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="❌"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasFile}" Value="True">
                                                <Setter Property="Text" Value="✅"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="File" FontSize="12" Foreground="#94A3B8"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Copies Display -->
                    <Border Background="#334155" CornerRadius="8" Padding="12,8" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock FontSize="12" Foreground="White" FontWeight="Medium">
                                <Run Text="{Binding NewJobCopies, Mode=OneWay}"/>
                                <Run Text=" copies" Foreground="#94A3B8"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    
                    <!-- Printers Display -->
                    <Border CornerRadius="8" Padding="12,8" Margin="0,0,16,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#334155"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedPrinters}" Value="True">
                                        <Setter Property="Background" Value="#14532D"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖨️" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock FontSize="12" Foreground="White" FontWeight="Medium">
                                <Run Text="{Binding SelectedPrintersCount, Mode=OneWay}"/>
                                <Run Text=" printers" Foreground="#94A3B8"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Settings summary chips -->
                    <Border Background="#334155" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                        <TextBlock FontSize="12" Foreground="#94A3B8">
                            <Run Text="{Binding PaperSize, Mode=OneWay}"/>
                            <Run Text=" •"/>
                        </TextBlock>
                    </Border>
                    <Border Background="#334155" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                        <TextBlock FontSize="12" Foreground="#94A3B8">
                            <Run Text="{Binding FitMode, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                    <Border Background="#334155" CornerRadius="8" Padding="12,8">
                        <TextBlock FontSize="12" Foreground="#94A3B8"
                                   Text="{Binding IsPortrait, Converter={StaticResource BoolToVis}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="▭"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPortrait}" Value="True">
                                            <Setter Property="Text" Value="▯"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>

                <!-- Presets Button -->
                <Button Grid.Column="1" Command="{Binding TogglePresetsCommand}"
                        Style="{StaticResource GhostButton}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="Presets" FontSize="13"/>
                    </StackPanel>
                </Button>

                <!-- Reset Button -->
                <Button Grid.Column="2" Command="{Binding ResetWorkspaceCommand}"
                        Style="{StaticResource GhostButton}" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="↺" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="Reset" FontSize="13"/>
                    </StackPanel>
                </Button>

                <!-- Print Button -->
                <Button Grid.Column="3" Command="{Binding SmartPrintCommand}"
                        IsEnabled="{Binding CanSmartPrint}" MinWidth="180">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                            <Setter Property="Background" Value="#22C55E"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#16A34A"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#475569"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🚀" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="{DynamicResource PrintExecution_StartPrinting}" 
                                   FontSize="15" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
        <!-- ═══════════════════════════════════════════════════════════════════
             🔔 IN-APP TOAST NOTIFICATION
             ═══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Grid.RowSpan="3"
                Panel.ZIndex="200"
                VerticalAlignment="Bottom" HorizontalAlignment="Right"
                Margin="0,0,32,100"
                MinWidth="300" MaxWidth="400"
                CornerRadius="12" Padding="16,14"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#14532D"/>
                    <Setter Property="BorderBrush" Value="#22C55E"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ToastIsSuccess}" Value="False">
                            <Setter Property="Background" Value="#450A0A"/>
                            <Setter Property="BorderBrush" Value="#EF4444"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding ToastMessage}"
                           FontSize="13" FontWeight="Medium" Foreground="White"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Command="{Binding DismissToastCommand}"
                        Style="{StaticResource GhostButton}" Padding="8,4" Margin="8,0,0,0">
                    <TextBlock Text="✕" FontSize="12" Foreground="#94A3B8"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
