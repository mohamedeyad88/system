<UserControl x:Class="Apex.UI.Views.TemplateDesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Apex.UI.Views"
             xmlns:converters="clr-namespace:Apex.UI.Converters"
             xmlns:svc="clr-namespace:Apex.UI.Services"
             FlowDirection="{Binding Source={x:Static svc:LocalizationService.Instance},
                                     Path=FlowDirection, Mode=OneWay}"
             Background="{DynamicResource Brush.Background}">

    <UserControl.Resources>

        <!-- ── Converter instances ───────────────────────────────────────── -->
        <BooleanToVisibilityConverter                        x:Key="BooleanToVisibilityConverter"/>
        <converters:StepVisibilityConverter                  x:Key="StepVisConv"/>
        <converters:StepBackgroundConverter                  x:Key="StepBgConv"/>
        <converters:NonEmptyStringToVisibilityConverter      x:Key="NonEmptyToVis"/>
        <converters:SlotDataTypeToArabicConverter            x:Key="DataTypeToArabic"/>
        <converters:HorizontalAlignToArabicConverter         x:Key="AlignToArabic"/>
        <converters:VerticalAlignToArabicConverter           x:Key="VAlignToArabic"/>
        <converters:ImageFitToArabicConverter                x:Key="ImageFitToArabic"/>

        <!-- ── Stepper button style ──────────────────────────────────────── -->
        <Style x:Key="StepBtn" TargetType="Button">
            <Setter Property="Foreground"      Value="{DynamicResource Brush.Text.Secondary}"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="Height"          Value="48"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Brush.Border.Light}"
                                BorderThickness="0,0,0,3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Brush.Surface}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Glyph that prefixes a toolbar button's label.
             Without the gap the two run together and read as a typo — "TText",
             "#Number", "DDate" — which is exactly what customers reported. -->
        <Style x:Key="BtnGlyph" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin"     Value="0,0,5,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="BtnLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ── Field-type toolbar button ─────────────────────────────────── -->
        <Style x:Key="FieldTypeBtn" TargetType="Button">
            <Setter Property="Height"          Value="28"/>
            <Setter Property="Padding"         Value="8,0"/>
            <Setter Property="Margin"          Value="0,0,4,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="{DynamicResource Brush.Slate.300}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{DynamicResource Brush.Surface.Elevated}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#6B6864"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Zoom button ──────────────────────────────────────────────────── -->
        <Style x:Key="ZoomBtn" TargetType="Button">
            <Setter Property="Width"           Value="28"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{DynamicResource Brush.Surface.Elevated}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#6B6864"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Shared styles ──────────────────────────────────────────────── -->

        <Style x:Key="DarkBox" TargetType="TextBox">
            <Setter Property="Background"       Value="{DynamicResource Brush.Background}"/>
            <Setter Property="Foreground"       Value="{DynamicResource Brush.Slate.200}"/>
            <Setter Property="BorderBrush"      Value="{DynamicResource Brush.Border.Light}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Padding"          Value="8,5"/>
            <Setter Property="Height"           Value="32"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="CaretBrush"       Value="White"/>
            <Setter Property="SelectionBrush"   Value="#0891B2"/>
        </Style>

        <!-- Inherits the global dark ComboBox ControlTemplate via BasedOn so the popup,
             arrow and item chrome stay dark; only surface colours are overridden here. -->
        <Style x:Key="DarkCombo" TargetType="ComboBox"
               BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Background"      Value="{DynamicResource Brush.Background}"/>
            <Setter Property="Foreground"      Value="{DynamicResource Brush.Slate.200}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Border.Light}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Slate.200}"/>
                        <Setter Property="Padding"    Value="10,5"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Elevated}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.Primary}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{DynamicResource Brush.Text.Secondary}"/>
            <Setter Property="FontSize"    Value="10"/>
            <Setter Property="Margin"      Value="0,0,0,3"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground"   Value="{DynamicResource Brush.Slate.300}"/>
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Margin"       Value="0,0,0,10"/>
        </Style>

        <!-- Blue primary button -->
        <ControlTemplate x:Key="BlueBtnTpl" TargetType="Button">
            <Border x:Name="b" Background="{DynamicResource Brush.Primary}" CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="b" Property="Background" Value="#0E7490"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="b" Property="Background" Value="#E6F3F6"/>
                    <Setter TargetName="b" Property="Opacity"    Value="0.6"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Green save button -->
        <ControlTemplate x:Key="GreenBtnTpl" TargetType="Button">
            <Border x:Name="b" Background="{DynamicResource Brush.Success.Dark}" CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="b" Property="Background" Value="#047857"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Red danger button -->
        <ControlTemplate x:Key="RedBtnTpl" TargetType="Button">
            <Border x:Name="b" Background="#B42318" CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="b" Property="Background" Value="#B91C1C"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Ghost icon button -->
        <ControlTemplate x:Key="GhostBtnTpl" TargetType="Button">
            <Border x:Name="b" Background="Transparent" CornerRadius="6"
                    BorderBrush="{DynamicResource Brush.Border.Light}" BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="b" Property="Background"   Value="{DynamicResource Brush.Surface}"/>
                    <Setter TargetName="b" Property="BorderBrush"  Value="{DynamicResource Brush.Border.Medium}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>   <!-- Header -->
            <RowDefinition Height="60"/>   <!-- Stepper -->
            <RowDefinition Height="*"/>    <!-- Content (Designer OR Smart Variables) -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════ HEADER ══════════════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border.Light}" BorderThickness="0,0,0,1">
            <!-- v2.0.9: proper 2-column Grid prevents title/buttons overlap in RTL -->
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>    <!-- Col 0: title  (RIGHT side in RTL) -->
                    <ColumnDefinition Width="Auto"/> <!-- Col 1: actions (LEFT side in RTL) -->
                </Grid.ColumnDefinitions>

                <!-- Title — col 0 = logical start = RIGHT in RTL -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <TextBlock Text="{DynamicResource TD_001}" Foreground="White"
                               FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <!-- Loading indicator -->
                    <Border Background="{DynamicResource Brush.Primary}" CornerRadius="4" Padding="8,3" Margin="8,0,0,0"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{DynamicResource TD_002}" Foreground="White" FontSize="11"/>
                    </Border>
                </StackPanel>

                <!-- Header actions — col 1 = logical end = LEFT in RTL
                     FlowDirection=LTR on the panel keeps button order (import, new, save) left-to-right -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            FlowDirection="LeftToRight"
                            VerticalAlignment="Center" Margin="0,0,0,0">
                    <Button x:Name="BtnImport" Height="34" Padding="12,0" Margin="0,0,6,0"
                            Cursor="Hand" Template="{StaticResource GhostBtnTpl}">
                        <TextBlock Text="{DynamicResource TD_003}" Foreground="{DynamicResource Brush.Slate.300}" FontSize="12"
                                   VerticalAlignment="Center"/>
                    </Button>
                    <Button Command="{Binding AddNewTemplateCommand}"
                            Height="34" Padding="14,0" Cursor="Hand"
                            Template="{StaticResource BlueBtnTpl}" Margin="0,0,6,0">
                        <TextBlock Text="{DynamicResource TD_004}" Foreground="White" FontSize="12"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Button>
                    <!-- Save button -->
                    <Button Command="{Binding SaveWithSmartDataCommand}"
                            Height="34" Padding="14,0" Cursor="Hand"
                            IsEnabled="{Binding HasTemplate}"
                            Template="{StaticResource GhostBtnTpl}">
                        <TextBlock Text="{DynamicResource TD_005}" Foreground="{DynamicResource Brush.Slate.300}" FontSize="12"
                                   VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════ STEPPER ══════════════════════ -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border.Light}" BorderThickness="0,0,0,1">
            <!-- ── New numbered-circle stepper ────────────────────────────────
                 Layout: one Grid row with alternating step/connector columns.
                 Each step column contains a Button whose template shows:
                   • A 28×28 circle (gray / blue-active / green-complete)
                   • A short label below the circle
                 Connector columns hold a 2×28 Rectangle that fills green
                 as the upstream step is completed.
            ─────────────────────────────────────────────────────────────── -->
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76"/> <!-- 0 -->
                    <ColumnDefinition Width="30"/> <!-- conn -->
                    <ColumnDefinition Width="76"/> <!-- 1 -->
                    <ColumnDefinition Width="30"/> <!-- conn -->
                    <ColumnDefinition Width="76"/> <!-- 2 -->
                    <ColumnDefinition Width="30"/> <!-- conn -->
                    <ColumnDefinition Width="76"/> <!-- 3 -->
                    <ColumnDefinition Width="30"/> <!-- conn -->
                    <ColumnDefinition Width="76"/> <!-- 4 -->
                    <ColumnDefinition Width="30"/> <!-- conn -->
                    <ColumnDefinition Width="76"/> <!-- 5 -->
                </Grid.ColumnDefinitions>

                <!-- ── Step 0: تصميم ─────────────────────── -->
                <Button Grid.Column="0"
                        Command="{Binding GoToStepCommand}" CommandParameter="0"
                        BorderThickness="0" Cursor="Hand" Padding="0" Background="Transparent">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <StackPanel HorizontalAlignment="Center">
                                <Border HorizontalAlignment="Center" Width="28" Height="28"
                                        CornerRadius="14" Margin="0,0,0,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background"      Value="{DynamicResource Brush.Background}"/>
                                            <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Border.Medium}"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveStep}" Value="0">
                                                    <Setter Property="Background"      Value="{DynamicResource Brush.Primary}"/>
                                                    <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Primary}"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Step0Complete}" Value="True">
                                                    <Setter Property="Background"      Value="{DynamicResource Brush.Success.Dark}"/>
                                                    <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Success.Dark}"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="11" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text"       Value="1"/>
                                                <Setter Property="Foreground"  Value="{DynamicResource Brush.Text.Tertiary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActiveStep}" Value="0">
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Step0Complete}" Value="True">
                                                        <Setter Property="Text"      Value="&#x2713;"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock HorizontalAlignment="Center" Text="{DynamicResource TD_006}" FontSize="10">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground"  Value="{DynamicResource Brush.Text.StepInactive}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveStep}" Value="0">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Slate.200}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Step0Complete}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Connector 0→1 -->
                <Rectangle Grid.Column="1" Height="2" VerticalAlignment="Center" Margin="0,-8,0,0">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="Fill" Value="{DynamicResource Brush.Surface.Elevated}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Step0Complete}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource Brush.Success.Dark}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>

                <!-- ── Step 1: لصق ──────────────────────── -->
                <Button Grid.Column="2"
                        Command="{Binding GoToStepCommand}" CommandParameter="1"
                        IsEnabled="{Binding HasTemplate}"
                        ToolTip="{DynamicResource TD_007}"
                        ToolTipService.ShowOnDisabled="True"
                        BorderThickness="0" Cursor="Hand" Padding="0" Background="Transparent">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <StackPanel HorizontalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnabled,
                                                         RelativeSource={RelativeSource AncestorType=Button}}"
                                                         Value="False">
                                                <Setter Property="Opacity" Value="0.4"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border HorizontalAlignment="Center" Width="28" Height="28"
                                        CornerRadius="14" Margin="0,0,0,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background"      Value="{DynamicResource Brush.Background}"/>
                                            <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Border.Medium}"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveStep}" Value="1">
                                                    <Setter Property="Background"      Value="{DynamicResource Brush.Primary}"/>
                                                    <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Primary}"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SmartVars.HasPastedData}" Value="True">
                                                    <Setter Property="Background"      Value="{DynamicResource Brush.Success.Dark}"/>
                                                    <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Success.Dark}"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="11" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text"       Value="2"/>
                                                <Setter Property="Foreground"  Value="{DynamicResource Brush.Text.Tertiary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActiveStep}" Value="1">
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SmartVars.HasPastedData}" Value="True">
                                                        <Setter Property="Text"      Value="&#x2713;"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock HorizontalAlignment="Center" Text="{DynamicResource TD_008}" FontSize="10">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground"  Value="{DynamicResource Brush.Text.StepInactive}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveStep}" Value="1">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Slate.200}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SmartVars.HasPastedData}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Connector 1→2 -->
                <Rectangle Grid.Column="3" Height="2" VerticalAlignment="Center" Margin="0,-8,0,0">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="Fill" Value="{DynamicResource Brush.Surface.Elevated}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SmartVars.HasPastedData}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource Brush.Success.Dark}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>

                <!-- ── Step 2: ربط ──────────────────────── -->
                <Button Grid.Column="4"
                        Command="{Binding GoToStepCommand}" CommandParameter="2"
                        IsEnabled="{Binding SmartVars.HasPastedData}"
                        ToolTip="{DynamicResource TD_009}"
                        ToolTipService.ShowOnDisabled="True"
                        BorderThickness="0" Cursor="Hand" Padding="0" Background="Transparent">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <StackPanel HorizontalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnabled,
                                                         RelativeSource={RelativeSource AncestorType=Button}}"
                                                         Value="False">
                                                <Setter Property="Opacity" Value="0.4"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border HorizontalAlignment="Center" Width="28" Height="28"
                                        CornerRadius="14" Margin="0,0,0,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background"      Value="{DynamicResource Brush.Background}"/>
                                            <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Border.Medium}"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveStep}" Value="2">
                                                    <Setter Property="Background"      Value="{DynamicResource Brush.Primary}"/>
                                                    <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Primary}"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ActiveStep}" Value="3">
                                                    <Setter Property="Background"      Value="{DynamicResource Brush.Success.Dark}"/>
                                                    <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Success.Dark}"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ActiveStep}" Value="4">
                                                    <Setter Property="Background"      Value="{DynamicResource Brush.Success.Dark}"/>
                                                    <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Success.Dark}"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ActiveStep}" Value="5">
                                                    <Setter Property="Background"      Value="{DynamicResource Brush.Success.Dark}"/>
                                                    <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Success.Dark}"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="11" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text"       Value="3"/>
                                                <Setter Property="Foreground"  Value="{DynamicResource Brush.Text.Tertiary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActiveStep}" Value="2">
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ActiveStep}" Value="3">
                                                        <Setter Property="Text"       Value="&#x2713;"/>
                                                        <Setter Property="Foreground"  Value="White"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ActiveStep}" Value="4">
                                                        <Setter Property="Text"       Value="&#x2713;"/>
                                                        <Setter Property="Foreground"  Value="White"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ActiveStep}" Value="5">
                                                        <Setter Property="Text"       Value="&#x2713;"/>
                                                        <Setter Property="Foreground"  Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock HorizontalAlignment="Center" Text="{DynamicResource TD_010}" FontSize="10">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground"  Value="{DynamicResource Brush.Text.StepInactive}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveStep}" Value="2">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Slate.200}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ActiveStep}" Value="3">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ActiveStep}" Value="4">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ActiveStep}" Value="5">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Connector 2→3 -->
                <Rectangle Grid.Column="5" Height="2" VerticalAlignment="Center" Margin="0,-8,0,0">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="Fill" Value="{DynamicResource Brush.Surface.Elevated}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveStep}" Value="3">
                                    <Setter Property="Fill" Value="{DynamicResource Brush.Success.Dark}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ActiveStep}" Value="4">
                                    <Setter Property="Fill" Value="{DynamicResource Brush.Success.Dark}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ActiveStep}" Value="5">
                                    <Setter Property="Fill" Value="{DynamicResource Brush.Success.Dark}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>

                <!-- ── Step 3: صور ──────────────────────── -->
                <Button Grid.Column="6"
                        Command="{Binding GoToStepCommand}" CommandParameter="3"
                        IsEnabled="{Binding SmartVars.HasPastedData}"
                        ToolTip="{DynamicResource TD_009}"
                        ToolTipService.ShowOnDisabled="True"
                        BorderThickness="0" Cursor="Hand" Padding="0" Background="Transparent">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <StackPanel HorizontalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnabled,
                                                         RelativeSource={RelativeSource AncestorType=Button}}"
                                                         Value="False">
                                                <Setter Property="Opacity" Value="0.4"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border HorizontalAlignment="Center" Width="28" Height="28"
                                        CornerRadius="14" Margin="0,0,0,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background"      Value="{DynamicResource Brush.Background}"/>
                                            <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Border.Medium}"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveStep}" Value="3">
                                                    <Setter Property="Background"      Value="{DynamicResource Brush.Primary}"/>
                                                    <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Primary}"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ActiveStep}" Value="4">
                                                    <Setter Property="Background"      Value="{DynamicResource Brush.Success.Dark}"/>
                                                    <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Success.Dark}"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ActiveStep}" Value="5">
                                                    <Setter Property="Background"      Value="{DynamicResource Brush.Success.Dark}"/>
                                                    <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Success.Dark}"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="11" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text"       Value="4"/>
                                                <Setter Property="Foreground"  Value="{DynamicResource Brush.Text.Tertiary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActiveStep}" Value="3">
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ActiveStep}" Value="4">
                                                        <Setter Property="Text"       Value="&#x2713;"/>
                                                        <Setter Property="Foreground"  Value="White"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ActiveStep}" Value="5">
                                                        <Setter Property="Text"       Value="&#x2713;"/>
                                                        <Setter Property="Foreground"  Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock HorizontalAlignment="Center" Text="{DynamicResource TD_011}" FontSize="10">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground"  Value="{DynamicResource Brush.Text.StepInactive}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveStep}" Value="3">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Slate.200}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ActiveStep}" Value="4">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ActiveStep}" Value="5">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Connector 3→4 -->
                <Rectangle Grid.Column="7" Height="2" VerticalAlignment="Center" Margin="0,-8,0,0">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="Fill" Value="{DynamicResource Brush.Surface.Elevated}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveStep}" Value="4">
                                    <Setter Property="Fill" Value="{DynamicResource Brush.Success.Dark}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ActiveStep}" Value="5">
                                    <Setter Property="Fill" Value="{DynamicResource Brush.Success.Dark}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>

                <!-- ── Step 4: معاينة ─────────────────────── -->
                <Button Grid.Column="8"
                        Command="{Binding GoToStepCommand}" CommandParameter="4"
                        IsEnabled="{Binding SmartVars.HasPastedData}"
                        ToolTip="{DynamicResource TD_012}"
                        ToolTipService.ShowOnDisabled="True"
                        BorderThickness="0" Cursor="Hand" Padding="0" Background="Transparent">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <StackPanel HorizontalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnabled,
                                                         RelativeSource={RelativeSource AncestorType=Button}}"
                                                         Value="False">
                                                <Setter Property="Opacity" Value="0.4"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border HorizontalAlignment="Center" Width="28" Height="28"
                                        CornerRadius="14" Margin="0,0,0,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background"      Value="{DynamicResource Brush.Background}"/>
                                            <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Border.Medium}"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveStep}" Value="4">
                                                    <Setter Property="Background"      Value="{DynamicResource Brush.Primary}"/>
                                                    <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Primary}"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ActiveStep}" Value="5">
                                                    <Setter Property="Background"      Value="{DynamicResource Brush.Success.Dark}"/>
                                                    <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Success.Dark}"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="11" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text"       Value="5"/>
                                                <Setter Property="Foreground"  Value="{DynamicResource Brush.Text.Tertiary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActiveStep}" Value="4">
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ActiveStep}" Value="5">
                                                        <Setter Property="Text"       Value="&#x2713;"/>
                                                        <Setter Property="Foreground"  Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock HorizontalAlignment="Center" Text="{DynamicResource TD_013}" FontSize="10">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground"  Value="{DynamicResource Brush.Text.StepInactive}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveStep}" Value="4">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Slate.200}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ActiveStep}" Value="5">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Connector 4→5 -->
                <Rectangle Grid.Column="9" Height="2" VerticalAlignment="Center" Margin="0,-8,0,0">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="Fill" Value="{DynamicResource Brush.Surface.Elevated}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveStep}" Value="5">
                                    <Setter Property="Fill" Value="{DynamicResource Brush.Success.Dark}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>

                <!-- ── Step 5: تصدير ─────────────────────── -->
                <Button Grid.Column="10"
                        Command="{Binding GoToStepCommand}" CommandParameter="5"
                        IsEnabled="{Binding SmartVars.HasPastedData}"
                        ToolTip="{DynamicResource TD_014}"
                        ToolTipService.ShowOnDisabled="True"
                        BorderThickness="0" Cursor="Hand" Padding="0" Background="Transparent">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <StackPanel HorizontalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnabled,
                                                         RelativeSource={RelativeSource AncestorType=Button}}"
                                                         Value="False">
                                                <Setter Property="Opacity" Value="0.4"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border HorizontalAlignment="Center" Width="28" Height="28"
                                        CornerRadius="14" Margin="0,0,0,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background"      Value="{DynamicResource Brush.Background}"/>
                                            <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Border.Medium}"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveStep}" Value="5">
                                                    <Setter Property="Background"      Value="{DynamicResource Brush.Primary}"/>
                                                    <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Primary}"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="11" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text"       Value="6"/>
                                                <Setter Property="Foreground"  Value="{DynamicResource Brush.Text.Tertiary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActiveStep}" Value="5">
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock HorizontalAlignment="Center" Text="{DynamicResource TD_015}" FontSize="10">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground"  Value="{DynamicResource Brush.Text.StepInactive}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveStep}" Value="5">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Slate.200}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </Grid>
        </Border>

        <!-- ══════════════════════ BODY (3 columns) — Step 0 only ═══════════ -->
        <Grid Grid.Row="2">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDesignStep}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- ─────────────── LEFT: Library ─────────────── -->
            <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border.Light}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Section title -->
                    <TextBlock Grid.Row="0" Text="{DynamicResource TD_016}" Foreground="White"
                               FontSize="13" FontWeight="SemiBold" Margin="14,14,14,8"/>

                    <!-- Search -->
                    <TextBox Grid.Row="1"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DarkBox}"
                             Height="32" Margin="10,0,10,6"
                             Tag="{DynamicResource TD_SearchTemplates}">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Border Background="{DynamicResource Brush.Background}" BorderBrush="{DynamicResource Brush.Border.Light}"
                                        BorderThickness="1" CornerRadius="6" Padding="8,0">
                                    <Grid>
                                        <TextBlock Text="{TemplateBinding Tag}"
                                                   Foreground="{DynamicResource Brush.Text.Disabled}" FontSize="11"
                                                   VerticalAlignment="Center" Margin="0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ScrollViewer x:Name="PART_ContentHost"
                                                      VerticalAlignment="Center"
                                                      Foreground="{DynamicResource Brush.Slate.200}" FontSize="12"/>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>

                    <!-- Category filter -->
                    <ComboBox Grid.Row="2"
                              ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory}"
                              Style="{StaticResource DarkCombo}"
                              Margin="10,0,10,8"/>

                    <!-- Template list -->
                    <ListBox Grid.Row="3"
                             ItemsSource="{Binding Templates}"
                             SelectedItem="{Binding SelectedEntry}"
                             Background="Transparent" BorderThickness="0"
                             Margin="6,0,6,4"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <StackPanel>
                                        <!-- Template name -->
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.Slate.200}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <!-- Meta row: category · pages · date -->
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <Border Background="#E6F3F6" CornerRadius="3"
                                                    Padding="5,1">
                                                <TextBlock Text="{Binding Category}"
                                                           Foreground="#0E7490" FontSize="9"/>
                                            </Border>
                                            <TextBlock Text="{Binding PageCount, StringFormat=' · {0} ص'}"
                                                       Foreground="{DynamicResource Brush.Text.Disabled}" FontSize="9"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ModifiedAt, StringFormat=' · {0:dd/MM/yy}'}"
                                                       Foreground="#6B6864" FontSize="9"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="b" Background="Transparent"
                                                    CornerRadius="6" Margin="0,1"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource Brush.Surface.Elevated}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="#E6F3F6"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- Library actions -->
                    <Grid Grid.Row="4" Margin="8,4,8,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Command="{Binding DuplicateTemplateCommand}"
                                Height="30" Cursor="Hand"
                                Template="{StaticResource GhostBtnTpl}" Padding="4,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⧉" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource TD_017}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2"
                                Command="{Binding DeleteTemplateCommand}"
                                Height="30" Cursor="Hand"
                                Template="{StaticResource RedBtnTpl}" Padding="8,0"
                                ToolTip="{DynamicResource TD_DelTemplateTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗑️" Style="{StaticResource BtnGlyph}"/>
                                <TextBlock Text="{DynamicResource TD_DelTemplate}"
                                           Foreground="White" Style="{StaticResource BtnLabel}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- ─────────────── CENTER: Canvas ─────────────── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Canvas toolbar (hidden when no template) -->
                <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border.Light}" BorderThickness="0,0,0,1"
                        Padding="12,8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasTemplate}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <WrapPanel Orientation="Horizontal">

                        <!-- Page size preset -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                            <TextBlock Text="{DynamicResource TD_019}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox ItemsSource="{Binding PageSizePresets}"
                                      SelectedItem="{Binding SelectedPageSize}"
                                      Style="{StaticResource DarkCombo}"
                                      Width="110" Height="30"/>

                            <!-- Custom width × height (shown only when "مخصص" is selected) -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        Margin="6,0,0,0"
                                        Visibility="{Binding IsCustomPageSize, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBox Text="{Binding CustomWidthMm, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DarkBox}" Width="52" Height="30"
                                         ToolTip="{DynamicResource TD_020}"/>
                                <TextBlock Text="×" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="13"
                                           VerticalAlignment="Center" Margin="4,0"/>
                                <TextBox Text="{Binding CustomHeightMm, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DarkBox}" Width="52" Height="30"
                                         ToolTip="{DynamicResource TD_021}"/>
                                <TextBlock Text="{DynamicResource TD_022}" Foreground="{DynamicResource Brush.Text.Disabled}" FontSize="10"
                                           VerticalAlignment="Center" Margin="3,0,0,0"/>
                            </StackPanel>

                            <Button Command="{Binding ApplyPageSizeCommand}"
                                    Height="30" Padding="8,0" Margin="4,0,0,0"
                                    Cursor="Hand" Template="{StaticResource GhostBtnTpl}">
                                <TextBlock Text="{DynamicResource TD_023}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11"/>
                            </Button>
                        </StackPanel>

                        <!-- Separator -->
                        <Border Width="1" Height="20" Background="{DynamicResource Brush.Surface.Elevated}"
                                VerticalAlignment="Center" Margin="4,0"/>

                        <!-- Background upload -->
                        <Button x:Name="BtnUploadBg" Height="30" Padding="10,0" Margin="6,0,4,0"
                                Cursor="Hand" Template="{StaticResource GhostBtnTpl}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖼️" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource TD_024}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RemoveBackgroundCommand}"
                                Height="30" Padding="8,0" Margin="0,0,6,0"
                                Cursor="Hand" Template="{StaticResource GhostBtnTpl}">
                            <TextBlock Text="{DynamicResource TD_025}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="11"/>
                        </Button>

                        <!-- Separator -->
                        <Border Width="1" Height="20" Background="{DynamicResource Brush.Surface.Elevated}"
                                VerticalAlignment="Center" Margin="4,0"/>

                        <!-- Add / Delete slot (generic) -->
                        <Button Command="{Binding AddSlotCommand}"
                                Height="30" Padding="10,0" Margin="6,0,4,0"
                                Cursor="Hand" Template="{StaticResource BlueBtnTpl}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="➕" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource TD_026}" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DeleteSlotCommand}"
                                Height="30" Padding="8,0" Margin="0,0,4,0"
                                Cursor="Hand" Template="{StaticResource GhostBtnTpl}"
                                ToolTip="{DynamicResource TD_DelFieldTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗑️" Style="{StaticResource BtnGlyph}"/>
                                <TextBlock Text="{DynamicResource TD_DelField}"
                                           Foreground="{DynamicResource Brush.Error}"
                                           Style="{StaticResource BtnLabel}"/>
                            </StackPanel>
                        </Button>

                        <!-- Separator -->
                        <Border Width="1" Height="20" Background="{DynamicResource Brush.Surface.Elevated}"
                                VerticalAlignment="Center" Margin="4,0"/>

                        <!-- ── Field-type toolbar ─────────────────────────────────────────
                             Each button adds a slot of the matching type directly to canvas.
                             typeStr maps to SlotDataType enum names in AddFieldOfTypeCommand.
                        ── -->
                        <TextBlock Text="{DynamicResource TD_027}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="11"
                                   VerticalAlignment="Center" Margin="6,0,6,0"/>

                        <Button Command="{Binding AddFieldOfTypeCommand}" CommandParameter="Text"
                                Style="{StaticResource FieldTypeBtn}" ToolTip="{DynamicResource TD_028}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource TD_029}" Foreground="#0891B2" Style="{StaticResource BtnGlyph}"/>
                                <TextBlock Text="{DynamicResource TD_030}" Style="{StaticResource BtnLabel}"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding AddFieldOfTypeCommand}" CommandParameter="Number"
                                Style="{StaticResource FieldTypeBtn}" ToolTip="{DynamicResource TD_031}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="#" Foreground="{DynamicResource Brush.Success}" Style="{StaticResource BtnGlyph}"/>
                                <TextBlock Text="{DynamicResource TD_032}" Style="{StaticResource BtnLabel}"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding AddFieldOfTypeCommand}" CommandParameter="Date"
                                Style="{StaticResource FieldTypeBtn}" ToolTip="{DynamicResource TD_033}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource TD_034}" Foreground="{DynamicResource Brush.Warning}" Style="{StaticResource BtnGlyph}"/>
                                <TextBlock Text="{DynamicResource TD_035}" Style="{StaticResource BtnLabel}"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding AddFieldOfTypeCommand}" CommandParameter="Image"
                                Style="{StaticResource FieldTypeBtn}" ToolTip="{DynamicResource TD_036}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource TD_037}" Foreground="#0891B2" Style="{StaticResource BtnGlyph}"/>
                                <TextBlock Text="{DynamicResource TD_038}" Style="{StaticResource BtnLabel}"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding AddFieldOfTypeCommand}" CommandParameter="QrCode"
                                Style="{StaticResource FieldTypeBtn}" ToolTip="{DynamicResource TD_039}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="QR" Foreground="{DynamicResource Brush.Error}" FontWeight="Bold" FontSize="11"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding AddFieldOfTypeCommand}" CommandParameter="Barcode"
                                Style="{StaticResource FieldTypeBtn}" ToolTip="{DynamicResource TD_040}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▌▌" Foreground="{DynamicResource Brush.Error}" Style="{StaticResource BtnGlyph}"/>
                                <TextBlock Text="{DynamicResource TD_041}" Style="{StaticResource BtnLabel}"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding AddFieldOfTypeCommand}" CommandParameter="Counter"
                                Style="{StaticResource FieldTypeBtn}" ToolTip="{DynamicResource TD_042}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource TD_043}" Foreground="#0891B2" Style="{StaticResource BtnGlyph}"/>
                                <TextBlock Text="{DynamicResource TD_044}" Style="{StaticResource BtnLabel}"/>
                            </StackPanel>
                        </Button>

                        <!-- Separator -->
                        <Border Width="1" Height="20" Background="{DynamicResource Brush.Surface.Elevated}"
                                VerticalAlignment="Center" Margin="6,0"/>

                        <!-- ── Zoom controls ──────────────────────────────────── -->
                        <TextBlock Text="{DynamicResource TD_045}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="11"
                                   VerticalAlignment="Center" Margin="4,0,6,0"/>
                        <Button Command="{Binding ZoomOutCommand}"
                                Style="{StaticResource ZoomBtn}" Margin="0,0,3,0"
                                ToolTip="{DynamicResource TD_046}">
                            <TextBlock Text="&#x2212;" Foreground="{DynamicResource Brush.Slate.300}" FontSize="14" FontWeight="Bold"/>
                        </Button>
                        <Border Background="{DynamicResource Brush.Background}" BorderBrush="{DynamicResource Brush.Border.Light}" BorderThickness="1"
                                CornerRadius="4" Padding="8,0" Height="28" Margin="0,0,3,0"
                                ToolTip="{Binding ZoomBoostLabel}">
                            <TextBlock Text="{Binding ZoomBoostLabel}" Foreground="{DynamicResource Brush.Slate.200}"
                                       FontSize="11" VerticalAlignment="Center"
                                       MinWidth="36" TextAlignment="Center"/>
                        </Border>
                        <Button Command="{Binding ZoomInCommand}"
                                Style="{StaticResource ZoomBtn}" Margin="0,0,3,0"
                                ToolTip="{DynamicResource TD_047}">
                            <TextBlock Text="+" Foreground="{DynamicResource Brush.Slate.300}" FontSize="14" FontWeight="Bold"/>
                        </Button>
                        <Button Click="BtnFit_Click"
                                Height="28" Padding="8,0" Cursor="Hand"
                                Template="{StaticResource GhostBtnTpl}"
                                ToolTip="{DynamicResource TD_048}">
                            <TextBlock Text="{DynamicResource TD_049}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11"/>
                        </Button>

                        <!-- Separator -->
                        <Border Width="1" Height="20" Background="{DynamicResource Brush.Surface.Elevated}"
                                VerticalAlignment="Center" Margin="6,0"/>

                        <!-- Undo / Redo -->
                        <Button Command="{Binding UndoCommand}"
                                Style="{StaticResource ZoomBtn}" Margin="0,0,3,0"
                                ToolTip="{DynamicResource TD_050}" IsEnabled="{Binding CanUndo}">
                            <TextBlock Text="↩" Foreground="{DynamicResource Brush.Slate.300}" FontSize="14"/>
                        </Button>
                        <Button Command="{Binding RedoCommand}"
                                Style="{StaticResource ZoomBtn}" Margin="0,0,3,0"
                                ToolTip="{DynamicResource TD_051}" IsEnabled="{Binding CanRedo}">
                            <TextBlock Text="↪" Foreground="{DynamicResource Brush.Slate.300}" FontSize="14"/>
                        </Button>

                        <!-- Separator -->
                        <Border Width="1" Height="20" Background="{DynamicResource Brush.Surface.Elevated}"
                                VerticalAlignment="Center" Margin="6,0"/>

                        <!-- Grid snap -->
                        <CheckBox IsChecked="{Binding IsSnapEnabled}"
                                  Foreground="{DynamicResource Brush.Slate.300}" FontSize="11"
                                  Content="{DynamicResource TD_052}" Margin="0,0,4,0"
                                  VerticalAlignment="Center"
                                  ToolTip="{DynamicResource TD_053}"/>
                        <TextBox Text="{Binding GridSizeMm, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkBox}"
                                 Width="40" Height="28"
                                 ToolTip="{DynamicResource TD_054}"
                                 Visibility="{Binding IsSnapEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="{DynamicResource TD_022}" Foreground="{DynamicResource Brush.Text.Disabled}" FontSize="10"
                                   VerticalAlignment="Center" Margin="3,0,0,0"
                                   Visibility="{Binding IsSnapEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <!-- ── Alignment toolbar (visible when multi-select) ──── -->
                        <Border Width="1" Height="20" Background="{DynamicResource Brush.Surface.Elevated}"
                                VerticalAlignment="Center" Margin="6,0"
                                Visibility="{Binding HasMultiSelection, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding HasMultiSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{DynamicResource TD_055}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,5,0"/>

                            <Button Command="{Binding AlignSlotsLeftCommand}"
                                    Style="{StaticResource ZoomBtn}" Margin="0,0,2,0"
                                    ToolTip="{DynamicResource TD_056}">
                                <TextBlock Text="⫷" Foreground="{DynamicResource Brush.Slate.300}" FontSize="13"/>
                            </Button>
                            <Button Command="{Binding AlignSlotsCenterHCommand}"
                                    Style="{StaticResource ZoomBtn}" Margin="0,0,2,0"
                                    ToolTip="{DynamicResource TD_057}">
                                <TextBlock Text="⫼" Foreground="{DynamicResource Brush.Slate.300}" FontSize="13"/>
                            </Button>
                            <Button Command="{Binding AlignSlotsRightCommand}"
                                    Style="{StaticResource ZoomBtn}" Margin="0,0,2,0"
                                    ToolTip="{DynamicResource TD_058}">
                                <TextBlock Text="⫸" Foreground="{DynamicResource Brush.Slate.300}" FontSize="13"/>
                            </Button>
                            <Button Command="{Binding AlignSlotsTopCommand}"
                                    Style="{StaticResource ZoomBtn}" Margin="0,0,2,0"
                                    ToolTip="{DynamicResource TD_059}">
                                <TextBlock Text="⏶" Foreground="{DynamicResource Brush.Slate.300}" FontSize="13"/>
                            </Button>
                            <Button Command="{Binding AlignSlotsCenterVCommand}"
                                    Style="{StaticResource ZoomBtn}" Margin="0,0,2,0"
                                    ToolTip="{DynamicResource TD_060}">
                                <TextBlock Text="⏸" Foreground="{DynamicResource Brush.Slate.300}" FontSize="13" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform><RotateTransform Angle="90"/></TextBlock.RenderTransform>
                                </TextBlock>
                            </Button>
                            <Button Command="{Binding AlignSlotsBottomCommand}"
                                    Style="{StaticResource ZoomBtn}" Margin="0,0,2,0"
                                    ToolTip="{DynamicResource TD_061}">
                                <TextBlock Text="⏷" Foreground="{DynamicResource Brush.Slate.300}" FontSize="13"/>
                            </Button>

                            <Border Width="1" Height="16" Background="{DynamicResource Brush.Surface.Elevated}"
                                    VerticalAlignment="Center" Margin="4,0"/>

                            <Button Command="{Binding DistributeSlotsHCommand}"
                                    Style="{StaticResource ZoomBtn}" Margin="0,0,2,0"
                                    ToolTip="{DynamicResource TD_062}">
                                <TextBlock Text="⫦" Foreground="#38BDF8" FontSize="13"/>
                            </Button>
                            <Button Command="{Binding DistributeSlotsVCommand}"
                                    Style="{StaticResource ZoomBtn}" Margin="0,0,2,0"
                                    ToolTip="{DynamicResource TD_063}">
                                <TextBlock Text="⫩" Foreground="#38BDF8" FontSize="13"/>
                            </Button>
                        </StackPanel>

                    </WrapPanel>
                </Border>

                <!-- Canvas area -->
                <ScrollViewer Grid.Row="1"
                              x:Name="CanvasScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Background="{DynamicResource Brush.Background}"
                              PreviewMouseWheel="CanvasScrollViewer_PreviewMouseWheel">
                  <Grid>

                    <!-- Empty state -->
                    <TextBlock Text="{DynamicResource TD_064}"
                               FlowDirection="LeftToRight"
                               Foreground="#6B6864" FontSize="15"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="0,80,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasTemplate}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Page Viewbox (only when template loaded).
                         VerticalAlignment must be Stretch: with Top the Viewbox is
                         measured against its content's own size instead of the space
                         available, so Stretch="Uniform" had nothing to scale to and
                         the artboard sat at natural size in the middle of a large
                         empty canvas. It also made the neighbouring comment untrue —
                         ZoomBoost 1.0 was 100%, not fit-to-window. -->
                    <Viewbox Stretch="Uniform" Margin="24"
                             HorizontalAlignment="Center" VerticalAlignment="Stretch">
                        <Viewbox.Style>
                            <Style TargetType="Viewbox">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasTemplate}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Viewbox.Style>

                        <!-- Page surface -->
                        <Grid Width="{Binding CanvasWidthDip}"
                              Height="{Binding CanvasHeightDip}">

                            <!-- Zoom: applied via LayoutTransform so the Viewbox
                                 fit-scaling and user zoom stack independently.
                                 ZoomBoost=1.0 = fit-to-window; 1.25 = 25% larger, etc. -->
                            <Grid.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding ZoomBoost}"
                                                ScaleY="{Binding ZoomBoost}"/>
                            </Grid.LayoutTransform>

                            <!-- Drop shadow -->
                            <Grid.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.5"
                                                  BlurRadius="20" ShadowDepth="4"
                                                  Direction="315"/>
                            </Grid.Effect>

                            <!-- White page background -->
                            <Border Background="White"/>

                            <!-- Background image (if set) -->
                            <Image Source="{Binding BackgroundSource}"
                                   Stretch="Fill"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"/>

                            <!-- Slots canvas (ListBox with Canvas panel)
                                 x:Name="SlotsListBox" used by code-behind drag handler. -->
                            <ListBox x:Name="SlotsListBox"
                                     ItemsSource="{Binding CanvasSlots}"
                                     SelectedItem="{Binding SelectedCanvasSlot, Mode=TwoWay}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Width="{Binding CanvasWidthDip,
                                             RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Height="{Binding CanvasHeightDip,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     PreviewMouseLeftButtonDown="SlotsListBox_PreviewMouseLeftButtonDown"
                                     MouseMove="SlotsListBox_MouseMove"
                                     MouseLeftButtonUp="SlotsListBox_MouseLeftButtonUp"
                                     LostMouseCapture="SlotsListBox_LostMouseCapture">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Width="{Binding DataContext.CanvasWidthDip,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Height="{Binding DataContext.CanvasHeightDip,
                                                         RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Canvas.Left"  Value="{Binding Left}"/>
                                        <Setter Property="Canvas.Top"   Value="{Binding Top}"/>
                                        <Setter Property="Width"        Value="{Binding Width}"/>
                                        <Setter Property="Height"       Value="{Binding Height}"/>
                                        <Setter Property="Padding"      Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="slotBorder"
                                                            BorderBrush="{Binding BorderColor}"
                                                            BorderThickness="1.5"
                                                            Background="{Binding FillColor}"
                                                            Opacity="{Binding OpacityValue}"
                                                            RenderTransformOrigin="0.5,0.5"
                                                            Cursor="SizeAll">
                                                        <Border.RenderTransform>
                                                            <RotateTransform Angle="{Binding RotationAngle}"/>
                                                        </Border.RenderTransform>
                                                        <Grid Margin="2,1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <!-- Type badge -->
                                                            <Border Grid.Column="0"
                                                                    Background="{Binding BorderColor}"
                                                                    CornerRadius="2"
                                                                    Padding="3,1" Margin="0,0,3,0"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding TypeTag}"
                                                                           FontSize="7"
                                                                           Foreground="White"
                                                                           FontWeight="Bold"/>
                                                            </Border>
                                                            <!-- Slot name -->
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Label}"
                                                                       FontSize="8"
                                                                       Foreground="#14181D"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="slotBorder" Property="BorderThickness" Value="2"/>
                                                            <Setter TargetName="slotBorder" Property="BorderBrush"     Value="{DynamicResource Brush.Warning}"/>
                                                            <Setter TargetName="slotBorder" Property="Background"      Value="#33F59E0B"/>
                                                        </Trigger>
                                                        <!-- Multi-select: sky-blue dashed border -->
                                                        <DataTrigger Binding="{Binding IsMultiSelected}" Value="True">
                                                            <Setter TargetName="slotBorder" Property="BorderThickness" Value="2"/>
                                                            <Setter TargetName="slotBorder" Property="BorderBrush"     Value="#38BDF8"/>
                                                            <Setter TargetName="slotBorder" Property="Background"      Value="#1938BDF8"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="slotBorder" Property="BorderThickness" Value="2"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <!-- No items placeholder -->
                                <ListBox.Template>
                                    <ControlTemplate TargetType="ListBox">
                                        <Grid>
                                            <ItemsPresenter/>
                                            <TextBlock Text="{DynamicResource TD_065}"
                                                       Foreground="#14181D33" FontSize="10"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanvasSlots.Count,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                         Value="0">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </ControlTemplate>
                                </ListBox.Template>
                            </ListBox>

                            <!-- Resize handles overlay — code-behind places 8 Border handles here.
                                 Lives on top of SlotsListBox in the same page Grid so it shares
                                 the same coordinate space (page-pts) as the slots.
                                 IMPORTANT: Background must NOT be set (leave null / default).
                                 A "Transparent" SolidColorBrush makes the Canvas absorb all mouse
                                 events and blocks the SlotsListBox drag handlers below.
                                 With null background the Canvas passes through hits to SlotsListBox
                                 while its white-background Border children (the handles) still
                                 receive mouse events normally. -->
                            <Canvas x:Name="ResizeHandleCanvas"
                                    Width="{Binding CanvasWidthDip,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Height="{Binding CanvasHeightDip,
                                             RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </Grid>
                    </Viewbox>
                  </Grid>
                </ScrollViewer>

                <!-- Page navigation (hidden when no template loaded) -->
                <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border.Light}" BorderThickness="0,1,0,0"
                        Padding="16,8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasTemplate}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Canvas status -->
                            <RowDefinition Height="Auto"/> <!-- Page nav      -->
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Canvas status (spans full width, row 0) -->
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                                   Text="{Binding CanvasStatusText}"
                                   Foreground="{DynamicResource Brush.Text.Disabled}" FontSize="10"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,5"/>

                        <!-- Page navigation (row 1) — prev | counter | next | + | × -->
                        <Button Grid.Row="1" Grid.Column="0"
                                Command="{Binding PreviousPageCommand}"
                                Width="30" Height="30" Cursor="Hand"
                                Template="{StaticResource GhostBtnTpl}" Padding="0">
                            <TextBlock Text="▶" Foreground="White" FontSize="11"/>
                        </Button>
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="12">
                            <Run Text="{DynamicResource TD_066}"/>
                            <Run Text="{Binding CurrentPageDisplayIndex, Mode=OneWay}"
                                 Foreground="{DynamicResource Brush.Slate.300}" FontWeight="SemiBold"/>
                            <Run Text="{DynamicResource TD_067}"/>
                            <Run Text="{Binding TotalPages, Mode=OneWay}"
                                 Foreground="{DynamicResource Brush.Slate.300}" FontWeight="SemiBold"/>
                        </TextBlock>
                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal">
                            <Button Command="{Binding NextPageCommand}"
                                    Width="30" Height="30" Cursor="Hand"
                                    Template="{StaticResource GhostBtnTpl}" Padding="0">
                                <TextBlock Text="◀" Foreground="White" FontSize="11"/>
                            </Button>
                            <Button Command="{Binding AddPageCommand}"
                                    Width="28" Height="28" Cursor="Hand" Margin="4,0,0,0"
                                    Template="{StaticResource GhostBtnTpl}" Padding="0"
                                    ToolTip="{DynamicResource TD_068}">
                                <TextBlock Text="+" Foreground="#1B7F4C" FontSize="15" FontWeight="Bold"/>
                            </Button>
                            <Button Command="{Binding DeletePageCommand}"
                                    Width="28" Height="28" Cursor="Hand" Margin="2,0,0,0"
                                    Template="{StaticResource GhostBtnTpl}" Padding="0"
                                    ToolTip="{DynamicResource TD_069}"
                                    IsEnabled="{Binding HasTemplate}">
                                <TextBlock Text="×" Foreground="{DynamicResource Brush.Error}" FontSize="15" FontWeight="Bold"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ─────────────── RIGHT: Properties ─────────────── -->
            <Border Grid.Column="2" Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border.Light}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- No template placeholder -->
                    <TextBlock Grid.Row="0"
                               Text="{DynamicResource TD_070}"
                               Foreground="#6B6864" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasTemplate}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Properties panel (shown when HasTemplate) -->
                    <ScrollViewer Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="14,12,14,8">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasTemplate}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel>

                            <!-- ┄┄ Section: Template metadata ┄┄ -->
                            <Border Background="{DynamicResource Brush.Background}" CornerRadius="8"
                                    Padding="12,10" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource TD_071}" Style="{StaticResource SectionTitle}"/>

                                    <TextBlock Text="{DynamicResource TD_072}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding EditTemplateName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DarkBox}" Margin="0,0,0,8"/>

                                    <TextBlock Text="{DynamicResource TD_073}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding EditTemplateCategory, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DarkBox}" Margin="0,0,0,8"/>

                                    <TextBlock Text="{DynamicResource TD_074}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding EditTemplateDescription, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DarkBox}"
                                             Height="56" TextWrapping="Wrap"
                                             AcceptsReturn="True" Margin="0,0,0,8"/>

                                    <TextBlock Text="{DynamicResource TD_075}"
                                               Foreground="{DynamicResource Brush.Text.Disabled}" FontSize="10"
                                               FontStyle="Italic" HorizontalAlignment="Center"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- ┄┄ Section: Slot editor ┄┄ -->
                            <Border Background="{DynamicResource Brush.Background}" CornerRadius="8"
                                    Padding="12,10" Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="{DynamicResource TD_076}" Style="{StaticResource SectionTitle}"
                                                   Margin="0" VerticalAlignment="Center"/>
                                        <Border Background="{DynamicResource Brush.Surface.Elevated}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource TD_077}" Foreground="{DynamicResource Brush.Text.Disabled}" FontSize="9">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasSlot}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>

                                    <!-- Slot form (only when HasSlot) -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasSlot}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <!-- Name + Variable -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{DynamicResource TD_078}" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Text="{Binding SlotName, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource DarkBox}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{DynamicResource TD_079}" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Text="{Binding SlotVariableName, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource DarkBox}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Data type -->
                                        <TextBlock Text="{DynamicResource TD_080}" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox ItemsSource="{Binding AvailableDataTypes}"
                                                  SelectedItem="{Binding SlotDataType}"
                                                  Style="{StaticResource DarkCombo}"
                                                  Margin="0,0,0,8">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource DataTypeToArabic}}"
                                                               FontSize="12" Foreground="{DynamicResource Brush.Slate.200}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <!-- Position X, Y -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{DynamicResource TD_081}" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Text="{Binding SlotX, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource DarkBox}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{DynamicResource TD_082}" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Text="{Binding SlotY, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource DarkBox}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Size W, H -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{DynamicResource TD_020}" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Text="{Binding SlotW, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource DarkBox}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{DynamicResource TD_021}" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Text="{Binding SlotH, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource DarkBox}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- ── Text-specific properties (hidden for Image / QR / Barcode) ── -->
                                        <StackPanel Visibility="{Binding IsTextLikeSlot,
                                                                 Converter={StaticResource BooleanToVisibilityConverter}}">

                                            <!-- Font + Size -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="70"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{DynamicResource TD_083}" Style="{StaticResource FieldLabel}"/>
                                                    <ComboBox ItemsSource="{Binding AvailableFonts}"
                                                              SelectedItem="{Binding SlotFontName}"
                                                              Style="{StaticResource DarkCombo}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{DynamicResource TD_084}" Style="{StaticResource FieldLabel}"/>
                                                    <TextBox Text="{Binding SlotFontSize, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource DarkBox}"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Checkboxes row -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <CheckBox IsChecked="{Binding SlotIsBold}"
                                                          Foreground="{DynamicResource Brush.Slate.300}" FontSize="11"
                                                          Content="{DynamicResource TD_085}" Margin="0,0,12,0"/>
                                                <CheckBox IsChecked="{Binding SlotIsItalic}"
                                                          Foreground="{DynamicResource Brush.Slate.300}" FontSize="11"
                                                          Content="{DynamicResource TD_086}" Margin="0,0,12,0"/>
                                                <CheckBox IsChecked="{Binding SlotIsRtl}"
                                                          Foreground="{DynamicResource Brush.Slate.300}" FontSize="11"
                                                          Content="{DynamicResource TD_087}"/>
                                            </StackPanel>

                                            <!-- Alignment + Color -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{DynamicResource TD_088}" Style="{StaticResource FieldLabel}"/>
                                                    <ComboBox ItemsSource="{Binding AvailableAlignments}"
                                                              SelectedItem="{Binding SlotTextAlign}"
                                                              Style="{StaticResource DarkCombo}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Converter={StaticResource AlignToArabic}}"
                                                                           FontSize="12" Foreground="{DynamicResource Brush.Slate.200}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{DynamicResource TD_089}" Style="{StaticResource FieldLabel}"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="30"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0"
                                                                 Text="{Binding SlotTextColor, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource DarkBox}"/>
                                                        <Border Grid.Column="1" CornerRadius="4" Margin="4,0,0,0"
                                                                Background="{Binding SlotTextColor}"
                                                                BorderBrush="{DynamicResource Brush.Border.Light}" BorderThickness="1"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Text color presets -->
                                            <TextBlock Text="{DynamicResource TD_090}" Style="{StaticResource FieldLabel}" Margin="0,4,0,2"/>
                                            <ItemsControl ItemsSource="{Binding PresetColors}" Margin="0,0,0,8">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Width="18" Height="18" Margin="1" Cursor="Hand"
                                                                BorderThickness="0"
                                                                Command="{Binding DataContext.SetTextColorPresetCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="cb" Background="{Binding}"
                                                                            CornerRadius="3"
                                                                            BorderBrush="{DynamicResource Brush.Border.Light}" BorderThickness="1">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Style.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}"/>
                                                                                        <Setter Property="BorderThickness" Value="2"/>
                                                                                    </Trigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Format string -->
                                            <TextBlock Text="{DynamicResource TD_091}"
                                                       Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding SlotFormatString, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource DarkBox}" Margin="0,0,0,8"/>

                                            <!-- Vertical align -->
                                            <TextBlock Text="{DynamicResource TD_092}" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox ItemsSource="{Binding AvailableVerticalAlignments}"
                                                      SelectedItem="{Binding SlotVerticalAlign}"
                                                      Style="{StaticResource DarkCombo}"
                                                      Margin="0,0,0,8">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource VAlignToArabic}}"
                                                                   FontSize="12" Foreground="{DynamicResource Brush.Slate.200}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                        </StackPanel>
                                        <!-- ── / Text-specific properties ── -->

                                        <!-- Appearance: Rotation + Opacity + Background (all types) -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Rotation -->
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{DynamicResource TD_093}" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Text="{Binding SlotRotation, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource DarkBox}"/>
                                            </StackPanel>
                                            <!-- Opacity -->
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{DynamicResource TD_094}" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Text="{Binding SlotOpacity, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:F2}'}"
                                                         Style="{StaticResource DarkBox}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Background colour -->
                                        <TextBlock Text="{DynamicResource TD_095}"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="30"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding SlotBgColor, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource DarkBox}"/>
                                            <Border Grid.Column="1" CornerRadius="4" Margin="4,0,0,0"
                                                    Background="{Binding SlotBgColor}"
                                                    BorderBrush="{DynamicResource Brush.Border.Light}" BorderThickness="1"/>
                                        </Grid>

                                        <!-- Background color presets -->
                                        <TextBlock Text="{DynamicResource TD_096}" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                                        <ItemsControl ItemsSource="{Binding PresetColors}" Margin="0,0,0,8">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Width="18" Height="18" Margin="1" Cursor="Hand"
                                                            BorderThickness="0"
                                                            Command="{Binding DataContext.SetBgColorPresetCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{Binding}"
                                                                        CornerRadius="3"
                                                                        BorderBrush="{DynamicResource Brush.Border.Light}" BorderThickness="1">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Style.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}"/>
                                                                                    <Setter Property="BorderThickness" Value="2"/>
                                                                                </Trigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Image fit mode (shown only for Image type) -->
                                        <StackPanel Visibility="{Binding IsImageSlot,
                                                                 Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Margin="0,0,0,8">
                                            <TextBlock Text="{DynamicResource TD_097}" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox ItemsSource="{Binding AvailableImageFitModes}"
                                                      SelectedItem="{Binding SlotImageFitMode}"
                                                      Style="{StaticResource DarkCombo}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource ImageFitToArabic}}"
                                                                   FontSize="12" Foreground="{DynamicResource Brush.Slate.200}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Required flag (all types) -->
                                        <CheckBox IsChecked="{Binding SlotRequired}"
                                                  Foreground="{DynamicResource Brush.Slate.300}" FontSize="11"
                                                  Content="{DynamicResource TD_098}"
                                                  Margin="0,0,0,8"/>

                                        <!-- Default value (all types) -->
                                        <TextBlock Text="{DynamicResource TD_099}" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding SlotContent, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource DarkBox}"
                                                 Height="52" TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Margin="0,0,0,10"/>

                                        <!-- Slot reorder (z-order) -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                    Command="{Binding MoveSlotUpCommand}"
                                                    Height="28" Cursor="Hand"
                                                    Template="{StaticResource GhostBtnTpl}" Padding="4,0"
                                                    ToolTip="{DynamicResource TD_100}">
                                                <TextBlock Text="{DynamicResource TD_101}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11"/>
                                            </Button>
                                            <Button Grid.Column="2"
                                                    Command="{Binding MoveSlotDownCommand}"
                                                    Height="28" Cursor="Hand"
                                                    Template="{StaticResource GhostBtnTpl}" Padding="4,0"
                                                    ToolTip="{DynamicResource TD_102}">
                                                <TextBlock Text="{DynamicResource TD_103}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11"/>
                                            </Button>
                                        </Grid>

                                        <!-- Apply + Delete slot row -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                    Command="{Binding ApplySlotEditsCommand}"
                                                    Height="34" Cursor="Hand"
                                                    Template="{StaticResource GreenBtnTpl}"
                                                    Padding="0">
                                                <TextBlock Text="{DynamicResource TD_104}"
                                                           Foreground="White" FontSize="12"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"/>
                                            </Button>
                                            <Button Grid.Column="2"
                                                    Command="{Binding DeleteSlotCommand}"
                                                    Height="34" Cursor="Hand"
                                                    Template="{StaticResource RedBtnTpl}"
                                                    Padding="0">
                                                <TextBlock Text="{DynamicResource TD_105}"
                                                           Foreground="White" FontSize="12"
                                                           HorizontalAlignment="Center"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- ┄┄ Section: ربط البيانات (shown when slot selected AND data pasted) ┄┄ -->
                            <Border Background="{DynamicResource Brush.Background}" CornerRadius="8"
                                    Padding="12,10" Margin="0,0,0,12">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasSlot}"              Value="True"/>
                                                    <Condition Binding="{Binding SmartVars.HasPastedData}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="🔗" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource TD_106}" Style="{StaticResource SectionTitle}"
                                                   Margin="0" VerticalAlignment="Center"/>
                                        <!-- Bound badge — visible only when a column is selected -->
                                        <Border Background="#E7F3EC" CornerRadius="4" Padding="5,2" Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding SelectedSlotBoundColumn,
                                                             Converter={StaticResource NonEmptyToVis}}">
                                            <TextBlock Text="{DynamicResource TD_107}" Foreground="#1B7F4C" FontSize="10"/>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{DynamicResource TD_108}"
                                               Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>

                                    <ComboBox ItemsSource="{Binding SmartVars.DataColumns}"
                                              SelectedItem="{Binding SelectedSlotBoundColumn, Mode=TwoWay}"
                                              Style="{StaticResource DarkCombo}"
                                              Margin="0,0,0,6">
                                        <!-- empty/unbound option -->
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource Brush.Slate.200}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Foreground="{DynamicResource Brush.Text.Disabled}" FontSize="10"
                                               TextWrapping="Wrap"
                                               Text="{DynamicResource TD_109}"/>
                                </StackPanel>
                            </Border>

                            <!-- Spacer -->
                            <Border Height="8"/>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- ── Footer: Save + Status ── -->
                    <Border Grid.Row="1" Padding="14,10"
                            BorderBrush="{DynamicResource Brush.Border.Light}" BorderThickness="0,1,0,0"
                            Background="{DynamicResource Brush.Surface}">
                        <StackPanel>
                            <!-- Unsaved-changes indicator -->
                            <Border CornerRadius="6" Padding="8,4" Margin="0,0,0,6"
                                    Background="#FDF1DC" HorizontalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{DynamicResource TD_110}"
                                           Foreground="#E08A00" FontSize="10"/>
                            </Border>

                            <Button Command="{Binding SaveCurrentTemplateCommand}"
                                    Height="40" Cursor="Hand"
                                    IsEnabled="{Binding HasTemplate}"
                                    Template="{StaticResource BlueBtnTpl}" Padding="0"
                                    Margin="0,0,0,6"
                                    ToolTip="Ctrl+S">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💾" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource TD_111}"
                                               Foreground="White" FontSize="13"
                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Status message -->
                            <TextBlock Text="{Binding StatusMessage}"
                                       Foreground="{Binding StatusColor}"
                                       FontSize="11" TextAlignment="Center"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                </Grid>
            </Border>

        </Grid>

        <!-- ══════════════════════ SMART VARIABLES STEPS (1-5) ══════════════
             Shown in Grid.Row="2" when ActiveStep > 0 (IsSmartStep = true).

             FIX: The outer Grid binds Visibility directly to IsSmartStep on
             TemplateDesignerViewModel (the DataContext of THIS UserControl).
             SmartVariablesView gets SmartVars as its own DataContext.
             No RelativeSource gymnastics needed — the Grid DataContext is
             TemplateDesignerViewModel, so {Binding IsSmartStep} resolves
             correctly without any AncestorLevel indirection.
        ══════════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2"
              Visibility="{Binding IsSmartStep,
                           Converter={StaticResource BooleanToVisibilityConverter}}">
            <local:SmartVariablesView DataContext="{Binding SmartVars}"/>
        </Grid>

    </Grid>
</UserControl>
