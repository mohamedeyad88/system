<UserControl x:Class="Apex.UI.Views.TemplateDesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Apex.UI.Views"
             xmlns:converters="clr-namespace:Apex.UI.Converters"
             FlowDirection="RightToLeft"
             Background="#0F172A">

    <UserControl.Resources>

        <!-- ── Converter instances ───────────────────────────────────────── -->
        <BooleanToVisibilityConverter                        x:Key="BooleanToVisibilityConverter"/>
        <converters:StepVisibilityConverter                  x:Key="StepVisConv"/>
        <converters:StepBackgroundConverter                  x:Key="StepBgConv"/>
        <converters:NonEmptyStringToVisibilityConverter      x:Key="NonEmptyToVis"/>
        <converters:SlotDataTypeToArabicConverter            x:Key="DataTypeToArabic"/>
        <converters:HorizontalAlignToArabicConverter         x:Key="AlignToArabic"/>

        <!-- ── Stepper button style ──────────────────────────────────────── -->
        <Style x:Key="StepBtn" TargetType="Button">
            <Setter Property="Foreground"      Value="#94A3B8"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="Height"          Value="48"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#334155"
                                BorderThickness="0,0,0,3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1E293B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Field-type toolbar button ─────────────────────────────────── -->
        <Style x:Key="FieldTypeBtn" TargetType="Button">
            <Setter Property="Height"          Value="28"/>
            <Setter Property="Padding"         Value="8,0"/>
            <Setter Property="Margin"          Value="0,0,4,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="#CBD5E1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="#334155" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Shared styles ──────────────────────────────────────────────── -->

        <Style x:Key="DarkBox" TargetType="TextBox">
            <Setter Property="Background"       Value="#0F172A"/>
            <Setter Property="Foreground"       Value="#E2E8F0"/>
            <Setter Property="BorderBrush"      Value="#334155"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Padding"          Value="8,5"/>
            <Setter Property="Height"           Value="32"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="CaretBrush"       Value="White"/>
            <Setter Property="SelectionBrush"   Value="#2563EB"/>
        </Style>

        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Background"      Value="#0F172A"/>
            <Setter Property="Foreground"      Value="#E2E8F0"/>
            <Setter Property="BorderBrush"     Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#1E293B"/>
                        <Setter Property="Foreground" Value="#E2E8F0"/>
                        <Setter Property="Padding"    Value="10,5"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#334155"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="#94A3B8"/>
            <Setter Property="FontSize"    Value="10"/>
            <Setter Property="Margin"      Value="0,0,0,3"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground"   Value="#CBD5E1"/>
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Margin"       Value="0,0,0,10"/>
        </Style>

        <!-- Blue primary button -->
        <ControlTemplate x:Key="BlueBtnTpl" TargetType="Button">
            <Border x:Name="b" Background="#2563EB" CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="b" Property="Background" Value="#1D4ED8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="b" Property="Background" Value="#1E3A5F"/>
                    <Setter TargetName="b" Property="Opacity"    Value="0.6"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Green save button -->
        <ControlTemplate x:Key="GreenBtnTpl" TargetType="Button">
            <Border x:Name="b" Background="#059669" CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="b" Property="Background" Value="#047857"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Red danger button -->
        <ControlTemplate x:Key="RedBtnTpl" TargetType="Button">
            <Border x:Name="b" Background="#DC2626" CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="b" Property="Background" Value="#B91C1C"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Ghost icon button -->
        <ControlTemplate x:Key="GhostBtnTpl" TargetType="Button">
            <Border x:Name="b" Background="Transparent" CornerRadius="6"
                    BorderBrush="#334155" BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="b" Property="Background"   Value="#1E293B"/>
                    <Setter TargetName="b" Property="BorderBrush"  Value="#475569"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>   <!-- Header -->
            <RowDefinition Height="48"/>   <!-- Stepper -->
            <RowDefinition Height="*"/>    <!-- Content (Designer OR Smart Variables) -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════ HEADER ══════════════════════ -->
        <Border Grid.Row="0" Background="#1E293B"
                BorderBrush="#334155" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <!-- Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📄" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="مصمم القوالب" Foreground="White"
                               FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <!-- Loading indicator -->
                    <Border Background="#2563EB" CornerRadius="4" Padding="8,3" Margin="12,0,0,0"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="جارٍ التحميل..." Foreground="White" FontSize="11"/>
                    </Border>
                </StackPanel>

                <!-- Header actions -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                    <Button x:Name="BtnImport" Height="34" Padding="12,0" Margin="0,0,6,0"
                            Cursor="Hand" Template="{StaticResource GhostBtnTpl}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📥" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text=" استيراد" Foreground="#CBD5E1" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding AddNewTemplateCommand}"
                            Height="34" Padding="14,0" Cursor="Hand"
                            Template="{StaticResource BlueBtnTpl}" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text=" قالب جديد" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Save with Smart Data button (header quick-save) -->
                    <Button Command="{Binding SaveWithSmartDataCommand}"
                            Height="34" Padding="14,0" Cursor="Hand"
                            IsEnabled="{Binding HasTemplate}"
                            Template="{StaticResource GhostBtnTpl}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text=" حفظ" Foreground="#CBD5E1" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════ STEPPER ══════════════════════ -->
        <Border Grid.Row="1" Background="#1E293B"
                BorderBrush="#334155" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Stretch">

                <!-- Step 0 — Design -->
                <Button Style="{StaticResource StepBtn}"
                        Command="{Binding GoToStepCommand}" CommandParameter="0">
                    <Button.Background>
                        <Binding Path="ActiveStep" Converter="{StaticResource StepBgConv}" ConverterParameter="0"/>
                    </Button.Background>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📄 " FontSize="13"/>
                        <TextBlock FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text"       Value="تصميم القالب"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveStep}" Value="0">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>

                <TextBlock Text="›" Foreground="#475569" FontSize="18"
                           VerticalAlignment="Center" Margin="0,0,0,0"/>

                <!-- Step 1 — Paste -->
                <Button Style="{StaticResource StepBtn}"
                        Command="{Binding GoToStepCommand}" CommandParameter="1"
                        IsEnabled="{Binding HasTemplate}">
                    <Button.Background>
                        <Binding Path="ActiveStep" Converter="{StaticResource StepBgConv}" ConverterParameter="1"/>
                    </Button.Background>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📋 " FontSize="13"/>
                        <TextBlock FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text"       Value="لصق البيانات"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveStep}" Value="1">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>

                <TextBlock Text="›" Foreground="#475569" FontSize="18"
                           VerticalAlignment="Center"/>

                <!-- Step 2 — Map -->
                <Button Style="{StaticResource StepBtn}"
                        Command="{Binding GoToStepCommand}" CommandParameter="2"
                        IsEnabled="{Binding SmartVars.HasPastedData}">
                    <Button.Background>
                        <Binding Path="ActiveStep" Converter="{StaticResource StepBgConv}" ConverterParameter="2"/>
                    </Button.Background>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔗 " FontSize="13"/>
                        <TextBlock FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text"       Value="ربط المتغيرات"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveStep}" Value="2">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>

                <TextBlock Text="›" Foreground="#475569" FontSize="18"
                           VerticalAlignment="Center"/>

                <!-- Step 3 — Images -->
                <Button Style="{StaticResource StepBtn}"
                        Command="{Binding GoToStepCommand}" CommandParameter="3"
                        IsEnabled="{Binding SmartVars.HasPastedData}">
                    <Button.Background>
                        <Binding Path="ActiveStep" Converter="{StaticResource StepBgConv}" ConverterParameter="3"/>
                    </Button.Background>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🖼 " FontSize="13"/>
                        <TextBlock FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text"       Value="إدارة الصور"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveStep}" Value="3">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>

                <TextBlock Text="›" Foreground="#475569" FontSize="18"
                           VerticalAlignment="Center"/>

                <!-- Step 4 — Preview -->
                <Button Style="{StaticResource StepBtn}"
                        Command="{Binding GoToStepCommand}" CommandParameter="4"
                        IsEnabled="{Binding SmartVars.HasPastedData}">
                    <Button.Background>
                        <Binding Path="ActiveStep" Converter="{StaticResource StepBgConv}" ConverterParameter="4"/>
                    </Button.Background>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👁 " FontSize="13"/>
                        <TextBlock FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text"       Value="معاينة"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveStep}" Value="4">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>

                <TextBlock Text="›" Foreground="#475569" FontSize="18"
                           VerticalAlignment="Center"/>

                <!-- Step 5 — Export -->
                <Button Style="{StaticResource StepBtn}"
                        Command="{Binding GoToStepCommand}" CommandParameter="5"
                        IsEnabled="{Binding SmartVars.HasPastedData}">
                    <Button.Background>
                        <Binding Path="ActiveStep" Converter="{StaticResource StepBgConv}" ConverterParameter="5"/>
                    </Button.Background>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✅ " FontSize="13"/>
                        <TextBlock FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text"       Value="فحص وتصدير"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveStep}" Value="5">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Border>

        <!-- ══════════════════════ BODY (3 columns) — Step 0 only ═══════════ -->
        <Grid Grid.Row="2">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDesignStep}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- ─────────────── LEFT: Library ─────────────── -->
            <Border Grid.Column="0" Background="#1E293B"
                    BorderBrush="#334155" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Section title -->
                    <TextBlock Grid.Row="0" Text="📚 المكتبة" Foreground="White"
                               FontSize="13" FontWeight="SemiBold" Margin="14,14,14,8"/>

                    <!-- Search -->
                    <TextBox Grid.Row="1"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DarkBox}"
                             Height="32" Margin="10,0,10,6"
                             Tag="بحث في القوالب...">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Border Background="#0F172A" BorderBrush="#334155"
                                        BorderThickness="1" CornerRadius="6" Padding="8,0">
                                    <Grid>
                                        <TextBlock Text="{TemplateBinding Tag}"
                                                   Foreground="#475569" FontSize="11"
                                                   VerticalAlignment="Center" Margin="0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ScrollViewer x:Name="PART_ContentHost"
                                                      VerticalAlignment="Center"
                                                      Foreground="#E2E8F0" FontSize="12"/>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>

                    <!-- Category filter -->
                    <ComboBox Grid.Row="2"
                              ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory}"
                              Style="{StaticResource DarkCombo}"
                              Margin="10,0,10,8"/>

                    <!-- Template list -->
                    <ListBox Grid.Row="3"
                             ItemsSource="{Binding Templates}"
                             SelectedItem="{Binding SelectedEntry}"
                             Background="Transparent" BorderThickness="0"
                             Margin="6,0,6,4"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" Foreground="#E2E8F0"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <Border Background="#334155" CornerRadius="3"
                                                    Padding="5,1">
                                                <TextBlock Text="{Binding Category}"
                                                           Foreground="#64748B" FontSize="9"/>
                                            </Border>
                                            <TextBlock Text="{Binding PageCount, StringFormat=' · {0}ص'}"
                                                       Foreground="#475569" FontSize="9"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="b" Background="Transparent"
                                                    CornerRadius="6" Margin="0,1"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="#334155"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="#1E3A8A"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- Library actions -->
                    <Grid Grid.Row="4" Margin="8,4,8,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Command="{Binding DuplicateTemplateCommand}"
                                Height="30" Cursor="Hand"
                                Template="{StaticResource GhostBtnTpl}" Padding="4,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⧉" Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text=" نسخ" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2"
                                Command="{Binding DeleteTemplateCommand}"
                                Height="30" Cursor="Hand"
                                Template="{StaticResource RedBtnTpl}" Padding="4,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗑️" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text=" حذف" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- ─────────────── CENTER: Canvas ─────────────── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Canvas toolbar (hidden when no template) -->
                <Border Grid.Row="0" Background="#1E293B"
                        BorderBrush="#334155" BorderThickness="0,0,0,1"
                        Padding="12,8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasTemplate}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <WrapPanel Orientation="Horizontal">

                        <!-- Page size preset -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                            <TextBlock Text="الحجم:" Foreground="#64748B" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox ItemsSource="{Binding PageSizePresets}"
                                      SelectedItem="{Binding SelectedPageSize}"
                                      Style="{StaticResource DarkCombo}"
                                      Width="100" Height="30"/>
                            <Button Command="{Binding ApplyPageSizeCommand}"
                                    Height="30" Padding="8,0" Margin="4,0,0,0"
                                    Cursor="Hand" Template="{StaticResource GhostBtnTpl}">
                                <TextBlock Text="تطبيق" Foreground="#94A3B8" FontSize="11"/>
                            </Button>
                        </StackPanel>

                        <!-- Separator -->
                        <Border Width="1" Height="20" Background="#334155"
                                VerticalAlignment="Center" Margin="4,0"/>

                        <!-- Background upload -->
                        <Button x:Name="BtnUploadBg" Height="30" Padding="10,0" Margin="6,0,4,0"
                                Cursor="Hand" Template="{StaticResource GhostBtnTpl}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖼️" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text=" خلفية" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RemoveBackgroundCommand}"
                                Height="30" Padding="8,0" Margin="0,0,6,0"
                                Cursor="Hand" Template="{StaticResource GhostBtnTpl}">
                            <TextBlock Text="× حذف الخلفية" Foreground="#64748B" FontSize="11"/>
                        </Button>

                        <!-- Separator -->
                        <Border Width="1" Height="20" Background="#334155"
                                VerticalAlignment="Center" Margin="4,0"/>

                        <!-- Add / Delete slot (generic) -->
                        <Button Command="{Binding AddSlotCommand}"
                                Height="30" Padding="10,0" Margin="6,0,4,0"
                                Cursor="Hand" Template="{StaticResource BlueBtnTpl}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="➕" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text=" حقل" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DeleteSlotCommand}"
                                Height="30" Padding="8,0" Margin="0,0,4,0"
                                Cursor="Hand" Template="{StaticResource GhostBtnTpl}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗑️" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text=" حذف" Foreground="#EF4444" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Separator -->
                        <Border Width="1" Height="20" Background="#334155"
                                VerticalAlignment="Center" Margin="4,0"/>

                        <!-- ── Field-type toolbar ─────────────────────────────────────────
                             Each button adds a slot of the matching type directly to canvas.
                             typeStr maps to SlotDataType enum names in AddFieldOfTypeCommand.
                        ── -->
                        <TextBlock Text="أضف:" Foreground="#64748B" FontSize="11"
                                   VerticalAlignment="Center" Margin="6,0,6,0"/>

                        <Button Command="{Binding AddFieldOfTypeCommand}" CommandParameter="Text"
                                Style="{StaticResource FieldTypeBtn}" ToolTip="متغير نصي">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ن" Foreground="#3B82F6" FontWeight="Bold" FontSize="11"/>
                                <TextBlock Text=" نص" FontSize="11"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding AddFieldOfTypeCommand}" CommandParameter="Number"
                                Style="{StaticResource FieldTypeBtn}" ToolTip="رقم / كود">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="#" Foreground="#10B981" FontWeight="Bold" FontSize="11"/>
                                <TextBlock Text=" رقم" FontSize="11"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding AddFieldOfTypeCommand}" CommandParameter="Date"
                                Style="{StaticResource FieldTypeBtn}" ToolTip="تاريخ">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ت" Foreground="#F59E0B" FontWeight="Bold" FontSize="11"/>
                                <TextBlock Text=" تاريخ" FontSize="11"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding AddFieldOfTypeCommand}" CommandParameter="Image"
                                Style="{StaticResource FieldTypeBtn}" ToolTip="متغير صورة">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ص" Foreground="#8B5CF6" FontWeight="Bold" FontSize="11"/>
                                <TextBlock Text=" صورة" FontSize="11"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding AddFieldOfTypeCommand}" CommandParameter="QrCode"
                                Style="{StaticResource FieldTypeBtn}" ToolTip="QR كود">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="QR" Foreground="#EF4444" FontWeight="Bold" FontSize="11"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding AddFieldOfTypeCommand}" CommandParameter="Barcode"
                                Style="{StaticResource FieldTypeBtn}" ToolTip="باركود">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▌▌" Foreground="#EF4444" FontWeight="Bold" FontSize="11"/>
                                <TextBlock Text=" باركود" FontSize="11"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding AddFieldOfTypeCommand}" CommandParameter="Counter"
                                Style="{StaticResource FieldTypeBtn}" ToolTip="ترقيم تلقائي">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="١٢" Foreground="#06B6D4" FontWeight="Bold" FontSize="11"/>
                                <TextBlock Text=" مسلسل" FontSize="11"/>
                            </StackPanel>
                        </Button>

                    </WrapPanel>
                </Border>

                <!-- Canvas area -->
                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Background="#0F172A">
                  <Grid>

                    <!-- Empty state -->
                    <TextBlock Text="← اختر قالباً من المكتبة أو أنشئ قالباً جديداً"
                               Foreground="#334155" FontSize="15"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="0,80,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasTemplate}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Page Viewbox (only when template loaded) -->
                    <Viewbox Stretch="Uniform" Margin="24"
                             HorizontalAlignment="Center" VerticalAlignment="Top">
                        <Viewbox.Style>
                            <Style TargetType="Viewbox">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasTemplate}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Viewbox.Style>

                        <!-- Page surface -->
                        <Grid Width="{Binding CanvasWidthPt}"
                              Height="{Binding CanvasHeightPt}">

                            <!-- Drop shadow -->
                            <Grid.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.5"
                                                  BlurRadius="20" ShadowDepth="4"
                                                  Direction="315"/>
                            </Grid.Effect>

                            <!-- White page background -->
                            <Border Background="White"/>

                            <!-- Background image (if set) -->
                            <Image Source="{Binding BackgroundSource}"
                                   Stretch="Fill"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"/>

                            <!-- Slots canvas (ListBox with Canvas panel) -->
                            <ListBox ItemsSource="{Binding CanvasSlots}"
                                     SelectedItem="{Binding SelectedCanvasSlot, Mode=TwoWay}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Width="{Binding CanvasWidthPt,
                                             RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Height="{Binding CanvasHeightPt,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Width="{Binding DataContext.CanvasWidthPt,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Height="{Binding DataContext.CanvasHeightPt,
                                                         RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Canvas.Left"  Value="{Binding Left}"/>
                                        <Setter Property="Canvas.Top"   Value="{Binding Top}"/>
                                        <Setter Property="Width"        Value="{Binding Width}"/>
                                        <Setter Property="Height"       Value="{Binding Height}"/>
                                        <Setter Property="Padding"      Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="slotBorder"
                                                            BorderBrush="{Binding BorderColor}"
                                                            BorderThickness="1.5"
                                                            Background="{Binding FillColor}"
                                                            Cursor="Hand">
                                                        <Grid Margin="2,1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <!-- Type badge -->
                                                            <Border Grid.Column="0"
                                                                    Background="{Binding BorderColor}"
                                                                    CornerRadius="2"
                                                                    Padding="3,1" Margin="0,0,3,0"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding TypeTag}"
                                                                           FontSize="7"
                                                                           Foreground="White"
                                                                           FontWeight="Bold"/>
                                                            </Border>
                                                            <!-- Slot name -->
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Label}"
                                                                       FontSize="8"
                                                                       Foreground="#1E293B"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="slotBorder" Property="BorderThickness" Value="2"/>
                                                            <Setter TargetName="slotBorder" Property="BorderBrush"     Value="#F59E0B"/>
                                                            <Setter TargetName="slotBorder" Property="Background"      Value="#33F59E0B"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="slotBorder" Property="BorderThickness" Value="2"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <!-- No items placeholder -->
                                <ListBox.Template>
                                    <ControlTemplate TargetType="ListBox">
                                        <Grid>
                                            <ItemsPresenter/>
                                            <TextBlock Text="الصفحة فارغة — اضغط &quot;حقل جديد&quot; للبدء"
                                                       Foreground="#CBD5E133" FontSize="10"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanvasSlots.Count,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                         Value="0">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </ControlTemplate>
                                </ListBox.Template>
                            </ListBox>
                        </Grid>
                    </Viewbox>
                  </Grid>
                </ScrollViewer>

                <!-- Page navigation (hidden when no template loaded) -->
                <Border Grid.Row="2" Background="#1E293B"
                        BorderBrush="#334155" BorderThickness="0,1,0,0"
                        Padding="16,8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasTemplate}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding PreviousPageCommand}"
                                Width="30" Height="30" Cursor="Hand"
                                Template="{StaticResource GhostBtnTpl}" Padding="0">
                            <TextBlock Text="▶" Foreground="White" FontSize="11"/>
                        </Button>
                        <TextBlock Grid.Column="1" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#64748B" FontSize="12">
                            <Run Text="صفحة "/>
                            <Run Text="{Binding CurrentPageDisplayIndex, Mode=OneWay}"
                                 Foreground="#CBD5E1" FontWeight="SemiBold"/>
                            <Run Text=" من "/>
                            <Run Text="{Binding TotalPages}"
                                 Foreground="#CBD5E1" FontWeight="SemiBold"/>
                        </TextBlock>
                        <Button Grid.Column="2" Command="{Binding NextPageCommand}"
                                Width="30" Height="30" Cursor="Hand"
                                Template="{StaticResource GhostBtnTpl}" Padding="0">
                            <TextBlock Text="◀" Foreground="White" FontSize="11"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- ─────────────── RIGHT: Properties ─────────────── -->
            <Border Grid.Column="2" Background="#1E293B"
                    BorderBrush="#334155" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- No template placeholder -->
                    <TextBlock Grid.Row="0"
                               Text="اختر قالباً لتظهر خصائصه هنا"
                               Foreground="#334155" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasTemplate}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Properties panel (shown when HasTemplate) -->
                    <ScrollViewer Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="14,12,14,8">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasTemplate}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel>

                            <!-- ┄┄ Section: Template metadata ┄┄ -->
                            <Border Background="#0F172A" CornerRadius="8"
                                    Padding="12,10" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="📋 بيانات القالب" Style="{StaticResource SectionTitle}"/>

                                    <TextBlock Text="اسم القالب" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding EditTemplateName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DarkBox}" Margin="0,0,0,8"/>

                                    <TextBlock Text="التصنيف" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding EditTemplateCategory, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DarkBox}" Margin="0,0,0,8"/>

                                    <TextBlock Text="الوصف" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding EditTemplateDescription, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DarkBox}"
                                             Height="56" TextWrapping="Wrap"
                                             AcceptsReturn="True" Margin="0,0,0,8"/>

                                    <Button Command="{Binding ApplyTemplateMetaCommand}"
                                            Height="30" Cursor="Hand"
                                            Template="{StaticResource GhostBtnTpl}" Padding="0">
                                        <TextBlock Text="✅ تحديث بيانات القالب"
                                                   Foreground="#94A3B8" FontSize="11"
                                                   HorizontalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- ┄┄ Section: Slot editor ┄┄ -->
                            <Border Background="#0F172A" CornerRadius="8"
                                    Padding="12,10" Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="✏️ خصائص الحقل" Style="{StaticResource SectionTitle}"
                                                   Margin="0" VerticalAlignment="Center"/>
                                        <Border Background="#334155" CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="اختر حقلاً من الصفحة" Foreground="#475569" FontSize="9">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasSlot}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>

                                    <!-- Slot form (only when HasSlot) -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasSlot}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <!-- Name + Variable -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="الاسم" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Text="{Binding SlotName, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource DarkBox}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="اسم المتغير {{…}}" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Text="{Binding SlotVariableName, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource DarkBox}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Data type -->
                                        <TextBlock Text="نوع البيانات" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox ItemsSource="{Binding AvailableDataTypes}"
                                                  SelectedItem="{Binding SlotDataType}"
                                                  Style="{StaticResource DarkCombo}"
                                                  Margin="0,0,0,8">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource DataTypeToArabic}}"
                                                               FontSize="12" Foreground="#E2E8F0"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <!-- Position X, Y -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="X (مم)" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Text="{Binding SlotX, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource DarkBox}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Y (مم)" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Text="{Binding SlotY, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource DarkBox}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Size W, H -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="العرض (مم)" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Text="{Binding SlotW, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource DarkBox}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="الارتفاع (مم)" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Text="{Binding SlotH, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource DarkBox}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Font + Size -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="70"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="الخط" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox ItemsSource="{Binding AvailableFonts}"
                                                          SelectedItem="{Binding SlotFontName}"
                                                          Style="{StaticResource DarkCombo}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="الحجم" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Text="{Binding SlotFontSize, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource DarkBox}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Checkboxes row -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <CheckBox IsChecked="{Binding SlotIsBold}"
                                                      Foreground="#CBD5E1" FontSize="11"
                                                      Content="عريض" Margin="0,0,12,0"/>
                                            <CheckBox IsChecked="{Binding SlotIsItalic}"
                                                      Foreground="#CBD5E1" FontSize="11"
                                                      Content="مائل" Margin="0,0,12,0"/>
                                            <CheckBox IsChecked="{Binding SlotIsRtl}"
                                                      Foreground="#CBD5E1" FontSize="11"
                                                      Content="RTL عربي"/>
                                        </StackPanel>

                                        <!-- Alignment + Color -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="المحاذاة" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox ItemsSource="{Binding AvailableAlignments}"
                                                          SelectedItem="{Binding SlotTextAlign}"
                                                          Style="{StaticResource DarkCombo}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Converter={StaticResource AlignToArabic}}"
                                                                       FontSize="12" Foreground="#E2E8F0"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="لون النص (#RRGGBB)" Style="{StaticResource FieldLabel}"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="30"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0"
                                                             Text="{Binding SlotTextColor, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource DarkBox}"/>
                                                    <Border Grid.Column="1" CornerRadius="4" Margin="4,0,0,0"
                                                            Background="{Binding SlotTextColor}"
                                                            BorderBrush="#334155" BorderThickness="1"/>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Default value -->
                                        <TextBlock Text="القيمة الافتراضية" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding SlotContent, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource DarkBox}"
                                                 Height="52" TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Margin="0,0,0,8"/>

                                        <!-- Format string -->
                                        <TextBlock Text="صيغة التنسيق (مثال: dd/MM/yyyy أو 000000)"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding SlotFormatString, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource DarkBox}" Margin="0,0,0,10"/>

                                        <!-- Apply + Delete slot row -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                    Command="{Binding ApplySlotEditsCommand}"
                                                    Height="34" Cursor="Hand"
                                                    Template="{StaticResource GreenBtnTpl}"
                                                    Padding="0">
                                                <TextBlock Text="✅ تطبيق التعديلات"
                                                           Foreground="White" FontSize="12"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"/>
                                            </Button>
                                            <Button Grid.Column="2"
                                                    Command="{Binding DeleteSlotCommand}"
                                                    Height="34" Cursor="Hand"
                                                    Template="{StaticResource RedBtnTpl}"
                                                    Padding="0">
                                                <TextBlock Text="🗑️ حذف"
                                                           Foreground="White" FontSize="12"
                                                           HorizontalAlignment="Center"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- ┄┄ Section: ربط البيانات (shown when slot selected AND data pasted) ┄┄ -->
                            <Border Background="#0F172A" CornerRadius="8"
                                    Padding="12,10" Margin="0,0,0,12">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasSlot}"              Value="True"/>
                                                    <Condition Binding="{Binding SmartVars.HasPastedData}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="🔗" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="ربط البيانات" Style="{StaticResource SectionTitle}"
                                                   Margin="0" VerticalAlignment="Center"/>
                                        <!-- Bound badge — visible only when a column is selected -->
                                        <Border Background="#14532D" CornerRadius="4" Padding="5,2" Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding SelectedSlotBoundColumn,
                                                             Converter={StaticResource NonEmptyToVis}}">
                                            <TextBlock Text="✓ مربوط" Foreground="#22C55E" FontSize="10"/>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="اختر عمود البيانات لهذا الحقل:"
                                               Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>

                                    <ComboBox ItemsSource="{Binding SmartVars.DataColumns}"
                                              SelectedItem="{Binding SelectedSlotBoundColumn, Mode=TwoWay}"
                                              Style="{StaticResource DarkCombo}"
                                              Margin="0,0,0,6">
                                        <!-- empty/unbound option -->
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="12" Foreground="#E2E8F0"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Foreground="#475569" FontSize="10"
                                               TextWrapping="Wrap"
                                               Text="الحقل المحدد سيُملأ تلقائياً من هذا العمود عند الدمج."/>
                                </StackPanel>
                            </Border>

                            <!-- Spacer -->
                            <Border Height="8"/>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- ── Footer: Save + Status ── -->
                    <Border Grid.Row="1" Padding="14,10"
                            BorderBrush="#334155" BorderThickness="0,1,0,0"
                            Background="#1E293B">
                        <StackPanel>
                            <Button Command="{Binding SaveCurrentTemplateCommand}"
                                    Height="40" Cursor="Hand"
                                    Template="{StaticResource BlueBtnTpl}" Padding="0"
                                    Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💾" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text=" حفظ القالب"
                                               Foreground="White" FontSize="13"
                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Status message -->
                            <TextBlock Text="{Binding StatusMessage}"
                                       Foreground="{Binding StatusColor}"
                                       FontSize="11" TextAlignment="Center"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                </Grid>
            </Border>

        </Grid>

        <!-- ══════════════════════ SMART VARIABLES STEPS (1-5) ══════════════
             Shown in Grid.Row="2" when ActiveStep > 0.
             The SmartVariablesView's ActiveTabIndex tracks ActiveStep - 1
             so each stepper click shows the matching tab.
        ══════════════════════════════════════════════════════════════════════ -->
        <local:SmartVariablesView Grid.Row="2"
                                  DataContext="{Binding SmartVars}">
            <local:SmartVariablesView.Style>
                <Style TargetType="local:SmartVariablesView">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSmartStep}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </local:SmartVariablesView.Style>
        </local:SmartVariablesView>

    </Grid>
</UserControl>
