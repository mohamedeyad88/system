<UserControl x:Class="Apex.UI.Views.PrintersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Apex.UI.Views"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="#F8FAFC">
    
    <UserControl.Resources>
        <!-- Modern Card -->
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.08" Color="#000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Button -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#475569"/>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#10B981"/>
        </Style>

        <!-- Modern ComboBox -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </UserControl.Resources>
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="🖨️ Printer Management" FontSize="28" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="{DynamicResource Printers_SelectAndPrint}" FontSize="14" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="🔄 Refresh" Command="{Binding RefreshStatusCommand}" 
                    Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"/>
        </Grid>

        <!-- Quick Print Card -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="24" Margin="0,0,0,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header with Selected Printer -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="📤 Quick Print" FontSize="18" FontWeight="SemiBold" Foreground="#1E293B"/>
                    <Border Grid.Column="1" HorizontalAlignment="Right" CornerRadius="8" Padding="12,6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FEF3C7"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPrinter, Converter={StaticResource NullToBoolConverter}}" Value="True">
                                        <Setter Property="Background" Value="#D1FAE5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding SelectedPrinterDisplay}" FontSize="13" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#92400E"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPrinter, Converter={StaticResource NullToBoolConverter}}" Value="True">
                                            <Setter Property="Foreground" Value="#047857"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>

                <!-- File Selection Row -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- File path -->
                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <TextBox Text="{Binding NewJobFileName}" Style="{StaticResource ModernTextBox}"/>
                        <TextBlock Text="{DynamicResource Printers_SelectFile}" Foreground="#94A3B8" Padding="14,0" 
                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding NewJobFileName, Converter={StaticResource EmptyStringToVisibility}}"/>
                    </Grid>
                    <Button Grid.Column="1" Content="📂 Browse" Command="{Binding BrowseFileCommand}" 
                            Style="{StaticResource SecondaryButton}" Margin="0,0,12,0"/>

                    <!-- Copies -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{DynamicResource Printers_Copies}" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding NewJobCopies}" Style="{StaticResource ModernTextBox}" Width="50" TextAlignment="Center"/>
                    </StackPanel>

                    <!-- Print -->
                    <Button Grid.Column="3" Content="🖨️ Print" Command="{Binding SubmitJobCommand}" 
                            Style="{StaticResource SuccessButton}" Margin="0,0,8,0"/>
                    
                    <!-- Clear -->
                    <Button Grid.Column="4" Content="✕" Command="{Binding ClearFileCommand}" 
                            Style="{StaticResource SecondaryButton}" Width="40"/>
                </Grid>

                <!-- Activity Log -->
                <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="8" Margin="0,16,0,0" Padding="16" 
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="80"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="📋 Activity Log" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding LogText}" FontFamily="Consolas" FontSize="12" 
                                       Foreground="#475569" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Printers Toolbar -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="🖨️ Available Printers" FontSize="18" FontWeight="SemiBold" 
                       Foreground="#1E293B" VerticalAlignment="Center"/>
            <Border Grid.Column="1" Background="#E0F2FE" CornerRadius="12" Padding="10,4" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Printers.Count, StringFormat={}{0} printers}" FontSize="12" Foreground="#0369A1"/>
            </Border>

            <!-- Search Box -->
            <Grid Grid.Column="2" HorizontalAlignment="Right" Margin="24,0,12,0">
                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource ModernTextBox}" Width="200"/>
                <TextBlock Text="🔍 Search..." Foreground="#94A3B8" Padding="14,0" 
                           VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding SearchQuery, Converter={StaticResource EmptyStringToVisibility}}"/>
            </Grid>

            <!-- View Toggle -->
            <Button Grid.Column="3" Command="{Binding ToggleViewModeCommand}" 
                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="8">
                <Grid>
                    <TextBlock Text="📃 List View" Visibility="{Binding IsGridMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Text="▦ Grid View" Visibility="{Binding IsListMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </Button>

            <!-- Filter -->
            <ComboBox Grid.Column="4" SelectedValue="{Binding FilterType}" Style="{StaticResource ModernComboBox}" 
                      Width="120" Margin="0,0,8,0" SelectedValuePath="Content">
                <ComboBoxItem Content="All" IsSelected="True"/>
                <ComboBoxItem Content="Local"/>
                <ComboBoxItem Content="Network"/>
                <ComboBoxItem Content="Online"/>
            </ComboBox>

            <!-- Sort -->
            <ComboBox Grid.Column="5" SelectedValue="{Binding SortBy}" Style="{StaticResource ModernComboBox}" 
                      Width="100" SelectedValuePath="Content">
                <ComboBoxItem Content="Name" IsSelected="True"/>
                <ComboBoxItem Content="Status"/>
                <ComboBoxItem Content="Queue"/>
            </ComboBox>
        </Grid>

        <!-- Printer Cards Grid / List -->
        <Grid Grid.Row="3">
            
            <!-- Grid View (Compact Cards) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsGridMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding FilteredPrinters}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="220" Margin="0,0,16,16" Padding="16" CornerRadius="12" Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick" 
                                                  Command="{Binding DataContext.SelectPrinterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.08" Color="#000"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="#3B82F6"/>
                                                <Setter Property="Background" Value="#EFF6FF"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.12" Color="#000"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Top Row: Icon + Name -->
                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="8" Background="#DBEAFE">
                                            <TextBlock Text="🖨️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" 
                                                   Margin="10,0,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" 
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Middle Row: Stats -->
                                    <Grid Grid.Row="1" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Border CornerRadius="4" Padding="6,2" Background="#F1F5F9" Margin="0,0,8,0">
                                                <TextBlock FontSize="10" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Offline"/>
                                                            <Setter Property="Foreground" Value="#64748B"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                    <Setter Property="Text" Value="Online"/>
                                                                    <Setter Property="Foreground" Value="#059669"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <TextBlock Text="{Binding QueueLength, StringFormat={}Q: {0}}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Bottom Row: Buttons -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Select" Height="28" FontSize="11"
                                                Command="{Binding DataContext.SelectPrinterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Margin="0,0,6,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Content" Value="✓ Active"/>
                                                            <Setter Property="Background" Value="#10B981"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Grid.Column="1" Content="⚙️" Height="28" Width="28" Padding="0" Style="{StaticResource SecondaryButton}"
                                                Command="{Binding DataContext.OpenPropertiesCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- List View (Dense) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsListMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding FilteredPrinters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="12,8" CornerRadius="8" Background="White" Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick" 
                                                  Command="{Binding DataContext.SelectPrinterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="#3B82F6"/>
                                                <Setter Property="Background" Value="#EFF6FF"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F8FAFC"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/> <!-- Icon -->
                                        <ColumnDefinition Width="200"/> <!-- Name -->
                                        <ColumnDefinition Width="100"/> <!-- Status -->
                                        <ColumnDefinition Width="100"/> <!-- Queue -->
                                        <ColumnDefinition Width="80"/> <!-- Type -->
                                        <ColumnDefinition Width="*"/> <!-- Spacer -->
                                        <ColumnDefinition Width="Auto"/> <!-- Actions -->
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="🖨️" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Offline"/>
                                                <Setter Property="Foreground" Value="#EF4444"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                        <Setter Property="Text" Value="Online"/>
                                                        <Setter Property="Foreground" Value="#10B981"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Grid.Column="3" Text="{Binding QueueLength, StringFormat={}{0} jobs}" VerticalAlignment="Center" Foreground="#64748B" FontSize="12"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Type}" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="11"/>

                                    <StackPanel Grid.Column="6" Orientation="Horizontal">
                                        <Button Content="Select" Height="26" FontSize="11" Width="60" Margin="0,0,8,0"
                                                Command="{Binding DataContext.SelectPrinterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Content" Value="Active"/>
                                                            <Setter Property="Background" Value="#10B981"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="⚙️" Height="26" Width="26" Padding="0" Style="{StaticResource SecondaryButton}"
                                                Command="{Binding DataContext.OpenPropertiesCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Properties Modal Overlay -->
        <Grid Grid.RowSpan="4" Background="#80000000" 
              Visibility="{Binding IsPropertiesPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.InputBindings>
                <MouseBinding Gesture="LeftClick" Command="{Binding ClosePropertiesCommand}"/>
            </Grid.InputBindings>
            
            <Border Width="450" Height="600" Background="White" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.2" Color="#000"/>
                </Border.Effect>
                 <!-- Prevent click-through closing -->
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding DoNothingCommand}"/>
                </Border.InputBindings>
                
                <local:PrinterPropertiesView DataContext="{Binding}"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>

