<UserControl x:Class="Apex.UI.Views.PrintersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Apex.UI.Views"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="Transparent">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header Bar -->
            <RowDefinition Height="*"/>      <!-- Main Content -->
            <RowDefinition Height="Auto"/>   <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════════
             🔝 HEADER BAR
             ═══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="🖨️" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Printing Operations" FontSize="18" FontWeight="SemiBold" 
                               Foreground="#1E293B" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Toolbar -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="📂 Open File" Command="{Binding BrowseFileCommand}" 
                            Margin="0,0,8,0" Padding="12,6" Background="#F1F5F9" 
                            BorderThickness="0" Cursor="Hand"/>
                    <Button Content="🔄 Refresh" Command="{Binding RefreshStatusCommand}" 
                            Margin="0,0,8,0" Padding="12,6" Background="#F1F5F9" 
                            BorderThickness="0" Cursor="Hand"/>
                    <Button Content="⚙️ Settings" Padding="12,6" Background="#F1F5F9" 
                            BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════
             📄 MAIN CONTENT
             ═══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Background="#0F172A">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>  <!-- Printer List -->
                <ColumnDefinition Width="*"/>    <!-- Print Area -->
            </Grid.ColumnDefinitions>

            <!-- LEFT: Printer List -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Printer List Header -->
                    <Border Grid.Row="0" Background="#0F172A" Padding="16,12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Printers" FontWeight="SemiBold" FontSize="13" Foreground="#475569"/>
                            <TextBlock Grid.Column="1" Text="{Binding TotalPrintersCount, Mode=OneWay, StringFormat='({0})'}" 
                                       FontSize="12" Foreground="#94A3B8"/>
                        </Grid>
                    </Border>

                    <!-- Printer Items -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredPrinters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,10" Cursor="Hand" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="LeftClick" 
                                                          Command="{Binding DataContext.SelectPrinterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#EFF6FF"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#F8FAFC"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Status Indicator -->
                                            <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#EF4444"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                <Setter Property="Fill" Value="#10B981"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>

                                            <!-- Printer Info -->
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" 
                                                           Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock FontSize="11" Margin="0,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Offline"/>
                                                            <Setter Property="Foreground" Value="#EF4444"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                    <Setter Property="Text" Value="Ready"/>
                                                                    <Setter Property="Foreground" Value="#10B981"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Queue Badge -->
                                            <Border Grid.Column="2" Background="#F1F5F9" CornerRadius="4" Padding="6,2" 
                                                    VerticalAlignment="Center" Visibility="{Binding QueueLength, Converter={StaticResource NullToVisConverter}}">
                                                <TextBlock Text="{Binding QueueLength}" FontSize="10" Foreground="#64748B"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- RIGHT: Print Area -->
            <Grid Grid.Column="1" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Selected Printer Info -->
                <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Selected Printer" FontSize="12" Foreground="#64748B"/>
                            <TextBlock Text="{Binding SelectedPrinterDisplay}" FontSize="16" FontWeight="SemiBold" 
                                       Foreground="#1E293B" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1" Content="⚙️ Properties" 
                                Command="{Binding OpenPropertiesCommand}" CommandParameter="{Binding SelectedPrinter}"
                                Padding="12,6" Background="#F1F5F9" BorderThickness="0" Cursor="Hand"/>
                    </Grid>
                </Border>

                <!-- Print Job Form -->
                <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- File Selection -->
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Document" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#0F172A" CornerRadius="6" Padding="12,10"
                                        BorderBrush="#E2E8F0" BorderThickness="1">
                                    <Grid>
                                        <TextBlock Text="{Binding NewJobFileName}" FontSize="13" Foreground="#1E293B"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="No file selected..." Foreground="#94A3B8" FontSize="13"
                                                   Visibility="{Binding NewJobFileName, Converter={StaticResource EmptyStringToVisibility}}"/>
                                    </Grid>
                                </Border>
                                <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseFileCommand}"
                                        Margin="8,0,0,0" Padding="16,10" Background="#2563EB" Foreground="White"
                                        BorderThickness="0" Cursor="Hand"/>
                            </Grid>
                        </StackPanel>

                        <!-- Options -->
                        <Grid Grid.Row="1" Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Copies -->
                            <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,12,16">
                                <TextBlock Text="Copies" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,8"/>
                                <Border Background="#0F172A" CornerRadius="6" Padding="12,10" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <TextBox Text="{Binding NewJobCopies}" Background="Transparent" BorderThickness="0"
                                             FontSize="13" Foreground="#1E293B" TextAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <!-- Page Range (placeholder) -->
                            <StackPanel Grid.Column="1" Grid.Row="0" Margin="12,0,0,16">
                                <TextBlock Text="Pages" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,8"/>
                                <Border Background="#0F172A" CornerRadius="6" Padding="12,10" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <TextBlock Text="All" FontSize="13" Foreground="#1E293B" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Print Button -->
                        <Button Grid.Row="2" Command="{Binding SubmitJobCommand}" Cursor="Hand"
                                HorizontalAlignment="Stretch" Padding="0,14">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#10B981" Offset="0"/>
                                                <GradientStop Color="#059669" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="🖨️" FontSize="16" Margin="0,0,8,0"/>
                                            <TextBlock Text="Print Now" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#059669" Offset="0"/>
                                                        <GradientStop Color="#047857" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Quick Actions -->
                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Command="{Binding TestPrintCommand}" Margin="0,0,8,0"
                            Padding="0,10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" 
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="📄" Margin="0,0,6,0"/>
                                        <TextBlock Text="Test Page" FontSize="12" Foreground="#475569"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="1" Command="{Binding FlushQueueCommand}" CommandParameter="{Binding SelectedPrinter}" 
                            Margin="4,0,4,0" Padding="0,10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" 
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="🗑️" Margin="0,0,6,0"/>
                                        <TextBlock Text="Clear Queue" FontSize="12" Foreground="#475569"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="2" Margin="8,0,0,0" Padding="0,10" 
                            Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" 
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="📋" Margin="0,0,6,0"/>
                                        <TextBlock Text="View Queue" FontSize="12" Foreground="#475569"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════════
             📊 STATUS BAR
             ═══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#1E293B" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Icon + Text -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#10B981"/>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="Ready" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center Status Message -->
                <TextBlock Grid.Column="1" Text="{Binding LogText}" FontSize="11" Foreground="#64748B" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="400"/>

                <!-- Right Info -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="🖨️" FontSize="12" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding TotalPrintersCount, Mode=OneWay, StringFormat='{}{0} Printers'}" 
                               FontSize="12" Foreground="#94A3B8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Properties Modal Overlay -->
        <Grid Grid.RowSpan="3" Background="#80000000" 
              Visibility="{Binding IsPropertiesPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.InputBindings>
                <MouseBinding Gesture="LeftClick" Command="{Binding ClosePropertiesCommand}"/>
            </Grid.InputBindings>
            
            <Border Width="450" Height="550" Background="White" CornerRadius="12" 
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.25" Color="#000"/>
                </Border.Effect>
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding DoNothingCommand}"/>
                </Border.InputBindings>
                
                <local:PrinterPropertiesView DataContext="{Binding}"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
