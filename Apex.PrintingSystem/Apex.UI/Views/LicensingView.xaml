<UserControl x:Class="Apex.UI.Views.LicensingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="#0F172A">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32,40,32" MaxWidth="700">

            <!-- Header -->
            <TextBlock Text="{DynamicResource LIC_001}" FontSize="28" FontWeight="Bold"
                       Foreground="#F1F5F9" Margin="0,0,0,6"/>
            <TextBlock Text="{DynamicResource LIC_002}"
                       FontSize="14" Foreground="#64748B" Margin="0,0,0,32"/>

            <!-- Status Card -->
            <Border Background="#1E293B" CornerRadius="12" Padding="24" Margin="0,0,0,20"
                    BorderBrush="#334155" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource LIC_003}" FontSize="12" Foreground="#64748B" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding LicenseStatusText}" FontSize="20" FontWeight="Bold"
                                   Foreground="{Binding StatusColor}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource LIC_004}" FontSize="13" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding LicenseTypeText}" FontSize="13" Foreground="#E2E8F0" FontWeight="SemiBold"/>
                            <TextBlock Text="   |   " FontSize="13" Foreground="#475569"/>
                            <TextBlock Text="{DynamicResource LIC_005}" FontSize="13" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding ExpiryText}" FontSize="13" Foreground="#E2E8F0" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                    Visibility="{Binding IsTrialActive, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{DynamicResource LIC_006}" FontSize="13" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding DaysRemaining}" FontSize="13"
                                       Foreground="#F59E0B" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding RefreshStatusCommand}"
                            Content="{DynamicResource LIC_007}" Padding="14,8"
                            Background="#334155" Foreground="#94A3B8"
                            BorderThickness="1" BorderBrush="#475569"
                            FontSize="12" Cursor="Hand" VerticalAlignment="Top">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#475569"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Device ID Card -->
            <Border Background="#1E293B" CornerRadius="12" Padding="24" Margin="0,0,0,20"
                    BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{DynamicResource ACT_005}" FontSize="14" FontWeight="SemiBold"
                               Foreground="#F1F5F9" Margin="0,0,0,6"/>
                    <TextBlock Text="{DynamicResource LIC_008}"
                               FontSize="12" Foreground="#64748B" Margin="0,0,0,14"/>

                    <Border Background="#0F172A" BorderBrush="#475569" BorderThickness="1"
                            CornerRadius="8" Padding="16,12" Margin="0,0,0,14">
                        <TextBlock Text="{Binding DeviceDisplayId}"
                                   FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                                   Foreground="#60A5FA" TextAlignment="Center"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- Copy Button -->
                        <Button Command="{Binding CopyDeviceIdCommand}" Margin="0,0,10,0"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="#334155" CornerRadius="8"
                                            Padding="16,10" BorderBrush="#475569" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📋 " FontSize="14"/>
                                            <TextBlock Text="{DynamicResource LIC_009}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="White"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#475569"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- WhatsApp Button -->
                        <Button Command="{Binding OpenWhatsAppCommand}" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" CornerRadius="8" Padding="16,10">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#25D366" Offset="0"/>
                                                <GradientStop Color="#128C7E" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📱 " FontSize="14"/>
                                            <TextBlock Text="{DynamicResource LIC_010}" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="White"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Activate Card -->
            <Border Background="#1E293B" CornerRadius="12" Padding="24"
                    BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{DynamicResource LIC_011}" FontSize="14" FontWeight="SemiBold"
                               Foreground="#F1F5F9" Margin="0,0,0,6"/>
                    <TextBlock Text="{DynamicResource LIC_012}"
                               FontSize="12" Foreground="#64748B" Margin="0,0,0,16"/>

                    <!-- Instant online activation by serial (buy now, no need to wait for the trial to end) -->
                    <TextBlock Text="تفعيل فوري برقم السيريال" FontSize="13" FontWeight="SemiBold"
                               Foreground="#F1F5F9" Margin="0,0,0,4"/>
                    <TextBlock Text="أدخل السيريال (APX-XXXXX-XXXXX-XXXXX) للتفعيل مباشرةً دون انتظار انتهاء الفترة التجريبية."
                               FontSize="12" Foreground="#64748B" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding SerialKey, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsNotActivating}"
                                 FontFamily="Consolas" FontSize="14" Padding="12,10"
                                 VerticalContentAlignment="Center" MinWidth="220"
                                 Background="#0F172A" Foreground="#E2E8F0" CaretBrush="#E2E8F0"
                                 BorderBrush="#334155" BorderThickness="1"/>
                        <Button Grid.Column="1" Command="{Binding ActivateWithSerialCommand}"
                                IsEnabled="{Binding IsNotActivating}" Margin="10,0,0,0" Cursor="Hand"
                                Padding="22,10" Background="#22C55E" BorderThickness="0"
                                Foreground="White" FontWeight="SemiBold" Content="تفعيل"/>
                    </Grid>
                    <TextBlock Text="{Binding OnlineStatus}" Foreground="{Binding OnlineStatusColor}"
                               FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap"/>

                    <Border Height="1" Background="#334155" Margin="0,0,0,16"/>
                    <TextBlock Text="أو لديك ملف ترخيص (.apex):" FontSize="12"
                               Foreground="#64748B" Margin="0,0,0,10"/>

                    <Button Command="{Binding ImportLicenseCommand}" HorizontalAlignment="Left"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" CornerRadius="8" Padding="20,12">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#2563EB" Offset="0"/>
                                            <GradientStop Color="#1D4ED8" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📂 " FontSize="15"/>
                                        <TextBlock Text="{DynamicResource LIC_013}" FontSize="14"
                                                   FontWeight="SemiBold" Foreground="White"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
    </Grid>
</UserControl>
