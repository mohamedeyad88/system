<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Apex.UI.ViewModels"
                    xmlns:v="clr-namespace:Apex.UI.Views">

    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
        <v:DashboardView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ImpositionViewModel}">
        <v:ImpositionView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:PageToolsViewModel}">
        <v:PageToolsView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:PrintManagerViewModel}">
        <v:PrintManagerView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <v:SettingsView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SystemPerformanceViewModel}">
        <v:SystemPerformanceView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:LogViewerViewModel}">
        <v:LogViewerWindow />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:NumberingWizardViewModel}">
        <v:NumberingWizardView />
    </DataTemplate>


    <DataTemplate DataType="{x:Type vm:LicensingViewModel}">
        <v:LicensingView />
    </DataTemplate>


    <DataTemplate DataType="{x:Type vm:ColorCalibrationViewModel}">
        <v:ColorCalibrationView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:TemplateDesignerViewModel}">
        <v:TemplateDesignerView />
    </DataTemplate>

</ResourceDictionary>
