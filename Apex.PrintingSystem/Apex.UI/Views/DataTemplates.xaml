<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Apex.UI.ViewModels"
                    xmlns:v="clr-namespace:Apex.UI.Views">

    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
        <v:DashboardView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:PrintersViewModel}">
        <v:PrintersView />
    </DataTemplate>
    
    <DataTemplate DataType="{x:Type vm:PrintManagerViewModel}">
        <v:PrintManagerView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <v:SettingsView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SystemPerformanceViewModel}">
        <v:SystemPerformanceView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:LogViewerViewModel}">
        <v:LogViewerWindow />
    </DataTemplate>
    
    <DataTemplate DataType="{x:Type vm:NumberedBooksViewModel}">
        <v:NumberingWizardView />
    </DataTemplate>
    
    <DataTemplate DataType="{x:Type vm:NumberingWizardViewModel}">
        <v:NumberingWizardView />
    </DataTemplate>
    
    <DataTemplate DataType="{x:Type vm:PrintOperationsViewModel}">
        <v:PrintOperationsView />
    </DataTemplate>
    
    <DataTemplate DataType="{x:Type vm:BatchPrintViewModel}">
        <v:BatchPrintView />
    </DataTemplate>
    
    <DataTemplate DataType="{x:Type vm:DistributionViewModel}">
        <v:DistributionView />
    </DataTemplate>
    
    <DataTemplate DataType="{x:Type vm:QuotationViewModel}">
        <v:QuotationView />
    </DataTemplate>

</ResourceDictionary>
