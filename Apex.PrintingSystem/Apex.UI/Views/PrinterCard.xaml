<UserControl x:Class="Apex.UI.Views.PrinterCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="280">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <!-- Modern Button -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Background" Value="#14181D"/>
            <Setter Property="Foreground" Value="#6B6864"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryCardButton" TargetType="Button" BasedOn="{StaticResource CardButton}">
            <Setter Property="Background" Value="#DBEAFE"/>
            <Setter Property="Foreground" Value="#0E7490"/>
        </Style>
    </UserControl.Resources>
    
    <Border CornerRadius="16" Padding="20">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="White" Offset="0"/>
                <GradientStop Color="#FAFBFC" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.08" Color="#000"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Icon -->
                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Margin="0,0,12,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0891B2" Offset="0"/>
                            <GradientStop Color="#0E7490" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="🖨️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#6B6864" Margin="0,2,0,0"/>
                </StackPanel>
                
                <!-- Status Indicator -->
                <Border Grid.Column="2" Width="10" Height="10" CornerRadius="5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#B42318"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                    <Setter Property="Background" Value="#1B7F4C"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>

            <!-- Stats & Badges -->
            <StackPanel Grid.Row="1">
                <!-- Queue Info -->
                <Border Background="#FAF9F7" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource PrinterCard_QueueLength}" FontSize="11" Foreground="#6B6864"/>
                            <TextBlock Text="{Binding QueueLength, StringFormat='{}{0} jobs'}" FontWeight="Bold" FontSize="16" Foreground="#FFFFFF"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#DBEAFE" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding JobsToday, StringFormat='{}{0} today'}" FontSize="11" Foreground="#0E7490"/>
                        </Border>
                    </Grid>
                </Border>
                
                <!-- Alert Badges -->
                <WrapPanel Margin="0,0,0,8">
                    <Border Background="#FEF3C7" CornerRadius="6" Padding="8,4" Margin="0,0,6,4" 
                            Visibility="{Binding HasPaperJam, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="⚠️ Paper Jam" Foreground="#B45309" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#FEE2E2" CornerRadius="6" Padding="8,4" Margin="0,0,6,4"
                            Visibility="{Binding IsTonerLow, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="🔴 Low Toner" Foreground="#B91C1C" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </WrapPanel>
                
                <!-- Capability Badges -->
                <WrapPanel>
                    <Border Background="#D1FAE5" CornerRadius="6" Padding="8,4" Margin="0,0,6,4"
                            Visibility="{Binding Capabilities.CanPrintColor, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="🎨 Color" Foreground="#047857" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#E0E7FF" CornerRadius="6" Padding="8,4" Margin="0,0,6,4"
                            Visibility="{Binding Capabilities.CanDuplex, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="📄 Duplex" Foreground="#4338CA" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#FCE7F3" CornerRadius="6" Padding="8,4" Margin="0,0,6,4"
                            Visibility="{Binding Capabilities.CanStaple, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="📎 Staple" Foreground="#0E7490" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </WrapPanel>
            </StackPanel>

            <!-- Actions -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="🧪 Test" Style="{StaticResource PrimaryCardButton}" Margin="0,0,4,0"
                        Command="{Binding DataContext.TestPrintCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"/>
                <Button Grid.Column="1" Content="📋 Queue" Style="{StaticResource CardButton}" Margin="4,0"/>
                <Button Grid.Column="2" Content="⚙️" Style="{StaticResource CardButton}" Margin="4,0,0,0" Width="40"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
