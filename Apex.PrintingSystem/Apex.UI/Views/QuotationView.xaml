<UserControl x:Class="Apex.UI.Views.QuotationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Apex.UI.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="#0F172A">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel: Input Form -->
        <Border Grid.Column="0"
                Background="{DynamicResource Brush.Surface}"
                CornerRadius="12"
                Margin="16,16,8,16"
                Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Header -->
                    <TextBlock Text="{DynamicResource Quotation_BasicDetails}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Primary}"
                               Margin="0,0,0,16"/>

                    <!-- Customer Name -->
                    <TextBlock Text="{DynamicResource Settings_CompanyName}" Margin="0,0,0,4"
                               Foreground="{DynamicResource Brush.Text.Secondary}"/>
                    <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"
                             Padding="12,8" Margin="0,0,0,12"/>

                    <!-- Job Description -->
                    <TextBlock Text="{DynamicResource Quotation_JobDescription}" Margin="0,0,0,4"
                               Foreground="{DynamicResource Brush.Text.Secondary}"/>
                    <TextBox Text="{Binding JobDescription, UpdateSourceTrigger=PropertyChanged}"
                             Padding="12,8" Margin="0,0,0,16"/>

                    <Separator Margin="0,0,0,16"/>

                    <!-- Pages & Copies -->
                    <TextBlock Text="{DynamicResource Quotation_PrintDetails}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Primary}"
                               Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="{DynamicResource Quotation_TotalPages}" Margin="0,0,0,4"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"/>
                            <TextBox Text="{Binding TotalPages, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="12,8"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="{DynamicResource Quotation_Quantity}" Margin="0,0,0,4"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"/>
                            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="12,8"/>
                        </StackPanel>
                    </Grid>

                    <!-- Print Options -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <CheckBox Content="{DynamicResource Quotation_DoubleSided}"
                                  IsChecked="{Binding IsDoubleSided}"
                                  Margin="0,0,16,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <CheckBox Content="{DynamicResource Distribution_PrintInColor}"
                                  IsChecked="{Binding IsColor}"/>
                    </StackPanel>

                    <!-- Paper Type -->
                    <TextBlock Text="{DynamicResource Quotation_PricePerSheet}" Margin="0,0,0,4"
                               Foreground="{DynamicResource Brush.Text.Secondary}"/>
                    <ComboBox ItemsSource="{Binding AvailablePaperTypes}"
                              SelectedItem="{Binding SelectedPaper}"
                              DisplayMemberPath="Name"
                              Padding="12,8" Margin="0,0,0,16"/>

                    <Separator Margin="0,0,0,16"/>

                    <!-- Cover Options -->
                    <TextBlock Text="{DynamicResource Quotation_CoverOptions}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Primary}"
                               Margin="0,0,0,12"/>

                    <CheckBox Content="{DynamicResource Quotation_AddCover}"
                              IsChecked="{Binding HasCover}"
                              Margin="0,0,0,8"/>

                    <StackPanel Visibility="{Binding HasCover, Converter={StaticResource BoolToVisibility}}"
                                Margin="20,0,0,12">
                        <TextBlock Text="{DynamicResource Quotation_CoverPrice}" Margin="0,0,0,4"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"/>
                        <TextBox Text="{Binding CoverCost, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                                 Padding="12,8" Margin="0,0,0,8"/>

                        <CheckBox Content="{DynamicResource Quotation_FinishingServices}"
                                  IsChecked="{Binding HasLamination}"
                                  Margin="0,0,0,8"/>

                        <StackPanel Visibility="{Binding HasLamination, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{DynamicResource Quotation_FinishingCost}" Margin="0,0,0,4"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"/>
                            <TextBox Text="{Binding LaminationCost, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                                     Padding="12,8"/>
                        </StackPanel>
                    </StackPanel>

                    <Separator Margin="0,0,0,16"/>

                    <!-- Cost Settings -->
                    <TextBlock Text="{DynamicResource Quotation_CostBreakdown}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Primary}"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="{DynamicResource Quotation_PrintingCost}" Margin="0,0,0,4"
                               Foreground="{DynamicResource Brush.Text.Secondary}"/>
                    <TextBox Text="{Binding InkCostPerPage, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                             Padding="12,8" Margin="0,0,0,12"/>

                    <TextBlock Text="{DynamicResource Settings_Financial}" Margin="0,0,0,4"
                               Foreground="{DynamicResource Brush.Text.Secondary}"/>
                    <TextBox Text="{Binding SetupCost, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                             Padding="12,8" Margin="0,0,0,16"/>

                    <Separator Margin="0,0,0,16"/>

                    <!-- Manual Discount -->
                    <TextBlock Text="{DynamicResource Quotation_ManualDiscount}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Primary}"
                               Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Quotation_ManualDiscountHint}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   FontSize="12" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding ManualDiscountPercent, UpdateSourceTrigger=PropertyChanged, Delay=500, StringFormat={}{0:F0}}"
                                 Padding="12,8" TextAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{Binding ManualDiscountPercent, StringFormat={}{0:F0}%}"
                               Foreground="#F59E0B" FontWeight="Bold" FontSize="13"
                               HorizontalAlignment="Right" Margin="0,4,0,16"
                               Visibility="{Binding ManualDiscountPercent, Converter={StaticResource BoolToVisibility}}"/>

                    <Separator Margin="0,0,0,16"/>

                    <!-- Reset Button -->
                    <Button Content="{DynamicResource Quotation_Reset}"
                            Command="{Binding ResetToDefaultsCommand}"
                            Padding="16,10"
                            Background="{DynamicResource Brush.Slate.500}"
                            Foreground="White"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Center Panel -->
        <Grid Grid.Column="1" Margin="8,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Price Summary Cards -->
            <StackPanel Grid.Row="0">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Per Copy Price -->
                    <Border Grid.Column="0" CornerRadius="12" Padding="20" Margin="0,0,8,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3B82F6" Offset="0"/>
                                <GradientStop Color="#2563EB" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource CostCalc_FinalPrice}"
                                       Foreground="White" FontSize="14" Opacity="0.9"/>
                            <TextBlock Text="{Binding PricePerCopyAfterDiscount, StringFormat={}{0:F2} EGP}"
                                       Foreground="White" FontSize="32" FontWeight="Bold" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Total Price -->
                    <Border Grid.Column="1" CornerRadius="12" Padding="20" Margin="8,0,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#10B981" Offset="0"/>
                                <GradientStop Color="#059669" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource CostCalc_TotalCost}"
                                       Foreground="White" FontSize="14" Opacity="0.9"/>
                            <TextBlock Text="{Binding TotalPrice, StringFormat={}{0:F2} EGP}"
                                       Foreground="White" FontSize="32" FontWeight="Bold" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding Quantity, StringFormat={}{0}}"
                                       Foreground="White" FontSize="12" Opacity="0.8"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Discount Badge -->
                <Border CornerRadius="8" Padding="12,8" Margin="0,0,0,8"
                        HorizontalAlignment="Center"
                        Visibility="{Binding AppliedDiscountPercent, Converter={StaticResource BoolToVisibility}}">
                    <Border.Background>
                        <SolidColorBrush Color="#F59E0B"/>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🏷️ " Foreground="White"/>
                        <TextBlock Text="{Binding AppliedDiscountPercent, StringFormat={}{0:F0}%}"
                                   Foreground="White" FontWeight="Bold"/>
                        <TextBlock Text=" = " Foreground="White"/>
                        <TextBlock Text="{Binding DiscountAmount, StringFormat={}{0:F2} EGP}"
                                   Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Scrollable Middle Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                <StackPanel>

                    <!-- Cost Breakdown -->
                    <Border Background="{DynamicResource Brush.Surface}" CornerRadius="12" Padding="20" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="{DynamicResource Quotation_CostBreakdown}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Primary}"
                                       Margin="0,0,0,16"/>

                            <StackPanel Grid.Row="1">
                                <!-- Paper Cost -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Quotation_SheetsRequired}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding SheetsPerCopy, StringFormat={}{0}}"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="12"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding PaperCostPerCopy, StringFormat={}{0:F2} EGP}"
                                               FontWeight="SemiBold"/>
                                </Grid>

                                <!-- Ink Cost -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Quotation_PrintingCost}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding InkCostPerCopy, StringFormat={}{0:F2} EGP}"
                                               FontWeight="SemiBold"/>
                                </Grid>

                                <!-- Cover Cost -->
                                <Grid Margin="0,0,0,8"
                                      Visibility="{Binding HasCover, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Quotation_CoverCost}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding CoverCostPerCopy, StringFormat={}{0:F2} EGP}"
                                               FontWeight="SemiBold"/>
                                </Grid>

                                <Separator Margin="0,8"/>

                                <!-- Total per copy -->
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Quotation_FinalPrice}"
                                               FontSize="16" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.Primary}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding PricePerCopyAfterDiscount, StringFormat={}{0:F2} EGP}"
                                               FontSize="16" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.Primary}"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Quantity Comparison Table -->
                    <Border Background="{DynamicResource Brush.Surface}" CornerRadius="12" Padding="16" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Quotation_ComparisonTable}"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Primary}"
                                       Margin="0,0,0,12"/>

                            <!-- Table Header -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Quotation_Qty}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                <TextBlock Grid.Column="1" Text="{DynamicResource Quotation_PerCopy}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                <TextBlock Grid.Column="2" Text="{DynamicResource Quotation_Total}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                <TextBlock Grid.Column="3" Text="{DynamicResource Quotation_Discount}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding ComparisonPoints}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="4,8" Margin="0,2">
                                            <Border.Background>
                                                <SolidColorBrush Color="#1E293B"/>
                                            </Border.Background>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Quantity}" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding PricePerCopy, StringFormat={}{0:F2} EGP}"
                                                           FontSize="13"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding TotalPrice, StringFormat={}{0:F2} EGP}"
                                                           FontSize="13"/>
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding AppliedDiscount, StringFormat={}{0:F0}%}"
                                                           Foreground="#10B981" FontWeight="SemiBold" FontSize="13"
                                                           Visibility="{Binding AppliedDiscount, Converter={StaticResource BoolToVisibility}}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Saved Quotes -->
                    <Border Background="{DynamicResource Brush.Surface}" CornerRadius="12" Padding="16"
                            Visibility="{Binding HasSavedQuotes, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Quotation_SavedQuotes}"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Primary}"
                                       Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding SavedQuotes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="12,10" Margin="0,0,0,6">
                                            <Border.Background>
                                                <SolidColorBrush Color="#1E293B"/>
                                            </Border.Background>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding CustomerName}"
                                                               FontWeight="SemiBold" FontSize="13"/>
                                                    <TextBlock Text="{Binding SavedDate, StringFormat={}{0:dd/MM/yyyy  HH:mm}}"
                                                               Foreground="{DynamicResource Brush.Text.Secondary}"
                                                               FontSize="11" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding Quantity, StringFormat={}{0} نسخة}"
                                                               Foreground="{DynamicResource Brush.Text.Secondary}"
                                                               FontSize="11"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding TotalPrice, StringFormat={}{0:F2} EGP}"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource Brush.Primary}"
                                                           VerticalAlignment="Center" FontSize="14"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Action Buttons -->
            <WrapPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,12,0,0">
                <!-- Save Quote -->
                <Button Command="{Binding SaveQuoteCommand}"
                        Padding="20,12" Margin="0,0,8,8" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#7C3AED" CornerRadius="8" Padding="20,12">
                                <TextBlock Text="{DynamicResource Quotation_SaveQuote}" Foreground="White"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <!-- Share WhatsApp -->
                <Button Command="{Binding ShareViaWhatsAppCommand}"
                        Padding="20,12" Margin="0,0,8,8" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#25D366" CornerRadius="8" Padding="20,12">
                                <TextBlock Text="{DynamicResource Quotation_ShareWhatsApp}" Foreground="White"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <!-- Copy -->
                <Button Command="{Binding CopyToClipboardCommand}"
                        Padding="20,12" Margin="0,0,8,8" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#64748B" CornerRadius="8" Padding="20,12">
                                <TextBlock Text="{DynamicResource Quotation_CopyButton}" Foreground="White"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <!-- Export HTML -->
                <Button Command="{Binding ExportToHtmlCommand}"
                        Padding="20,12" Margin="0,0,8,8" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#2563EB" CornerRadius="8" Padding="20,12">
                                <TextBlock Text="{DynamicResource Quotation_ExportHtmlButton}" Foreground="White"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <!-- Export PDF -->
                <Button Command="{Binding ExportToPdfCommand}"
                        Padding="20,12" Margin="0,0,8,8" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#DC2626" CornerRadius="8" Padding="20,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📄 " Foreground="White"/>
                                    <TextBlock Text="تصدير PDF" Foreground="White"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <!-- Print -->
                <Button Command="{Binding PrintCommand}"
                        Padding="20,12" Margin="0,0,0,8" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#10B981" CornerRadius="8" Padding="20,12">
                                <TextBlock Text="{DynamicResource Quotation_PrintButton}" Foreground="White"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </WrapPanel>
        </Grid>

    </Grid>
</UserControl>
