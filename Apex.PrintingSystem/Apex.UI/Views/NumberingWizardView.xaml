<UserControl x:Class="Apex.UI.Views.NumberingWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1400"
             Background="{DynamicResource Brush.Background}">
    
    <UserControl.Resources>

        <!-- Ruler Brushes -->
        <DrawingBrush x:Key="HorizontalRulerBrush" Viewport="0,0,50,30" ViewportUnits="Absolute" TileMode="Tile">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#D1D5DB">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <!-- Major Tick (every 50px) -->
                                <LineGeometry StartPoint="0,15" EndPoint="0,30"/>
                                <!-- Minor Ticks -->
                                <LineGeometry StartPoint="10,25" EndPoint="10,30"/>
                                <LineGeometry StartPoint="20,25" EndPoint="20,30"/>
                                <LineGeometry StartPoint="30,25" EndPoint="30,30"/>
                                <LineGeometry StartPoint="40,25" EndPoint="40,30"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#9CA3AF" Thickness="1"/>
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <DrawingBrush x:Key="VerticalRulerBrush" Viewport="0,0,30,50" ViewportUnits="Absolute" TileMode="Tile">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#D1D5DB">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <!-- Major Tick -->
                                <LineGeometry StartPoint="15,0" EndPoint="30,0"/>
                                <!-- Minor Ticks -->
                                <LineGeometry StartPoint="25,10" EndPoint="30,10"/>
                                <LineGeometry StartPoint="25,20" EndPoint="30,20"/>
                                <LineGeometry StartPoint="25,30" EndPoint="30,30"/>
                                <LineGeometry StartPoint="25,40" EndPoint="30,40"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#9CA3AF" Thickness="1"/>
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- LEFT PANEL: Settings -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Start Number -->
                    <TextBlock Text="{DynamicResource Numbering_StartNumber}" Style="{DynamicResource FieldLabel}"/>
                    <TextBox Text="{Binding StartNumber, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DarkInput}" Margin="0,0,0,16"/>
                    
                    <!-- Total Numbers -->
                    <TextBlock Text="{DynamicResource Numbering_TotalNumbers}" Style="{DynamicResource FieldLabel}"/>
                    <TextBox Text="{Binding TotalNumbers, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DarkInput}" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>
                    
                    <!-- Copies Per Number -->
                    <TextBlock Text="{DynamicResource Numbering_CopiesPerNumber}" Style="{DynamicResource SectionLabel}"/>
                    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border.Light}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                        <StackPanel>
                            <CheckBox Content="Copy 1" Foreground="{DynamicResource TextPrimary}" IsChecked="{Binding UseCopy1}" Margin="0,0,0,8"/>
                            <CheckBox Content="Copy 2" Foreground="{DynamicResource TextPrimary}" IsChecked="{Binding UseCopy2}" Margin="0,0,0,8"/>
                            <CheckBox Content="Copy 3" Foreground="{DynamicResource TextPrimary}" IsChecked="{Binding UseCopy3}"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Numbering Mode -->
                    <TextBlock Text="{DynamicResource Numbering_NumberingMode}" Style="{DynamicResource SectionLabel}"/>
                    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border.Light}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                        <StackPanel>
                            <RadioButton Content="Auto Detect" Foreground="{DynamicResource TextPrimary}" IsChecked="{Binding IsAutoDetect}" GroupName="Mode" Margin="0,0,0,8">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="Bd" Background="{DynamicResource Brush.Success}" CornerRadius="4" Padding="12,8" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Fill="White" Margin="0,0,8,0"/>
                                                <ContentPresenter VerticalAlignment="Center"/>
                                                <TextBlock Text="✓" Foreground="White" Margin="8,0,0,0" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>
                            <RadioButton Content="Shershara (Linear)" Foreground="{DynamicResource TextSecondary}" IsChecked="{Binding IsLinearMode}" GroupName="Mode" Margin="0,0,0,8"/>
                            <RadioButton Content="Cutting (Imposed)" Foreground="{DynamicResource TextSecondary}" IsChecked="{Binding IsImposedMode}" GroupName="Mode" Margin="0,0,0,8"/>
                            <RadioButton Content="Custom Pattern" Foreground="{DynamicResource TextSecondary}" GroupName="Mode"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Action Buttons -->
                    <TextBlock Text="{DynamicResource Numbering_SlotActions}" Style="{DynamicResource SectionLabel}"/>
                    <Button Content="📂 Load Template" Command="{Binding LoadTemplateCommand}" Style="{DynamicResource ActionButton}" Margin="0,0,0,8"/>
                    <Button Content="➕ Add Slot" Command="{Binding AddSlotCommand}" Style="{DynamicResource ActionButton}" Margin="0,0,0,8"/>
                    <Button Content="🗑️ Delete Slot" Command="{Binding DeleteSelectedSlotCommand}" 
                            Background="#EF4444" Style="{DynamicResource ActionButton}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        
        <!-- CENTER: Canvas with Template -->
        <Grid Grid.Column="1" Background="#E5E7EB" Margin="1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Canvas Area with Integrated Rulers -->
            <Border Grid.Row="1" Grid.Column="1" Background="#F3F4F6" Padding="10">
                <Grid>
                    <!-- Zoomable Container -->
                    <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="Auto"/> <!-- Canvas Width -->
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="Auto"/> <!-- Canvas Height -->
                            </Grid.RowDefinitions>

                            <!-- Rulers Background -->
                            <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource HorizontalRulerBrush}" BorderBrush="#555" BorderThickness="0,0,0,1"/>
                            <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource VerticalRulerBrush}" BorderBrush="#555" BorderThickness="0,0,1,0"/>
                            
                            <!-- Measurement Ticks (Visual Only, assuming 100px major steps) -->
                             <!-- We use a visual brush in resources or code. For simplicity, just basic border for now 
                                  as creating a vector ruler in XAML without binding is static. 
                                  User asked for "Rulers". We provide the area. 
                                  To make it look like a ruler, we can use a LinearGradient or DrawingBrush. -->
                            
                            <!-- Template Canvas -->
                            <Canvas x:Name="TemplateCanvas" 
                                    Grid.Row="1" Grid.Column="1"
                                    Width="{Binding CanvasWidth}" 
                                    Height="{Binding CanvasHeight}" 
                                    Background="White" 
                                    ClipToBounds="True"
                                    MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                                    MouseMove="Canvas_MouseMove"
                                    MouseLeftButtonUp="Canvas_MouseLeftButtonUp">
                                <Canvas.Effect>
                                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.3" Color="#000"/>
                                </Canvas.Effect>
                                
                                <!-- Template Image -->
                                <Image Source="{Binding TemplateImage}" 
                                       Width="{Binding CanvasWidth}" 
                                       Height="{Binding CanvasHeight}" 
                                       Stretch="Fill"/>
                                
                                <!-- Number Slots -->
                                <ItemsControl ItemsSource="{Binding Slots}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource NormalizedToPixelConverter}">
                                                        <Binding Path="X"/>
                                                        <Binding Path="DataContext.CanvasWidth" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Canvas.Top">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource NormalizedToPixelConverter}">
                                                        <Binding Path="Y"/>
                                                        <Binding Path="DataContext.CanvasHeight" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Number Text Only - With Rotation Support -->
                                            <Border Background="Transparent" 
                                                    BorderBrush="{Binding IsSelected, Converter={StaticResource BooleanToColorConverter}, FallbackValue=Transparent}"
                                                    BorderThickness="1"
                                                    Padding="4"
                                                    Cursor="SizeAll"
                                                    Tag="{Binding}"
                                                    RenderTransformOrigin="0.5,0.5"
                                                    Opacity="{Binding Opacity, Converter={StaticResource PercentToOpacityConverter}}"
                                                    MouseLeftButtonDown="Slot_MouseLeftButtonDown">
                                                <Border.RenderTransform>
                                                    <RotateTransform Angle="{Binding Rotation}"/>
                                                </Border.RenderTransform>
                                                <TextBlock Text="{Binding PreviewNumber}" 
                                                           Foreground="{Binding FontColor, FallbackValue=Black, TargetNullValue=Black}"
                                                           FontFamily="{Binding FontFamily}"
                                                           FontSize="{Binding FontSize}"
                                                           FontWeight="{Binding IsBold, Converter={StaticResource BoolToFontWeightConverter}}"
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>
                        </Grid>
                    </Viewbox>
                    
                    <!-- Zoom Controls -->
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10">
                        <Button Content="+" Width="32" Height="32" Background="{DynamicResource Brush.Surface.Highlight}" Foreground="White" 
                                BorderThickness="0" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"
                                Command="{Binding ZoomInCommand}"/>
                        <Button Content="−" Width="32" Height="32" Background="{DynamicResource Brush.Surface.Highlight}" Foreground="White" 
                                BorderThickness="0" FontSize="18" FontWeight="Bold"
                                Command="{Binding ZoomOutCommand}"/>
                    </StackPanel>
                    
                    <Button Content="⛶ fit to screen" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                            Background="{DynamicResource Brush.Surface.Highlight}" Foreground="{DynamicResource Brush.Text.Secondary}"
                            Padding="10,6" BorderThickness="0" Margin="0,0,50,10"
                            Command="{Binding FitToScreenCommand}"/>
                </Grid>
            </Border>
        </Grid>
        
        <!-- RIGHT PANEL: Typography -->
        <Border Grid.Column="2" Background="{DynamicResource Brush.Surface}" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Numbering_Typography}" Style="{DynamicResource SectionLabel}" FontSize="16"/>
                    
                    <!-- Font Family -->
                    <TextBlock Text="{DynamicResource Numbering_Font}" Style="{DynamicResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding AvailableFonts}" 
                              SelectedItem="{Binding SelectedSlot.FontFamily, Mode=TwoWay}" 
                              Background="White" 
                              Foreground="#1A1A1A" 
                              Padding="10" Margin="0,0,0,16">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="#1A1A1A"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    
                    <!-- Font Size -->
                    <TextBlock Text="{DynamicResource Numbering_FontSize}" Style="{DynamicResource FieldLabel}"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Slider Value="{Binding SelectedSlot.FontSize, Mode=TwoWay, FallbackValue=24}" Minimum="8" Maximum="72" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding SelectedSlot.FontSize, StringFormat='{}{0}pt', FallbackValue='24pt'}" 
                                   Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                    
                    <!-- Font Weight -->
                    <TextBlock Text="{DynamicResource Numbering_FontWeight}" Style="{DynamicResource FieldLabel}"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{Binding IsBold, Converter={StaticResource InverseBoolToColorConverter}, FallbackValue=#2D323C}" 
                                CornerRadius="4,0,0,4" Padding="12,8" Cursor="Hand"
                                MouseLeftButtonDown="RegularWeight_Click">
                            <TextBlock Text="{DynamicResource Numbering_Regular}" Foreground="White" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="1" 
                                Background="{Binding IsBold, Converter={StaticResource BoolToColorConverter}, FallbackValue=#2D323C}" 
                                CornerRadius="0,4,4,0" Padding="12,8" Cursor="Hand"
                                MouseLeftButtonDown="BoldWeight_Click">
                            <TextBlock Text="{DynamicResource Numbering_Bold}" Foreground="White" HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>
                    
                    <!-- Color -->
                    <TextBlock Text="{DynamicResource Numbering_Color}" Style="{DynamicResource FieldLabel}"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{Binding SelectedSlot.FontColor, FallbackValue='#000000'}" CornerRadius="4" Width="32" Height="32"/>
                        <TextBox Grid.Column="1" Text="{Binding SelectedSlot.FontColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue='#000000'}" 
                                  Margin="8,0,0,0"/>
                    </Grid>
                    
                    <!-- Alignment -->
                    <TextBlock Text="{DynamicResource Numbering_Alignment}" Style="{DynamicResource FieldLabel}"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource Brush.Surface.Highlight}" CornerRadius="4,0,0,4" Padding="10,8" Cursor="Hand"
                                MouseLeftButtonDown="AlignLeft_Click">
                            <TextBlock Text="≡" Foreground="{DynamicResource Brush.Text.Secondary}" HorizontalAlignment="Center" FontSize="16"/>
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource Brush.Primary}" Padding="10,8" Cursor="Hand"
                                MouseLeftButtonDown="AlignCenter_Click">
                            <TextBlock Text="≡" Foreground="White" HorizontalAlignment="Center" FontSize="16"/>
                        </Border>
                        <Border Grid.Column="2" Background="{DynamicResource Brush.Surface.Highlight}" CornerRadius="0,4,4,0" Padding="10,8" Cursor="Hand"
                                MouseLeftButtonDown="AlignRight_Click">
                            <TextBlock Text="≡" Foreground="{DynamicResource Brush.Text.Secondary}" HorizontalAlignment="Center" FontSize="16"/>
                        </Border>
                    </Grid>
                    
                    <!-- Rotation -->
                    <TextBlock Text="{DynamicResource Numbering_Rotation}" Style="{DynamicResource FieldLabel}"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource Brush.Primary}" CornerRadius="4,0,0,4" Padding="8,6" Cursor="Hand"
                                MouseLeftButtonDown="Rotation0_Click">
                            <TextBlock Text="0°" Foreground="White" HorizontalAlignment="Center" FontSize="12"/>
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource Brush.Surface.Highlight}" Padding="8,6" Cursor="Hand"
                                MouseLeftButtonDown="Rotation90_Click">
                            <TextBlock Text="90°" Foreground="{DynamicResource Brush.Text.Secondary}" HorizontalAlignment="Center" FontSize="12"/>
                        </Border>
                        <Border Grid.Column="2" Background="{DynamicResource Brush.Surface.Highlight}" Padding="8,6" Cursor="Hand"
                                MouseLeftButtonDown="Rotation180_Click">
                            <TextBlock Text="180°" Foreground="{DynamicResource Brush.Text.Secondary}" HorizontalAlignment="Center" FontSize="12"/>
                        </Border>
                        <Border Grid.Column="3" Background="{DynamicResource Brush.Surface.Highlight}" CornerRadius="0,4,4,0" Padding="8,6" Cursor="Hand"
                                MouseLeftButtonDown="Rotation270_Click">
                            <TextBlock Text="270°" Foreground="{DynamicResource Brush.Text.Secondary}" HorizontalAlignment="Center" FontSize="12"/>
                        </Border>
                    </Grid>
                    
                    <!-- Opacity -->
                    <TextBlock Text="{DynamicResource Numbering_Opacity}" Style="{DynamicResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Slider Value="{Binding SelectedSlot.Opacity, Mode=TwoWay, FallbackValue=100}" Minimum="0" Maximum="100" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding SelectedSlot.Opacity, StringFormat='{}{0}%', FallbackValue='100%'}" 
                                   Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
        
        <!-- BOTTOM: Preview, Print Settings and Progress -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{DynamicResource Brush.Surface}" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>
                
                <!-- Preview Thumbnails -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource Numbering_Preview}" Foreground="{DynamicResource Brush.Text.Primary}" FontWeight="SemiBold" 
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding TotalPages}" Foreground="{DynamicResource Brush.Text.Secondary}" 
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Border Background="{DynamicResource Brush.Surface.Highlight}" CornerRadius="4" Width="60" Height="80" Margin="0,0,8,0">
                        <TextBlock Text="P1" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="10" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Background="{DynamicResource Brush.Surface.Highlight}" CornerRadius="4" Width="60" Height="80" Margin="0,0,8,0">
                        <TextBlock Text="P2" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="10" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
                
                <!-- Print Progress (Center) -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="40,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Visibility="{Binding IsPrinting, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="🖨️ Printing..." Foreground="{DynamicResource AccentBlue}" FontWeight="SemiBold" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding PrintProgress, StringFormat='{}{0}%'}" Foreground="{DynamicResource Brush.Text.Primary}" FontWeight="Bold"/>
                    </StackPanel>
                    <ProgressBar Value="{Binding PrintProgress}" Maximum="100" Height="6" 
                                 Background="{DynamicResource Brush.Surface.Highlight}" Foreground="{DynamicResource AccentGreen}"
                                 Visibility="{Binding IsPrinting, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding PrintStatus}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="12" Margin="0,4,0,0"
                               Visibility="{Binding IsPrinting, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
                
                <!-- Printer Selection (Before Actions) -->
                <StackPanel Grid.Column="2" Margin="0,0,20,0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Numbering_Printer}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding AvailablePrinters}" 
                              SelectedItem="{Binding SelectedPrinter}"
                              Background="White"
                              Foreground="#1A1A1A"
                              Width="180">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="#1A1A1A" Padding="5,3"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                
                <!-- Unified Action Bar -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Cancel Button (visible during printing) -->
                    <Button Content="⏹️ Cancel" Background="{DynamicResource Brush.Error}" Style="{DynamicResource Button.Primary}" 
                            Width="100" Margin="0,0,8,0"
                            Command="{Binding CancelCommand}"
                            Visibility="{Binding IsPrinting, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    
                    <!-- Pause/Resume Button (visible during printing) -->
                    <Button Width="100" Margin="0,0,8,0"
                            Command="{Binding PauseResumeCommand}"
                            Visibility="{Binding IsPrinting, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                <Setter Property="Content" Value="⏸️ Pause"/>
                                <Setter Property="Background" Value="#F59E0B"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                        <Setter Property="Content" Value="▶️ Resume"/>
                                        <Setter Property="Background" Value="#22C55E"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    
                    <!-- Print Button -->
                    <Button Content="🖨️ Print" Style="{DynamicResource Button.Primary}" Width="100" Margin="0,0,8,0"
                            Command="{Binding StartPrintCommand}"
                            IsEnabled="{Binding IsPrinting, Converter={StaticResource InverseBoolConverter}}"/>
                    
                    <!-- Stream Print Button (Primary) -->
                    <Button Content="⚡ Stream" Style="{DynamicResource Button.Success}" Width="100"
                            Command="{Binding StartStreamPrintCommand}"
                            IsEnabled="{Binding IsPrinting, Converter={StaticResource InverseBoolConverter}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
