                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Numbering_Suffix}" FontSize="10" Foreground="{DynamicResource Muted}"/>
                                        <TextBox Text="{Binding NumberSuffix, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="70" Padding="6,4" Background="#FAF9F7" Foreground="#14181D"
                                                 BorderBrush="{DynamicResource Border}" BorderThickness="1" CaretBrush="#14181D"/>
                                    </StackPanel>
                                </StackPanel>
                                <!-- Live example of what will actually print -->
