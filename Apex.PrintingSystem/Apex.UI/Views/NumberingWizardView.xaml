<UserControl x:Class="Apex.UI.Views.NumberingWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:controls="clr-namespace:Apex.UI.Controls"
            xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:models="clr-namespace:Apex.UI.Models"
             xmlns:converters="clr-namespace:Apex.UI.Converters"
             xmlns:vm="clr-namespace:Apex.UI.ViewModels"
             mc:Ignorable="d" d:DesignHeight="900" d:DesignWidth="1600">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:GuideLineX1Converter x:Key="GuideLineX1Converter"/>
        <converters:GuideLineY1Converter x:Key="GuideLineY1Converter"/>
        <converters:GuideLineX2Converter x:Key="GuideLineX2Converter"/>
        <converters:GuideLineY2Converter x:Key="GuideLineY2Converter"/>
        <converters:WorkflowModeToBoolConverter x:Key="WorkflowModeToBoolConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisConverter"/>
        <converters:NullToBoolConverter x:Key="NullToBoolConverter"/>
        <converters:GreaterThanZeroToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <converters:InverseCountToVisibilityConverter x:Key="CountToHiddenConverter"/>
        <converters:FileNameOnlyConverter x:Key="FileNameOnlyConverter"/>
        <converters:NormalizedToPixelConverter x:Key="NormalizedToPixelConverter"/>
        <converters:BooleanToColorConverter x:Key="BooleanToColorConverter"/>
        <converters:InverseBoolToColorConverter x:Key="InverseBoolToColorConverter"/>
        <converters:PercentToOpacityConverter x:Key="PercentToOpacityConverter"/>
        <converters:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter"/>
        <converters:LongToStringConverter x:Key="LongToStringConverter"/>
        <converters:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
        <converters:DivideByTwoConverter x:Key="DivideByTwoConverter"/>
        
        <!-- ═══════════════════════════════════════════════════════════════════
             🎨 DARK CONTENT THEME
             ═══════════════════════════════════════════════════════════════════ -->

        <!-- Background - Dark -->
        <LinearGradientBrush x:Key="BackgroundGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FAF9F7" Offset="0"/>
            <GradientStop Color="#FFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <!-- Card Gradient (Dark) -->
        <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#FAF9F7" Offset="1"/>
        </LinearGradientBrush>
        
        <!-- Primary Button Gradient -->
        <LinearGradientBrush x:Key="PrimaryButtonGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0891B2" Offset="0"/>
            <GradientStop Color="#0891B2" Offset="1"/>
        </LinearGradientBrush>
        
        <LinearGradientBrush x:Key="PrimaryButtonHoverGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0891B2" Offset="0"/>
            <GradientStop Color="#0891B2" Offset="1"/>
        </LinearGradientBrush>
        
        <!-- Success Button Gradient -->
        <LinearGradientBrush x:Key="SuccessButtonGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1B7F4C" Offset="0"/>
            <GradientStop Color="#1B7F4C" Offset="1"/>
        </LinearGradientBrush>
        
        <!-- Canvas Background (Design Area) -->
        <LinearGradientBrush x:Key="CanvasBackgroundGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#14181D" Offset="0"/>
            <GradientStop Color="#14181D" Offset="0.5"/>
            <GradientStop Color="#14181D" Offset="1"/>
        </LinearGradientBrush>
        
        <!-- Typography Panel Gradient -->
        <LinearGradientBrush x:Key="TypographyPanelGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#FAF9F7" Offset="1"/>
        </LinearGradientBrush>
        
        <!-- Ribbon Colors (Dark Theme) -->
        <SolidColorBrush x:Key="RibbonBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="RibbonTabActive" Color="#0891B2"/>
        <SolidColorBrush x:Key="RibbonTabInactive" Color="#FAF9F7"/>
        <SolidColorBrush x:Key="RibbonTabHover" Color="#DDD9D3"/>
        <SolidColorBrush x:Key="RibbonBorder" Color="#DDD9D3"/>

        <!-- Text Colors for Dark Theme -->
        <SolidColorBrush x:Key="TextPrimary" Color="#14181D"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#6B6864"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6B6864"/>

        <!-- Card Colors (Dark) -->
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#DDD9D3"/>
        <SolidColorBrush x:Key="CardHover" Color="#DDD9D3"/>
        
        <!-- ═══════════════════════════════════════════════════════════════════
             🎯 MODERN TAB CONTROL STYLE - تصميم التبويبات الحديث
             Light ribbon with visible tabs
             ═══════════════════════════════════════════════════════════════════ -->
        <Style x:Key="ModernTabItem" TargetType="TabItem">
            <!-- Idle text lightened for the dark ribbon (was #6B6864, too dim on #FAF9F7). -->
            <Setter Property="Foreground" Value="#6B6864"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" 
                                Background="#FAF9F7" 
                                BorderThickness="1"
                                BorderBrush="#DDD9D3"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                Margin="4,4,4,4">
                            <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#0891B2"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#0891B2"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <!-- Dark-theme hover (was #DDD9D3/#FFFFFF, a light-mode leftover). -->
                                <Setter TargetName="TabBorder" Property="Background" Value="#DDD9D3"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#6B6864"/>
                                <Setter Property="Foreground" Value="#14181D"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="#0891B2"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="ModernTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ModernTabItem}"/>
        </Style>
        
        <!-- Modern Tab as RadioButton - More Reliable -->
        <Style x:Key="ModernTabRadioButton" TargetType="RadioButton">
            <!-- Dark-theme idle state (was #6B6864 text on #F4F2EF, a light-mode leftover). -->
            <Setter Property="Foreground" Value="#6B6864"/>
            <Setter Property="Background" Value="#FAF9F7"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderThickness="1"
                                BorderBrush="#DDD9D3"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#0891B2"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#0891B2"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <!-- Dark-theme hover (was #DDD9D3, a light-mode leftover). -->
                                <Setter TargetName="TabBorder" Property="Background" Value="#DDD9D3"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#6B6864"/>
                                <Setter Property="Foreground" Value="#14181D"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="#0891B2"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Shadow Effects (Enhanced for Dark Theme) -->
        <DropShadowEffect x:Key="Shadow.Small" BlurRadius="15" ShadowDepth="3" Opacity="0.3" Color="#000000"/>
        <DropShadowEffect x:Key="Shadow.Medium" BlurRadius="25" ShadowDepth="6" Opacity="0.4" Color="#000000"/>
        <DropShadowEffect x:Key="Shadow.Large" BlurRadius="35" ShadowDepth="8" Opacity="0.5" Color="#000000"/>
        <DropShadowEffect x:Key="Shadow.Button" BlurRadius="12" ShadowDepth="4" Opacity="0.4" Color="#0891B2"/>
        <DropShadowEffect x:Key="Shadow.ButtonHover" BlurRadius="20" ShadowDepth="6" Opacity="0.5" Color="#0891B2"/>
        <DropShadowEffect x:Key="Shadow.Glow" BlurRadius="20" ShadowDepth="0" Opacity="0.3" Color="#0891B2"/>
        
        <!-- Button Animations -->
        <Storyboard x:Key="ButtonHoverStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                           To="1.05" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                           To="1.05" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        
        <Storyboard x:Key="ButtonClickStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                           To="0.95" Duration="0:0:0.1" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                           To="0.95" Duration="0:0:0.1" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        
        <Storyboard x:Key="ButtonExitStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                           To="1" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                           To="1" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        
        <!-- Tab Transition Animation -->
        <Storyboard x:Key="TabContentFadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        
        <!-- Pulse Animation for Important Buttons -->
        <Storyboard x:Key="PulseAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                           From="1" To="0.7" Duration="0:0:1.5" 
                           AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>
    
    <Grid Background="#FAF9F7">

        <!-- ════ اختصارات لوحة المفاتيح ════ -->
        <Grid.InputBindings>
            <KeyBinding Key="S" Modifiers="Ctrl"   Command="{Binding SaveProjectCommand}"/>
            <KeyBinding Key="O" Modifiers="Ctrl"   Command="{Binding LoadProjectCommand}"/>
            <KeyBinding Key="D" Modifiers="Ctrl"   Command="{Binding DuplicateSlotCommand}"/>
            <KeyBinding Key="P" Modifiers="Ctrl"   Command="{Binding StartPrintCommand}"/>
            <KeyBinding Key="F5"                   Command="{Binding RefreshPreviewNowCommand}"/>
            <KeyBinding Key="Delete"               Command="{Binding DeleteSelectedSlotCommand}"/>
            <KeyBinding Key="Z" Modifiers="Ctrl"   Command="{Binding ZoomInCommand}"/>
            <KeyBinding Key="Z" Modifiers="Ctrl+Shift" Command="{Binding ZoomOutCommand}"/>
            <KeyBinding Key="F" Modifiers="Ctrl"   Command="{Binding FitToScreenCommand}"/>
        </Grid.InputBindings>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Ribbon -->
            <RowDefinition Height="*"/> <!-- Main Content -->
        </Grid.RowDefinitions>
        
        <!-- ============================================ -->
        <!-- RIBBON BAR (Word-like) -->
        <!-- ============================================ -->
        <Border Grid.Row="0" 
                Background="{StaticResource RibbonBackground}" 
                BorderBrush="{StaticResource RibbonBorder}" 
                BorderThickness="0,0,0,1"
                Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Tabs          -->
                    <RowDefinition Height="Auto"/> <!-- Tab Content   -->
                    <RowDefinition Height="Auto"/> <!-- Action Buttons-->
                    <RowDefinition Height="Auto"/> <!-- Progress Bar  -->
                </Grid.RowDefinitions>
                
                <!-- Tab Headers - Using Buttons with Commands -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,12,16,12">
                    <Button Content="{DynamicResource Numbering_Tab_Home}"
                            Command="{Binding NavigateToPrepareCommand}"
                            Margin="0,0,8,0"
                            Padding="20,12"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#FAF9F7"/>
                                <Setter Property="Foreground" Value="#6B6864"/>
                                <Setter Property="BorderBrush" Value="#DDD9D3"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="8" 
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPrepareMode}" Value="True">
                                        <Setter Property="Background" Value="#0891B2"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#0891B2"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#DDD9D3"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="{DynamicResource Numbering_Tab_Design}"
                            Command="{Binding NavigateToLayoutCommand}"
                            Margin="0,0,8,0"
                            Padding="20,12"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#FAF9F7"/>
                                <Setter Property="Foreground" Value="#6B6864"/>
                                <Setter Property="BorderBrush" Value="#DDD9D3"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="8" 
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLayoutMode}" Value="True">
                                        <Setter Property="Background" Value="#0891B2"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#0891B2"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#DDD9D3"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="{DynamicResource Numbering_Tab_Print}"
                            Command="{Binding NavigateToExecuteCommand}"
                            Padding="20,12"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#FAF9F7"/>
                                <Setter Property="Foreground" Value="#6B6864"/>
                                <Setter Property="BorderBrush" Value="#DDD9D3"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="8" 
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExecuteMode}" Value="True">
                                        <Setter Property="Background" Value="#0891B2"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#0891B2"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#DDD9D3"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                
                <!-- Tab Content Panels -->
                <Border Grid.Row="1"
                        Background="#FFFFFF"
                        BorderBrush="#DDD9D3"
                        BorderThickness="0,0,0,1"
                        Padding="16,12"
                        MinHeight="80">
                    <!-- Bound the variable tab-content height so the action buttons (Row 2)
                         below this border are never pushed off-screen on shorter windows.
                         Content scrolls within this cap instead of overflowing. -->
                    <!-- Horizontal scrolling disabled on purpose. A ScrollViewer that
                         can scroll sideways measures its content with unlimited width,
                         so the WrapPanel inside would never reach a wrapping point and
                         the ribbon would keep overflowing exactly as it did with a
                         StackPanel. Constraining the width is what makes it wrap. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  MaxHeight="420">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- HOME Tab Content -->
                        <!-- A WrapPanel, not a horizontal StackPanel: a StackPanel gives
                             its children unlimited width, so the ribbon simply grew past
                             the window and left a quarter of itself behind a horizontal
                             scrollbar even maximised on a 1920px display. Wrapping puts
                             the overflow on a second line where it can be read. -->
                        <WrapPanel x:Name="HomeTabContentStackPanel" Grid.Row="0" Orientation="Horizontal"
                                   Visibility="{Binding IsPrepareMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <!-- Insert Design Button Group -->
                        <Border BorderBrush="#DDD9D3" BorderThickness="0,0,1,0" Padding="0,0,16,0" Margin="0,0,16,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Numbering_Design}" FontSize="11" Foreground="#6B6864" Margin="0,0,0,8"/>
                                <!-- Plain button to open file dialog (no printer dropdown) -->
                                <Button x:Name="InsertDesignButton"
                                        Command="{Binding LoadTemplateCommand}" 
                                        Foreground="White"
                                        Padding="20,10"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        PreviewMouseDown="InsertDesign_PreviewMouseDown"
                                        Background="{StaticResource PrimaryButtonGradient}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                CornerRadius="6" 
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📄" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Numbering_InsertDesign}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        
                        <!-- Numbering Group -->
                        <Border BorderBrush="#DDD9D3" BorderThickness="0,0,1,0" Padding="0,0,16,0" Margin="0,0,16,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Numbering_Numbering}" FontSize="11" Foreground="#6B6864" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <DockPanel Margin="0,0,0,4" LastChildFill="False">
                                            <TextBlock Text="{DynamicResource Numbering_From}" FontSize="10" Foreground="#6B6864"
                                                       DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                            <!-- Jumps past every number already issued in this series -->
                                            <Button Content="{DynamicResource Num_NextAvailable}"
                                                    Command="{Binding UseNextAvailableNumberCommand}"
                                                    DockPanel.Dock="Right" Cursor="Hand"
                                                    FontSize="10" Padding="6,2" Margin="8,0,0,0"
                                                    Background="#FFFFFF" Foreground="#0891B2"
                                                    BorderBrush="#DDD9D3" BorderThickness="1"
                                                    ToolTip="{Binding SuggestedNextNumber}"/>
                                        </DockPanel>
                                        <TextBox Text="{Binding StartNumber, Converter={StaticResource LongToStringConverter}, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                 Width="110"
                                                 Height="32"
                                                 FontSize="13"
                                                 FontWeight="SemiBold"
                                                 Padding="8,0"
                                                 VerticalContentAlignment="Center"
                                                 Background="#FFFFFF"
                                                 Foreground="#14181D"
                                                 BorderBrush="#6B6864"
                                                 BorderThickness="1"
                                                 CaretBrush="#0891B2">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush" Value="#6B6864"/>
                                                        </Trigger>
                                                        <Trigger Property="IsFocused" Value="True">
                                                            <Setter Property="BorderBrush" Value="#0891B2"/>
                                                            <Setter Property="BorderThickness" Value="2"/>
                                                            <Trigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <ColorAnimation Storyboard.TargetProperty="(TextBox.BorderBrush).(SolidColorBrush.Color)" 
                                                                                       To="#0891B2" Duration="0:0:0.2"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </Trigger.EnterActions>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{DynamicResource Numbering_To}" FontSize="10" Foreground="#6B6864" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding TotalNumbers, Converter={StaticResource LongToStringConverter}, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                                                 Width="110"
                                                 Height="32"
                                                 FontSize="13"
                                                 FontWeight="Bold"
                                                 Padding="8,0"
                                                 VerticalContentAlignment="Center"
                                                 Background="#FFFFFF"
                                                 Foreground="#14181D"
                                                 BorderBrush="#0891B2"
                                                 BorderThickness="2"
                                                 CaretBrush="#0891B2">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush" Value="#0891B2"/>
                                                        </Trigger>
                                                        <Trigger Property="IsFocused" Value="True">
                                                            <Setter Property="BorderBrush" Value="#0E7490"/>
                                                            <Setter Property="BorderThickness" Value="2"/>
                                                            <Trigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <ColorAnimation Storyboard.TargetProperty="(TextBox.BorderBrush).(SolidColorBrush.Color)" 
                                                                                       To="#0E7490" Duration="0:0:0.2"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </Trigger.EnterActions>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        
                        <!-- Copies Group -->
                        <Border BorderBrush="#DDD9D3" BorderThickness="0,0,1,0" Padding="0,0,16,0" Margin="0,0,16,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Numbering_Copies}" FontSize="11" Foreground="#6B6864" Margin="0,0,0,8"/>
                                <TextBox Text="{Binding NumberOfCopies, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                                         Width="80"
                                         Height="36"
                                         FontSize="13"
                                         Padding="10,0"
                                         TextAlignment="Center"
                                         Background="#FFFFFF"
                                         Foreground="#14181D"
                                         BorderBrush="#6B6864"
                                        BorderThickness="1"
                                        ToolTip="{DynamicResource Numbering_CopiesTooltip}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="#0891B2"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </Trigger>
                                                <Trigger Property="IsFocused" Value="True">
                                                    <Setter Property="BorderBrush" Value="#0891B2"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </StackPanel>
                        </Border>
                        
                        <!-- Numbering Mode Group (ترقيم القص وترقيم الشرشرة) -->
                        <Border BorderBrush="#DDD9D3" BorderThickness="0,0,1,0" Padding="0,0,16,0" Margin="0,0,16,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Numbering_NumberingType}" FontSize="11" Foreground="#6B6864" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Vertical">
                                    <RadioButton Content="{DynamicResource Numbering_LinearMode}"
                                                 IsChecked="{Binding IsLinearMode}"
                                                 GroupName="NumberingMode"
                                                 Margin="0,0,0,6"
                                                 VerticalAlignment="Center"/>
                                    <RadioButton Content="{DynamicResource Numbering_ImposedMode}"
                                                 IsChecked="{Binding IsImposedMode}"
                                                 GroupName="NumberingMode"
                                                 VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Digit Style Group (أرقام عربية / غربية) -->
                        <Border BorderBrush="#DDD9D3" BorderThickness="0,0,1,0" Padding="0,0,16,0" Margin="0,0,16,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Numbering_DigitStyle}" FontSize="11" Foreground="#6B6864" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Vertical">
                                    <!-- The "(0123)" in this label is a SAMPLE of what will be
                                         printed, so it has to render as Latin digits. Under the
                                         Arabic UI, WPF was substituting them, and both options
                                         read "(٠١٢٣)" — leaving the operator no way to see the
                                         difference before committing a run. -->
                                    <RadioButton Content="{DynamicResource Numbering_DigitWestern}"
                                                 NumberSubstitution.Substitution="European"
                                                 IsChecked="{Binding UseWesternDigits}"
                                                 GroupName="DigitStyle"
                                                 Margin="0,0,0,6"
                                                 VerticalAlignment="Center"/>
                                    <RadioButton Content="{DynamicResource Numbering_DigitArabic}"
                                                 IsChecked="{Binding UseArabicDigits}"
                                                 GroupName="DigitStyle"
                                                 VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        
                        <!-- Number format: digits + series prefix/suffix (INV-000123/2026) -->
                        <Border BorderBrush="#DDD9D3" BorderThickness="0,0,1,0" Padding="0,0,16,0" Margin="0,0,16,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Numbering_NumberFormat}" FontSize="11" Foreground="#6B6864" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="{DynamicResource Numbering_Prefix}" FontSize="10" Foreground="#6B6864"/>
                                        <TextBox Text="{Binding NumberPrefix, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="70" Padding="6,4" Background="#FAF9F7" Foreground="#14181D"
                                                 BorderBrush="#DDD9D3" BorderThickness="1" CaretBrush="#14181D"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="{DynamicResource Numbering_Digits}" FontSize="10" Foreground="#6B6864"/>
                                        <TextBox Text="{Binding NumberPadDigits, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="48" Padding="6,4" Background="#FAF9F7" Foreground="#14181D"
                                                 BorderBrush="#DDD9D3" BorderThickness="1" CaretBrush="#14181D"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Numbering_Suffix}" FontSize="10" Foreground="#6B6864"/>
                                        <TextBox Text="{Binding NumberSuffix, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="70" Padding="6,4" Background="#FAF9F7" Foreground="#14181D"
                                                 BorderBrush="#DDD9D3" BorderThickness="1" CaretBrush="#14181D"/>
                                    </StackPanel>
                                </StackPanel>
                                <!-- Live example of what will actually print -->
                                <TextBlock Margin="0,8,0,0" FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                           Foreground="#1B7F4C" Text="{Binding NumberFormatPreview}"/>
                            </StackPanel>
                        </Border>

                        <!-- Issued-numbers register: what was printed, and any gaps -->
                        <Border BorderBrush="#DDD9D3" BorderThickness="0,0,1,0" Padding="0,0,16,0" Margin="0,0,16,0">
                            <StackPanel MinWidth="220">
                                <DockPanel Margin="0,0,0,8" LastChildFill="False">
                                    <TextBlock Text="{DynamicResource Num_RegistryTitle}" FontSize="11"
                                               Foreground="#6B6864" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <Button Content="{DynamicResource Num_RegistryRefresh}"
                                            Command="{Binding RefreshRegistryCommand}"
                                            DockPanel.Dock="Right" Cursor="Hand"
                                            FontSize="10" Padding="6,2" Margin="8,0,0,0"
                                            Background="#FFFFFF" Foreground="#0891B2"
                                            BorderBrush="#DDD9D3" BorderThickness="1"/>
                                </DockPanel>

                                <TextBlock Text="{Binding RegistrySummary}" FontSize="11"
                                           Foreground="#6B6864" TextWrapping="Wrap" Margin="0,0,0,6"/>

                                <ItemsControl ItemsSource="{Binding IssuedRanges}" MaxHeight="90">
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsPresenter/>
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="10"
                                                       Foreground="#14181D" Margin="0,0,0,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Gaps are what an auditor asks about first -->
                                <StackPanel Margin="0,6,0,0"
                                            Visibility="{Binding HasRegistryEntries, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{DynamicResource Num_RegistryGaps}" FontSize="10" Foreground="#E08A00"/>
                                    <ItemsControl ItemsSource="{Binding NumberGaps}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="10"
                                                           Foreground="#E08A00"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ════ MEDIUM ① — معاينة متعددة الصفحات ════ -->
                        <Border BorderBrush="#DDD9D3" BorderThickness="0,0,1,0" Padding="0,0,16,0" Margin="0,0,16,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Numbering_Preview_Label}" FontSize="11" Foreground="#6B6864" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <!-- 4-page preview button -->
                                    <Button Command="{Binding ShowMultiPreviewCommand}"
                                            ToolTip="{DynamicResource Numbering_Preview4PagesToolTip}"
                                            Padding="12,8" Margin="0,0,6,0"
                                            Background="#FAF9F7" Foreground="#6B6864"
                                            BorderThickness="1" BorderBrush="#6B6864"
                                            FontSize="13" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E6F3F6"/></Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔍" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Numbering_FourPages}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <!-- Auto-preview toggle -->
                                    <ToggleButton IsChecked="{Binding AutoPreviewEnabled}"
                                                  ToolTip="{DynamicResource Numbering_AutoPreviewTooltip}"
                                                  Padding="10,8"
                                                  FontSize="12" Cursor="Hand">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Setter Property="Background" Value="#FAF9F7"/>
                                                <Setter Property="Foreground" Value="#6B6864"/>
                                                <Setter Property="BorderBrush" Value="#6B6864"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter Property="Background" Value="#E6F3F6"/>
                                                        <Setter Property="Foreground" Value="#0891B2"/>
                                                        <Setter Property="BorderBrush" Value="#0891B2"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#FFFFFF"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚡" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Numbering_Automatic}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ToggleButton>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ════ MEDIUM ② — إحصائيات الطباعة ════ -->
                        <Border BorderBrush="#DDD9D3" BorderThickness="0,0,1,0" Padding="0,0,16,0" Margin="0,0,16,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Numbering_Statistics}" FontSize="11" Foreground="#6B6864" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="🗂" FontSize="11" Margin="0,0,5,0" Foreground="#6B6864" VerticalAlignment="Center"/>
                                        <TextBlock FontSize="12" Foreground="#6B6864" VerticalAlignment="Center">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0:N0}">
                                                    <Binding Path="PaperSheetsNeeded"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Text=" " FontSize="12" Foreground="#6B6864" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Numbering_SheetsUnit}" FontSize="12" Foreground="#6B6864" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="⏱" FontSize="11" Margin="0,0,5,0" Foreground="#6B6864" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding EstimatedPrintTime}" FontSize="12" Foreground="#6B6864" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <!-- Notes button -->
                                    <Button Command="{Binding ToggleNotesCommand}"
                                            ToolTip="{DynamicResource Numbering_NotesToolTip}"
                                            Padding="8,5" Margin="0,2,0,0"
                                            Background="Transparent" Foreground="#6B6864"
                                            BorderThickness="1" BorderBrush="#DDD9D3"
                                            FontSize="11" Cursor="Hand" HorizontalAlignment="Left">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#FFFFFF"/>
                                                        <Setter Property="Foreground" Value="#6B6864"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📝" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Numbering_Notes}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Print Mode Group -->
                        <Border Padding="0,0,16,0" Margin="0,0,16,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Numbering_ModeLabel}" FontSize="11" Foreground="#6B6864" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="{DynamicResource Numbering_TraditionalPrint}" 
                                                 IsChecked="{Binding UseSmartTrayPrinting, Converter={StaticResource InverseBoolConverter}}"
                                                 GroupName="PrintMode"
                                                 Margin="0,0,12,0"
                                                 VerticalAlignment="Center"/>
                                    <RadioButton Content="{DynamicResource Numbering_SmartPrint}" 
                                                 IsChecked="{Binding UseSmartTrayPrinting}"
                                                 GroupName="PrintMode"
                                                 VerticalAlignment="Center"/>
                                </StackPanel>
                                <!-- Behavioral Description -->
                                <StackPanel Margin="0,8,0,0" Orientation="Vertical">
                                    <TextBlock Text="{DynamicResource Numbering_SmartPrint_Description}" 
                                               FontSize="11" Foreground="#6B6864" 
                                               TextWrapping="Wrap" 
                                               Visibility="{Binding UseSmartTrayPrinting, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <TextBlock Text="{DynamicResource Numbering_TraditionalPrint_Description}" 
                                               FontSize="11" Foreground="#6B6864" 
                                               TextWrapping="Wrap"
                                               Visibility="{Binding UseSmartTrayPrinting, Converter={StaticResource InverseBoolConverter}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ════ SAVE / LOAD PROJECT GROUP ════ -->
                        <Border BorderBrush="#DDD9D3" BorderThickness="0,0,1,0" Padding="0,0,16,0" Margin="0,0,16,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Numbering_Project}" FontSize="11" Foreground="#6B6864" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding SaveProjectCommand}"
                                            ToolTip="{DynamicResource Numbering_SaveProjectToolTip}"
                                            Padding="12,8" Margin="0,0,6,0"
                                            Background="#FAF9F7" Foreground="#6B6864"
                                            BorderThickness="1" BorderBrush="#6B6864"
                                            FontSize="13" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E6F3F6"/></Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💾" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Numbering_SaveButton}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding LoadProjectCommand}"
                                            ToolTip="{DynamicResource Numbering_LoadProjectToolTip}"
                                            Padding="12,8"
                                            Background="#FAF9F7" Foreground="#6B6864"
                                            BorderThickness="1" BorderBrush="#6B6864"
                                            FontSize="13" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E6F3F6"/></Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📂" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Numbering_LoadButton}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ════ CHECKPOINT RESUME GROUP ════ -->
                        <Border Padding="0,0,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{DynamicResource Numbering_CheckpointResume}" FontSize="11" Foreground="#6B6864" VerticalAlignment="Center"/>
                                    <Button Command="{Binding LoadCheckpointsCommand}"
                                            Content="↺" ToolTip="{DynamicResource Numbering_CheckCheckpointsToolTip}"
                                            Width="22" Height="22" Margin="6,0,0,0"
                                            Background="Transparent" Foreground="#6B6864"
                                            BorderThickness="0" FontSize="14" Cursor="Hand"
                                            VerticalAlignment="Center"/>
                                </StackPanel>
                                <!-- Checkpoints List -->
                                <Border Background="#FAF9F7" BorderBrush="#E6F3F6" BorderThickness="1"
                                        CornerRadius="6" Padding="6" MaxHeight="72" MinWidth="190"
                                        Visibility="{Binding CheckpointStates.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding CheckpointStates}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="4,3" Cursor="Hand" CornerRadius="4"
                                                            Background="Transparent">
                                                        <Border.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick"
                                                                          Command="{Binding DataContext.ResumeFromCheckpointCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                        </Border.InputBindings>
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#FFFFFF"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="⏸" FontSize="10" Foreground="#E08A00" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                            <TextBlock FontSize="11" Foreground="#6B6864" VerticalAlignment="Center">
                                                                <TextBlock.Text>
                                                                    <MultiBinding StringFormat="{}{0:N0}  ·  {1:HH:mm  dd/MM}">
                                                                        <Binding Path="LastPrintedNumber"/>
                                                                        <Binding Path="Timestamp"/>
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                                <!-- Empty state -->
                                <TextBlock Text="{DynamicResource Numbering_NoCheckpoints}"
                                           FontSize="10" Foreground="#6B6864"
                                           Visibility="{Binding CheckpointStates.Count, Converter={StaticResource CountToHiddenConverter}}"/>
                                <!-- Buttons -->
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Command="{Binding ResumeFromCheckpointCommand}"
                                            ToolTip="{DynamicResource Numbering_ResumeCheckpointToolTip}"
                                            Padding="10,6" Margin="0,0,6,0"
                                            Background="#E7F3EC" Foreground="#1B7F4C"
                                            BorderThickness="1" BorderBrush="#E7F3EC"
                                            FontSize="12" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E7F3EC"/></Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="▶" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Numbering_ResumeButton}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding DeleteCheckpointCommand}"
                                            ToolTip="{DynamicResource Numbering_DeleteCheckpointToolTip}"
                                            Padding="10,6"
                                            Background="#FFFFFF" Foreground="#6B6864"
                                            BorderThickness="1" BorderBrush="#6B6864"
                                            FontSize="12" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#DDD9D3"/></Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🗑" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Numbering_DeleteButton}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        </WrapPanel>

                        <!-- LAYOUT Tab Content -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" 
                                   Visibility="{Binding IsLayoutMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLayoutMode}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard Storyboard="{StaticResource TabContentFadeIn}"/>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                        <!-- Zoom Group -->
                        <Border BorderBrush="#DDD9D3" BorderThickness="0,0,1,0" Padding="0,0,16,0" Margin="0,0,16,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Numbering_Zoom}" FontSize="11" Foreground="#6B6864" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="−" 
                                            Command="{Binding ZoomOutCommand}" 
                                            Width="36" 
                                            Height="36" 
                                            Margin="0,0,4,0"
                                            Background="#FAF9F7"
                                            Foreground="#6B6864"
                                            BorderThickness="1"
                                            BorderBrush="#6B6864"
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Cursor="Hand">
                                        <Button.RenderTransform>
                                            <ScaleTransform/>
                                        </Button.RenderTransform>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" 
                                                                    CornerRadius="6" 
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#DDD9D3"/>
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                                                                                   To="1.1" Duration="0:0:0.15"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                                                                                   To="1.1" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                                                                                   To="1" Duration="0:0:0.15"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                                                                                   To="1" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Border VerticalAlignment="Center" 
                                            Width="50" 
                                            Background="#FAF9F7"
                                            Padding="4,2"
                                            BorderBrush="#DDD9D3"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                        <TextBlock Text="{Binding ZoomLevel, StringFormat='{}{0:P0}'}" 
                                                   TextAlignment="Center"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#6B6864"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <Button Content="+" 
                                            Command="{Binding ZoomInCommand}" 
                                            Width="36" 
                                            Height="36" 
                                            Margin="4,0,0,0"
                                            Background="#FAF9F7"
                                            Foreground="#6B6864"
                                            BorderThickness="1"
                                            BorderBrush="#6B6864"
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Cursor="Hand">
                                        <Button.RenderTransform>
                                            <ScaleTransform/>
                                        </Button.RenderTransform>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" 
                                                                    CornerRadius="6" 
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#DDD9D3"/>
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                                                                                   To="1.1" Duration="0:0:0.15"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                                                                                   To="1.1" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                                                                                   To="1" Duration="0:0:0.15"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                                                                                   To="1" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="⛶" 
                                            Command="{Binding FitToScreenCommand}" 
                                            Width="36" 
                                            Height="36" 
                                            Margin="4,0,0,0" 
                                            ToolTip="Fit to Screen"
                                            Background="#FAF9F7"
                                            Foreground="#6B6864"
                                            BorderThickness="1"
                                            BorderBrush="#6B6864"
                                            FontSize="14"
                                            Cursor="Hand">
                                        <Button.RenderTransform>
                                            <ScaleTransform/>
                                        </Button.RenderTransform>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" 
                                                                    CornerRadius="6" 
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#DDD9D3"/>
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                                                                                   To="1.1" Duration="0:0:0.15"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                                                                                   To="1.1" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                                                                                   To="1" Duration="0:0:0.15"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                                                                                   To="1" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        
                        <!-- Grid Group -->
                        <Border BorderBrush="#DDD9D3" BorderThickness="0,0,1,0" Padding="0,0,16,0" Margin="0,0,16,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Numbering_Grid}" FontSize="11" Foreground="#6B6864" Margin="0,0,0,8"/>
                                <ToggleButton Content="⊞" 
                                              IsChecked="{Binding ShowGrid}"
                                              Width="44" 
                                              Height="36"
                                              Background="#FAF9F7"
                                              Foreground="#6B6864"
                                              BorderThickness="1"
                                              BorderBrush="#6B6864"
                                              FontSize="16"
                                              Cursor="Hand"
                                              ToolTip="Toggle Grid">
                                    <ToggleButton.RenderTransform>
                                        <ScaleTransform/>
                                    </ToggleButton.RenderTransform>
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                CornerRadius="6" 
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Background" Value="#0891B2"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="BorderBrush" Value="#0891B2"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#DDD9D3"/>
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                                                                               To="1.1" Duration="0:0:0.15"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                                                                               To="1.1" Duration="0:0:0.15"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                                                                               To="1" Duration="0:0:0.15"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                                                                               To="1" Duration="0:0:0.15"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                            </StackPanel>
                        </Border>
                        
                        <!-- Slot Actions Group -->
                        <Border BorderBrush="#DDD9D3" BorderThickness="0,0,1,0" Padding="0,0,16,0" Margin="0,0,16,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Numbering_Numbering}" FontSize="11" Foreground="#6B6864" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="➕" 
                                            Command="{Binding AddSlotCommand}" 
                                            Width="38" 
                                            Height="36" 
                                            Margin="0,0,6,0" 
                                            ToolTip="Add Slot"
                                            Background="#1B7F4C"
                                            Foreground="White"
                                            BorderThickness="0"
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Cursor="Hand">
                                        <Button.RenderTransform>
                                            <ScaleTransform/>
                                        </Button.RenderTransform>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" 
                                                                    CornerRadius="6">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#1B7F4C"/>
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                                                                                   To="1.15" Duration="0:0:0.2"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                                                                                   To="1.15" Duration="0:0:0.2">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="3"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                                                                                   To="1" Duration="0:0:0.15"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                                                                                   To="1" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="🗑️" 
                                            Command="{Binding DeleteSelectedSlotCommand}" 
                                            Width="38" 
                                            Height="36"
                                            Background="#B42318"
                                            Foreground="White"
                                            BorderThickness="0"
                                            FontSize="16"
                                            Cursor="Hand"
                                            IsEnabled="{Binding SelectedSlot, Converter={StaticResource NullToBoolConverter}}"
                                            ToolTip="Delete Slot">
                                        <Button.RenderTransform>
                                            <ScaleTransform/>
                                        </Button.RenderTransform>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" 
                                                                    CornerRadius="6">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#B42318"/>
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                                                                                   To="1.1" Duration="0:0:0.15"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                                                                                   To="1.1" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                                                                                   To="1" Duration="0:0:0.15"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                                                                                   To="1" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <!-- Dark-theme disabled (was #DDD9D3/#6B6864, light-mode leftover). -->
                                                        <Setter Property="Background" Value="#FFFFFF"/>
                                                        <Setter Property="Foreground" Value="#6B6864"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- ════ LOW ① — Duplicate Slot (Ctrl+D) ════ -->
                                    <Button Command="{Binding DuplicateSlotCommand}"
                                            Width="38" Height="36" Margin="6,0,0,0"
                                            Background="#0891B2" Foreground="White"
                                            BorderThickness="0" FontSize="15"
                                            Cursor="Hand"
                                            IsEnabled="{Binding SelectedSlot, Converter={StaticResource NullToBoolConverter}}"
                                            ToolTip="{DynamicResource Numbering_DuplicateFieldToolTip}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#0E7490"/></Trigger>
                                                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#DDD9D3"/></Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="⧉" FontSize="16"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ════ LOW ③ — Export Preview ════ -->
                        <Border BorderBrush="#DDD9D3" BorderThickness="0,0,1,0" Padding="0,0,16,0" Margin="0,0,16,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Numbering_ExportLabel}" FontSize="11" Foreground="#6B6864" Margin="0,0,0,8"/>
                                <Button Command="{Binding ExportPreviewCommand}"
                                        ToolTip="{DynamicResource Numbering_ExportPreviewToolTip}"
                                        Padding="12,8"
                                        Background="#FAF9F7" Foreground="#6B6864"
                                        BorderThickness="1" BorderBrush="#6B6864"
                                        FontSize="13" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E6F3F6"/></Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🖼" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="PNG/JPG" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                        <!-- Continue Button (moved to Grid.Row="2" in parent Grid) -->
                    
                    <!-- EXECUTE Tab Content -->
                    <Grid Grid.Row="0" Visibility="{Binding IsExecuteMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                    <!-- Wraps for the same reason as the Home ribbon above. -->
                    <WrapPanel Grid.Row="0" Orientation="Horizontal">
                        <!-- Printer Selection Group -->
                        <Border BorderBrush="#DDD9D3" BorderThickness="0,0,1,0" Padding="0,0,16,0" Margin="0,0,16,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Numbering_Printer}" FontSize="11" Foreground="#6B6864" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox ItemsSource="{Binding AvailablePrinters}" 
                                              SelectedItem="{Binding SelectedPrinter}"
                                              Width="180"
                                              Height="36"
                                              FontSize="13"
                                              Padding="10,0"
                                              Background="#FFFFFF"
                                              Foreground="#14181D"
                                              BorderBrush="#6B6864"
                                              BorderThickness="1"
                                              Cursor="Hand"
                                              Margin="0,0,8,0">
                                        <!-- Inherit the global dark ComboBox template + dark item style.
                                             Only add hover/focus accent on top. (Previously this used
                                             the default template + white items → light popup.) -->
                                        <ComboBox.Style>
                                            <Style TargetType="ComboBox"
                                                   BasedOn="{StaticResource {x:Type ComboBox}}">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="#0891B2"/>
                                                    </Trigger>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter Property="BorderBrush" Value="#0891B2"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.Style>
                                    </ComboBox>
                                    <Button Content="⚙️" 
                                            Width="36" 
                                            Height="36"
                                            Background="#FAF9F7"
                                            Foreground="#6B6864"
                                            BorderThickness="1"
                                            BorderBrush="#6B6864"
                                            FontSize="16"
                                            Cursor="Hand"
                                            ToolTip="{DynamicResource PrinterProps_GeneralInfo}"
                                            Command="{Binding OpenPrinterPropertiesCommand}"
                                            IsEnabled="{Binding SelectedPrinter, Converter={StaticResource NullToBoolConverter}}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" 
                                                                    CornerRadius="6" 
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#DDD9D3"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        
                        <!-- Tray Selection (always visible when copies are enabled) -->
                        <Border BorderBrush="#DDD9D3" BorderThickness="0,0,1,0" Padding="0,0,16,0" Margin="0,0,16,0"
                                Visibility="{Binding HasMultipleCopies, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Numbering_TrayDistribution}" FontSize="11" Foreground="#6B6864" Margin="0,0,0,8"/>
                                <StackPanel>
                                    <!-- Shared dark style for tray ComboBoxes -->
                                    <StackPanel.Resources>
                                        <Style x:Key="DarkTrayCombo" TargetType="ComboBox"
                                               BasedOn="{StaticResource {x:Type ComboBox}}">
                                            <Setter Property="Width"           Value="120"/>
                                            <Setter Property="Height"          Value="32"/>
                                            <Setter Property="FontSize"        Value="12"/>
                                            <Setter Property="Padding"         Value="8,0"/>
                                            <Setter Property="Background"      Value="#FFFFFF"/>
                                            <Setter Property="Foreground"      Value="#14181D"/>
                                            <Setter Property="BorderBrush"     Value="#6B6864"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="ItemContainerStyle">
                                                <Setter.Value>
                                                    <Style TargetType="ComboBoxItem">
                                                        <Setter Property="Background" Value="#FFFFFF"/>
                                                        <Setter Property="Foreground" Value="#14181D"/>
                                                        <Setter Property="Padding"    Value="8,5"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#DDD9D3"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter Property="Background" Value="#0891B2"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </StackPanel.Resources>

                                    <!-- Original -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="{DynamicResource Numbering_Original}" Width="70" VerticalAlignment="Center" FontSize="12" Foreground="#6B6864"/>
                                        <ComboBox ItemsSource="{Binding AvailableTrayOptions}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding OriginalTray}"
                                                  Style="{StaticResource DarkTrayCombo}"/>
                                    </StackPanel>
                                    <!-- Copy 1 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6" Visibility="{Binding UseCopy1, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{DynamicResource Numbering_Copy1Label}" Width="70" VerticalAlignment="Center" FontSize="12" Foreground="#6B6864"/>
                                        <ComboBox ItemsSource="{Binding AvailableTrayOptions}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding Copy1Tray}"
                                                  Style="{StaticResource DarkTrayCombo}"/>
                                    </StackPanel>
                                    <!-- Copy 2 -->
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding UseCopy2, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{DynamicResource Numbering_Copy2Label}" Width="70" VerticalAlignment="Center" FontSize="12" Foreground="#6B6864"/>
                                        <ComboBox ItemsSource="{Binding AvailableTrayOptions}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding Copy2Tray}"
                                                  Style="{StaticResource DarkTrayCombo}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        
                        <!-- Detailed Summary Info -->
                        <Border BorderBrush="#DDD9D3" BorderThickness="0,0,1,0" Padding="0,0,16,0" Margin="0,0,16,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Numbering_PrintSummary}" FontSize="11" Foreground="#6B6864" Margin="0,0,0,8" FontWeight="SemiBold"/>
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,4">
                                        <Run Text="{DynamicResource Numbering_PrinterLabel}" Foreground="#6B6864"/>
                                        <Run Text="{Binding SelectedPrinter}" FontWeight="SemiBold" Foreground="#14181D"/>
                                    </TextBlock>
                                    <TextBlock Margin="0,0,0,4">
                                        <Run Text="{DynamicResource Numbering_StartNumberLabel}" Foreground="#6B6864"/>
                                        <Run Text="{Binding StartNumber}" FontWeight="SemiBold" Foreground="#14181D"/>
                                    </TextBlock>
                                    <TextBlock Margin="0,0,0,4">
                                        <Run Text="{DynamicResource Numbering_TotalNumbersLabel}" Foreground="#6B6864"/>
                                        <Run Text="{Binding TotalNumbers, StringFormat='{}{0:N0}'}" FontWeight="SemiBold" Foreground="#14181D"/>
                                    </TextBlock>
                                    <TextBlock Margin="0,0,0,4">
                                        <Run Text="{DynamicResource Numbering_CopiesCountLabel}" Foreground="#6B6864"/>
                                        <Run Text="{Binding CopiesCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="#14181D"/>
                                    </TextBlock>
                                    <TextBlock Margin="0,0,0,4">
                                        <Run Text="{DynamicResource Numbering_TotalPagesLabel}" Foreground="#6B6864"/>
                                        <Run Text="{Binding TotalPagesComputed, Mode=OneWay, StringFormat='{}{0:N0}'}" FontWeight="Bold" Foreground="#0891B2"/>
                                    </TextBlock>
                                    <!-- Printing Mode Name -->
                                    <TextBlock Margin="0,8,0,4">
                                        <Run Text="{DynamicResource Numbering_ModeLabel}" Foreground="#6B6864"/>
                                        <Run Text="{Binding PrintingModeName, Mode=OneWay}" FontWeight="SemiBold">
                                            <Run.Style>
                                                <Style TargetType="Run">
                                                    <Setter Property="Foreground" Value="#1B7F4C"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UseSmartTrayPrinting}" Value="False">
                                                            <Setter Property="Foreground" Value="#6B6864"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Run.Style>
                                        </Run>
                                    </TextBlock>
                                    
                                    <!-- Printing Mode Description -->
                                    <Border Background="#FAF9F7" 
                                            BorderBrush="#DDD9D3" 
                                            BorderThickness="1" 
                                            CornerRadius="4" 
                                            Padding="12,10" 
                                            Margin="0,4,0,0">
                                        <TextBlock Text="{Binding PrintingModeDescription, Mode=OneWay}" 
                                                   FontSize="11" 
                                                   Foreground="#6B6864" 
                                                   TextWrapping="Wrap" 
                                                   LineHeight="18"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        
                        <!-- Print Progress Indicator -->
                        <Border BorderBrush="#DDD9D3" BorderThickness="0,0,1,0" Padding="0,0,16,0" Margin="0,0,16,0"
                                Visibility="{Binding IsPrinting, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Numbering_PrintStatus}" FontSize="11" Foreground="#6B6864" Margin="0,0,0,8" FontWeight="SemiBold"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding PrintStatus}" 
                                               FontSize="12" 
                                               FontWeight="SemiBold" 
                                               Foreground="#0891B2"
                                               Margin="0,0,0,6"/>
                                    <ProgressBar Value="{Binding PrintProgress}" 
                                                 Maximum="100" 
                                                 Height="8" 
                                                 Margin="0,0,0,4">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ProgressBar">
                                                            <!-- PART_Track/PART_Indicator: WPF sizes the fill to Value/Maximum
                                                                 against the track's actual width. (The old converter capped
                                                                 the fill at a fixed 100px regardless of the bar's real width.) -->
                                                            <Border x:Name="PART_Track"
                                                                    Background="#DDD9D3"
                                                                    CornerRadius="4"
                                                                    BorderThickness="0">
                                                                <Border x:Name="PART_Indicator"
                                                                        Background="#0891B2"
                                                                        CornerRadius="4"
                                                                        HorizontalAlignment="Left"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>
                                    <TextBlock Text="{Binding PrintProgress, StringFormat='{}{0:F0}%'}" 
                                               FontSize="10" 
                                               Foreground="#6B6864"
                                               HorizontalAlignment="Right"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        
                        <!-- Print Scale Options -->
                        <StackPanel VerticalAlignment="Bottom" Margin="16,0,0,20">
                            <TextBlock Text="{DynamicResource Numbering_ScalingOptions}" 
                                       FontSize="14" 
                                       FontWeight="SemiBold" 
                                       Foreground="#6B6864"
                                       Margin="0,0,0,12"/>
                            
                            <StackPanel>
                                <!-- Actual Size (100%) -->
                                <RadioButton Content="{DynamicResource Numbering_ActualSize}" 
                                             IsChecked="{Binding PrintScaleMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=ActualSize}"
                                             GroupName="PrintScale"
                                             Margin="0,0,0,8"
                                             FontSize="13"
                                             Foreground="#14181D"
                                             Cursor="Hand"
                                             Checked="PrintScaleMode_Checked"/>
                                
                                <!-- Fit to Page -->
                                <RadioButton Content="{DynamicResource Numbering_FitToPage}" 
                                             IsChecked="{Binding PrintScaleMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=FitToPage}"
                                             GroupName="PrintScale"
                                             FontSize="13"
                                             Foreground="#14181D"
                                             Cursor="Hand"
                                             Checked="PrintScaleMode_Checked"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- ════ LOW ② — سجل الطباعة + المشاريع الأخيرة ════
                             This group is a WrapPanel item like the others; it used to
                             sit AFTER </WrapPanel> with no Grid.Row, so it defaulted to
                             Grid.Row="0" and drew ON TOP of the ribbon — the field
                             operator saw its buttons clipped/overlapping. Keeping it
                             inside the WrapPanel lets it wrap to a new line like every
                             other group instead of overlapping them. -->
                        <Border Padding="0,0,0,0" Margin="16,0,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Numbering_HistoryLabel}" FontSize="11" Foreground="#6B6864" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <!-- Print History -->
                                    <Button Command="{Binding TogglePrintHistoryCommand}"
                                            ToolTip="{DynamicResource Numbering_PrintHistoryToolTip}"
                                            Padding="12,8" Margin="0,0,6,0"
                                            Background="#FAF9F7" Foreground="#6B6864"
                                            BorderThickness="1" BorderBrush="#6B6864"
                                            FontSize="12" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E6F3F6"/></Trigger>
                                                    <DataTrigger Binding="{Binding IsPrintHistoryOpen}" Value="True">
                                                        <Setter Property="Background" Value="#E6F3F6"/>
                                                        <Setter Property="BorderBrush" Value="#0891B2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📋" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Numbering_HistoryLabel}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <!-- Recent Projects -->
                                    <Button Command="{Binding ToggleRecentProjectsCommand}"
                                            ToolTip="{DynamicResource Numbering_RecentProjectsToolTip}"
                                            Padding="12,8"
                                            Background="#FAF9F7" Foreground="#6B6864"
                                            BorderThickness="1" BorderBrush="#6B6864"
                                            FontSize="12" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E6F3F6"/></Trigger>
                                                    <DataTrigger Binding="{Binding IsRecentProjectsOpen}" Value="True">
                                                        <Setter Property="Background" Value="#E6F3F6"/>
                                                        <Setter Property="BorderBrush" Value="#0891B2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🕐" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Numbering_RecentButton}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                        <!-- Print Button (moved to Grid.Row="2" in parent Grid) -->
                    </Grid>
                    </Grid>
                    </ScrollViewer>
                </Border>

                <!-- Action Buttons (moved outside Border to ensure visibility) -->
                <StackPanel Grid.Row="2" Margin="16,16,16,16" Orientation="Horizontal" HorizontalAlignment="Right" Background="#FFFFFF">
                    <!-- Back Button (visible when not in Prepare mode) -->
                    <Button Command="{Binding NavigateBackCommand}"
                            Visibility="{Binding IsPrepareMode, Converter={StaticResource InverseBoolConverter}}"
                            Foreground="#6B6864"
                            Padding="20,12"
                            FontSize="14"
                            FontWeight="SemiBold"
                            BorderThickness="1"
                            BorderBrush="#6B6864"
                            Background="#FFFFFF"
                            Cursor="Hand"
                            Margin="0,0,12,0">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="←" FontSize="16" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource Numbering_Back}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    
                    <!-- Start Design Button (visible in Prepare mode) -->
                    <Button x:Name="StartLayoutButton"
                            Command="{Binding StartLayoutCommand}" 
                            PreviewMouseDown="StartLayoutButton_PreviewMouseDown"
                            Visibility="{Binding IsPrepareMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Foreground="White"
                            Padding="28,12"
                            FontSize="15"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.RenderTransform>
                            <ScaleTransform/>
                        </Button.RenderTransform>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{StaticResource PrimaryButtonGradient}"/>
                                <Setter Property="Effect" Value="{StaticResource Shadow.Button}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="8" 
                                                    Padding="{TemplateBinding Padding}"
                                                    Effect="{TemplateBinding Effect}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryButtonHoverGradient}"/>
                                        <Setter Property="Effect" Value="{StaticResource Shadow.ButtonHover}"/>
                                        <Trigger.EnterActions>
                                            <BeginStoryboard Storyboard="{StaticResource ButtonHoverStoryboard}"/>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard Storyboard="{StaticResource ButtonExitStoryboard}"/>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard Storyboard="{StaticResource ButtonClickStoryboard}"/>
                                        </Trigger.EnterActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✨" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </TextBlock.RenderTransform>
                                <TextBlock.Triggers>
                                    <EventTrigger RoutedEvent="{x:Static FrameworkElement.LoadedEvent}">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)" 
                                                               From="0" To="360" Duration="0:0:3">
                                                    <DoubleAnimation.EasingFunction>
                                                        <PowerEase Power="1" EasingMode="EaseInOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </TextBlock.Triggers>
                            </TextBlock>
                            <TextBlock Text="{DynamicResource Numbering_StartLayout}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <!-- Continue Button (visible in Layout mode) -->
                    <Button Command="{Binding NavigateToExecuteCommand}" 
                            Visibility="{Binding IsLayoutMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Foreground="White"
                            Padding="24,12"
                            FontSize="15"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.RenderTransform>
                            <ScaleTransform/>
                        </Button.RenderTransform>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{StaticResource SuccessButtonGradient}"/>
                                <Setter Property="Effect" Value="{StaticResource Shadow.Button}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="8" 
                                                    Padding="{TemplateBinding Padding}"
                                                    Effect="{TemplateBinding Effect}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1B7F4C"/>
                                        <Setter Property="Effect" Value="{StaticResource Shadow.ButtonHover}"/>
                                        <Trigger.EnterActions>
                                            <BeginStoryboard Storyboard="{StaticResource ButtonHoverStoryboard}"/>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard Storyboard="{StaticResource ButtonExitStoryboard}"/>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard Storyboard="{StaticResource ButtonClickStoryboard}"/>
                                        </Trigger.EnterActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➡️" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </TextBlock.RenderTransform>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLayoutMode}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="(TextBlock.RenderTransform).(TranslateTransform.X)" 
                                                                           From="0" To="5" Duration="0:0:0.8" 
                                                                           AutoReverse="True">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <SineEase EasingMode="EaseInOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{DynamicResource Numbering_ContinueToPrint}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <!-- Print Button (visible in Execute mode) -->
                    <!-- Command only. It used to also carry Click="StartPrintButton_Click",
                         and that handler executed the very same StartPrintCommand, so one
                         press fired the print twice. It is the only button of 45+ in this
                         view with a Click handler; every other works on Command alone. -->
                            <Button x:Name="StartPrintButton"
                                    Command="{Binding StartPrintCommand}"
                            Visibility="{Binding IsExecuteMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Foreground="White"
                                    Padding="28,14"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    IsEnabled="{Binding IsPrinting, Converter={StaticResource InverseBoolConverter}}">
                                <Button.RenderTransform>
                                    <ScaleTransform/>
                                </Button.RenderTransform>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{StaticResource PrimaryButtonGradient}"/>
                                        <Setter Property="Effect" Value="{StaticResource Shadow.Button}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" 
                                                            CornerRadius="8" 
                                                            Padding="{TemplateBinding Padding}"
                                                            Effect="{TemplateBinding Effect}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryButtonHoverGradient}"/>
                                                <Setter Property="Effect" Value="{StaticResource Shadow.ButtonHover}"/>
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard Storyboard="{StaticResource ButtonHoverStoryboard}"/>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard Storyboard="{StaticResource ButtonExitStoryboard}"/>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard Storyboard="{StaticResource ButtonClickStoryboard}"/>
                                                </Trigger.EnterActions>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <!-- Dark-theme disabled (was #DDD9D3, light-mode leftover). -->
                                                <Setter Property="Background" Value="#FFFFFF"/>
                                                <Setter Property="Foreground" Value="#6B6864"/>
                                                <Setter Property="Effect" Value="{x:Null}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🖨️" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExecuteMode, Mode=OneWay}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard RepeatBehavior="Forever">
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                                                                   From="1" To="0.6" Duration="0:0:1" 
                                                                                   AutoReverse="True">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <SineEase EasingMode="EaseInOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{DynamicResource Numbering_PrintNow}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                <!-- ══════════════════════════════════════════════════════
                     GLOBAL PRINT PROGRESS BAR  (شريط تقدم الطباعة)
                     يظهر عند بدء الطباعة في أي وضع
                     ══════════════════════════════════════════════════════ -->
                <Border Grid.Row="3"
                        Background="#FAF9F7"
                        BorderBrush="#E6F3F6" BorderThickness="0,2,0,0"
                        Padding="24,12"
                        Visibility="{Binding IsPrinting,
                                     Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>  <!-- Icon + Status   -->
                            <ColumnDefinition Width="*"/>     <!-- Progress track  -->
                            <ColumnDefinition Width="Auto"/>  <!-- Stats           -->
                            <ColumnDefinition Width="Auto"/>  <!-- Pause / Cancel  -->
                        </Grid.ColumnDefinitions>

                        <!-- ① Status text -->
                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Margin="0,0,24,0" MinWidth="220">
                            <TextBlock FontSize="13" FontWeight="SemiBold">
                                <Run Text="🖨️  " Foreground="#0891B2"/>
                                <Run Text="{Binding PrintStatus, Mode=OneWay}"
                                     Foreground="#14181D"/>
                            </TextBlock>
                            <TextBlock Text="{Binding PrintedPagesDisplay, Mode=OneWay}"
                                       FontSize="11" Foreground="#6B6864"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- ② Progress bar track (custom) -->
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <!-- Track background -->
                            <Border Height="10" Background="#FFFFFF" CornerRadius="5"/>
                            <!-- ProgressBar (WPF handles width automatically) -->
                            <ProgressBar x:Name="GlobalProgressBar"
                                         Value="{Binding PrintProgress, Mode=OneWay}"
                                         Maximum="100" Height="10"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="#0891B2">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ProgressBar">
                                                    <Grid>
                                                        <!-- Track (named PART_Track so WPF sizes PART_Indicator) -->
                                                        <Border x:Name="PART_Track" Background="#FFFFFF" CornerRadius="5"/>
                                                        <!-- Fill -->
                                                        <Border x:Name="PART_Indicator"
                                                                HorizontalAlignment="Left"
                                                                CornerRadius="5">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                    <GradientStop Color="#0891B2" Offset="0"/>
                                                                    <GradientStop Color="#0891B2" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                        </Grid>

                        <!-- ③ Stats: Percent + Elapsed + ETA -->
                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Margin="20,0,20,0"
                                    HorizontalAlignment="Right">
                            <!-- Percent -->
                            <TextBlock HorizontalAlignment="Right"
                                       FontSize="18" FontWeight="Bold">
                                <Run Text="{Binding PrintProgress, Mode=OneWay, StringFormat='{}{0:F0}'}"
                                     Foreground="#0891B2"/>
                                <Run Text="%" Foreground="#DDD9D3" FontSize="13"/>
                            </TextBlock>
                            <!-- Elapsed + ETA -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding ElapsedTimeDisplay, Mode=OneWay}"
                                           FontSize="11" Foreground="#6B6864"
                                           Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding PrintSpeedDisplay, Mode=OneWay}"
                                           FontSize="11" Foreground="#1B7F4C"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- ④ Pause + Cancel buttons -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <!-- Pause / Resume -->
                            <Button Command="{Binding PauseResumeCommand}"
                                    Cursor="Hand"
                                    Margin="0,0,8,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#E6F3F6"/>
                                        <Setter Property="Foreground" Value="#0E7490"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="14,8"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bg"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="7"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bg" Property="Background" Value="#E6F3F6"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⏸ " FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Numbering_PauseButton}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Cancel -->
                            <Button Command="{Binding CancelPrintCommand}"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#F6E4E2"/>
                                        <Setter Property="Foreground" Value="#B42318"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="14,8"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bg"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="7"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bg" Property="Background" Value="#F6E4E2"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="■ " FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Numbering_CancelPrintingButton}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </Border>

        <!-- ============================================ -->
        <!-- MAIN CONTENT AREA -->
        <!-- ============================================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/> <!-- Canvas -->
                <ColumnDefinition Width="320"/> <!-- Properties Panel -->
            </Grid.ColumnDefinitions>
            
            <!-- Canvas Area -->
            <ScrollViewer Grid.Column="0"
                          x:Name="CanvasScrollViewer"
                          SizeChanged="CanvasScrollViewer_SizeChanged"
                          Background="{StaticResource CanvasBackgroundGradient}"
                          Padding="20"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          CanContentScroll="True">
                <Border Background="#FAF9F7"
                        BorderBrush="#DDD9D3"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="24">
                    <Border x:Name="CanvasContainer">
                        <Border Background="#FFFFFF"
                                BorderBrush="#6B6864"
                                BorderThickness="3">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.15" Color="#FFFFFF"/>
                            </Border.Effect>
                            <!-- Zoom via LayoutTransform (was RenderTransform + centre pivot).
                                 RenderTransform is visual-only: the ScrollViewer never saw the
                                 scaled size, so a zoomed-in sheet could not be scrolled to and
                                 the pivot had to be faked at the centre. LayoutTransform grows
                                 the real layout, so the scrollbars reach every part and the
                                 code-behind can anchor the zoom on the mouse pointer. -->
                            <Border.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding ZoomLevel}"
                                                ScaleY="{Binding ZoomLevel}"/>
                            </Border.LayoutTransform>

                            <Canvas x:Name="TemplateCanvas" 
                                    Width="{Binding CanvasWidth}" 
                                    Height="{Binding CanvasHeight}" 
                                    Background="#FFFFFF" 
                                    ClipToBounds="True"
                                    MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                                    MouseMove="Canvas_MouseMove"
                                    MouseLeftButtonUp="Canvas_MouseLeftButtonUp">
                                
                                <!-- Template Image (base layer) -->
                                <Image Source="{Binding TemplateImage}"
                                       Width="{Binding CanvasWidth}"
                                       Height="{Binding CanvasHeight}"
                                       Stretch="Fill"/>

                                <!-- Live Preview Overlay (auto-generated with actual numbers) -->
                                <Image Source="{Binding LivePreviewImage}"
                                       Width="{Binding CanvasWidth}"
                                       Height="{Binding CanvasHeight}"
                                       Stretch="Fill"
                                       Visibility="{Binding LivePreviewImage, Converter={StaticResource NullToVisConverter}}"/>

                                <!-- Generating Preview Spinner -->
                                <Border Background="#B4231828"
                                        CornerRadius="8"
                                        Padding="14,8"
                                        Canvas.Left="8"
                                        Canvas.Top="8"
                                        Visibility="{Binding IsGeneratingPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⟳" FontSize="14" Foreground="#0891B2" Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource Numbering_GeneratingPreview}" Foreground="#14181D" FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <!-- Grid Overlay (Smart Grid - 0.5 cm spacing) -->
                                <ItemsControl ItemsSource="{Binding GridLines}" 
                                              Visibility="{Binding ShowGrid, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Line X1="{Binding X1}" Y1="{Binding Y1}" 
                                                  X2="{Binding X2}" Y2="{Binding Y2}"
                                                  Stroke="#14181D" 
                                                  StrokeThickness="0.5"
                                                  Opacity="0.6"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                
                                <!-- Guide Lines -->
                                <ItemsControl ItemsSource="{Binding Guides}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:GuideLine}">
                                            <Line Tag="{Binding}"
                                                  MouseLeftButtonDown="GuideLine_MouseDown"
                                                  MouseRightButtonDown="GuideLine_RightClick"
                                                  Cursor="SizeAll">
                                                <Line.X1>
                                                    <MultiBinding Converter="{StaticResource GuideLineX1Converter}">
                                                        <Binding/>
                                                        <Binding Path="DataContext.CanvasWidth" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </Line.X1>
                                                <Line.Y1>
                                                    <MultiBinding Converter="{StaticResource GuideLineY1Converter}">
                                                        <Binding/>
                                                        <Binding Path="DataContext.CanvasHeight" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </Line.Y1>
                                                <Line.X2>
                                                    <MultiBinding Converter="{StaticResource GuideLineX2Converter}">
                                                        <Binding/>
                                                        <Binding Path="DataContext.CanvasWidth" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </Line.X2>
                                                <Line.Y2>
                                                    <MultiBinding Converter="{StaticResource GuideLineY2Converter}">
                                                        <Binding/>
                                                        <Binding Path="DataContext.CanvasHeight" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </Line.Y2>
                                                <Line.Style>
                                                    <Style TargetType="Line">
                                                        <Setter Property="Stroke" Value="#0891B2"/>
                                                        <Setter Property="StrokeThickness" Value="1"/>
                                                        <Setter Property="StrokeDashArray" Value="5,3"/>
                                                        <Setter Property="Opacity" Value="0.7"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Stroke" Value="#0891B2"/>
                                                                <Setter Property="StrokeThickness" Value="2"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Line.Style>
                                            </Line>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                
                                <!-- Number Slots -->
                                <ItemsControl x:Name="SlotsItemsControl" 
                                              ItemsSource="{Binding Slots}"
                                              Visibility="Visible">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource NormalizedToPixelConverter}">
                                                        <Binding Path="X"/>
                                                        <Binding Path="DataContext.CanvasWidth" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Canvas.Top">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource NormalizedToPixelConverter}">
                                                        <Binding Path="Y"/>
                                                        <Binding Path="DataContext.CanvasHeight" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Tag="{Binding}"
                                                BorderBrush="Transparent"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                Cursor="Hand"
                                                MouseLeftButtonDown="Slot_MouseLeftButtonDown"
                                                Opacity="1.0"
                                                Visibility="Visible">
                                            <Border.Width>
                                                <MultiBinding Converter="{StaticResource NormalizedToPixelConverter}">
                                                    <Binding Path="Width"/>
                                                    <Binding Path="DataContext.CanvasWidth" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </Border.Width>
                                            <Border.Height>
                                                <MultiBinding Converter="{StaticResource NormalizedToPixelConverter}">
                                                    <Binding Path="Height"/>
                                                    <Binding Path="DataContext.CanvasHeight" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </Border.Height>
                                            <TextBlock Text="{Binding PreviewNumber}" 
                                                       Foreground="{Binding FontColor, FallbackValue=Black, TargetNullValue=Black}"
                                                       FontFamily="{Binding FontFamily}"
                                                       FontSize="{Binding FontSize}"
                                                       FontWeight="{Binding IsBold, Converter={StaticResource BoolToFontWeightConverter}}"
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center"
                                                       RenderTransformOrigin="0.5,0.5">
                                                <TextBlock.RenderTransform>
                                                    <RotateTransform Angle="{Binding Rotation}"/>
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>
                        </Border>
                    </Border>
                </Border>
            </ScrollViewer>
            
            <!-- Properties Panel (Right Side) -->
            <Border Grid.Column="1" 
                    Background="#FFFFFF" 
                    BorderBrush="#DDD9D3" 
                    BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <!-- Tab-specific Properties -->
                        
                        <!-- HOME Tab Properties -->
                        <StackPanel Visibility="{Binding IsPrepareMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{DynamicResource Numbering_JobProperties}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#14181D"
                                       Margin="0,0,0,20"/>
                            
                            <!-- Start Number Display -->
                            <TextBlock Text="{DynamicResource Numbering_StartNumberLabel}" 
                                       FontSize="12" 
                                       Foreground="#6B6864" 
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding StartNumber, StringFormat='{}{0:N0}'}" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Foreground="#14181D"
                                       Margin="0,0,0,20"/>
                            
                            <!-- Total Numbers Display -->
                            <TextBlock Text="{DynamicResource Numbering_TotalNumbersLabel}" 
                                       FontSize="12" 
                                       Foreground="#6B6864" 
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding TotalNumbers, StringFormat='{}{0:N0}'}" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Foreground="#14181D"
                                       Margin="0,0,0,20"/>
                            
                            <!-- Copies Count -->
                            <TextBlock Text="{DynamicResource Numbering_CopiesCountLabel}" 
                                       FontSize="12" 
                                       Foreground="#6B6864" 
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding CopiesCount, Mode=OneWay, StringFormat='{}{0}'}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#14181D"
                                       Margin="0,0,0,20"/>
                        </StackPanel>
                        
                        <!-- LAYOUT Tab Properties -->
                        <StackPanel Visibility="{Binding IsLayoutMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{DynamicResource Numbering_DesignProperties}" 
                                       FontSize="16" 
                                       FontWeight="Bold" 
                                       Foreground="#14181D"
                                       Margin="0,0,0,20"/>
                            
                            <!-- Selected Slot Properties -->
                            <StackPanel Visibility="{Binding SelectedSlot, Converter={StaticResource NullToVisConverter}}">
                                <TextBlock Text="{DynamicResource Numbering_Font}" 
                                           FontSize="14" 
                                           FontWeight="SemiBold" 
                                           Foreground="#6B6864" 
                                           Margin="0,0,0,16"/>
                                
                                <!-- Font Family -->
                                <TextBlock Text="{DynamicResource Numbering_FontFamily}" 
                                           Foreground="#6B6864" 
                                           FontSize="12" 
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <ComboBox ItemsSource="{Binding AvailableFonts}"
                                          SelectedItem="{Binding SelectedSlot.FontFamily, Mode=TwoWay}"
                                          Margin="0,0,0,16"
                                          Height="36"
                                          FontSize="13"
                                          Background="#FFFFFF"
                                          Foreground="#14181D"
                                          BorderBrush="#6B6864">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                            <Setter Property="Foreground" Value="#14181D"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#DDD9D3"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#0891B2"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                                
                                <!-- Slot kind: print the number, or encode it as a scannable code -->
                                <TextBlock Text="{DynamicResource Num_SlotKind}"
                                           Foreground="#6B6864" FontSize="12" FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <ComboBox ItemsSource="{Binding Source={x:Static models:NumberSlot.AvailableKinds}}"
                                          SelectedItem="{Binding SelectedSlot.SlotKind, Mode=TwoWay}"
                                          Margin="0,0,0,10" Padding="8,4"/>
                                <StackPanel Margin="0,0,0,16"
                                            Visibility="{Binding SelectedSlot.IsBarcode, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                                    <TextBlock Text="{DynamicResource Num_BarcodeType}"
                                               Foreground="#6B6864" FontSize="11" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding Source={x:Static models:NumberSlot.AvailableBarcodeTypes}}"
                                              SelectedItem="{Binding SelectedSlot.BarcodeType, Mode=TwoWay}"
                                              Padding="8,4"/>
                                </StackPanel>

                                <!-- Font Size -->
                                <TextBlock Text="{DynamicResource Numbering_FontSizeLabel}"
                                           Foreground="#6B6864"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Value="{Binding SelectedSlot.FontSize, Mode=TwoWay, FallbackValue=24}" 
                                            Minimum="8" 
                                            Maximum="72" 
                                            VerticalAlignment="Center"
                                            Height="28"
                                            Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" 
                                               Text="{Binding SelectedSlot.FontSize, StringFormat='{}{0}pt', FallbackValue='24pt'}" 
                                               Foreground="#6B6864" 
                                               VerticalAlignment="Center" 
                                               HorizontalAlignment="Right"
                                               FontSize="12"
                                               FontWeight="SemiBold"/>
                                </Grid>
                                
                                <!-- Font Weight -->
                                <TextBlock Text="{DynamicResource Numbering_FontWeightLabel}" 
                                           Foreground="#6B6864" 
                                           FontSize="12" 
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{Binding SelectedSlot.IsBold, Converter={StaticResource InverseBoolToColorConverter}, FallbackValue=#0891B2}" 
                                            CornerRadius="8,0,0,8" 
                                            Padding="12,10" 
                                            Cursor="Hand"
                                            MouseLeftButtonDown="RegularWeight_Click">
                                        <TextBlock Text="{DynamicResource Numbering_FontWeightNormal}" 
                                                   Foreground="White" 
                                                   HorizontalAlignment="Center"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                    <Border Grid.Column="1" 
                                            Background="{Binding SelectedSlot.IsBold, Converter={StaticResource BoolToColorConverter}, FallbackValue=#DDD9D3}" 
                                            CornerRadius="0,8,8,0" 
                                            Padding="12,10" 
                                            Cursor="Hand"
                                            MouseLeftButtonDown="BoldWeight_Click">
                                        <TextBlock Text="{DynamicResource Numbering_FontWeightBold}" 
                                                   Foreground="White" 
                                                   HorizontalAlignment="Center"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                                
                                <!-- Color -->
                                <TextBlock Text="{DynamicResource Numbering_ColorLabel}" 
                                           Foreground="#6B6864" 
                                           FontSize="12" 
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{Binding SelectedSlot.FontColor, FallbackValue='#000000'}" 
                                            CornerRadius="8" 
                                            Width="36" 
                                            Height="36"
                                            BorderBrush="#6B6864"
                                            BorderThickness="1"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="ColorSwatch_Click"/>
                                    <TextBox Grid.Column="1" 
                                             Text="{Binding SelectedSlot.FontColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue='#000000'}" 
                                             Margin="8,0,0,0"
                                             Height="36"
                                             Background="#FFFFFF"
                                             Foreground="#14181D"
                                             BorderBrush="#6B6864"
                                             BorderThickness="1"
                                             Padding="8,0"
                                             VerticalContentAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                            
                            <!-- No Selection Message -->
                            <TextBlock Text="{DynamicResource Numbering_SelectSlot}"
                                       FontSize="13"
                                       Foreground="#6B6864"
                                       TextAlignment="Center"
                                       Margin="0,40,0,0"
                                       Visibility="{Binding SelectedSlot, Converter={StaticResource NullToVisConverter}, ConverterParameter=Inverse}"/>

                        </StackPanel>

                        <!-- EXECUTE Tab Properties -->
                        <StackPanel Visibility="{Binding IsExecuteMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{DynamicResource Numbering_PrintSummary}" 
                                       FontSize="16" 
                                       FontWeight="Bold" 
                                       Foreground="#14181D"
                                       Margin="0,0,0,20"/>
                            
                            <!-- Read-only here: the printer is CHOSEN once in the top
                                 ribbon (picker + properties gear + tray). This panel used
                                 to repeat the whole dropdown, so the operator saw the
                                 printer selector twice on one screen. -->
                            <TextBlock Text="{DynamicResource Numbering_Printer}"
                                       FontSize="12"
                                       Foreground="#6B6864"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding SelectedPrinter, FallbackValue='—', TargetNullValue='—'}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#14181D"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,0,0,20"/>
                            
                            <TextBlock Text="{DynamicResource Numbering_CopiesCountLabel}" 
                                       FontSize="12" 
                                       Foreground="#6B6864" 
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding CopiesCount, Mode=OneWay, StringFormat='{}{0}'}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#14181D"
                                       Margin="0,0,0,20"/>
                            
                            <TextBlock Text="{DynamicResource Numbering_TotalPagesLabel}" 
                                       FontSize="12" 
                                       Foreground="#6B6864" 
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding TotalPagesComputed, Mode=OneWay, StringFormat='{}{0:N0}'}" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Foreground="#0891B2"
                                       Margin="0,0,0,20"/>
                            
                            <!-- Printing Mode Info -->
                            <TextBlock Text="{DynamicResource Numbering_PrintType}" 
                                       FontSize="12" 
                                       Foreground="#6B6864" 
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding PrintingModeName, Mode=OneWay}" 
                                       FontSize="14" 
                                       FontWeight="SemiBold" 
                                       Margin="0,0,0,8">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#1B7F4C"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UseSmartTrayPrinting}" Value="False">
                                                <Setter Property="Foreground" Value="#6B6864"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            
                            <!-- Printing Mode Description -->
                            <Border Background="#FAF9F7" 
                                    BorderBrush="#DDD9D3" 
                                    BorderThickness="1" 
                                    CornerRadius="4" 
                                    Padding="12,10" 
                                    Margin="0,0,0,20">
                                <TextBlock Text="{Binding PrintingModeDescription, Mode=OneWay}" 
                                           FontSize="11" 
                                           Foreground="#6B6864" 
                                           TextWrapping="Wrap" 
                                           LineHeight="18"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ════════════════════════════════════════════════════════════
             MEDIUM ① — Multi-page Preview Popup (4 pages)
             ════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              Background="#B4231814"
              Visibility="{Binding IsMultiPreviewOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              Panel.ZIndex="100">
            <Border Background="#FAF9F7"
                    BorderBrush="#E6F3F6"
                    BorderThickness="1"
                    CornerRadius="12"
                    MaxWidth="860"
                    MaxHeight="640"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.5" Color="#FAF9F7"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="🔍" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Numbering_PreviewFirstPages}" FontSize="18" FontWeight="Bold"
                                   Foreground="#14181D" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Numbering_PreviewFirstPagesSubtitle}"
                                   FontSize="13" Foreground="#6B6864" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Pages Grid -->
                    <Grid Grid.Row="1">
                        <!-- Generating spinner -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding IsGeneratingMultiPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="⟳" FontSize="32" Foreground="#0891B2" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Numbering_GeneratingPreview}" FontSize="14" Foreground="#6B6864"
                                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>

                        <!-- 4 Page thumbnails -->
                        <ItemsControl ItemsSource="{Binding MultiPreviewPages}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGeneratingMultiPreview}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FAF9F7" BorderBrush="#E6F3F6" BorderThickness="1"
                                            CornerRadius="6" Margin="6" Padding="4">
                                        <StackPanel>
                                            <Image Source="{Binding}" Stretch="Uniform" MaxHeight="480"/>
                                            <TextBlock Text="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                       FontSize="11" Foreground="#6B6864"
                                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- Close button -->
                    <Button Grid.Row="2" Command="{Binding CloseMultiPreviewCommand}"
                            Content="{DynamicResource NW_001}"
                            HorizontalAlignment="Center" Margin="0,16,0,0"
                            Padding="24,10" Background="#FFFFFF" Foreground="#6B6864"
                            BorderThickness="1" BorderBrush="#6B6864" FontSize="14" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#DDD9D3"/></Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- ════════════════════════════════════════════════════════════
             MEDIUM ④ — Project Notes Slide-in Panel
             ════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="#FAF9F7"
                BorderBrush="#E6F3F6"
                BorderThickness="1,0,0,0"
                Width="260"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Panel.ZIndex="50"
                Visibility="{Binding IsNotesOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,16,16,8">
                    <TextBlock Text="📝" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Numbering_ProjectNotes}" FontSize="14" FontWeight="SemiBold"
                               Foreground="#14181D" VerticalAlignment="Center"/>
                    <Button Command="{Binding ToggleNotesCommand}"
                            Content="✕"
                            Background="Transparent" Foreground="#6B6864"
                            BorderThickness="0" FontSize="16" Cursor="Hand"
                            Margin="8,0,0,0"
                            HorizontalAlignment="Right">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" Padding="4,0">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#14181D"/></Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <Rectangle Grid.Row="0" Height="1" Fill="#E6F3F6" VerticalAlignment="Bottom" Margin="0,36,0,0"/>

                <!-- Notes TextBox -->
                <TextBox Grid.Row="1"
                         Text="{Binding ProjectNotes, UpdateSourceTrigger=PropertyChanged}"
                         Background="#FAF9F7"
                         Foreground="#14181D"
                         BorderThickness="0"
                         Padding="16,12"
                         FontSize="13"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         CaretBrush="#0891B2"
                         SelectionBrush="#0891B2"
                         VerticalContentAlignment="Top">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <ScrollViewer x:Name="PART_ContentHost" VerticalScrollBarVisibility="Auto"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- Footer hint -->
                <TextBlock Grid.Row="2"
                           Text="{DynamicResource Numbering_NotesSavedAutomatically}"
                           FontSize="10" Foreground="#DDD9D3"
                           TextWrapping="Wrap"
                           Padding="16,8,16,12"/>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════════
             LOW ② — Print History Panel
             ════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="#FAF9F7"
                BorderBrush="#E6F3F6"
                BorderThickness="1,0,0,0"
                Width="300"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Panel.ZIndex="49"
                Margin="0,0,0,0"
                Visibility="{Binding IsPrintHistoryOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="16,14,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                        <TextBlock Text="📋" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Numbering_PrintHistory}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#14181D" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding TogglePrintHistoryCommand}"
                            Content="✕" Background="Transparent" Foreground="#6B6864"
                            BorderThickness="0" FontSize="16" Cursor="Hand" Padding="4,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#14181D"/></Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
                <Rectangle Grid.Row="0" Height="1" Fill="#E6F3F6" VerticalAlignment="Bottom" Margin="0,44,0,0"/>

                <!-- History List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,2,0,0">
                    <StackPanel>
                        <!-- Empty state -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40,0,0"
                                    Visibility="{Binding PrintHistory.Count, Converter={StaticResource CountToHiddenConverter}}">
                            <TextBlock Text="📭" FontSize="32" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Numbering_NoPrintJobs}"
                                       FontSize="13" Foreground="#6B6864"
                                       HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding PrintHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent" BorderBrush="#FFFFFF" BorderThickness="0,0,0,1"
                                            Padding="16,10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#FAF9F7"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#14181D" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}#{0:N0} — {1:N0} رقم">
                                                            <Binding Path="StartNumber"/>
                                                            <Binding Path="TotalNumbers"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding Printer}" FontSize="10" Foreground="#6B6864" TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                                                    <TextBlock Text=" · " FontSize="10" Foreground="#DDD9D3"/>
                                                    <TextBlock Text="{Binding PagesCount, StringFormat='{}{0:N0} صفحة'}" FontSize="10" Foreground="#6B6864"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
                                                           FontSize="11" Foreground="#6B6864" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:dd/MM}'}"
                                                           FontSize="10" Foreground="#DDD9D3" HorizontalAlignment="Right"/>
                                                <!-- Status badge -->
                                                <Border CornerRadius="3" Padding="5,1" Margin="0,3,0,0" HorizontalAlignment="Right">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#E7F3EC"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="ملغي">
                                                                    <Setter Property="Background" Value="#F6E4E2"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="خطأ">
                                                                    <Setter Property="Background" Value="#F6E4E2"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Status}" FontSize="9" Foreground="#1B7F4C">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="ملغي">
                                                                        <Setter Property="Foreground" Value="#B42318"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="خطأ">
                                                                        <Setter Property="Foreground" Value="#B42318"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer: Clear button -->
                <Border Grid.Row="2" BorderBrush="#E6F3F6" BorderThickness="0,1,0,0" Padding="16,10">
                    <Button Command="{Binding ClearPrintHistoryCommand}"
                            Content="{DynamicResource NW_002}"
                            HorizontalAlignment="Center"
                            Padding="16,7" Background="#FFFFFF" Foreground="#6B6864"
                            BorderThickness="1" BorderBrush="#DDD9D3" FontSize="12" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#DDD9D3"/>
                                        <Setter Property="Foreground" Value="#B42318"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Border>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════════
             LOW ⑥ — Recent Projects Panel
             ════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="#FAF9F7"
                BorderBrush="#E6F3F6"
                BorderThickness="1,0,0,0"
                Width="300"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Panel.ZIndex="48"
                Visibility="{Binding IsRecentProjectsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="16,14,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                        <TextBlock Text="🕐" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Numbering_RecentProjects}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#14181D" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding ToggleRecentProjectsCommand}"
                            Content="✕" Background="Transparent" Foreground="#6B6864"
                            BorderThickness="0" FontSize="16" Cursor="Hand" Padding="4,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#14181D"/></Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
                <Rectangle Grid.Row="0" Height="1" Fill="#E6F3F6" VerticalAlignment="Bottom" Margin="0,44,0,0"/>

                <!-- Projects List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Empty state -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40,0,0"
                                    Visibility="{Binding RecentProjects.Count, Converter={StaticResource CountToHiddenConverter}}">
                            <TextBlock Text="📁" FontSize="32" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Numbering_NoRecentProjects}"
                                       FontSize="13" Foreground="#6B6864"
                                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding RecentProjects}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent" BorderBrush="#FFFFFF" BorderThickness="0,0,0,1"
                                            Padding="16,10" Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.OpenRecentProjectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#FAF9F7"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📄" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#14181D"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="220"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Text>
                                                        <Binding Converter="{StaticResource FileNameOnlyConverter}"/>
                                                    </TextBlock.Text>
                                                    <TextBlock.ToolTip>
                                                        <ToolTip Content="{Binding}"/>
                                                    </TextBlock.ToolTip>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Text="{Binding}" FontSize="10" Foreground="#DDD9D3"
                                                       TextTrimming="CharacterEllipsis" Margin="21,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

    </Grid>
</UserControl>
