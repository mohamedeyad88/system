                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                                <!-- Empty state -->
                                <TextBlock Text="{DynamicResource Numbering_NoCheckpoints}"
                                           FontSize="10" Foreground="{DynamicResource Muted}"
                                           Visibility="{Binding CheckpointStates.Count, Converter={StaticResource CountToHiddenConverter}}"/>
