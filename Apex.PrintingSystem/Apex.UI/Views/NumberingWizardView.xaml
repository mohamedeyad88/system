                                            Background="#FAF9F7"
                                            Padding="4,2"
                                            BorderBrush="{DynamicResource Border}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                        <TextBlock Text="{Binding ZoomLevel, StringFormat='{}{0:P0}'}" 
                                                   TextAlignment="Center"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Muted}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <Button Content="+" 
                                            Command="{Binding ZoomInCommand}" 
                                            Width="36" 
                                            Height="36" 
                                            Margin="4,0,0,0"
                                            Background="#FAF9F7"
                                            Foreground="{DynamicResource Muted}"
                                            BorderThickness="1"
                                            BorderBrush="#6B6864"
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Cursor="Hand">
                                        <Button.RenderTransform>
                                            <ScaleTransform/>
                                        </Button.RenderTransform>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" 
                                                                    CornerRadius="6" 
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#DDD9D3"/>
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                                                                                   To="1.1" Duration="0:0:0.15"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                                                                                   To="1.1" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                                                                                   To="1" Duration="0:0:0.15"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                                                                                   To="1" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="⛶" 
                                            Command="{Binding FitToScreenCommand}" 
                                            Width="36" 
                                            Height="36" 
                                            Margin="4,0,0,0" 
                                            ToolTip="Fit to Screen"
                                            Background="#FAF9F7"
                                            Foreground="{DynamicResource Muted}"
                                            BorderThickness="1"
                                            BorderBrush="#6B6864"
                                            FontSize="14"
                                            Cursor="Hand">
                                        <Button.RenderTransform>
                                            <ScaleTransform/>
                                        </Button.RenderTransform>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" 
                                                                    CornerRadius="6" 
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#DDD9D3"/>
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                                                                                   To="1.1" Duration="0:0:0.15"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                                                                                   To="1.1" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                                                                                   To="1" Duration="0:0:0.15"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                                                                                   To="1" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        
                        <!-- Grid Group -->
                        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" Padding="0,0,16,0" Margin="0,0,16,14" MinHeight="74" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Numbering_Grid}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/>
                                <ToggleButton Content="⊞" 
                                              IsChecked="{Binding ShowGrid}"
                                              Width="44" 
                                              Height="36"
                                              Background="#FAF9F7"
                                              Foreground="{DynamicResource Muted}"
                                              BorderThickness="1"
                                              BorderBrush="#6B6864"
                                              FontSize="16"
                                              Cursor="Hand"
                                              ToolTip="Toggle Grid">
                                    <ToggleButton.RenderTransform>
                                        <ScaleTransform/>
                                    </ToggleButton.RenderTransform>
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                CornerRadius="6" 
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Background" Value="#0891B2"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="BorderBrush" Value="#0891B2"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#DDD9D3"/>
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                                                                               To="1.1" Duration="0:0:0.15"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                                                                               To="1.1" Duration="0:0:0.15"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                                                                               To="1" Duration="0:0:0.15"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                                                                               To="1" Duration="0:0:0.15"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                            </StackPanel>
                        </Border>
                        
                        <!-- Slot Actions Group -->
                        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" Padding="0,0,16,0" Margin="0,0,16,14" MinHeight="74" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Numbering_NumberFields}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="➕" 
                                            Command="{Binding AddSlotCommand}" 
                                            Width="38" 
                                            Height="36" 
                                            Margin="0,0,6,0" 
                                            ToolTip="Add Slot"
                                            Background="{DynamicResource Panel}"
                                            Foreground="{DynamicResource Ink}"
                                            BorderThickness="1" BorderBrush="{DynamicResource Border}"
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Cursor="Hand">
                                        <Button.RenderTransform>
                                            <ScaleTransform/>
                                        </Button.RenderTransform>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" 
                                                                    CornerRadius="6">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#1B7F4C"/>
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                                                                                   To="1.15" Duration="0:0:0.2"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                                                                                   To="1.15" Duration="0:0:0.2">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="3"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                                                                                   To="1" Duration="0:0:0.15"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                                                                                   To="1" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="🗑️" 
                                            Command="{Binding DeleteSelectedSlotCommand}" 
                                            Width="38" 
                                            Height="36"
                                            Background="#B42318"
                                            Foreground="White"
                                            BorderThickness="0"
                                            FontSize="16"
                                            Cursor="Hand"
                                            IsEnabled="{Binding SelectedSlot, Converter={StaticResource NullToBoolConverter}}"
                                            ToolTip="Delete Slot">
                                        <Button.RenderTransform>
                                            <ScaleTransform/>
                                        </Button.RenderTransform>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" 
                                                                    CornerRadius="6">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#B42318"/>
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                                                                                   To="1.1" Duration="0:0:0.15"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                                                                                   To="1.1" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                                                                                   To="1" Duration="0:0:0.15"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                                                                                   To="1" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <!-- Dark-theme disabled (was #DDD9D3/#6B6864, light-mode leftover). -->
                                                        <Setter Property="Background" Value="#FFFFFF"/>
                                                        <Setter Property="Foreground" Value="#6B6864"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- ════ LOW ① — Duplicate Slot (Ctrl+D) ════ -->
                                    <Button Command="{Binding DuplicateSlotCommand}"
                                            Width="38" Height="36" Margin="6,0,0,0"
                                            Background="{DynamicResource Panel}" Foreground="{DynamicResource Ink}"
                                            BorderThickness="1" BorderBrush="{DynamicResource Border}" FontSize="15"
                                            Cursor="Hand"
                                            IsEnabled="{Binding SelectedSlot, Converter={StaticResource NullToBoolConverter}}"
                                            ToolTip="{DynamicResource Numbering_DuplicateFieldToolTip}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#0E7490"/></Trigger>
                                                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#DDD9D3"/></Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="⧉" FontSize="16"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ════ LOW ③ — Export Preview ════ -->
                        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" Padding="0,0,16,0" Margin="0,0,16,14" MinHeight="74" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Numbering_ExportLabel}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/>
                                <Button Command="{Binding ExportPreviewCommand}"
                                        ToolTip="{DynamicResource Numbering_ExportPreviewToolTip}"
                                        Padding="12,8"
                                        Background="#FAF9F7" Foreground="{DynamicResource Muted}"
                                        BorderThickness="1" BorderBrush="#6B6864"
                                        FontSize="13" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E6F3F6"/></Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🖼" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="PNG/JPG" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                        <!-- Continue Button (moved to Grid.Row="2" in parent Grid) -->
                    
                    <!-- EXECUTE Tab Content -->
                    <Grid Grid.Row="0" Visibility="{Binding IsExecuteMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                    <!-- Wraps for the same reason as the Home ribbon above. -->
                    <WrapPanel Grid.Row="0" Orientation="Horizontal">
                        <!-- Printer Selection Group -->
                        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" Padding="0,0,16,0" Margin="0,0,16,14" MinHeight="74" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Numbering_Printer}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox ItemsSource="{Binding AvailablePrinters}" 
                                              SelectedItem="{Binding SelectedPrinter}"
                                              Width="180"
                                              Height="36"
                                              FontSize="13"
                                              Padding="10,0"
                                              Background="#FFFFFF"
                                              Foreground="#14181D"
                                              BorderBrush="#6B6864"
                                              BorderThickness="1"
                                              Cursor="Hand"
                                              Margin="0,0,8,0">
                                        <!-- Inherit the global dark ComboBox template + dark item style.
                                             Only add hover/focus accent on top. (Previously this used
                                             the default template + white items → light popup.) -->
                                        <ComboBox.Style>
                                            <Style TargetType="ComboBox"
                                                   BasedOn="{StaticResource {x:Type ComboBox}}">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="#0891B2"/>
                                                    </Trigger>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter Property="BorderBrush" Value="#0891B2"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.Style>
                                    </ComboBox>
                                    <Button Content="⚙️" 
                                            Width="36" 
                                            Height="36"
                                            Background="#FAF9F7"
                                            Foreground="{DynamicResource Muted}"
                                            BorderThickness="1"
                                            BorderBrush="#6B6864"
                                            FontSize="16"
                                            Cursor="Hand"
                                            ToolTip="{DynamicResource PrinterProps_GeneralInfo}"
                                            Command="{Binding OpenPrinterPropertiesCommand}"
                                            IsEnabled="{Binding SelectedPrinter, Converter={StaticResource NullToBoolConverter}}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" 
                                                                    CornerRadius="6" 
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#DDD9D3"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        
                        <!-- Tray Selection (always visible when copies are enabled) -->
                        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" Padding="0,0,16,0" Margin="0,0,16,14" MinHeight="74" VerticalAlignment="Top"
                                Visibility="{Binding HasMultipleCopies, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Numbering_TrayDistribution}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/>
                                <StackPanel>
                                    <!-- Shared dark style for tray ComboBoxes -->
                                    <StackPanel.Resources>
                                        <Style x:Key="DarkTrayCombo" TargetType="ComboBox"
                                               BasedOn="{StaticResource {x:Type ComboBox}}">
                                            <!-- 120 cut real tray names off mid-word
                                                 ("تغذية خلفية للورق" showed as "…للورر").
                                                 Now the printer's own labels fit, and the
                                                 tooltip carries the full name regardless. -->
                                            <Setter Property="Width"           Value="165"/>
                                            <Setter Property="Height"          Value="32"/>
                                            <Setter Property="FontSize"        Value="12"/>
                                            <Setter Property="Padding"         Value="8,0"/>
                                            <Setter Property="Background"      Value="#FFFFFF"/>
                                            <Setter Property="Foreground"      Value="#14181D"/>
                                            <Setter Property="BorderBrush"     Value="#6B6864"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="ItemContainerStyle">
                                                <Setter.Value>
                                                    <Style TargetType="ComboBoxItem">
                                                        <Setter Property="Background" Value="#FFFFFF"/>
                                                        <Setter Property="Foreground" Value="#14181D"/>
                                                        <Setter Property="Padding"    Value="8,5"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#DDD9D3"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter Property="Background" Value="#0891B2"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </StackPanel.Resources>

                                    <!-- Original -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="{DynamicResource Numbering_Original}" Width="58" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Muted}"/>
                                        <ComboBox ItemsSource="{Binding AvailableTrayOptions}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding OriginalTray}"
                                                  ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=SelectedItem.DisplayName}"
                                                  Style="{StaticResource DarkTrayCombo}"/>
                                    </StackPanel>
                                    <!-- Copy 1 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6" Visibility="{Binding UseCopy1, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{DynamicResource Numbering_Copy1Label}" Width="58" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Muted}"/>
                                        <ComboBox ItemsSource="{Binding AvailableTrayOptions}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding Copy1Tray}"
                                                  ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=SelectedItem.DisplayName}"
                                                  Style="{StaticResource DarkTrayCombo}"/>
                                    </StackPanel>
                                    <!-- Copy 2 -->
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding UseCopy2, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{DynamicResource Numbering_Copy2Label}" Width="58" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Muted}"/>
                                        <ComboBox ItemsSource="{Binding AvailableTrayOptions}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding Copy2Tray}"
                                                  ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=SelectedItem.DisplayName}"
                                                  Style="{StaticResource DarkTrayCombo}"/>
                                    </StackPanel>

                                    <!-- Say it out loud when the hardware cannot do what was
                                         asked. Copies quietly coming off one drawer is what
                                         "multi-tray printing does not work" turned out to be. -->
                                    <TextBlock Text="{DynamicResource Numbering_TraySeparationUnavailable}"
                                               Visibility="{Binding TraySeparationUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               Foreground="#B42318" FontSize="11" TextWrapping="Wrap"
                                               MaxWidth="230" Margin="0,8,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        
                        <!-- Detailed Summary Info -->
                        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" Padding="0,0,16,0" Margin="0,0,16,14" MinHeight="74" VerticalAlignment="Top">
                            <!-- Capped, or the mode sentence below stretches the group as
                                 wide as it is long — see the note on the Mode group. -->
                            <StackPanel MaxWidth="290">
                                <TextBlock Text="{DynamicResource Numbering_PrintSummary}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,8" FontWeight="SemiBold"/>
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,4">
                                        <Run Text="{DynamicResource Numbering_PrinterLabel}" Foreground="{DynamicResource Muted}"/>
                                        <Run Text="{Binding SelectedPrinter}" FontWeight="SemiBold" Foreground="#14181D"/>
                                    </TextBlock>
                                    <TextBlock Margin="0,0,0,4">
                                        <Run Text="{DynamicResource Numbering_StartNumberLabel}" Foreground="{DynamicResource Muted}"/>
                                        <Run Text="{Binding StartNumber}" FontWeight="SemiBold" Foreground="#14181D"/>
                                    </TextBlock>
                                    <TextBlock Margin="0,0,0,4">
                                        <Run Text="{DynamicResource Numbering_TotalNumbersLabel}" Foreground="{DynamicResource Muted}"/>
                                        <Run Text="{Binding TotalNumbers, StringFormat='{}{0:N0}'}" FontWeight="SemiBold" Foreground="#14181D"/>
                                    </TextBlock>
                                    <TextBlock Margin="0,0,0,4">
                                        <Run Text="{DynamicResource Numbering_CopiesCountLabel}" Foreground="{DynamicResource Muted}"/>
                                        <Run Text="{Binding CopiesCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="#14181D"/>
                                    </TextBlock>
                                    <TextBlock Margin="0,0,0,4">
                                        <Run Text="{DynamicResource Numbering_TotalPagesLabel}" Foreground="{DynamicResource Muted}"/>
                                        <Run Text="{Binding TotalPagesComputed, Mode=OneWay, StringFormat='{}{0:N0}'}" FontWeight="Bold" Foreground="#0891B2"/>
                                    </TextBlock>
                                    <!-- The mode and its explanation used to be repeated here,
                                         a full sentence wide, even though the Mode group at
                                         the end of the ribbon is where the operator actually
                                         chooses it. Saying it twice cost enough width to push
                                         that group onto a line of its own. The explanation now
                                         lives next to the control it explains. -->
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        
                        <!-- The ribbon's "print status" group stood here: a second, smaller
                             copy of the progress panel that already sits under the ribbon with
                             the live number, the page count, the time remaining and the
                             pause/cancel buttons. Two progress bars for one job is confusing by
                             itself, and because this one appeared only while printing it
                             re-flowed the entire ribbon the moment a job started — every group
                             shifted under the operator's hand. The panel below is the one that
                             stays. -->

                        <!-- Print Scale Options.
                             Was a bare StackPanel anchored to the BOTTOM of the ribbon with
                             its own 14px heading and a 20px bottom margin, so it hung below
                             the other groups and stretched the whole row to its height —
                             the empty band the operator was looking at. It is a ribbon
                             group like every other one now. -->
                        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" Padding="0,0,16,0" Margin="0,0,16,14" MinHeight="74" VerticalAlignment="Top">
                            <StackPanel>
                            <TextBlock Text="{DynamicResource Numbering_ScalingOptions}"
                                       FontSize="11"
                                       Foreground="{DynamicResource Muted}"
                                       Margin="0,0,0,8"/>

                            <StackPanel>
                                <!-- Actual Size (100%) -->
                                <RadioButton Content="{DynamicResource Numbering_ActualSize}"
                                             IsChecked="{Binding PrintScaleMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=ActualSize}"
                                             GroupName="PrintScale"
                                             Margin="0,0,0,6"
                                             FontSize="12"
                                             Foreground="#14181D"
                                             Cursor="Hand"
                                             Checked="PrintScaleMode_Checked"/>

                                <!-- Fit to Page -->
                                <RadioButton Content="{DynamicResource Numbering_FitToPage}"
                                             IsChecked="{Binding PrintScaleMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=FitToPage}"
                                             GroupName="PrintScale"
                                             FontSize="12"
                                             Foreground="#14181D"
                                             Cursor="Hand"
                                             Checked="PrintScaleMode_Checked"/>
                            </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ════ LOW ② — سجل الطباعة + المشاريع الأخيرة ════
                             This group is a WrapPanel item like the others; it used to
                             sit AFTER </WrapPanel> with no Grid.Row, so it defaulted to
                             Grid.Row="0" and drew ON TOP of the ribbon — the field
                             operator saw its buttons clipped/overlapping. Keeping it
                             inside the WrapPanel lets it wrap to a new line like every
                             other group instead of overlapping them. -->
                        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" Padding="0,0,16,0" Margin="0,0,16,14" MinHeight="74" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Numbering_HistoryLabel}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <!-- Print History -->
                                    <Button Command="{Binding TogglePrintHistoryCommand}"
                                            ToolTip="{DynamicResource Numbering_PrintHistoryToolTip}"
                                            Padding="12,8" Margin="0,0,6,0"
                                            Background="#FAF9F7" Foreground="{DynamicResource Muted}"
                                            BorderThickness="1" BorderBrush="#6B6864"
                                            FontSize="12" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E6F3F6"/></Trigger>
                                                    <DataTrigger Binding="{Binding IsPrintHistoryOpen}" Value="True">
                                                        <Setter Property="Background" Value="#E6F3F6"/>
                                                        <Setter Property="BorderBrush" Value="#0891B2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📋" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Numbering_HistoryLabel}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <!-- Recent Projects -->
                                    <Button Command="{Binding ToggleRecentProjectsCommand}"
                                            ToolTip="{DynamicResource Numbering_RecentProjectsToolTip}"
                                            Padding="12,8"
                                            Background="#FAF9F7" Foreground="{DynamicResource Muted}"
                                            BorderThickness="1" BorderBrush="#6B6864"
                                            FontSize="12" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E6F3F6"/></Trigger>
                                                    <DataTrigger Binding="{Binding IsRecentProjectsOpen}" Value="True">
                                                        <Setter Property="Background" Value="#E6F3F6"/>
                                                        <Setter Property="BorderBrush" Value="#0891B2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🕐" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Numbering_RecentButton}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                         <!-- Moved off the Home ribbon: decisions taken at print time. -->
                        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" Padding="0,0,16,0" Margin="0,0,16,14" MinHeight="74" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Numbering_Preview_Label}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <!-- 4-page preview button -->
                                    <Button Command="{Binding ShowMultiPreviewCommand}"
                                            ToolTip="{DynamicResource Numbering_Preview4PagesToolTip}"
                                            Padding="12,8" Margin="0,0,6,0"
                                            Background="#FAF9F7" Foreground="{DynamicResource Muted}"
                                            BorderThickness="1" BorderBrush="#6B6864"
                                            FontSize="13" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E6F3F6"/></Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔍" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Numbering_FourPages}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <!-- Auto-preview toggle -->
                                    <ToggleButton IsChecked="{Binding AutoPreviewEnabled}"
                                                  ToolTip="{DynamicResource Numbering_AutoPreviewTooltip}"
                                                  Padding="10,8"
                                                  FontSize="12" Cursor="Hand">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Setter Property="Background" Value="#FAF9F7"/>
                                                <Setter Property="Foreground" Value="#6B6864"/>
                                                <Setter Property="BorderBrush" Value="#6B6864"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter Property="Background" Value="#E6F3F6"/>
                                                        <Setter Property="Foreground" Value="#0891B2"/>
                                                        <Setter Property="BorderBrush" Value="#0891B2"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#FFFFFF"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚡" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Numbering_Automatic}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ToggleButton>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- A WrapPanel measures its children with unlimited width, so
                             TextWrapping on its own never wraps here — it just made this
                             group as wide as the sentence, which pushed it onto a line of
                             its own and left the row above half empty. MaxWidth is what
                             actually makes the text wrap. -->
                        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" Padding="0,0,16,0" Margin="0,0,16,14" MinHeight="74" VerticalAlignment="Top">
                            <StackPanel MaxWidth="250">
                                <TextBlock Text="{DynamicResource Numbering_ModeLabel}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="{DynamicResource Numbering_TraditionalPrint}"
                                                 IsChecked="{Binding UseSmartTrayPrinting, Converter={StaticResource InverseBoolConverter}}"
                                                 GroupName="PrintMode"
                                                 Margin="0,0,12,0"
                                                 FontSize="12"
                                                 VerticalAlignment="Center"/>
                                    <RadioButton Content="{DynamicResource Numbering_SmartPrint}"
                                                 IsChecked="{Binding UseSmartTrayPrinting}"
                                                 GroupName="PrintMode"
                                                 FontSize="12"
                                                 VerticalAlignment="Center"/>
                                </StackPanel>
                                <!-- The full explanation of the selected mode, moved down from
                                     the summary so it sits with the radio buttons it describes
                                     instead of being said twice on one screen. -->
                                <TextBlock Text="{Binding PrintingModeDescription, Mode=OneWay}"
                                           FontSize="11" Foreground="{DynamicResource Muted}"
                                           TextWrapping="Wrap" MaxWidth="250" LineHeight="16"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                        <!-- Print Button (moved to Grid.Row="2" in parent Grid) -->
                    </Grid>
                    </Grid>
                    </ScrollViewer>
                </Border>

                <!-- Action Buttons (moved outside Border to ensure visibility) -->
                <StackPanel Grid.Row="2" Margin="16,16,16,16" Orientation="Horizontal" HorizontalAlignment="Right" Background="#FFFFFF">
                    <!-- Back Button (visible when not in Prepare mode) -->
                    <Button Command="{Binding NavigateBackCommand}"
                            Visibility="{Binding IsPrepareMode, Converter={StaticResource InverseBoolConverter}}"
                            Foreground="{DynamicResource Muted}"
                            Padding="20,12"
                            FontSize="14"
                            FontWeight="SemiBold"
                            BorderThickness="1"
                            BorderBrush="#6B6864"
                            Background="#FFFFFF"
                            Cursor="Hand"
                            Margin="0,0,12,0">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="←" FontSize="16" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource Numbering_Back}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    
                    <!-- Start Design Button (visible in Prepare mode) -->
                    <Button x:Name="StartLayoutButton"
                            Command="{Binding StartLayoutCommand}" 
                            PreviewMouseDown="StartLayoutButton_PreviewMouseDown"
                            Visibility="{Binding IsPrepareMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Foreground="White"
                            Padding="28,12"
                            FontSize="15"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.RenderTransform>
                            <ScaleTransform/>
                        </Button.RenderTransform>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{StaticResource PrimaryButtonGradient}"/>
                                <Setter Property="Effect" Value="{StaticResource Shadow.Button}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="8" 
                                                    Padding="{TemplateBinding Padding}"
                                                    Effect="{TemplateBinding Effect}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryButtonHoverGradient}"/>
                                        <Setter Property="Effect" Value="{StaticResource Shadow.ButtonHover}"/>
                                        <Trigger.EnterActions>
                                            <BeginStoryboard Storyboard="{StaticResource ButtonHoverStoryboard}"/>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard Storyboard="{StaticResource ButtonExitStoryboard}"/>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard Storyboard="{StaticResource ButtonClickStoryboard}"/>
                                        </Trigger.EnterActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✨" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </TextBlock.RenderTransform>
                                <TextBlock.Triggers>
                                    <EventTrigger RoutedEvent="{x:Static FrameworkElement.LoadedEvent}">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)" 
                                                               From="0" To="360" Duration="0:0:3">
                                                    <DoubleAnimation.EasingFunction>
                                                        <PowerEase Power="1" EasingMode="EaseInOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </TextBlock.Triggers>
                            </TextBlock>
                            <TextBlock Text="{DynamicResource Numbering_StartLayout}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <!-- Continue Button (visible in Layout mode) -->
                    <Button Command="{Binding NavigateToExecuteCommand}" 
                            Visibility="{Binding IsLayoutMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Foreground="White"
                            Padding="24,12"
                            FontSize="15"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.RenderTransform>
                            <ScaleTransform/>
                        </Button.RenderTransform>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{StaticResource SuccessButtonGradient}"/>
                                <Setter Property="Effect" Value="{StaticResource Shadow.Button}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="8" 
                                                    Padding="{TemplateBinding Padding}"
                                                    Effect="{TemplateBinding Effect}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1B7F4C"/>
                                        <Setter Property="Effect" Value="{StaticResource Shadow.ButtonHover}"/>
                                        <Trigger.EnterActions>
                                            <BeginStoryboard Storyboard="{StaticResource ButtonHoverStoryboard}"/>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard Storyboard="{StaticResource ButtonExitStoryboard}"/>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard Storyboard="{StaticResource ButtonClickStoryboard}"/>
                                        </Trigger.EnterActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➡️" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </TextBlock.RenderTransform>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLayoutMode}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="(TextBlock.RenderTransform).(TranslateTransform.X)" 
                                                                           From="0" To="5" Duration="0:0:0.8" 
                                                                           AutoReverse="True">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <SineEase EasingMode="EaseInOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{DynamicResource Numbering_ContinueToPrint}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <!-- Print Button (visible in Execute mode) -->
                    <!-- Command only. It used to also carry Click="StartPrintButton_Click",
                         and that handler executed the very same StartPrintCommand, so one
                         press fired the print twice. It is the only button of 45+ in this
                         view with a Click handler; every other works on Command alone. -->
                            <Button x:Name="StartPrintButton"
                                    Command="{Binding StartPrintCommand}"
                            Visibility="{Binding IsExecuteMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Foreground="White"
                                    Padding="28,14"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    IsEnabled="{Binding IsPrinting, Converter={StaticResource InverseBoolConverter}}">
                                <Button.RenderTransform>
                                    <ScaleTransform/>
                                </Button.RenderTransform>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{StaticResource PrimaryButtonGradient}"/>
                                        <Setter Property="Effect" Value="{StaticResource Shadow.Button}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" 
                                                            CornerRadius="8" 
                                                            Padding="{TemplateBinding Padding}"
                                                            Effect="{TemplateBinding Effect}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryButtonHoverGradient}"/>
                                                <Setter Property="Effect" Value="{StaticResource Shadow.ButtonHover}"/>
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard Storyboard="{StaticResource ButtonHoverStoryboard}"/>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard Storyboard="{StaticResource ButtonExitStoryboard}"/>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard Storyboard="{StaticResource ButtonClickStoryboard}"/>
                                                </Trigger.EnterActions>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <!-- Dark-theme disabled (was #DDD9D3, light-mode leftover). -->
                                                <Setter Property="Background" Value="#FFFFFF"/>
                                                <Setter Property="Foreground" Value="#6B6864"/>
                                                <Setter Property="Effect" Value="{x:Null}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🖨️" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExecuteMode, Mode=OneWay}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard RepeatBehavior="Forever">
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                                                                   From="1" To="0.6" Duration="0:0:1" 
                                                                                   AutoReverse="True">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <SineEase EasingMode="EaseInOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{DynamicResource Numbering_PrintNow}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                <!-- ══════════════════════════════════════════════════════
                     GLOBAL PRINT PROGRESS BAR  (شريط تقدم الطباعة)
                     يظهر عند بدء الطباعة في أي وضع
                     ══════════════════════════════════════════════════════ -->
                <Border Grid.Row="3"
                        Background="#FAF9F7"
                        BorderBrush="#E6F3F6" BorderThickness="0,2,0,0"
                        Padding="24,12"
                        Visibility="{Binding IsPrinting,
                                     Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>  <!-- Icon + Status   -->
                            <ColumnDefinition Width="*"/>     <!-- Progress track  -->
                            <ColumnDefinition Width="Auto"/>  <!-- Stats           -->
                            <ColumnDefinition Width="Auto"/>  <!-- Pause / Cancel  -->
                        </Grid.ColumnDefinitions>

                        <!-- ① Status text -->
                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Margin="0,0,24,0" MinWidth="220">
                            <TextBlock FontSize="13" FontWeight="SemiBold">
                                <Run Text="🖨️  " Foreground="#0891B2"/>
                                <Run Text="{Binding PrintStatus, Mode=OneWay}"
                                     Foreground="#14181D"/>
                            </TextBlock>
                            <TextBlock Text="{Binding PrintedPagesDisplay, Mode=OneWay}"
                                       FontSize="11" Foreground="{DynamicResource Muted}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- ② Progress bar track (custom) -->
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <!-- Track background -->
                            <Border Height="10" Background="#FFFFFF" CornerRadius="5"/>
                            <!-- ProgressBar (WPF handles width automatically) -->
                            <ProgressBar x:Name="GlobalProgressBar"
                                         Value="{Binding PrintProgress, Mode=OneWay}"
                                         Maximum="100" Height="10"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="#0891B2">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ProgressBar">
                                                    <Grid>
                                                        <!-- Track (named PART_Track so WPF sizes PART_Indicator) -->
                                                        <Border x:Name="PART_Track" Background="#FFFFFF" CornerRadius="5"/>
                                                        <!-- Fill -->
                                                        <Border x:Name="PART_Indicator"
                                                                HorizontalAlignment="Left"
                                                                CornerRadius="5">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                    <GradientStop Color="#0891B2" Offset="0"/>
                                                                    <GradientStop Color="#0891B2" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                        </Grid>

                        <!-- ③ Stats: Percent + Elapsed + ETA -->
                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Margin="20,0,20,0"
                                    HorizontalAlignment="Right">
                            <!-- Current serial — the hero readout: big mono, reads from across the
                                 shop while the press runs. Percent / time / speed drop to a
                                 secondary row underneath. -->
                            <TextBlock Text="{Binding CurrentNumberDisplay}"
                                       HorizontalAlignment="Right" TextAlignment="Right"
                                       FontFamily="{DynamicResource Font.Data}" Language="en-US"
                                       FontSize="48" FontWeight="Bold"
                                       Foreground="{DynamicResource Ink}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                                <TextBlock FontSize="13" FontFamily="{DynamicResource Font.Data}"
                                           Language="en-US" Margin="0,0,10,0">
                                    <Run Text="{Binding PrintProgress, Mode=OneWay, StringFormat='{}{0:F0}'}"
                                         Foreground="{DynamicResource Brand}" FontWeight="Bold"/>
                                    <Run Text="%" Foreground="{DynamicResource Muted}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding ElapsedTimeDisplay, Mode=OneWay}"
                                           FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding PrintSpeedDisplay, Mode=OneWay}"
                                           FontSize="11" Foreground="#1B7F4C"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- ④ Pause + Cancel buttons -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <!-- Pause / Resume -->
                            <Button Command="{Binding PauseResumeCommand}"
                                    Cursor="Hand"
                                    Margin="0,0,8,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#E6F3F6"/>
                                        <Setter Property="Foreground" Value="#0E7490"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="14,8"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bg"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="7"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bg" Property="Background" Value="#E6F3F6"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⏸ " FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Numbering_PauseButton}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Cancel -->
                            <Button Command="{Binding CancelPrintCommand}"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#F6E4E2"/>
                                        <Setter Property="Foreground" Value="#B42318"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="14,8"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bg"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="7"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bg" Property="Background" Value="#F6E4E2"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="■ " FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Numbering_CancelPrintingButton}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </Border>

        <!-- ============================================ -->
        <!-- MAIN CONTENT AREA -->
        <!-- ============================================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/> <!-- Canvas -->
                <ColumnDefinition Width="320"/> <!-- Properties Panel -->
            </Grid.ColumnDefinitions>
            
            <!-- Canvas Area -->
            <ScrollViewer Grid.Column="0"
                          x:Name="CanvasScrollViewer"
                          SizeChanged="CanvasScrollViewer_SizeChanged"
                          Background="{StaticResource CanvasBackgroundGradient}"
                          Padding="20"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          CanContentScroll="True">
                <Border Background="#FAF9F7"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="24">
                    <Border x:Name="CanvasContainer">
                        <Border Background="#FFFFFF"
                                BorderBrush="{DynamicResource Border}"
                                BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.22" Color="#8A8783"/>
                            </Border.Effect>
                            <!-- Zoom via LayoutTransform (was RenderTransform + centre pivot).
                                 RenderTransform is visual-only: the ScrollViewer never saw the
                                 scaled size, so a zoomed-in sheet could not be scrolled to and
                                 the pivot had to be faked at the centre. LayoutTransform grows
                                 the real layout, so the scrollbars reach every part and the
                                 code-behind can anchor the zoom on the mouse pointer. -->
                            <Border.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding ZoomLevel}"
                                                ScaleY="{Binding ZoomLevel}"/>
                            </Border.LayoutTransform>

                            <!-- FlowDirection is pinned LeftToRight even though the whole app is
                                 Arabic/RTL. This canvas is not text: it is a map of the sheet, and
                                 a slot's X is stored as a fraction measured from the sheet's LEFT
                                 edge — that is what the print engine renders from. Inheriting the
                                 window's RTL flow made Canvas.Left count from the RIGHT instead,
                                 so a field placed at 10% appeared at 10% from the right on screen
                                 and printed at 10% from the left: the designer showed a perfect
                                 mirror image of the sheet the operator got back. Dragging was
                                 mirrored with it. -->
                            <Canvas x:Name="TemplateCanvas"
                                    FlowDirection="LeftToRight"
                                    Width="{Binding CanvasWidth}"
                                    Height="{Binding CanvasHeight}"
                                    Background="#FFFFFF"
                                    ClipToBounds="True"
                                    MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                                    MouseMove="Canvas_MouseMove"
                                    MouseLeftButtonUp="Canvas_MouseLeftButtonUp">
                                
                                <!-- Template Image (base layer) -->
                                <Image Source="{Binding TemplateImage}"
                                       Width="{Binding CanvasWidth}"
                                       Height="{Binding CanvasHeight}"
                                       Stretch="Fill"/>

                                <!-- Live Preview Overlay (auto-generated with actual numbers) -->
                                <Image Source="{Binding LivePreviewImage}"
                                       Width="{Binding CanvasWidth}"
                                       Height="{Binding CanvasHeight}"
                                       Stretch="Fill"
                                       Visibility="{Binding LivePreviewImage, Converter={StaticResource NullToVisConverter}}"/>

                                <!-- Generating Preview Spinner -->
                                <Border Background="#F2FFFFFF"
                                        BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,8"
                                        Canvas.Left="8"
                                        Canvas.Top="8"
                                        Visibility="{Binding IsGeneratingPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⟳" FontSize="14" Foreground="#0891B2" Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource Numbering_GeneratingPreview}" Foreground="#14181D" FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <!-- Grid Overlay (Smart Grid - 0.5 cm spacing) -->
                                <ItemsControl ItemsSource="{Binding GridLines}" 
                                              Visibility="{Binding ShowGrid, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Line X1="{Binding X1}" Y1="{Binding Y1}"
                                                  X2="{Binding X2}" Y2="{Binding Y2}"
                                                  Stroke="#C9C4BB"
                                                  StrokeThickness="0.5"
                                                  Opacity="0.7"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                
                                <!-- Guide Lines -->
                                <ItemsControl ItemsSource="{Binding Guides}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:GuideLine}">
                                            <Line Tag="{Binding}"
                                                  MouseLeftButtonDown="GuideLine_MouseDown"
                                                  MouseRightButtonDown="GuideLine_RightClick"
                                                  Cursor="SizeAll">
                                                <Line.X1>
                                                    <MultiBinding Converter="{StaticResource GuideLineX1Converter}">
                                                        <Binding/>
                                                        <Binding Path="DataContext.CanvasWidth" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </Line.X1>
                                                <Line.Y1>
                                                    <MultiBinding Converter="{StaticResource GuideLineY1Converter}">
                                                        <Binding/>
                                                        <Binding Path="DataContext.CanvasHeight" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </Line.Y1>
                                                <Line.X2>
                                                    <MultiBinding Converter="{StaticResource GuideLineX2Converter}">
                                                        <Binding/>
                                                        <Binding Path="DataContext.CanvasWidth" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </Line.X2>
                                                <Line.Y2>
                                                    <MultiBinding Converter="{StaticResource GuideLineY2Converter}">
                                                        <Binding/>
                                                        <Binding Path="DataContext.CanvasHeight" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </Line.Y2>
                                                <Line.Style>
                                                    <Style TargetType="Line">
                                                        <Setter Property="Stroke" Value="#0891B2"/>
                                                        <Setter Property="StrokeThickness" Value="1"/>
                                                        <Setter Property="StrokeDashArray" Value="5,3"/>
                                                        <Setter Property="Opacity" Value="0.7"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Stroke" Value="#0891B2"/>
                                                                <Setter Property="StrokeThickness" Value="2"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Line.Style>
                                            </Line>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                
                                <!-- Number Slots -->
                                <ItemsControl x:Name="SlotsItemsControl" 
                                              ItemsSource="{Binding Slots}"
                                              Visibility="Visible">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource NormalizedToPixelConverter}">
                                                        <Binding Path="X"/>
                                                        <Binding Path="DataContext.CanvasWidth" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Canvas.Top">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource NormalizedToPixelConverter}">
                                                        <Binding Path="Y"/>
                                                        <Binding Path="DataContext.CanvasHeight" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- A slot used to be an invisible box: transparent fill, zero-width
                                             border, and nothing drawn but the preview number at its stored
                                             FontSize. The canvas is laid out at the design's OWN pixel size
                                             (a 300dpi A4 scan is ~2480x3508) and zoomed to fit, so that
                                             number can land at a handful of device pixels — which is how an
                                             operator ends up reporting that adding a field does nothing.
                                             The field now carries a tint and an outline that stay visible at
                                             any zoom, and it turns solid when it is the selected one. -->
                                        <Border Tag="{Binding}"
                                                BorderThickness="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ZoomInvariantThicknessConverter}, ConverterParameter=1.5}"
                                                Cursor="Hand"
                                                MouseLeftButtonDown="Slot_MouseLeftButtonDown"
                                                Opacity="1.0"
                                                Visibility="Visible">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1F0891B2"/>
                                                    <Setter Property="BorderBrush" Value="#800891B2"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="#380891B2"/>
                                                            <Setter Property="BorderBrush" Value="#FF0891B2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.Width>
                                                <MultiBinding Converter="{StaticResource NormalizedToPixelConverter}">
                                                    <Binding Path="Width"/>
                                                    <Binding Path="DataContext.CanvasWidth" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </Border.Width>
                                            <Border.Height>
                                                <MultiBinding Converter="{StaticResource NormalizedToPixelConverter}">
                                                    <Binding Path="Height"/>
                                                    <Binding Path="DataContext.CanvasHeight" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </Border.Height>
                                            <!-- FontSize goes through SlotFontScaleConverter: the stored value is
                                                 in 96-dpi design units and the print engine scales it by the
                                                 template's resolution, so binding it raw drew the number at a
                                                 third of its printed size on a 300-dpi design. Vertical
                                                 alignment is Top to match the engine, which anchors the number
                                                 at the slot's top-left and only adjusts X for alignment. -->
                                            <!-- Drawn only while there is no rendered sheet underneath.
                                                 Both layers used to draw the number at once, and WPF and
                                                 the print renderer never place a glyph on exactly the same
                                                 pixel, so at rest every number showed twice, a hair apart.
                                                 The rendered sheet is what prints, so it wins; this text is
                                                 the stand-in while dragging and before the render lands. -->
                                            <TextBlock Text="{Binding PreviewNumber}"
                                                       Visibility="{Binding DataContext.LivePreviewImage, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullToVisibleConverter}}"
                                                       Foreground="{Binding FontColor, FallbackValue=Black, TargetNullValue=Black}"
                                                       FontFamily="{Binding FontFamily}"
                                                       FontWeight="{Binding IsBold, Converter={StaticResource BoolToFontWeightConverter}}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Top"
                                                       RenderTransformOrigin="0.5,0.5">
                                                <TextBlock.FontSize>
                                                    <MultiBinding Converter="{StaticResource SlotFontScaleConverter}">
                                                        <Binding Path="FontSize"/>
                                                        <Binding Path="DataContext.CanvasWidth" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </TextBlock.FontSize>
                                                <TextBlock.RenderTransform>
                                                    <RotateTransform Angle="{Binding Rotation}"/>
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>
                        </Border>
                    </Border>
                </Border>
            </ScrollViewer>
            
            <!-- Properties Panel (Right Side) -->
            <Border Grid.Column="1" 
                    Background="#FFFFFF" 
                    BorderBrush="{DynamicResource Border}" 
                    BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <!-- Tab-specific Properties -->
                        
                        <!-- HOME Tab Properties -->
                        <StackPanel Visibility="{Binding IsPrepareMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{DynamicResource Numbering_JobProperties}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#14181D"
                                       Margin="0,0,0,20"/>
                            
                            <!-- Start Number Display -->
                            <TextBlock Text="{DynamicResource Numbering_StartNumberLabel}" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource Muted}" 
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding StartNumber, StringFormat='{}{0:N0}'}" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Foreground="#14181D"
                                       Margin="0,0,0,20"/>
                            
                            <!-- Total Numbers Display -->
                            <TextBlock Text="{DynamicResource Numbering_TotalNumbersLabel}" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource Muted}" 
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding TotalNumbers, StringFormat='{}{0:N0}'}" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Foreground="#14181D"
                                       Margin="0,0,0,20"/>
                            
                            <!-- Copies Count -->
                            <TextBlock Text="{DynamicResource Numbering_CopiesCountLabel}" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource Muted}" 
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding CopiesCount, Mode=OneWay, StringFormat='{}{0}'}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#14181D"
                                       Margin="0,0,0,20"/>
                        </StackPanel>
                        
                        <!-- LAYOUT Tab Properties -->
                        <StackPanel Visibility="{Binding IsLayoutMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{DynamicResource Numbering_DesignProperties}" 
                                       FontSize="16" 
                                       FontWeight="Bold" 
                                       Foreground="#14181D"
                                       Margin="0,0,0,20"/>
                            
                            <!-- Selected Slot Properties -->
                            <StackPanel Visibility="{Binding SelectedSlot, Converter={StaticResource NullToVisConverter}}">
                                <TextBlock Text="{DynamicResource Numbering_Font}" 
                                           FontSize="14" 
                                           FontWeight="SemiBold" 
                                           Foreground="{DynamicResource Muted}" 
                                           Margin="0,0,0,16"/>
                                
                                <!-- Font Family -->
                                <TextBlock Text="{DynamicResource Numbering_FontFamily}" 
                                           Foreground="{DynamicResource Muted}" 
                                           FontSize="12" 
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <ComboBox ItemsSource="{Binding AvailableFonts}"
                                          SelectedItem="{Binding SelectedSlot.FontFamily, Mode=TwoWay}"
                                          Margin="0,0,0,16"
                                          Height="36"
                                          FontSize="13"
                                          Background="#FFFFFF"
                                          Foreground="#14181D"
                                          BorderBrush="#6B6864">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                            <Setter Property="Foreground" Value="#14181D"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#DDD9D3"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#0891B2"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                                
                                <!-- Slot kind: print the number, or encode it as a scannable code -->
                                <TextBlock Text="{DynamicResource Num_SlotKind}"
                                           Foreground="{DynamicResource Muted}" FontSize="12" FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <ComboBox ItemsSource="{Binding Source={x:Static models:NumberSlot.AvailableKinds}}"
                                          SelectedItem="{Binding SelectedSlot.SlotKind, Mode=TwoWay}"
                                          Margin="0,0,0,10" Padding="8,4"/>
                                <StackPanel Margin="0,0,0,16"
                                            Visibility="{Binding SelectedSlot.IsBarcode, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                                    <TextBlock Text="{DynamicResource Num_BarcodeType}"
                                               Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding Source={x:Static models:NumberSlot.AvailableBarcodeTypes}}"
                                              SelectedItem="{Binding SelectedSlot.BarcodeType, Mode=TwoWay}"
                                              Padding="8,4"/>
                                </StackPanel>

                                <!-- Font Size -->
                                <TextBlock Text="{DynamicResource Numbering_FontSizeLabel}"
                                           Foreground="{DynamicResource Muted}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Value="{Binding SelectedSlot.FontSize, Mode=TwoWay, FallbackValue=24}" 
                                            Minimum="8" 
                                            Maximum="72" 
                                            VerticalAlignment="Center"
                                            Height="28"
                                            Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" 
                                               Text="{Binding SelectedSlot.FontSize, StringFormat='{}{0}pt', FallbackValue='24pt'}" 
                                               Foreground="{DynamicResource Muted}" 
                                               VerticalAlignment="Center" 
                                               HorizontalAlignment="Right"
                                               FontSize="12"
                                               FontWeight="SemiBold"/>
                                </Grid>
                                
                                <!-- Font Weight -->
                                <TextBlock Text="{DynamicResource Numbering_FontWeightLabel}" 
                                           Foreground="{DynamicResource Muted}" 
                                           FontSize="12" 
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{Binding SelectedSlot.IsBold, Converter={StaticResource InverseBoolToColorConverter}, FallbackValue=#0891B2}" 
                                            CornerRadius="8,0,0,8" 
                                            Padding="12,10" 
                                            Cursor="Hand"
                                            MouseLeftButtonDown="RegularWeight_Click">
                                        <TextBlock Text="{DynamicResource Numbering_FontWeightNormal}" 
                                                   Foreground="White" 
                                                   HorizontalAlignment="Center"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                    <Border Grid.Column="1" 
                                            Background="{Binding SelectedSlot.IsBold, Converter={StaticResource BoolToColorConverter}, FallbackValue=#DDD9D3}" 
                                            CornerRadius="0,8,8,0" 
                                            Padding="12,10" 
                                            Cursor="Hand"
                                            MouseLeftButtonDown="BoldWeight_Click">
                                        <TextBlock Text="{DynamicResource Numbering_FontWeightBold}" 
                                                   Foreground="White" 
                                                   HorizontalAlignment="Center"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                                
                                <!-- Color -->
                                <TextBlock Text="{DynamicResource Numbering_ColorLabel}" 
                                           Foreground="{DynamicResource Muted}" 
                                           FontSize="12" 
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{Binding SelectedSlot.FontColor, FallbackValue='#000000'}" 
                                            CornerRadius="8" 
                                            Width="36" 
                                            Height="36"
                                            BorderBrush="#6B6864"
                                            BorderThickness="1"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="ColorSwatch_Click"/>
                                    <TextBox Grid.Column="1" 
                                             Text="{Binding SelectedSlot.FontColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue='#000000'}" 
                                             Margin="8,0,0,0"
                                             Height="36"
                                             Background="#FFFFFF"
                                             Foreground="#14181D"
                                             BorderBrush="#6B6864"
                                             BorderThickness="1"
                                             Padding="8,0"
                                             VerticalContentAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                            
                            <!-- No Selection Message -->
                            <TextBlock Text="{DynamicResource Numbering_SelectSlot}"
                                       FontSize="13"
                                       Foreground="{DynamicResource Muted}"
                                       TextAlignment="Center"
                                       Margin="0,40,0,0"
                                       Visibility="{Binding SelectedSlot, Converter={StaticResource NullToVisConverter}, ConverterParameter=Inverse}"/>

                        </StackPanel>

                        <!-- EXECUTE Tab Properties -->
                        <StackPanel Visibility="{Binding IsExecuteMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{DynamicResource Numbering_PrintSummary}" 
                                       FontSize="16" 
                                       FontWeight="Bold" 
                                       Foreground="#14181D"
                                       Margin="0,0,0,20"/>
                            
                            <!-- Read-only here: the printer is CHOSEN once in the top
                                 ribbon (picker + properties gear + tray). This panel used
                                 to repeat the whole dropdown, so the operator saw the
                                 printer selector twice on one screen. -->
                            <TextBlock Text="{DynamicResource Numbering_Printer}"
                                       FontSize="12"
                                       Foreground="{DynamicResource Muted}"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding SelectedPrinter, FallbackValue='—', TargetNullValue='—'}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#14181D"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,0,0,20"/>
                            
                            <TextBlock Text="{DynamicResource Numbering_CopiesCountLabel}" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource Muted}" 
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding CopiesCount, Mode=OneWay, StringFormat='{}{0}'}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#14181D"
                                       Margin="0,0,0,20"/>
                            
                            <TextBlock Text="{DynamicResource Numbering_TotalPagesLabel}" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource Muted}" 
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding TotalPagesComputed, Mode=OneWay, StringFormat='{}{0:N0}'}" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Foreground="#0891B2"
                                       Margin="0,0,0,20"/>
                            
                            <!-- Printing Mode Info -->
                            <TextBlock Text="{DynamicResource Numbering_PrintType}" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource Muted}" 
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding PrintingModeName, Mode=OneWay}" 
                                       FontSize="14" 
                                       FontWeight="SemiBold" 
                                       Margin="0,0,0,8">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#1B7F4C"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UseSmartTrayPrinting}" Value="False">
                                                <Setter Property="Foreground" Value="#6B6864"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            
                            <!-- Printing Mode Description -->
                            <Border Background="#FAF9F7" 
                                    BorderBrush="{DynamicResource Border}" 
                                    BorderThickness="1" 
                                    CornerRadius="4" 
                                    Padding="12,10" 
                                    Margin="0,0,0,20">
                                <TextBlock Text="{Binding PrintingModeDescription, Mode=OneWay}" 
                                           FontSize="11" 
                                           Foreground="{DynamicResource Muted}" 
                                           TextWrapping="Wrap" 
                                           LineHeight="18"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ════════════════════════════════════════════════════════════
             MEDIUM ① — Multi-page Preview Popup (4 pages)
             ════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              Background="#B4231814"
              Visibility="{Binding IsMultiPreviewOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              Panel.ZIndex="100">
            <Border Background="#FAF9F7"
                    BorderBrush="#E6F3F6"
                    BorderThickness="1"
                    CornerRadius="12"
                    MaxWidth="1500"
                    MaxHeight="980"
                    Margin="40"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.5" Color="#FAF9F7"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- title -->
                        <RowDefinition Height="Auto"/>   <!-- cut-piece breakdown -->
                        <RowDefinition Height="*"/>      <!-- the four sheets -->
                        <RowDefinition Height="Auto"/>   <!-- close -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="🔍" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Numbering_PreviewFirstPages}" FontSize="18" FontWeight="Bold"
                                   Foreground="#14181D" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Numbering_PreviewFirstPagesSubtitle}"
                                   FontSize="13" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- What each cut piece ends up holding. Only meaningful in cutting mode,
                         and the one thing the four sheets on screen cannot show: after the
                         guillotine each field becomes its own book, and a wrong range is only
                         discovered once the paper is already cut. -->
                    <Border Grid.Row="1"
                            Background="#FFFBEB" BorderBrush="#F59E0B" BorderThickness="1"
                            CornerRadius="6" Padding="12,8" Margin="0,0,0,12"
                            Visibility="{Binding HasImposedRanges, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Numbering_CutPiecesTitle}"
                                       FontSize="12" FontWeight="SemiBold" Foreground="#14181D" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding ImposedRanges}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FFFFFF" BorderBrush="#F59E0B" BorderThickness="1"
                                                CornerRadius="4" Padding="8,4" Margin="0,0,8,4">
                                            <TextBlock Text="{Binding Text}" FontSize="12" Foreground="#14181D"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Pages Grid -->
                    <Grid Grid.Row="2">
                        <!-- Generating spinner -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding IsGeneratingMultiPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="⟳" FontSize="32" Foreground="#0891B2" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Numbering_GeneratingPreview}" FontSize="14" Foreground="{DynamicResource Muted}"
                                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>

                        <!-- 4 Page thumbnails -->
                        <ItemsControl ItemsSource="{Binding MultiPreviewPages}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGeneratingMultiPreview}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <!-- Two by two, not four in a row: four A4 sheets side by side
                                 left each about 200px wide and the numbering stamp on them
                                 a few unreadable pixels. -->
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="2" Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.OpenPreviewPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand"
                                            ToolTip="{DynamicResource Numbering_OpenPageToolTip}"
                                            Background="Transparent" BorderThickness="0" Padding="0" Margin="6">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Frame"
                                                        Background="#FFFFFF" BorderBrush="#E6F3F6" BorderThickness="1"
                                                        CornerRadius="6" Padding="6">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Frame" Property="BorderBrush" Value="#0891B2"/>
                                                        <Setter TargetName="Frame" Property="Background" Value="#F2FBFD"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel>
                                            <Image Source="{Binding Image}" Stretch="Uniform"/>
                                            <TextBlock Text="{Binding Label}"
                                                       FontSize="12" Foreground="{DynamicResource Muted}"
                                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- One page, opened properly. Scrollable, because at full size an
                             A4 sheet at 300 dpi is taller than any window. -->
                        <Grid Background="#FAF9F7"
                              Visibility="{Binding IsPreviewPageOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Button Grid.Row="0" Command="{Binding ClosePreviewPageCommand}"
                                    Content="{DynamicResource Numbering_BackToPages}"
                                    HorizontalAlignment="Right" Margin="0,0,0,10"
                                    Padding="14,6" Background="#FFFFFF" Foreground="{DynamicResource Muted}"
                                    BorderThickness="1" BorderBrush="#6B6864" FontSize="12" Cursor="Hand"/>
                            <ScrollViewer Grid.Row="1"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          Background="#DDD9D3">
                                <Image Source="{Binding OpenedPreviewPage}" Stretch="None"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12"/>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- Close button -->
                    <Button Grid.Row="3" Command="{Binding CloseMultiPreviewCommand}"
                            Content="{DynamicResource NW_001}"
                            HorizontalAlignment="Center" Margin="0,16,0,0"
                            Padding="24,10" Background="#FFFFFF" Foreground="{DynamicResource Muted}"
                            BorderThickness="1" BorderBrush="#6B6864" FontSize="14" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#DDD9D3"/></Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- ════════════════════════════════════════════════════════════
             MEDIUM ④ — Project Notes Slide-in Panel
             ════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="#FAF9F7"
                BorderBrush="#E6F3F6"
                BorderThickness="1,0,0,0"
                Width="260"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Panel.ZIndex="50"
                Visibility="{Binding IsNotesOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,16,16,8">
                    <TextBlock Text="📝" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Numbering_ProjectNotes}" FontSize="14" FontWeight="SemiBold"
                               Foreground="#14181D" VerticalAlignment="Center"/>
                    <Button Command="{Binding ToggleNotesCommand}"
                            Content="✕"
                            Background="Transparent" Foreground="{DynamicResource Muted}"
                            BorderThickness="0" FontSize="16" Cursor="Hand"
                            Margin="8,0,0,0"
                            HorizontalAlignment="Right">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" Padding="4,0">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#14181D"/></Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <Rectangle Grid.Row="0" Height="1" Fill="#E6F3F6" VerticalAlignment="Bottom" Margin="0,36,0,0"/>

                <!-- Notes TextBox -->
                <TextBox Grid.Row="1"
                         Text="{Binding ProjectNotes, UpdateSourceTrigger=PropertyChanged}"
                         Background="#FAF9F7"
                         Foreground="#14181D"
                         BorderThickness="0"
                         Padding="16,12"
                         FontSize="13"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         CaretBrush="#0891B2"
                         SelectionBrush="#0891B2"
                         VerticalContentAlignment="Top">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <ScrollViewer x:Name="PART_ContentHost" VerticalScrollBarVisibility="Auto"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- Footer hint -->
                <TextBlock Grid.Row="2"
                           Text="{DynamicResource Numbering_NotesSavedAutomatically}"
                           FontSize="10" Foreground="{DynamicResource Muted}"
                           TextWrapping="Wrap"
                           Padding="16,8,16,12"/>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════════
             LOW ② — Print History Panel
             ════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="#FAF9F7"
                BorderBrush="#E6F3F6"
                BorderThickness="1,0,0,0"
                Width="300"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Panel.ZIndex="49"
                Margin="0,0,0,0"
                Visibility="{Binding IsPrintHistoryOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="16,14,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                        <TextBlock Text="📋" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Numbering_PrintHistory}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#14181D" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding TogglePrintHistoryCommand}"
                            Content="✕" Background="Transparent" Foreground="{DynamicResource Muted}"
                            BorderThickness="0" FontSize="16" Cursor="Hand" Padding="4,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#14181D"/></Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
                <Rectangle Grid.Row="0" Height="1" Fill="#E6F3F6" VerticalAlignment="Bottom" Margin="0,44,0,0"/>

                <!-- History List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,2,0,0">
                    <StackPanel>
                        <!-- Empty state -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40,0,0"
                                    Visibility="{Binding PrintHistory.Count, Converter={StaticResource CountToHiddenConverter}}">
                            <TextBlock Text="📭" FontSize="32" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Numbering_NoPrintJobs}"
                                       FontSize="13" Foreground="{DynamicResource Muted}"
                                       HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding PrintHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent" BorderBrush="#FFFFFF" BorderThickness="0,0,0,1"
                                            Padding="16,10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#FAF9F7"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#14181D" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}#{0:N0} — {1:N0} رقم">
                                                            <Binding Path="StartNumber"/>
                                                            <Binding Path="TotalNumbers"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding Printer}" FontSize="10" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                                                    <TextBlock Text=" · " FontSize="10" Foreground="{DynamicResource Muted}"/>
                                                    <TextBlock Text="{Binding PagesCount, StringFormat='{}{0:N0} صفحة'}" FontSize="10" Foreground="{DynamicResource Muted}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
                                                           FontSize="11" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:dd/MM}'}"
                                                           FontSize="10" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/>
                                                <!-- Status badge -->
                                                <Border CornerRadius="3" Padding="5,1" Margin="0,3,0,0" HorizontalAlignment="Right">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#E7F3EC"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="ملغي">
                                                                    <Setter Property="Background" Value="#F6E4E2"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="خطأ">
                                                                    <Setter Property="Background" Value="#F6E4E2"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Status}" FontSize="9" Foreground="#1B7F4C">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="ملغي">
                                                                        <Setter Property="Foreground" Value="#B42318"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="خطأ">
                                                                        <Setter Property="Foreground" Value="#B42318"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer: Clear button -->
                <Border Grid.Row="2" BorderBrush="#E6F3F6" BorderThickness="0,1,0,0" Padding="16,10">
                    <Button Command="{Binding ClearPrintHistoryCommand}"
                            Content="{DynamicResource NW_002}"
                            HorizontalAlignment="Center"
                            Padding="16,7" Background="#FFFFFF" Foreground="{DynamicResource Muted}"
                            BorderThickness="1" BorderBrush="{DynamicResource Border}" FontSize="12" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#DDD9D3"/>
                                        <Setter Property="Foreground" Value="#B42318"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Border>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════════
             LOW ⑥ — Recent Projects Panel
             ════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="#FAF9F7"
                BorderBrush="#E6F3F6"
                BorderThickness="1,0,0,0"
                Width="300"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Panel.ZIndex="48"
                Visibility="{Binding IsRecentProjectsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="16,14,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                        <TextBlock Text="🕐" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Numbering_RecentProjects}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#14181D" VerticalAlignment="Center"/>
                        <!-- Clear-all sits next to the title rather than at the foot of the
                             list, so it is visible without scrolling a long list first. -->
                        <Button Command="{Binding ClearRecentProjectsCommand}"
                                Content="{DynamicResource Numbering_ClearRecent}"
                                ToolTip="{DynamicResource Numbering_ClearRecent_Tip}"
                                Background="Transparent" Foreground="#B42318"
                                BorderThickness="0" FontSize="11" Cursor="Hand"
                                Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding RecentProjects.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding ToggleRecentProjectsCommand}"
                            Content="✕" Background="Transparent" Foreground="{DynamicResource Muted}"
                            BorderThickness="0" FontSize="16" Cursor="Hand" Padding="4,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#14181D"/></Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
                <Rectangle Grid.Row="0" Height="1" Fill="#E6F3F6" VerticalAlignment="Bottom" Margin="0,44,0,0"/>

                <!-- Projects List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Empty state -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40,0,0"
                                    Visibility="{Binding RecentProjects.Count, Converter={StaticResource CountToHiddenConverter}}">
                            <TextBlock Text="📁" FontSize="32" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Numbering_NoRecentProjects}"
                                       FontSize="13" Foreground="{DynamicResource Muted}"
                                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding RecentProjects}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent" BorderBrush="#FFFFFF" BorderThickness="0,0,0,1"
                                            Padding="16,10" Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.OpenRecentProjectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#FAF9F7"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📄" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#14181D"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="190"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Text>
                                                            <Binding Converter="{StaticResource FileNameOnlyConverter}"/>
                                                        </TextBlock.Text>
                                                        <TextBlock.ToolTip>
                                                            <ToolTip Content="{Binding}"/>
                                                        </TextBlock.ToolTip>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Text="{Binding}" FontSize="10" Foreground="{DynamicResource Muted}"
                                                           TextTrimming="CharacterEllipsis" Margin="21,3,0,0"/>
                                            </StackPanel>
                                            <!-- Always visible, not hover-only: the whole point of this
                                                 button is that an operator could not find a way to remove
                                                 a design, so it must not be hidden behind a hover or a
                                                 right-click. -->
                                            <Button Grid.Column="1"
                                                    Command="{Binding DataContext.RemoveRecentProjectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="✕"
                                                    ToolTip="{DynamicResource Numbering_RemoveRecent_Tip}"
                                                    Background="Transparent" Foreground="{DynamicResource Muted}"
                                                    BorderThickness="0" FontSize="13" Cursor="Hand"
                                                    Padding="8,2" VerticalAlignment="Center">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            CornerRadius="4"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#FDECEA"/>
                                                                <Setter Property="Foreground" Value="#B42318"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

    </Grid>
</UserControl>
