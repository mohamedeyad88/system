<UserControl x:Class="Apex.UI.Views.AnalyticsDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:analytics="clr-namespace:Apex.Services.Analytics;assembly=Apex.Services"
             xmlns:conv="clr-namespace:Apex.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1400"
             FlowDirection="RightToLeft"
             FontFamily="Tahoma"
             Background="#0F172A">

    <UserControl.Resources>

        <!-- ── Value converters ────────────────────────────────────────── -->
        <conv:RevenueToBarHeightConverter x:Key="BarHeight"/>
        <conv:DateToBarColorConverter     x:Key="BarColor"/>

        <!-- ── Base card style ────────────────────────────────────────── -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background"     Value="#1E293B"/>
            <Setter Property="CornerRadius"   Value="12"/>
            <Setter Property="Padding"        Value="20,16"/>
            <Setter Property="Margin"         Value="6"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="12" ShadowDepth="4"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Section header ─────────────────────────────────────────── -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize"       Value="14"/>
            <Setter Property="FontWeight"     Value="SemiBold"/>
            <Setter Property="Foreground"     Value="#F1F5F9"/>
            <Setter Property="Margin"         Value="0,0,0,12"/>
        </Style>

        <!-- ── Large stat value ───────────────────────────────────────── -->
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize"       Value="24"/>
            <Setter Property="FontWeight"     Value="Bold"/>
            <Setter Property="Foreground"     Value="#F1F5F9"/>
        </Style>

        <!-- ── Secondary / caption text ──────────────────────────────── -->
        <Style x:Key="SubText" TargetType="TextBlock">
            <Setter Property="FontSize"       Value="12"/>
            <Setter Property="Foreground"     Value="#94A3B8"/>
            <Setter Property="Margin"         Value="0,4,0,0"/>
        </Style>

        <!-- ── Action button ──────────────────────────────────────────── -->
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Background"     Value="#334155"/>
            <Setter Property="Foreground"     Value="#F1F5F9"/>
            <Setter Property="BorderBrush"    Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"        Value="14,8"/>
            <Setter Property="FontFamily"     Value="Tahoma"/>
            <Setter Property="FontSize"       Value="13"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#475569"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1E293B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- Row 0: Header -->
                <RowDefinition Height="Auto"/>   <!-- Row 1: Stat cards -->
                <RowDefinition Height="Auto"/>   <!-- Row 2: Charts + printer list -->
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════════════════
                 ROW 0  —  Header bar
                 ═══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0"
                    Background="#1E293B"
                    CornerRadius="12"
                    Padding="20,14"
                    Margin="0,0,0,16">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="10" ShadowDepth="3"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title + refresh timestamp -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="لوحة التحليلات"
                                   FontSize="22" FontWeight="Bold" Foreground="#F1F5F9"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="آخر تحديث: "   FontSize="12" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding LastRefreshTime}" FontSize="12" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Action buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button Style="{StaticResource HeaderButton}"
                                Margin="0,0,8,0"
                                Command="{Binding RefreshCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F504;" Margin="0,0,6,0"/>
                                <TextBlock Text="تحديث"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource HeaderButton}"
                                Command="{Binding ExportCsvReportCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F4E5;" Margin="0,0,6,0"/>
                                <TextBlock Text="تصدير CSV"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════
                 ROW 1  —  Four KPI cards
                 ═══════════════════════════════════════════════════════════ -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">

                <!-- Card 1: إيراد اليوم -->
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="&#x1F4B0;" FontSize="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="إيراد اليوم" Style="{StaticResource SectionHeader}" Margin="0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TodayRevenueText}"
                                   Style="{StaticResource StatValue}" Foreground="#22C55E"/>
                        <TextBlock Style="{StaticResource SubText}">
                            <Run Text="هامش الربح: "/><Run Text="{Binding MarginText}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding WeekChangeText}"
                                   Style="{StaticResource SubText}" Margin="0,6,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- Card 2: ربح اليوم -->
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="&#x1F4C8;" FontSize="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="ربح اليوم" Style="{StaticResource SectionHeader}" Margin="0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ProfitText}"
                                   Style="{StaticResource StatValue}" Foreground="#3B82F6"/>
                        <TextBlock Style="{StaticResource SubText}">
                            <Run Text="نسبة الربح: "/><Run Text="{Binding MarginText}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding EstimatedMonthText}"
                                   Style="{StaticResource SubText}" Margin="0,6,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- Card 3: وظائف اليوم -->
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="&#x1F5A8;" FontSize="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="وظائف اليوم" Style="{StaticResource SectionHeader}" Margin="0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TodayTotalJobs}"
                                   Style="{StaticResource StatValue}" Foreground="#A855F7"/>
                        <TextBlock Style="{StaticResource SubText}">
                            <Run Text="معدل النجاح: "/><Run Text="{Binding SuccessRateText}"/>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Foreground="#22C55E" FontSize="11">
                                <Run Text="&#x2713; "/><Run Text="{Binding TodaySuccessJobs}"/>
                            </TextBlock>
                            <TextBlock Text=" / " Foreground="#94A3B8" FontSize="11"/>
                            <TextBlock Foreground="#EF4444" FontSize="11">
                                <Run Text="&#x2717; "/><Run Text="{Binding TodayFailedJobs}"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Card 4: صفحات اليوم -->
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="&#x1F4C4;" FontSize="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="صفحات اليوم" Style="{StaticResource SectionHeader}" Margin="0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TodayTotalPages}"
                                   Style="{StaticResource StatValue}" Foreground="#F97316"/>
                        <TextBlock Style="{StaticResource SubText}">
                            <Run Text="إيراد/صفحة: "/><Run Text="{Binding RevenuePerPageText}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource SubText}" Margin="0,6,0,0">
                            <Run Text="التكلفة: "/>
                            <Run Text="{Binding TodayCost, StringFormat='{}{0:F2} ج.م'}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- ═══════════════════════════════════════════════════════════
                 ROW 2  —  Bar chart (left 60%) + Printer list (right 40%)
                 ═══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>   <!-- 60% -->
                    <ColumnDefinition Width="12"/>   <!-- gutter -->
                    <ColumnDefinition Width="2*"/>   <!-- 40% -->
                </Grid.ColumnDefinitions>

                <!-- ── Left: آخر 7 أيام ──────────────────────────────── -->
                <Border Grid.Column="0" Style="{StaticResource StatCard}" Padding="20,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="160"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Section title -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="&#x1F4CA;" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="آخر 7 أيام" Style="{StaticResource SectionHeader}" Margin="0"/>
                        </StackPanel>

                        <!-- Bar chart -->
                        <Border Grid.Row="1" Background="#0F172A" CornerRadius="8" Padding="8,8,8,0">
                            <ItemsControl ItemsSource="{Binding Last7Days}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <!-- LeftToRight so first (oldest) item is on the left visually -->
                                        <UniformGrid Rows="1" FlowDirection="LeftToRight"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type analytics:DailyCostSummary}">
                                        <Grid Margin="3,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>       <!-- spacer above bar -->
                                                <RowDefinition Height="Auto"/>    <!-- revenue label -->
                                                <RowDefinition Height="Auto"/>    <!-- bar -->
                                                <RowDefinition Height="Auto"/>    <!-- date label -->
                                                <RowDefinition Height="Auto"/>    <!-- job count -->
                                            </Grid.RowDefinitions>

                                            <!-- Revenue amount above bar -->
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding TotalRevenue, StringFormat='{}{0:F0}'}"
                                                       FontSize="9" Foreground="#94A3B8"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,0,0,3"/>

                                            <!-- Bar (height driven by converter, color by date) -->
                                            <Border Grid.Row="2"
                                                    Width="34"
                                                    Height="{Binding TotalRevenue,
                                                             Converter={StaticResource BarHeight},
                                                             ConverterParameter=500}"
                                                    Background="{Binding Date,
                                                                 Converter={StaticResource BarColor}}"
                                                    CornerRadius="3,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Bottom"/>

                                            <!-- Date label -->
                                            <TextBlock Grid.Row="3"
                                                       Text="{Binding Date, StringFormat='dd/MM'}"
                                                       FontSize="10" Foreground="#64748B"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,4,0,0"/>

                                            <!-- Job count -->
                                            <TextBlock Grid.Row="4"
                                                       FontSize="9" Foreground="#475569"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,2,0,4">
                                                <Run Text="{Binding TotalJobs}"/><Run Text=" وظ"/>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- Summary footer row -->
                        <Border Grid.Row="2"
                                Background="#0F172A"
                                CornerRadius="8"
                                Padding="12,10"
                                Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="إيراد الأسبوع" Style="{StaticResource SubText}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding WeekRevenue, StringFormat='{}{0:F2} ج.م'}"
                                               FontSize="14" FontWeight="SemiBold" Foreground="#22C55E"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="ربح الأسبوع" Style="{StaticResource SubText}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding WeekProfit, StringFormat='{}{0:F2} ج.م'}"
                                               FontSize="14" FontWeight="SemiBold" Foreground="#3B82F6"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="التغيير الأسبوعي" Style="{StaticResource SubText}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding WeekChangeText}"
                                               FontSize="12" FontWeight="SemiBold" Foreground="#F59E0B"
                                               HorizontalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ── Right: أداء الطابعات ──────────────────────────── -->
                <Border Grid.Column="2" Style="{StaticResource StatCard}" Padding="20,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Section title -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="&#x1F5A8;" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="أداء الطابعات" Style="{StaticResource SectionHeader}" Margin="0"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding PrinterMetrics}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type analytics:PrinterEfficiencyMetrics}">
                                        <Border Background="#0F172A"
                                                CornerRadius="8"
                                                Padding="12,10"
                                                Margin="0,0,0,8">
                                            <StackPanel>

                                                <!-- Top row: name + grade badge -->
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding PrinterName}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="#F1F5F9"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>
                                                    <!-- Grade badge with DataTriggers -->
                                                    <Border Grid.Column="1"
                                                            CornerRadius="6" Padding="8,3"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#334155"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EfficiencyGrade}" Value="A">
                                                                        <Setter Property="Background" Value="#22C55E"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding EfficiencyGrade}" Value="B">
                                                                        <Setter Property="Background" Value="#3B82F6"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding EfficiencyGrade}" Value="C">
                                                                        <Setter Property="Background" Value="#F59E0B"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding EfficiencyGrade}" Value="D">
                                                                        <Setter Property="Background" Value="#EF4444"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding EfficiencyGrade}" Value="F">
                                                                        <Setter Property="Background" Value="#7F1D1D"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding EfficiencyGrade}"
                                                                   FontSize="13" FontWeight="Bold"
                                                                   Foreground="White"/>
                                                    </Border>
                                                </Grid>

                                                <!-- Health score ProgressBar -->
                                                <ProgressBar Value="{Binding HealthScore}"
                                                             Maximum="100" Minimum="0"
                                                             Height="6"
                                                             BorderThickness="0"
                                                             Background="#334155"
                                                             FlowDirection="LeftToRight"
                                                             Margin="0,0,0,6">
                                                    <ProgressBar.Style>
                                                        <Style TargetType="ProgressBar">
                                                            <Setter Property="Foreground" Value="#22C55E"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EfficiencyGrade}" Value="B">
                                                                    <Setter Property="Foreground" Value="#3B82F6"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding EfficiencyGrade}" Value="C">
                                                                    <Setter Property="Foreground" Value="#F59E0B"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding EfficiencyGrade}" Value="D">
                                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding EfficiencyGrade}" Value="F">
                                                                    <Setter Property="Foreground" Value="#7F1D1D"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ProgressBar.Style>
                                                </ProgressBar>

                                                <!-- Stats: jobs / revenue / health -->
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Foreground="#94A3B8" FontSize="11">
                                                        <Run Text="{Binding TotalJobsToday}"/>
                                                        <Run Text=" وظيفة"/>
                                                    </TextBlock>
                                                    <TextBlock Text=" · " Foreground="#475569" FontSize="11"/>
                                                    <TextBlock Foreground="#94A3B8" FontSize="11">
                                                        <Run Text="{Binding TotalRevenueToday, StringFormat='{}{0:F2}'}"/>
                                                        <Run Text=" ج.م"/>
                                                    </TextBlock>
                                                    <TextBlock Text=" · " Foreground="#475569" FontSize="11"/>
                                                    <TextBlock Foreground="#94A3B8" FontSize="11">
                                                        <Run Text="{Binding HealthScore}"/>
                                                        <Run Text=" نقطة"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <!-- Arabic status line -->
                                                <TextBlock Text="{Binding StatusArabic}"
                                                           FontSize="11" Foreground="#64748B"
                                                           Margin="0,4,0,0"
                                                           TextTrimming="CharacterEllipsis"/>

                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
