<Window x:Class="Apex.UI.Views.ActivationView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Apex.UI.Services"
        Title="تفعيل أبكس لحلول الطباعة المتكاملة"
        Width="600" Height="820"
        MinHeight="700" MaxHeight="920"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0F172A"
        FlowDirection="{Binding Source={x:Static svc:LocalizationService.Instance},
                                Path=FlowDirection, Mode=OneWay}">

    <Window.Resources>
        <!-- Converters (ensure available even when App.xaml resources haven't propagated) -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Card style -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- Primary action button -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- WhatsApp green button -->
        <Style x:Key="BtnWhatsApp" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#25D366"/>
        </Style>

        <!-- Ghost / secondary button -->
        <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Logo + title -->
            <RowDefinition Height="Auto"/>  <!-- Status card -->
            <RowDefinition Height="Auto"/>  <!-- Device ID card -->
            <RowDefinition Height="Auto"/>  <!-- Actions card -->
            <RowDefinition Height="Auto"/>  <!-- Install license card -->
            <RowDefinition Height="*"/>     <!-- spacer -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════
             Header
             ══════════════════════════════════════════ -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,28">
            <Border Background="#1E3A8A" Width="80" Height="80" CornerRadius="20"
                    HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock Text="🖨️" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="أبكس لحلول الطباعة المتكاملة"
                       FontSize="22" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Apex Printing Solutions"
                       FontSize="13" Foreground="#64748B"
                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ══════════════════════════════════════════
             Status card
             ══════════════════════════════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="18" FontWeight="SemiBold" Foreground="White"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding StatusDetail}"
                           FontSize="13" Foreground="#94A3B8"
                           HorizontalAlignment="Center" Margin="0,8,0,0"
                           Visibility="{Binding StatusDetail, Converter={StaticResource StringToVisibilityConverter}}"/>

                <!-- Trial countdown -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="0,12,0,0"
                            Visibility="{Binding ShowTrialInfo, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="الأيام المتبقية في التجربة: " FontSize="14" Foreground="#94A3B8"/>
                    <TextBlock Text="{Binding TrialDaysRemaining}" FontSize="20" FontWeight="Bold" Foreground="#F59E0B"/>
                    <TextBlock Text=" يوم" FontSize="14" Foreground="#94A3B8" Margin="4,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════
             Device ID card
             ══════════════════════════════════════════ -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="💻" FontSize="16" Margin="0,0,10,0"/>
                    <TextBlock Text="رقم تعريف الجهاز" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                </StackPanel>

                <TextBlock Text="يحتاج الموظف للتفعيل إلى رقم الجهاز هذا. انسخه وأرسله لطلب الترخيص."
                           FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <!-- Device ID display -->
                <Border Background="#0F172A" CornerRadius="10" Padding="16,12"
                        BorderBrush="#334155" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DeviceDisplayId}"
                                   FontFamily="Consolas, Courier New" FontSize="16"
                                   FontWeight="Bold" Foreground="#60A5FA"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Command="{Binding CopyDeviceIdCommand}"
                                Style="{StaticResource BtnSecondary}"
                                Padding="14,8" Margin="12,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" Margin="0,0,6,0"/>
                                <TextBlock Text="نسخ"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════
             Actions card – WhatsApp + file install
             ══════════════════════════════════════════ -->
        <Border Grid.Row="3" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="🔑 خيارات التفعيل"
                           FontSize="14" FontWeight="SemiBold" Foreground="White"
                           Margin="0,0,0,16"/>

                <!-- WhatsApp button -->
                <Button Command="{Binding OpenWhatsAppCommand}"
                        Style="{StaticResource BtnWhatsApp}"
                        Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💬" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="تواصل عبر واتساب للتفعيل" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="سيتم فتح محادثة مع الدعم الفني تلقائياً" FontSize="11" Opacity="0.85"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- Separator -->
                <Grid Margin="0,4,0,12">
                    <Rectangle Height="1" Fill="#334155" VerticalAlignment="Center"/>
                    <Border Background="#1E293B" HorizontalAlignment="Center" Padding="12,0">
                        <TextBlock Text="أو" FontSize="12" Foreground="#64748B"/>
                    </Border>
                </Grid>

                <!-- Browse license file -->
                <Button Command="{Binding BrowseLicenseFileCommand}"
                        Style="{StaticResource BtnPrimary}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📁" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="تثبيت ملف الترخيص (.apex)" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="اختر ملف الترخيص الذي أرسله الدعم الفني" FontSize="11" Opacity="0.85"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════
             Footer note
             ══════════════════════════════════════════ -->
        <TextBlock Grid.Row="5"
                   Text="Apex Printing Solutions © 2025 | الدعم الفني: 01099088053"
                   FontSize="11" Foreground="#475569"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
    </Grid>
    </ScrollViewer>
</Window>
