<Window x:Class="Apex.UI.Views.ActivationView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Apex.UI.Services"
        Title="تفعيل أبكس لحلول الطباعة المتكاملة"
        Width="600" Height="820"
        MinHeight="700" MaxHeight="920"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource Paper}"
        FlowDirection="{Binding Source={x:Static svc:LocalizationService.Instance},
                                Path=FlowDirection, Mode=OneWay}">

    <Window.Resources>
        <!-- Converters (ensure available even when App.xaml resources haven't propagated) -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Card style -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Panel}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- Primary action button -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Action}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAction}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Action}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- WhatsApp green button -->
        <Style x:Key="BtnWhatsApp" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#25D366"/>
        </Style>

        <!-- Ghost / secondary button -->
        <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="{DynamicResource Hover}"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Logo + title -->
            <RowDefinition Height="Auto"/>  <!-- Status card -->
            <RowDefinition Height="Auto"/>  <!-- Device ID card -->
            <RowDefinition Height="Auto"/>  <!-- Actions card -->
            <RowDefinition Height="Auto"/>  <!-- Install license card -->
            <RowDefinition Height="*"/>     <!-- spacer -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════
             Header
             ══════════════════════════════════════════ -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,28">
            <Border Background="{DynamicResource BrandSoft}" Width="80" Height="80" CornerRadius="20"
                    HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock Text="🖨️" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="أبكس لحلول الطباعة المتكاملة"
                       FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Ink}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Apex Printing Solutions"
                       FontSize="13" Foreground="{DynamicResource Muted}"
                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ══════════════════════════════════════════
             Status card
             ══════════════════════════════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding StatusDetail}"
                           FontSize="13" Foreground="{DynamicResource Muted}"
                           HorizontalAlignment="Center" Margin="0,8,0,0"
                           Visibility="{Binding StatusDetail, Converter={StaticResource StringToVisibilityConverter}}"/>

                <!-- Trial countdown -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="0,12,0,0"
                            Visibility="{Binding ShowTrialInfo, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="الأيام المتبقية في التجربة: " FontSize="14" Foreground="{DynamicResource Muted}"/>
                    <TextBlock Text="{Binding TrialDaysRemaining}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Printing}"/>
                    <TextBlock Text=" يوم" FontSize="14" Foreground="{DynamicResource Muted}" Margin="4,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════
             Device ID card
             ══════════════════════════════════════════ -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="💻" FontSize="16" Margin="0,0,10,0"/>
                    <TextBlock Text="رقم تعريف الجهاز" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                </StackPanel>

                <TextBlock Text="يحتاج الموظف للتفعيل إلى رقم الجهاز هذا. انسخه وأرسله لطلب الترخيص."
                           FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <!-- Device ID display -->
                <Border Background="{DynamicResource Paper}" CornerRadius="10" Padding="16,12"
                        BorderBrush="{DynamicResource Border}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- European digits, always — see the note in LicensingView.
                             The customer reads this id off the screen and sends it to us. -->
                        <TextBlock Text="{Binding DeviceDisplayId}"
                                   NumberSubstitution.Substitution="European"
                                   FontFamily="Consolas, Courier New" FontSize="16"
                                   FontWeight="Bold" Foreground="{DynamicResource Action}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Command="{Binding CopyDeviceIdCommand}"
                                Style="{StaticResource BtnSecondary}"
                                Padding="14,8" Margin="12,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" Margin="0,0,6,0"/>
                                <TextBlock Text="نسخ"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════
             Actions card – WhatsApp + file install
             ══════════════════════════════════════════ -->
        <Border Grid.Row="3" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="🔑 خيارات التفعيل"
                           FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"
                           Margin="0,0,0,16"/>

                <!-- Online activation (serial code) — the primary path -->
                <TextBlock Text="فعّل بكود السيريال (أونلاين)"
                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"
                           Margin="0,0,0,8"/>
                <TextBox Text="{Binding SerialKey, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsNotActivating}"
                         FontFamily="Consolas, Courier New" FontSize="15"
                         Padding="12,10" Margin="0,0,0,10"
                         Background="{DynamicResource Paper}" Foreground="{DynamicResource Ink}"
                         BorderBrush="{DynamicResource Border}" BorderThickness="1"
                         FlowDirection="LeftToRight"
                         VerticalContentAlignment="Center"/>

                <CheckBox IsChecked="{Binding IsEulaAccepted}"
                          Foreground="{DynamicResource Muted}" Margin="0,0,0,12" VerticalContentAlignment="Center">
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12">
                        <Run Text="أوافق على "/><Hyperlink Command="{Binding ShowEulaCommand}"
                            Foreground="{DynamicResource Action}"><Run Text="اتفاقية الترخيص"/></Hyperlink>
                    </TextBlock>
                </CheckBox>

                <Button Command="{Binding ActivateOnlineCommand}"
                        IsEnabled="{Binding CanActivate}"
                        Style="{StaticResource BtnPrimary}" Margin="0,0,0,8">
                    <TextBlock Text="تفعيل أونلاين" FontWeight="SemiBold" FontSize="14"/>
                </Button>

                <TextBlock Text="{Binding OnlineStatus}"
                           Foreground="{Binding OnlineStatusColor}"
                           FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"
                           Visibility="{Binding OnlineStatus, Converter={StaticResource StringToVisibilityConverter}}"/>

                <!-- Separator -->
                <Grid Margin="0,8,0,12">
                    <Rectangle Height="1" Fill="{DynamicResource Hover}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource Panel}" HorizontalAlignment="Center" Padding="12,0">
                        <TextBlock Text="أو" FontSize="12" Foreground="{DynamicResource Muted}"/>
                    </Border>
                </Grid>

                <!-- WhatsApp button -->
                <Button Command="{Binding OpenWhatsAppCommand}"
                        Style="{StaticResource BtnWhatsApp}"
                        Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💬" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="تواصل عبر واتساب للتفعيل" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="سيتم فتح محادثة مع الدعم الفني تلقائياً" FontSize="11" Opacity="0.85"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- Separator -->
                <Grid Margin="0,4,0,12">
                    <Rectangle Height="1" Fill="{DynamicResource Hover}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource Panel}" HorizontalAlignment="Center" Padding="12,0">
                        <TextBlock Text="أو" FontSize="12" Foreground="{DynamicResource Muted}"/>
                    </Border>
                </Grid>

                <!-- Browse license file -->
                <Button Command="{Binding BrowseLicenseFileCommand}"
                        Style="{StaticResource BtnPrimary}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📁" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="تثبيت ملف الترخيص (.apex)" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="اختر ملف الترخيص الذي أرسله الدعم الفني" FontSize="11" Opacity="0.85"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════
             Footer note
             ══════════════════════════════════════════ -->
        <TextBlock Grid.Row="5"
                   Text="Apex Printing Solutions © 2025 | الدعم الفني: 01099088053"
                   FontSize="11" Foreground="{DynamicResource Muted}"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
    </Grid>
    </ScrollViewer>
</Window>
