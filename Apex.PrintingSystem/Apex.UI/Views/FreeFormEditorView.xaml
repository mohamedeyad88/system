<UserControl x:Class="Apex.UI.Views.FreeFormEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1000"
             Background="#F8FAFC">
    
    <UserControl.Resources>
        <!-- Modern Card -->
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.08" Color="#000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Button -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#475569"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#EF4444"/>
        </Style>

        <!-- Field Label -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </UserControl.Resources>
    
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Style="{StaticResource ModernCard}" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Actions -->
                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <TextBlock Text="🎨 Template Editor" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,16"/>
                    <Button Command="{Binding LoadTemplateCommand}" Content="📂 Load Template" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"/>
                    <Button Command="{Binding AddSlotCommand}" Content="➕ Add Number Slot" Style="{StaticResource ModernButton}"/>
                </StackPanel>

                <!-- Selected Slot Properties -->
                <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="10" Padding="16" IsEnabled="{Binding SelectedSlot, Converter={StaticResource NullToBoolConverter}}">
                    <StackPanel>
                        <TextBlock Text="📍 Selected Slot" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,16"/>
                        
                        <!-- Position -->
                        <TextBlock Text="{DynamicResource FreeForm_Position}" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="X" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedSlot.X}" Style="{StaticResource ModernTextBox}" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Y" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedSlot.Y}" Style="{StaticResource ModernTextBox}" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        
                        <!-- Size -->
                        <TextBlock Text="{DynamicResource FreeForm_Size}" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource FreeForm_Width}" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedSlot.Width}" Style="{StaticResource ModernTextBox}" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource FreeForm_Height}" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedSlot.Height}" Style="{StaticResource ModernTextBox}" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        
                        <!-- Typography -->
                        <TextBlock Text="Typography" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Font" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedSlot.FontFamily}" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Size" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedSlot.FontSize}" Style="{StaticResource ModernTextBox}" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        
                        <Button Command="{Binding RemoveSlotCommand}" CommandParameter="{Binding SelectedSlot}" 
                                Content="🗑️ Remove Slot" Style="{StaticResource DangerButton}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Slots List -->
                <Border Grid.Row="2" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="📋 All Slots" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,8"/>
                        <ListBox ItemsSource="{Binding Slots}" 
                                 SelectedItem="{Binding SelectedSlot}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="#F1F5F9" CornerRadius="6" 
                                                        Padding="10,8" Margin="0,0,0,4" Cursor="Hand">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#DBEAFE"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/>
                                                        <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Id}" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                        <TextBlock Grid.Column="1" FontSize="11" Foreground="#94A3B8">
                                            <Run Text="{Binding FontSize}"/>
                                            <Run Text="pt"/>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        
                        <!-- Empty State -->
                        <TextBlock Text="No slots added yet. Click 'Add Number Slot' to create one." 
                                   FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"
                                   Visibility="{Binding Slots.Count, Converter={StaticResource InverseCountToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Canvas Area -->
        <Border Grid.Column="2" Style="{StaticResource ModernCard}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📐 Canvas" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                        <Border Background="#E0F2FE" CornerRadius="6" Padding="8,4" Margin="16,0,0,0">
                            <TextBlock FontSize="12" Foreground="#0369A1">
                                <Run Text="{Binding CanvasWidth, StringFormat='{}{0:F0}'}"/>
                                <Run Text="×"/>
                                <Run Text="{Binding CanvasHeight, StringFormat='{}{0:F0}'}"/>
                                <Run Text="px"/>
                            </TextBlock>
                        </Border>
                        <Border Background="#F0FDF4" CornerRadius="6" Padding="8,4" Margin="8,0,0,0">
                            <TextBlock Text="{Binding Slots.Count, StringFormat='{}{0} slots'}" FontSize="12" Foreground="#166534"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Canvas -->
                <Border Grid.Row="1" Background="#E2E8F0" CornerRadius="8" Padding="16">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" Background="White" ClipToBounds="True">
                            <Canvas.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.15" Color="#000"/>
                            </Canvas.Effect>
                            
                            <!-- Template Image -->
                            <Image Source="{Binding TemplatePath}" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" Stretch="Fill"/>
                            
                            <!-- Slots Overlay -->
                            <ItemsControl ItemsSource="{Binding Slots}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Width="{Binding DataContext.CanvasWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                Height="{Binding DataContext.CanvasHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left">
                                            <Setter.Value>
                                                <MultiBinding Converter="{StaticResource NormalizedToPixelConverter}">
                                                    <Binding Path="X"/>
                                                    <Binding Path="DataContext.CanvasWidth" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Canvas.Top">
                                            <Setter.Value>
                                                <MultiBinding Converter="{StaticResource NormalizedToPixelConverter}">
                                                    <Binding Path="Y"/>
                                                    <Binding Path="DataContext.CanvasHeight" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="2" CornerRadius="4" Cursor="Hand">
                                            <Border.BorderBrush>
                                                <SolidColorBrush Color="#3B82F6"/>
                                            </Border.BorderBrush>
                                            <Border.Background>
                                                <SolidColorBrush Color="#3B82F6" Opacity="0.15"/>
                                            </Border.Background>
                                            <Border.Width>
                                                <MultiBinding Converter="{StaticResource NormalizedToPixelConverter}">
                                                    <Binding Path="Width"/>
                                                    <Binding Path="DataContext.CanvasWidth" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </Border.Width>
                                            <Border.Height>
                                                <MultiBinding Converter="{StaticResource NormalizedToPixelConverter}">
                                                    <Binding Path="Height"/>
                                                    <Binding Path="DataContext.CanvasHeight" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </Border.Height>
                                            <TextBlock Text="12345" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                       Foreground="#1D4ED8" FontWeight="SemiBold" FontSize="14"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </Viewbox>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
