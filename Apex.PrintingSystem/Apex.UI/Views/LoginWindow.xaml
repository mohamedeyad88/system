<Window x:Class="Apex.UI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" Height="560"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="Transparent">

    <Border Background="#0F172A" CornerRadius="16"
            BorderBrush="#1E293B" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.55"
                              BlurRadius="32" ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <!-- ✕ close -->
            <Button x:Name="CloseBtn" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Margin="0,14,14,0"
                    Width="28" Height="28" Cursor="Hand"
                    Click="CloseBtn_Click" Background="Transparent" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="14" Background="Transparent">
                            <TextBlock Text="✕" Foreground="#6B7280" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Main content — RTL for labels, LTR overridden on inputs -->
            <StackPanel FlowDirection="RightToLeft"
                        VerticalAlignment="Center" Margin="36,48,36,36">

                <!-- Brand -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,28">
                    <Border Width="68" Height="68" CornerRadius="18"
                            HorizontalAlignment="Center" Margin="0,0,0,14">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3B82F6" Offset="0"/>
                                <GradientStop Color="#1D4ED8" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="🖨️" FontSize="34" FlowDirection="LeftToRight"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="أبكس للطباعة" Foreground="White"
                               FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="نظام إدارة الطباعة" Foreground="#64748B"
                               FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Card -->
                <Border Background="#1E293B" CornerRadius="14" Padding="22,20">
                    <StackPanel>

                        <TextBlock Text="تسجيل الدخول" Foreground="White"
                                   FontSize="15" FontWeight="SemiBold"
                                   Margin="0,0,0,18"/>

                        <!-- ── Username ── -->
                        <TextBlock Text="اسم المستخدم" Foreground="#94A3B8"
                                   FontSize="11" Margin="0,0,0,5"/>
                        <!-- FlowDirection LTR so Latin text renders normally -->
                        <Border Background="#0F172A" CornerRadius="8"
                                BorderBrush="#334155" BorderThickness="1"
                                Height="42" Margin="0,0,0,12"
                                x:Name="UsernameBorder">
                            <TextBox x:Name="UsernameBox"
                                     Background="Transparent" Foreground="White"
                                     BorderThickness="0" Padding="10,0"
                                     FontSize="13" VerticalAlignment="Center"
                                     FlowDirection="LeftToRight"
                                     CaretBrush="White"
                                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                     GotFocus="UsernameBox_GotFocus"
                                     LostFocus="UsernameBox_LostFocus"/>
                        </Border>

                        <!-- ── Password ── -->
                        <TextBlock Text="كلمة المرور" Foreground="#94A3B8"
                                   FontSize="11" Margin="0,0,0,5"/>
                        <Border Background="#0F172A" CornerRadius="8"
                                BorderBrush="#334155" BorderThickness="1"
                                Height="42" Margin="0,0,0,14"
                                x:Name="PasswordBorder">
                            <PasswordBox x:Name="PasswordBox"
                                         Background="Transparent" Foreground="White"
                                         BorderThickness="0" Padding="10,0"
                                         FontSize="13" VerticalAlignment="Center"
                                         FlowDirection="LeftToRight"
                                         CaretBrush="White"
                                         GotFocus="PasswordBox_GotFocus"
                                         LostFocus="PasswordBox_LostFocus"/>
                        </Border>

                        <!-- ── Error message ── -->
                        <Border x:Name="ErrorBorder"
                                Background="#450A0A" CornerRadius="7"
                                BorderBrush="#7F1D1D" BorderThickness="1"
                                Padding="10,8" Margin="0,0,0,12"
                                Visibility="Collapsed">
                            <TextBlock x:Name="ErrorText"
                                       Foreground="#FCA5A5" FontSize="12"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <!-- ── Login button ── -->
                        <Button x:Name="LoginBtn"
                                Command="{Binding LoginCommand}"
                                Height="44" Margin="0,0,0,10"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" CornerRadius="9" Height="44">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#3B82F6" Offset="0"/>
                                                <GradientStop Color="#1D4ED8" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <TextBlock x:Name="btnText" Text="تسجيل الدخول"
                                                   Foreground="White" FontSize="14"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Opacity" Value="0.88"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="b" Property="Opacity" Value="0.5"/>
                                            <Setter TargetName="btnText" Property="Text" Value="جارٍ التحقق..."/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Divider -->
                        <Grid Margin="0,2,0,10">
                            <Border Height="1" Background="#2D3748"/>
                            <TextBlock Text="أو" Foreground="#475569" FontSize="11"
                                       HorizontalAlignment="Center" Background="#1E293B"
                                       Padding="8,0"/>
                        </Grid>

                        <!-- ── Guest button ── -->
                        <Button Command="{Binding LoginAsGuestCommand}"
                                Height="38" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" CornerRadius="9" Height="38"
                                            Background="Transparent"
                                            BorderBrush="#334155" BorderThickness="1">
                                        <TextBlock Text="الدخول كضيف"
                                                   Foreground="#94A3B8" FontSize="13"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#0F172A"/>
                                            <Setter TargetName="b" Property="BorderBrush" Value="#4B5563"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                    </StackPanel>
                </Border>

                <!-- Hint -->
                <TextBlock Text="admin / admin123" Foreground="#374151"
                           FontSize="10" FlowDirection="LeftToRight"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
