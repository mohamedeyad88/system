<Window x:Class="Apex.UI.Views.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:Apex.UI.ViewModels"
        xmlns:svc="clr-namespace:Apex.UI.Services"
        mc:Ignorable="d"
        Title="{DynamicResource Log_Title}" Height="600" Width="900" WindowStartupLocation="CenterScreen"
        FlowDirection="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=FlowDirection, Mode=OneWay}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="{DynamicResource Log_Refresh}" Command="{Binding RefreshCommand}" Padding="10,5" Margin="0,0,10,0"/>
            <Button Content="{DynamicResource Log_OpenFolder}" Command="{Binding OpenLogFolderCommand}" Padding="10,5"/>
            <CheckBox Content="{DynamicResource Log_AutoRefresh}" IsChecked="{Binding AutoRefresh}" Margin="20,0,0,0" VerticalAlignment="Center"/>
            
            <TextBlock Text="{DynamicResource Log_Filter}" VerticalAlignment="Center" Margin="20,0,5,0"/>
            <ComboBox ItemsSource="{Binding LogLevels}" 
                      SelectedValue="{Binding SelectedLogLevel}" Width="100" VerticalContentAlignment="Center"/>
            
            <TextBlock Text="{DynamicResource Log_Search}" VerticalAlignment="Center" Margin="20,0,5,0"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="200" VerticalContentAlignment="Center" Padding="5"/>
        </StackPanel>

        <!-- The log itself is always LTR: Serilog writes English timestamps, levels
             and stack traces, which read wrong if the window's RTL flow reaches them. -->
        <TextBox Grid.Row="1" Text="{Binding LogContent}" IsReadOnly="True"
                 FlowDirection="LeftToRight"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12"/>
    </Grid>
</Window>
