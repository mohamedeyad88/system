<UserControl x:Class="Apex.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:Apex.UI.Properties"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900"
             Background="#FAF9F7">
    
    <UserControl.Resources>
        <!-- Dark Card -->
        <Style x:Key="DarkCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="#8F887A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <!-- Dark TextBox -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Background" Value="#FAF9F7"/>
            <Setter Property="BorderBrush" Value="#8F887A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <!-- Typed text and caret were WHITE on an off-white box, so every value an operator
                 entered — company name, phone, backup path — was invisible, and the fields
                 looked empty even when they were filled. -->
            <Setter Property="Foreground" Value="#14181D"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="#14181D"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0891B2"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Button -->
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#0E7490"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0B5C72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Secondary Button -->
        <Style x:Key="DarkSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#EDEAE5"/>
            <Setter Property="Foreground" Value="#57534E"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#6B6864"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section Title -->
        <Style x:Key="DarkSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#14181D"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <!-- Field Label -->
        <Style x:Key="DarkFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#6B6864"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>
    
    <Grid Margin="40,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,32">
            <!-- Was Foreground="White" on the off-white page (1.05:1): the screen title was invisible,
                 a leftover from when this app was dark. -->
            <TextBlock FontSize="32" FontWeight="Bold" Foreground="#14181D">
                <Run Text="⚙️ "/><Run Text="{DynamicResource Settings_Title}"/>
            </TextBlock>
            <TextBlock Text="{DynamicResource Settings_Description}" FontSize="14" Foreground="#6B6864" Margin="0,8,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="900" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Company Info Card (full width) -->
                <Border Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource DarkCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.ColumnSpan="3" Margin="0,0,0,20">
                            <TextBlock Text="🏢" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource Settings_CompanyInfo}" Style="{StaticResource DarkSectionTitle}" Margin="0"/>
                        </StackPanel>
                        <!-- Left column -->
                        <StackPanel Grid.Column="0" Margin="0,40,0,0">
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="{DynamicResource Settings_CompanyName}" Style="{StaticResource DarkFieldLabel}"/>
                                <TextBox Text="{Binding CompanyName}" Style="{StaticResource DarkTextBox}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="{DynamicResource Settings_Address}" Style="{StaticResource DarkFieldLabel}"/>
                                <TextBox Text="{Binding CompanyAddress}" Style="{StaticResource DarkTextBox}"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- Right column -->
                        <StackPanel Grid.Column="2" Margin="0,40,0,0">
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="{DynamicResource Settings_Phone}" Style="{StaticResource DarkFieldLabel}"/>
                                <TextBox Text="{Binding CompanyPhone}" Style="{StaticResource DarkTextBox}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Settings_Logo}" Style="{StaticResource DarkFieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding LogoPath}" Style="{StaticResource DarkTextBox}" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Content="📂" Command="{Binding BrowseLogoCommand}"
                                            Style="{StaticResource DarkSecondaryButton}" Width="48"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- System Settings Card -->
                <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource DarkCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Language -->
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <TextBlock Text="🌐" FontSize="18" Margin="0,0,10,0"/>
                                <TextBlock Text="{DynamicResource Settings_LanguageRegion}" Style="{StaticResource DarkSectionTitle}" Margin="0"/>
                            </StackPanel>
                            
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Settings_ApplicationLanguage}" Style="{StaticResource DarkFieldLabel}"/>
                                <Border Background="#FAF9F7" BorderBrush="#8F887A" BorderThickness="1" CornerRadius="10" Padding="4">
                                    <ComboBox SelectedValue="{Binding SelectedLanguage}" SelectedValuePath="Tag" 
                                              BorderThickness="0" Background="Transparent" Foreground="#14181D"
                                              FontSize="14" Padding="10,8">
                                        <!-- No flag emoji: Windows has no glyphs for
                                             regional-indicator pairs, so 🇺🇸 rendered as the
                                             bare letters "US" and the item read "US English".
                                             A language is not a country anyway. -->
                                        <ComboBoxItem Content="{DynamicResource SET2_002}" Tag="en"/>
                                        <ComboBoxItem Content="{DynamicResource SET2_001}" Tag="ar"/>
                                    </ComboBox>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Backup -->
                        <StackPanel Grid.Column="2">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <TextBlock Text="💾" FontSize="18" Margin="0,0,10,0"/>
                                <TextBlock Text="{DynamicResource Settings_Backup}" Style="{StaticResource DarkSectionTitle}" Margin="0"/>
                            </StackPanel>
                            
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Settings_BackupPath}" Style="{StaticResource DarkFieldLabel}"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding BackupPath}" Style="{StaticResource DarkTextBox}" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Content="📂" Command="{Binding BrowseBackupPathCommand}"
                                            Style="{StaticResource DarkSecondaryButton}" Width="48"/>
                                </Grid>
                                <!-- Run Backup Button -->
                                <!-- Was painted amber with white text (2.69:1). Amber means "printing" in this
                                     identity, not "press here"; it now uses the one primary button colour. -->
                                <Button Command="{Binding RunBackupCommand}" Style="{StaticResource DarkButton}" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💾" FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="{DynamicResource Settings_RunBackup}" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Save Button -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <!-- Was green: "done" is a status colour, not an action. One primary colour for actions. -->
            <Button Command="{Binding SaveSettingsCommand}" Style="{StaticResource DarkButton}">
                <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="White">
                    <Run Text="💾 "/><Run Text="{DynamicResource Settings_Save}"/>
                </TextBlock>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
