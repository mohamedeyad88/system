<Window x:Class="Apex.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Apex.UI"
        xmlns:views="clr-namespace:Apex.UI.Views"
        xmlns:viewmodels="clr-namespace:Apex.UI.ViewModels"
        xmlns:services="clr-namespace:Apex.UI.Services"
        xmlns:properties="clr-namespace:Apex.UI.Properties"
        mc:Ignorable="d"
        Title="{DynamicResource Welcome}" Height="800" Width="1200"
        MinWidth="1200" MinHeight="800"
        FlowDirection="{Binding Source={x:Static services:LocalizationService.Instance}, Path=FlowDirection, Mode=OneWay}"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        Background="#0F172A">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Professional Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource Gradient.Sidebar}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo Area -->
                <StackPanel Grid.Row="0" Margin="24,32,24,32">
                    <TextBlock Text="PRINT OS" 
                               Foreground="{DynamicResource Brush.Text.OnDark}" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               FontFamily="Segoe UI"/>
                    <TextBlock Text="{DynamicResource ProfessionalSuite}" 
                               Foreground="{DynamicResource Brush.Sidebar.Text}" 
                               FontSize="12" 
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Navigation with Modern Animated Buttons -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,0,12,16">

                        <!-- ══ Section: الرئيسية ══ -->
                        <TextBlock Text="{DynamicResource Nav_Section_Main}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#6B7280" Margin="8,0,0,8"/>

                        <!-- 🏠 Dashboard -->
                        <Button Command="{Binding NavigateToDashboardCommand}" Margin="0,0,0,4">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="Transparent" CornerRadius="10" Padding="14,12" Cursor="Hand">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                                        </Border.RenderTransform>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="10" Margin="0,0,12,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#3B82F6" Offset="0"/>
                                                        <GradientStop Color="#1D4ED8" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="🏠" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource Nav_Dashboard}" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                                <TextBlock Text="{DynamicResource Nav_Dashboard_Desc}" FontSize="10" Foreground="#9CA3AF"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#374151"/>
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.15"/>
                                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#4B5563"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding DataContext.IsDashboardActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- ══ Section: العمليات اليومية ══ -->
                        <TextBlock Text="العمليات اليومية" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#6B7280" Margin="8,16,0,8"/>

                        <!-- 📤 Printer Monitor -->
                        <Button Command="{Binding NavigateToDistributionCommand}" Margin="0,0,0,4">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="Transparent" CornerRadius="10" Padding="14,12" Cursor="Hand">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                                        </Border.RenderTransform>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="10" Margin="0,0,12,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#8B5CF6" Offset="0"/>
                                                        <GradientStop Color="#7C3AED" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="📤" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource Nav_PrinterMonitor}" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                                <TextBlock Text="{DynamicResource Nav_PrinterMonitor_Desc}" FontSize="10" Foreground="#9CA3AF"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#374151"/>
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.15"/>
                                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding DataContext.IsDistributionActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- 📚 Numbered Books -->
                        <Button Command="{Binding NavigateToNumberedBooksCommand}" Margin="0,0,0,4">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="Transparent" CornerRadius="10" Padding="14,12" Cursor="Hand">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                                        </Border.RenderTransform>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="10" Margin="0,0,12,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#F59E0B" Offset="0"/>
                                                        <GradientStop Color="#D97706" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="📚" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource Nav_NumberedBooks}" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                                <TextBlock Text="{DynamicResource Nav_NumberedBooks_Desc}" FontSize="10" Foreground="#9CA3AF"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#374151"/>
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.15"/>
                                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding DataContext.IsNumberedBooksActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- 🖨️ Print Operations -->
                        <Button Command="{Binding NavigateToPrintersCommand}" Margin="0,0,0,4">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="Transparent" CornerRadius="10" Padding="14,12" Cursor="Hand">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                                        </Border.RenderTransform>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="10" Margin="0,0,12,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#EC4899" Offset="0"/>
                                                        <GradientStop Color="#BE185D" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="⚙️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource Nav_PrintOps}" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                                <TextBlock Text="{DynamicResource Nav_PrintOps_Desc}" FontSize="10" Foreground="#9CA3AF"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#374151"/>
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.15"/>
                                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding DataContext.IsPrintOperationsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- ⚡ Quick Print -->
                        <Button Command="{Binding NavigateToPrintManagerCommand}" Margin="0,0,0,4">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="Transparent" CornerRadius="10" Padding="14,12" Cursor="Hand">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                                        </Border.RenderTransform>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="10" Margin="0,0,12,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#22C55E" Offset="0"/>
                                                        <GradientStop Color="#16A34A" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="⚡" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource Nav_QuickPrint}" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                                <TextBlock Text="{DynamicResource Nav_QuickPrint_Desc}" FontSize="10" Foreground="#9CA3AF"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#374151"/>
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.15"/>
                                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#4B5563"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding DataContext.IsPrintManagerActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- ══ Section: الأعمال ══ -->
                        <TextBlock Text="{DynamicResource Nav_Section_Business}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#6B7280" Margin="8,16,0,8"/>

                        <!-- 💰 Quotation -->
                        <Button Command="{Binding NavigateToQuotationCommand}" Margin="0,0,0,4">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="Transparent" CornerRadius="10" Padding="14,12" Cursor="Hand">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                                        </Border.RenderTransform>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="10" Margin="0,0,12,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#14B8A6" Offset="0"/>
                                                        <GradientStop Color="#0D9488" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="💰" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource Nav_Quotation}" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                                <TextBlock Text="{DynamicResource Nav_Quotation_Desc}" FontSize="10" Foreground="#9CA3AF"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#374151"/>
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.15"/>
                                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding DataContext.IsQuotationActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- 📑 Reports -->
                        <Button Command="{Binding NavigateToReportsCommand}" Margin="0,0,0,4">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="Transparent" CornerRadius="10" Padding="14,12" Cursor="Hand">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                                        </Border.RenderTransform>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="10" Margin="0,0,12,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#EF4444" Offset="0"/>
                                                        <GradientStop Color="#DC2626" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="📑" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="التقارير" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                                <TextBlock Text="تقارير مجدولة وسريعة" FontSize="10" Foreground="#9CA3AF"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#374151"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding DataContext.IsReportsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- 💹 Analytics -->
                        <Button Command="{Binding NavigateToAnalyticsCommand}" Margin="0,0,0,4">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="Transparent" CornerRadius="10" Padding="14,12" Cursor="Hand">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                                        </Border.RenderTransform>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="10" Margin="0,0,12,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#22C55E" Offset="0"/>
                                                        <GradientStop Color="#16A34A" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="💹" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="التحليلات" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                                <TextBlock Text="إيرادات وتكاليف" FontSize="10" Foreground="#9CA3AF"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#374151"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding DataContext.IsAnalyticsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- ══ Section: الإدارة ══ -->
                        <TextBlock Text="الإدارة" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#6B7280" Margin="8,16,0,8"/>

                        <!-- 👤 User Management -->
                        <Button Command="{Binding NavigateToUserManagementCommand}" Margin="0,0,0,4">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="Transparent" CornerRadius="10" Padding="14,12" Cursor="Hand">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                                        </Border.RenderTransform>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="10" Margin="0,0,12,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#F59E0B" Offset="0"/>
                                                        <GradientStop Color="#D97706" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="👤" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="المستخدمون" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                                <TextBlock Text="حسابات وصلاحيات" FontSize="10" Foreground="#9CA3AF"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#374151"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding DataContext.IsUserManagementActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- ══ Section: الأدوات المتقدمة ══ -->
                        <TextBlock Text="الأدوات المتقدمة" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#6B7280" Margin="8,16,0,8"/>

                        <!-- 📄 Template Designer -->
                        <Button Command="{Binding NavigateToTemplateDesignerCommand}" Margin="0,0,0,4">
                            <Button.Template>
