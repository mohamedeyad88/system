<Window x:Class="Apex.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Apex.UI"
        xmlns:views="clr-namespace:Apex.UI.Views"
        xmlns:viewmodels="clr-namespace:Apex.UI.ViewModels"
        xmlns:services="clr-namespace:Apex.UI.Services"
        xmlns:properties="clr-namespace:Apex.UI.Properties"
        xmlns:controls="clr-namespace:Apex.UI.Controls"
        mc:Ignorable="d"
        Title="{DynamicResource Welcome}" Height="800" Width="1200"
        Icon="pack://application:,,,/Assets/AppIcon.ico"
        UseLayoutRounding="True"
        TextOptions.TextRenderingMode="ClearType"
        MinWidth="1200" MinHeight="800"
        FlowDirection="{Binding Source={x:Static services:LocalizationService.Instance}, Path=FlowDirection, Mode=OneWay}"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FontFamily="{DynamicResource Font.Arabic}"
        Background="{DynamicResource Paper}">
    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Professional Sidebar. A soft even shadow lifts it above the content on every
             screen — one edit that gives the whole app depth (works in LTR and RTL). -->
        <Border Grid.Column="0" Background="{DynamicResource Panel}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0"
                Panel.ZIndex="1">
            <Border.Effect>
                <DropShadowEffect Color="#4A4438" Opacity="0.16" BlurRadius="20" ShadowDepth="0"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo Area -->
                <StackPanel Grid.Row="0" Margin="24,32,24,32">
                    <StackPanel Orientation="Horizontal">
                        <!-- Signature: a printer's registration / crop mark — the point where
                             everything lines up. The brand element, in the one cyan accent. -->
                        <Canvas Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,11,0">
                            <Path Data="M 1,16 L 1,5 M 5,1 L 16,1"
                                  Stroke="{DynamicResource Brand}" StrokeThickness="2"/>
                        </Canvas>
                        <TextBlock Text="APEX PRINT"
                                   Foreground="{DynamicResource Ink}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   FontFamily="{DynamicResource Font.Latin}"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource ProfessionalSuite}"
                               Foreground="{DynamicResource Muted}"
                               FontSize="12"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Navigation with Modern Animated Buttons -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,0,12,16">

                        <!-- ══ Section: الرئيسية ══ -->
                        <TextBlock Text="{DynamicResource Nav_Section_Main}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Muted}" Margin="8,0,0,8"/>

                        <!-- 🏠 Dashboard -->
                        <Button Command="{Binding NavigateToDashboardCommand}" Style="{StaticResource NavItemButton}"
                                controls:NavAssist.Icon="🏠"
                                controls:NavAssist.IsActive="{Binding IsDashboardActive}">
                            <controls:NavAssist.IconBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3B82F6" Offset="0"/>
                                    <GradientStop Color="#1D4ED8" Offset="1"/>
                                </LinearGradientBrush>
                            </controls:NavAssist.IconBrush>
                            <Button.Content>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Nav_Dashboard}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                                    <TextBlock Text="{DynamicResource Nav_Dashboard_Desc}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Muted}"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>

                        <!-- ══ Section: Printing ══ — sits directly under the dashboard:
                             the daily job, reached before any of the preparation tools. -->
                        <TextBlock Text="{DynamicResource Nav_Section_Daily}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Muted}" Margin="8,16,0,8"/>

                        <!-- 🖨️ Printing — one place for the whole job:
                             file queue + one or many printers + distribution mode. -->
                        <Button Command="{Binding NavigateToPrintManagerCommand}" Style="{StaticResource NavItemButton}"
                                controls:NavAssist.Icon="🖨️"
                                controls:NavAssist.IsActive="{Binding IsPrintManagerActive}">
                            <controls:NavAssist.IconBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#22C55E" Offset="0"/>
                                    <GradientStop Color="#16A34A" Offset="1"/>
                                </LinearGradientBrush>
                            </controls:NavAssist.IconBrush>
                            <Button.Content>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Nav_Printing}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                                    <TextBlock Text="{DynamicResource Nav_Printing_Desc}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Muted}"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>

                        <!-- ══ Section: Design ══ — reordered into production-flow order:
                             design → prepress → print (was Production/Design split). -->
                        <TextBlock Text="{DynamicResource Nav_Section_Design}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Muted}" Margin="8,16,0,8"/>

                        <!-- 📄 Template Designer -->
                        <Button Command="{Binding NavigateToTemplateDesignerCommand}" Style="{StaticResource NavItemButton}"
                                controls:NavAssist.Icon="📄"
                                controls:NavAssist.IsActive="{Binding IsTemplateDesignerActive}">
                            <controls:NavAssist.IconBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#14B8A6" Offset="0"/>
                                    <GradientStop Color="#0F766E" Offset="1"/>
                                </LinearGradientBrush>
                            </controls:NavAssist.IconBrush>
                            <Button.Content>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Nav_TemplateDesigner}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                                    <TextBlock Text="{DynamicResource Nav_TemplateDesigner_Desc}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Muted}"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>

                        <!-- 📚 Numbered Books -->
                        <Button Command="{Binding NavigateToNumberedBooksCommand}" Style="{StaticResource NavItemButton}"
                                controls:NavAssist.Icon="📚"
                                controls:NavAssist.IsActive="{Binding IsNumberedBooksActive}">
                            <controls:NavAssist.IconBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#F59E0B" Offset="0"/>
                                    <GradientStop Color="#D97706" Offset="1"/>
                                </LinearGradientBrush>
                            </controls:NavAssist.IconBrush>
                            <Button.Content>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Nav_NumberedBooks}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                                    <TextBlock Text="{DynamicResource Nav_NumberedBooks_Desc}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Muted}"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>

                        <!-- ══ Section: Prepress ══ -->
                        <TextBlock Text="{DynamicResource Nav_Section_Prepress}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Muted}" Margin="8,16,0,8"/>

                        <!-- 🧰 Page Tools -->
                        <Button Command="{Binding NavigateToPageToolsCommand}" Style="{StaticResource NavItemButton}"
                                controls:NavAssist.Icon="🧰"
                                controls:NavAssist.IsActive="{Binding IsPageToolsActive}">
                            <controls:NavAssist.IconBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0EA5E9" Offset="0"/>
                                    <GradientStop Color="#0369A1" Offset="1"/>
                                </LinearGradientBrush>
                            </controls:NavAssist.IconBrush>
                            <Button.Content>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Nav_PageTools}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                                    <TextBlock Text="{DynamicResource Nav_PageTools_Desc}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Muted}"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>

                        <!-- 📐 Imposition & Finishing -->
                        <Button Command="{Binding NavigateToImpositionCommand}" Style="{StaticResource NavItemButton}"
                                controls:NavAssist.Icon="📐"
                                controls:NavAssist.IsActive="{Binding IsImpositionActive}">
                            <controls:NavAssist.IconBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#8B5CF6" Offset="0"/>
                                    <GradientStop Color="#6D28D9" Offset="1"/>
                                </LinearGradientBrush>
                            </controls:NavAssist.IconBrush>
                            <Button.Content>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Nav_Imposition}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                                    <TextBlock Text="{DynamicResource Nav_Imposition_Desc}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Muted}"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>

                        <!-- Color Calibration nav removed: the tool's adjustments were never applied
                             by the print pipeline (field report: no real use). Engine code kept but
                             unreferenced; can be purged fully later. -->

                        <!-- ══ Section: النظام ══ -->
                        <TextBlock Text="{DynamicResource Nav_Section_System}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Muted}" Margin="8,16,0,8"/>

                        <!-- 📊 Performance -->
                        <Button Command="{Binding NavigateToPerformanceCommand}" Style="{StaticResource NavItemButton}"
                                controls:NavAssist.Icon="📊"
                                controls:NavAssist.IsActive="{Binding IsPerformanceActive}">
                            <controls:NavAssist.IconBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#06B6D4" Offset="0"/>
                                    <GradientStop Color="#0891B2" Offset="1"/>
                                </LinearGradientBrush>
                            </controls:NavAssist.IconBrush>
                            <Button.Content>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Nav_Performance}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                                    <TextBlock Text="{DynamicResource Nav_Performance_Desc}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Muted}"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>

                        <!-- ⚙️ Settings -->
                        <Button Command="{Binding NavigateToSettingsCommand}" Style="{StaticResource NavItemButton}"
                                controls:NavAssist.Icon="⚙️"
                                controls:NavAssist.IsActive="{Binding IsSettingsActive}">
                            <controls:NavAssist.IconBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#8B5CF6" Offset="0"/>
                                    <GradientStop Color="#7C3AED" Offset="1"/>
                                </LinearGradientBrush>
                            </controls:NavAssist.IconBrush>
                            <Button.Content>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Nav_Settings}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                                    <TextBlock Text="{DynamicResource Nav_Settings_Desc}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Muted}"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>

                        <!-- 🔑 License Management -->
                        <Button Command="{Binding NavigateToLicensingCommand}" Style="{StaticResource NavItemButton}"
                                controls:NavAssist.Icon="🔑"
                                controls:NavAssist.IsActive="{Binding IsLicensingActive}">
                            <controls:NavAssist.IconBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#F59E0B" Offset="0"/>
                                    <GradientStop Color="#D97706" Offset="1"/>
                                </LinearGradientBrush>
                            </controls:NavAssist.IconBrush>
                            <Button.Content>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Nav_Licensing}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                                    <TextBlock Text="{DynamicResource Nav_Licensing_Desc}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Muted}"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>

                        <!-- 📝 System Logs -->
                        <Button Command="{Binding OpenLogViewerCommand}" Margin="0,0,0,4">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="Transparent" CornerRadius="10" Padding="14,12" Cursor="Hand">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                                        </Border.RenderTransform>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="10" Margin="0,0,12,0" Background="Transparent">
                                                <TextBlock Text="📝" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource Nav_SystemLogs}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                                                <TextBlock Text="{DynamicResource Nav_SystemLogs_Desc}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Muted}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource BrandSoft}"/>
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.15"/>
                                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        
                    </StackPanel>
                </ScrollViewer>

                <!-- Bottom Language Switcher -->
                <Border Grid.Row="2"
                        Background="{DynamicResource Paper}"
                        Padding="16"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Language}"
                                   Foreground="{DynamicResource Muted}"
                                   FontSize="11"
                                   Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- English Language Button -->
                            <Button Grid.Column="0"
                                    Content="{DynamicResource English}"
                                    Command="{Binding SwitchLanguageCommand}"
                                    CommandParameter="en"
                                    Foreground="{DynamicResource Muted}"
                                    BorderThickness="0"
                                    Padding="8,6"
                                    FontSize="12"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="langBorder"
                                                Background="{DynamicResource TrackColor}"
                                                CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                            <!-- The button sets Foreground locally (Muted), and a local value outranks a
                                                 template trigger, so the old trigger's white never applied: the active
                                                 language showed grey text on the filled tile. The trigger now colours the
                                                 presenter inside the template, which a template trigger does control. -->
                                            <ContentPresenter x:Name="langText"
                                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="langBorder" Property="Background" Value="{DynamicResource BrandSoft}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding Source={x:Static services:LocalizationService.Instance}, Path=IsEnglishActive}" Value="True">
                                                <Setter TargetName="langBorder" Property="Background" Value="{DynamicResource Action}"/>
                                                <Setter TargetName="langText" Property="TextElement.Foreground" Value="{DynamicResource OnAction}"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <!-- Arabic Language Button -->
                            <Button Grid.Column="2"
                                    Content="{DynamicResource Arabic}"
                                    Command="{Binding SwitchLanguageCommand}"
                                    CommandParameter="ar"
                                    Foreground="{DynamicResource Muted}"
                                    BorderThickness="0"
                                    Padding="8,6"
                                    FontSize="12"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="langBorder"
                                                Background="{DynamicResource TrackColor}"
                                                CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                            <!-- The button sets Foreground locally (Muted), and a local value outranks a
                                                 template trigger, so the old trigger's white never applied: the active
                                                 language showed grey text on the filled tile. The trigger now colours the
                                                 presenter inside the template, which a template trigger does control. -->
                                            <ContentPresenter x:Name="langText"
                                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="langBorder" Property="Background" Value="{DynamicResource BrandSoft}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding Source={x:Static services:LocalizationService.Instance}, Path=IsArabicActive}" Value="True">
                                                <Setter TargetName="langBorder" Property="Background" Value="{DynamicResource Action}"/>
                                                <Setter TargetName="langText" Property="TextElement.Foreground" Value="{DynamicResource OnAction}"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area — animated page transitions -->
        <Grid Grid.Column="1" Background="{DynamicResource Paper}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Update-available notice (server-driven, dismissible) -->
            <Border Grid.Row="0" Background="{DynamicResource Brand}" Padding="14,8"
                    Visibility="{Binding UpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid FlowDirection="RightToLeft">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{DynamicResource OnAction}" FontSize="13">
                        <Run Text="🚀 تحديث جديد متاح — الإصدار"/>
                        <Run Text="{Binding UpdateVersion}" FontWeight="Bold"/>
                    </TextBlock>
                    <Button Grid.Column="1" Content="تحميل التحديث" Command="{Binding OpenUpdateLinkCommand}"
                            Background="{DynamicResource Panel}" Foreground="{DynamicResource BrandDeep}" BorderThickness="0"
                            Padding="14,5" FontSize="12" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,0"/>
                    <Button Grid.Column="2" Content="✕" Command="{Binding DismissUpdateCommand}"
                            Background="Transparent" Foreground="{DynamicResource OnAction}" BorderThickness="0"
                            Padding="8,4" FontSize="12" Cursor="Hand"/>
                </Grid>
            </Border>

            <controls:TransitionContentControl Grid.Row="1" Content="{Binding CurrentViewModel}"/>

            <!-- Persistent live print status — shown from EVERY section while a run is
                 active, so the operator can set up the next job and still watch the
                 press. Driven by the singleton BatchPrintJobManager via MainViewModel. -->
            <Border Grid.Row="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="16,10"
                    Visibility="{Binding IsPrintingGlobally, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🖨️" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ProgressBar Grid.Column="1" Value="{Binding PrintProgress}" Maximum="100" Height="12"
                                 VerticalAlignment="Center" Foreground="{DynamicResource Brand}" Background="{DynamicResource TrackColor}" BorderThickness="0"/>
                    <TextBlock Grid.Column="2" Text="{Binding PrintStatusText}" Foreground="{DynamicResource Ink}" FontSize="13"
                               FontFamily="{DynamicResource Font.Data}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
