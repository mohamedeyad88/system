<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ══════════════════════════════════════════════════════════════════════════
         APEX PRINT — الهوية البصرية الجديدة (فاتحة، سماوي واحد)
         Brand tokens per the identity document. ADDITIVE layer: introduces the new
         light palette under semantic keys (Ink/Paper/Brand/status…) WITHOUT touching
         the legacy Color.*/Brush.* keys, so screens migrate one by one, not all at once.
         ══════════════════════════════════════════════════════════════════════════ -->

    <!-- ── الألوان الأساسية — Core ───────────────────────────────────────── -->
    <Color x:Key="InkColor">#FF14181D</Color>      <!-- النص الأساسي، الأرقام الكبيرة، اللوجو -->
    <Color x:Key="PaperColor">#FFFAF9F7</Color>    <!-- خلفية التطبيق (أوف-وايت) -->
    <Color x:Key="PanelColor">#FFFFFFFF</Color>    <!-- البطاقات فوق الخلفية -->
    <!-- Darkened DDD9D3 -> A69E91 (1.34:1 -> 2.52:1 on the page ground). At 1.34 the
         group separators on the numbering bar were invisible, so its 18 groups blurred
         into one another and the toolbar read as unorganised. -->
    <!-- A69E91 -> 8F887A (2.52:1 -> 3.34:1 on paper). 2.52 was still under the 3:1 a
         control boundary needs, so card and field edges stayed faint on the shop floor. -->
    <Color x:Key="BorderColor">#FF8F887A</Color>   <!-- الحدود والفواصل -->
    <!-- Darkened 6B6864 -> 57534E (5.54:1 -> 7.63:1 on white). At the 10-11px sizes
         this UI uses for secondary text, 5.54 read as washed-out to operators. -->
    <Color x:Key="MutedColor">#FF57534E</Color>    <!-- النص الثانوي والتسميات -->

    <!-- ── لون العلامة الوحيد — Brand (single accent) ────────────────────── -->
    <!-- 2026-09-22: the accent moved from turquoise (0891B2) to a deep emerald at
         customers' request. Emerald leans blue, so it stays apart from the forest
         green of "Done" (166B40), which leans yellow. On white: 5.48:1. -->
    <Color x:Key="BrandColor">#FF047857</Color>     <!-- أخضر زمرّدي — أزرار، تحديد، روابط، الحالة النشطة -->
    <Color x:Key="BrandDeepColor">#FF065F46</Color> <!-- حالة الضغط (pressed) -->
    <Color x:Key="BrandSoftColor">#FFE6F4EE</Color> <!-- خلفية خفيفة للتحديد/الإبراز -->

    <!-- ── ألوان الحالة — Status (أهم ألوان في البرنامج) ─────────────────── -->
    <!-- E08A00 -> B45309. As text the old amber measured 2.56:1 on paper — "printing"
         is the one state an operator must read at a glance, and it was the faintest. -->
    <Color x:Key="PrintingColor">#FFB45309</Color> <!-- قيد الطباعة — شغّال دلوقتي -->
    <!-- 1B7F4C -> 166B40: the old green fell to 4.40:1 on its own tinted chip. -->
    <Color x:Key="DoneColor">#FF166B40</Color>     <!-- تم بنجاح -->
    <Color x:Key="StoppedColor">#FFB42318</Color>  <!-- متوقف — تدخّل مطلوب (أحمر: للأخطاء فقط) -->
    <!-- 8A8783 -> 726F6A (3.58:1 -> 5.00:1 on white). -->
    <Color x:Key="WaitingColor">#FF726F6A</Color>  <!-- في الانتظار / في الطابور -->

    <!-- ══════════════════════════════════════════════════════════════════════════
         الفرش — Brushes
         ══════════════════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="Ink"        Color="{StaticResource InkColor}"/>
    <SolidColorBrush x:Key="Paper"      Color="{StaticResource PaperColor}"/>
    <SolidColorBrush x:Key="Panel"      Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="Border"     Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="Muted"      Color="{StaticResource MutedColor}"/>

    <SolidColorBrush x:Key="Brand"      Color="{StaticResource BrandColor}"/>
    <SolidColorBrush x:Key="BrandDeep"  Color="{StaticResource BrandDeepColor}"/>
    <SolidColorBrush x:Key="BrandSoft"  Color="{StaticResource BrandSoftColor}"/>

    <SolidColorBrush x:Key="Printing"   Color="{StaticResource PrintingColor}"/>
    <SolidColorBrush x:Key="Done"       Color="{StaticResource DoneColor}"/>
    <SolidColorBrush x:Key="Stopped"    Color="{StaticResource StoppedColor}"/>
    <SolidColorBrush x:Key="Waiting"    Color="{StaticResource WaitingColor}"/>

    <!-- The fill for a primary button that carries white text. Brand (0891B2) stays the
         identity cyan for selection, focus and highlights, but white on it is only 3.68:1,
         so every white-labelled button failed. 0E7490 gives 5.36:1, and 0B5C72 on hover
         7.53:1. Not used for ink text: ink on 0E7490 is 3.33:1 — ink belongs on Brand. -->
    <Color x:Key="ActionColor">#FF047857</Color>
    <Color x:Key="ActionHoverColor">#FF065F46</Color>
    <SolidColorBrush x:Key="Action"      Color="{StaticResource ActionColor}"/>
    <SolidColorBrush x:Key="ActionHover" Color="{StaticResource ActionHoverColor}"/>
    <SolidColorBrush x:Key="OnAction"    Color="#FFFFFFFF"/>

    <!-- ── Surfaces and status tints — replace the hard-coded values screens used ──
         Every screen that wrote its own hex never saw a token change, which is why earlier
         contrast fixes barely showed. These give those values a name, each checked with the
         text that sits on it. -->
    <Color x:Key="HoverColor">#FFDDD9D3</Color>        <!-- hover / pressed surface. Muted on it 5.43:1 -->
    <Color x:Key="PanelSunkColor">#FFF4F2EF</Color>    <!-- inset panel. Muted on it 6.83:1 -->
    <Color x:Key="DoneSoftColor">#FFE7F3EC</Color>     <!-- "done" chip. Done on it 5.74:1 -->
    <Color x:Key="StoppedSoftColor">#FFF6E4E2</Color>  <!-- error chip. Stopped on it 5.36:1 -->
    <!-- FDF1DC -> FEF6EA: printing text on the old tint was 4.49:1, just under the line. -->
    <Color x:Key="PrintingSoftColor">#FFFEF6EA</Color> <!-- printing chip. Printing on it 4.68:1 -->

    <SolidColorBrush x:Key="Hover"        Color="{StaticResource HoverColor}"/>
    <SolidColorBrush x:Key="PanelSunk"    Color="{StaticResource PanelSunkColor}"/>
    <SolidColorBrush x:Key="DoneSoft"     Color="{StaticResource DoneSoftColor}"/>
    <SolidColorBrush x:Key="StoppedSoft"  Color="{StaticResource StoppedSoftColor}"/>
    <SolidColorBrush x:Key="PrintingSoft" Color="{StaticResource PrintingSoftColor}"/>

    <!-- نص على العلامة: أبيض تباينه ضعيف (~3.3:1) فوق السماوي؛ الحبر أوضح.
         نستخدم الحبر كنص افتراضي على الأزرار السماوية، ونحتفظ بأبيض للحالات الغامقة. -->
    <SolidColorBrush x:Key="OnBrand"       Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="OnBrandInverse" Color="#FFFFFFFF"/>

    <!-- خلفية مسار شريط التقدم -->
    <SolidColorBrush x:Key="TrackColor" Color="#FFEDEAE5"/>

    <!-- ══════════════════════════════════════════════════════════════════════════
         ألوان كانت مكتوبة بإيد جوه الشاشات — دلوقتي ليها أسامي هنا.
         Colours that used to be typed into individual screens. Every colour a view
         uses now has a name in this file, so a theme can be swapped by replacing
         this one dictionary — which is what a dark mode needs.
         ══════════════════════════════════════════════════════════════════════════ -->

    <!-- The sheet of paper. It stays white in every theme: the canvas and the
         previews show what will be printed, and paper is white. -->
    <Color x:Key="SheetColor">#FFFFFFFF</Color>
    <Color x:Key="SheetHintColor">#3314181D</Color>   <!-- faint text drawn ON the sheet -->
    <SolidColorBrush x:Key="Sheet"     Color="{StaticResource SheetColor}"/>
    <SolidColorBrush x:Key="SheetHint" Color="{StaticResource SheetHintColor}"/>

    <!-- The backdrop around the sheet, so the white page stands out. -->
    <Color x:Key="CanvasBackdropColor">#FFEAE7E1</Color>
    <Color x:Key="CanvasBackdropAltColor">#FFE3DFD8</Color>

    <!-- Shadows. -->
    <Color x:Key="ShadowColor">#FF000000</Color>
    <Color x:Key="ShadowSoftColor">#FF8A8783</Color>
    <Color x:Key="CardShadowColor">#FFB7B2A8</Color>

    <!-- A modal's backdrop, and the veil over a page while it renders. -->
    <Color x:Key="ScrimColor">#B4231814</Color>
    <Color x:Key="OverlayPanelColor">#F2FFFFFF</Color>
    <SolidColorBrush x:Key="Scrim"        Color="{StaticResource ScrimColor}"/>
    <SolidColorBrush x:Key="OverlayPanel" Color="{StaticResource OverlayPanelColor}"/>

    <!-- Fields drawn on the sheet: fill and outline, plain / selected / multi. -->
    <Color x:Key="BrandTintColor">#1F047857</Color>
    <Color x:Key="BrandTintStrongColor">#38047857</Color>
    <Color x:Key="BrandLineColor">#80047857</Color>
    <Color x:Key="SelectTintColor">#33F59E0B</Color>
    <Color x:Key="MultiSelectTintColor">#1938BDF8</Color>
    <SolidColorBrush x:Key="BrandTint"        Color="{StaticResource BrandTintColor}"/>
    <SolidColorBrush x:Key="BrandTintStrong"  Color="{StaticResource BrandTintStrongColor}"/>
    <SolidColorBrush x:Key="BrandLine"        Color="{StaticResource BrandLineColor}"/>
    <SolidColorBrush x:Key="SelectTint"       Color="{StaticResource SelectTintColor}"/>
    <SolidColorBrush x:Key="MultiSelectTint"  Color="{StaticResource MultiSelectTintColor}"/>

    <!-- ══════════════════════════════════════════════════════════════════════════
         أيقونات القائمة — بنفس لغة اللوجو.
         Sidebar icons, drawn in the logo's language: the logo is a printer's crop
         mark — two straight strokes meeting at a sharp corner — so every icon is
         straight 16×16 line work with square ends and mitred corners. Colour is the
         brand cyan only, as a gradient from Brand to BrandDeep: no new colours.
         ══════════════════════════════════════════════════════════════════════════ -->
    <Geometry x:Key="Icon.Dashboard">M1.5,1.5 H6.5 V6.5 H1.5 Z M9.5,1.5 H14.5 V6.5 H9.5 Z M1.5,9.5 H6.5 V14.5 H1.5 Z M9.5,9.5 H14.5 V14.5 H9.5 Z</Geometry>
    <Geometry x:Key="Icon.Printing">M4.5,6.5 V1.5 H11.5 V6.5 M4.5,12.5 H1.5 V6.5 H14.5 V12.5 H11.5 M4.5,9.5 H11.5 V14.5 H4.5 Z</Geometry>
    <Geometry x:Key="Icon.Designer">M2.5,1.5 H10.5 L13.5,4.5 V14.5 H2.5 Z M5.5,7.5 H10.5 M5.5,10.5 H8.5</Geometry>
    <Geometry x:Key="Icon.Numbering">M6,1.5 L4.5,14.5 M11.5,1.5 L10,14.5 M1.5,5.5 H14.5 M1.5,10.5 H14.5</Geometry>
    <Geometry x:Key="Icon.PageTools">M5.5,1.5 H14.5 V10.5 M1.5,4.5 H11.5 V14.5 H1.5 Z</Geometry>
    <!-- A sheet laid out four-up, with crop marks at two corners — the logo's own mark. -->
    <Geometry x:Key="Icon.Imposition">M4.5,4.5 H11.5 V11.5 H4.5 Z M8,4.5 V11.5 M4.5,8 H11.5 M0.5,4.5 H2.5 M4.5,0.5 V2.5 M13.5,11.5 H15.5 M11.5,13.5 V15.5</Geometry>
    <Geometry x:Key="Icon.Performance">M1.5,14.5 H14.5 M4.5,12.5 V8.5 M8,12.5 V3.5 M11.5,12.5 V6.5</Geometry>
    <Geometry x:Key="Icon.Settings">M1.5,4 H14.5 M1.5,8 H14.5 M1.5,12 H14.5 M5,2 V6 M11,6 V10 M7,10 V14</Geometry>
    <Geometry x:Key="Icon.License">M3.5,8 A3,3 0 1 0 9.5,8 A3,3 0 1 0 3.5,8 Z M9.5,8 H14.5 M12.5,8 V11 M14.5,8 V10.5</Geometry>
    <Geometry x:Key="Icon.Logs">M2.5,1.5 H13.5 V14.5 H2.5 Z M5.5,5 H10.5 M5.5,8 H10.5 M5.5,11 H8.5</Geometry>

    <!-- The stroke of an idle icon, and the fill of the active item's tile. -->
    <LinearGradientBrush x:Key="NavIconBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF059669" Offset="0"/>
        <GradientStop Color="{StaticResource BrandDeepColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavTileActiveBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF059669" Offset="0"/>
        <GradientStop Color="{StaticResource ActionColor}" Offset="1"/>
    </LinearGradientBrush>

    <!-- ══════════════════════════════════════════════════════════════════════════
         عمق من غير ألوان جديدة — Depth, without new colours.
         Every gradient here runs between colours already in this palette. The
         lightest point of each filled gradient still carries white text at ≥ 4.5:1
         (#05866A is the lightest used: 4.55:1).
         ══════════════════════════════════════════════════════════════════════════ -->
    <!-- Filled buttons and active tabs: lit at the top, settling into the deeper
         cyan at the bottom — reads as a raised button instead of a flat block. -->
    <LinearGradientBrush x:Key="ActionFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource ActionColor}" Offset="0"/>
        <GradientStop Color="{StaticResource ActionHoverColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ActionFillHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF05866A" Offset="0"/>
        <GradientStop Color="{StaticResource ActionColor}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Cards and the sidebar: the panel colour easing into the sunk panel. -->
    <LinearGradientBrush x:Key="SurfaceFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource PanelColor}" Offset="0"/>
        <GradientStop Color="{StaticResource PanelSunkColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SidebarFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource PanelColor}" Offset="0"/>
        <GradientStop Color="{StaticResource PanelSunkColor}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Progress: the brand cyan running into the deep cyan along the bar. -->
    <LinearGradientBrush x:Key="ProgressFill" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF10B981" Offset="0"/>
        <GradientStop Color="{StaticResource ActionColor}" Offset="1"/>
    </LinearGradientBrush>

    <!-- WhatsApp's own green: used for the WhatsApp button only. -->
    <Color x:Key="WhatsAppColor">#FF25D366</Color>
    <Color x:Key="WhatsAppDeepColor">#FF128C7E</Color>
    <SolidColorBrush x:Key="WhatsApp" Color="{StaticResource WhatsAppColor}"/>

    <!-- ══════════════════════════════════════════════════════════════════════════
         الخطوط — Typography (IBM Plex)
         ملاحظة: ملفات الخطوط لازم تتضاف في مجلد /Fonts كـ Resource (تعليمات منفصلة).
         لحد ما تتضاف، WPF بيرجع تلقائياً للخط الاحتياطي (Segoe UI / Tahoma) من غير كسر.
         ══════════════════════════════════════════════════════════════════════════ -->
    <!-- Cairo, in four real weights (400/500/600/700).
         Operators reported the type read "thin" and took effort. The cause was not
         only the face: the UI asks for SemiBold in 127 places and Bold in 93, while
         only Regular + SemiBold files were embedded — so Bold was faked and Medium
         fell back to Regular. Cairo ships Regular/Medium/SemiBold/Bold, all sharing
         the typographic family "Cairo", so every requested weight now resolves to a
         real cut. Cairo is also a sturdier Arabic screen face at small sizes. -->
    <FontFamily x:Key="Font.Arabic">pack://application:,,,/Fonts/#Cairo</FontFamily>
    <!-- Cairo carries the full Latin set too, so it serves the Latin wordmark. -->
    <FontFamily x:Key="Font.Latin">pack://application:,,,/Fonts/#Cairo</FontFamily>
    <!-- كل الأرقام والبيانات: Mono (لاتيني 0-9، خانات تتراص تحت بعض) -->
    <FontFamily x:Key="Font.Data">pack://application:,,,/Fonts/#IBM Plex Mono</FontFamily>

    <!-- ══════════════════════════════════════════════════════════════════════════
         سلّم المقاسات — Type scale
         ══════════════════════════════════════════════════════════════════════════ -->
    <sys:Double x:Key="Size.Counter">48</sys:Double>  <!-- رقم الترقيم الحالي — يتقري من مترين -->
    <sys:Double x:Key="Size.Title">24</sys:Double>    <!-- عنوان الشاشة -->
    <sys:Double x:Key="Size.Section">18</sys:Double>  <!-- عنوان قسم -->
    <sys:Double x:Key="Size.Body">14</sys:Double>     <!-- نص عادي / أرقام الجداول -->
    <sys:Double x:Key="Size.Caption">12</sys:Double>  <!-- تسمية صغيرة -->

</ResourceDictionary>
