        <Setter Property="Effect" Value="{DynamicResource Shadow.Small}"/>
    </Style>
    
    <!-- Interactive Card (with hover) -->
    <Style x:Key="Card.Interactive" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
