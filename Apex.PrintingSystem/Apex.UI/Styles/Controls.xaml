        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Effect" Value="{DynamicResource Shadow.Medium}"/>
                <Setter Property="Background" Value="{DynamicResource Gradient.Card.Hover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
