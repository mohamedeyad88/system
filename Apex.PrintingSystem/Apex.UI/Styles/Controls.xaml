        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Medium}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,10"/>
    </Style>
    
    <Style x:Key="ModernTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Medium}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,10"/>
    </Style>
    
    <Style x:Key="InputBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Medium}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,10"/>
    </Style>
    
    <!-- ==================== COMBOBOXITEM - عناصر القائمة المنسدلة (global dark) ==================== -->
    <!--
        Global implicit style for ComboBoxItem — overrides the default WPF ControlTemplate
        which hard-wires SystemColors.HighlightBrushKey in template triggers (making them
        immune to setter/trigger overrides). By supplying our own ControlTemplate with a
        named Border "Bd", our IsHighlighted / IsSelected triggers can set the Background
        directly on the element and fully bypass the system colour.
        This style acts as a safety net; ComboBoxes that specify ItemContainerStyle also
        embed the same ControlTemplate for explicit coverage.
    -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Background"                  Value="#FFFFFF"/>
        <Setter Property="Foreground"                  Value="#14181D"/>
        <Setter Property="Padding"                     Value="10,6"/>
        <Setter Property="FontSize"                    Value="13"/>
        <Setter Property="HorizontalContentAlignment"  Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Left"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#0B5C72"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#0E7490"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected"    Value="True"/>
                                <Condition Property="IsHighlighted" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="#1E40AF"/>
                            <Setter Property="Foreground" Value="White"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#6B6864"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== COMBOBOX - قائمة منسدلة (dark popup) ==================== -->
    <!--
        Global implicit style — applies to every ComboBox in the app.
        Provides a full dark ControlTemplate so the popup uses #FFFFFF instead of
        the system window brush (white).  Views that need a keyed override (DarkCombo)
        can still do so; this style is the baseline.
    -->
    <Style TargetType="ComboBox">
        <Setter Property="Background"        Value="#FFFFFF"/>
        <Setter Property="Foreground"        Value="#14181D"/>
        <Setter Property="BorderBrush"       Value="#8F887A"/>
        <Setter Property="BorderThickness"   Value="1"/>
        <Setter Property="Height"            Value="34"/>
        <Setter Property="FontSize"          Value="13"/>
        <Setter Property="MaxDropDownHeight" Value="240"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <!-- Explicit ControlTemplate required: WPF default ComboBoxItem template
                     hard-wires SystemColors.HighlightBrushKey in its own template triggers,
                     which override any Style setter/trigger for Background.
                     The only reliable fix is to supply our own template with a named Border
                     so our triggers can target it directly. -->
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Background"                  Value="#FFFFFF"/>
                    <Setter Property="Foreground"                  Value="#14181D"/>
                    <Setter Property="Padding"                     Value="10,6"/>
                    <Setter Property="FontSize"                    Value="13"/>
                    <Setter Property="HorizontalContentAlignment"  Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#0B5C72"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#0E7490"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsSelected"    Value="True"/>
                                            <Condition Property="IsHighlighted" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="Bd" Property="Background" Value="#1E40AF"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </MultiTrigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Foreground" Value="#6B6864"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="MainGrid">
                        <!-- Toggle button: background + arrow -->
                        <ToggleButton x:Name="TogBtn"
                                      Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd"
                                            Background="{Binding Background,
                                                         RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush,
                                                          RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderThickness="{Binding BorderThickness,
                                                              RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            CornerRadius="6">
                                        <DockPanel LastChildFill="False">
                                            <TextBlock DockPanel.Dock="Right" Text="▾"
                                                       Foreground="#6B6864" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0"/>
                                        </DockPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#6B6864"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#0891B2"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!-- Selected item display -->
                        <ContentPresenter x:Name="ContentSite"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="10,0,30,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"/>

                        <!-- Dark popup -->
                        <Popup x:Name="Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Border x:Name="DropBorder"
                                    Background="#FFFFFF"
                                    BorderBrush="#8F887A"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    MinWidth="{Binding ElementName=MainGrid, Path=ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <!-- Named alias kept for backward-compat — inherits the global dark style -->
    </Style>
    
    <!-- ==================== CHECKBOX - مربع اختيار ==================== -->
    
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- ==================== RADIOBUTTON - زر اختيار ==================== -->
    <!--
        Global implicit style so radio buttons inherit light text on the dark theme.
        Previously unstyled RadioButtons defaulted to black text (invisible on dark
        backgrounds). Keyed styles (e.g. ModernTabRadioButton) still override this.
    -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- ==================== SEPARATOR - فاصل ==================== -->
    
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource Brush.Divider}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="0,8"/>
    </Style>
    
    <Style x:Key="VerticalSeparator" TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource Brush.Divider}"/>
        <Setter Property="Width" Value="1"/>
        <Setter Property="Margin" Value="8,0"/>
    </Style>

    <!-- ==================== DARK THEME EXTRAS - للثيم الداكن ==================== -->

    <!-- Card.Dark - dark surface card used by views with hardcoded dark theme -->
    <Style x:Key="Card.Dark" TargetType="Border">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="BorderBrush" Value="#8F887A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="24"/>
        <Setter Property="Margin" Value="0,0,0,20"/>
    </Style>

    <!-- Button.Dark.Primary - blue button for dark-theme views -->
    <Style x:Key="Button.Dark.Primary" TargetType="Button">
        <Setter Property="Background" Value="#0E7490"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="500"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#0B5C72"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#0E7490"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Button.Dark.Ghost - transparent button for dark backgrounds -->
    <Style x:Key="Button.Dark.Ghost" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#6B6864"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#DDD9D3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== SIDEBAR NAV BUTTON (shared) ====================
         One template for all sidebar items. Per-item bits come from NavAssist
         attached properties (Icon, IconBrush, IsActive); the two text lines are
         the button CONTENT so DynamicResource localization keeps working. -->
    <Style x:Key="NavItemButton" TargetType="Button">
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="Transparent" CornerRadius="10" Padding="14,12" Cursor="Hand">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Icon tile stays neutral; the single cyan accent appears only on the
                                 ACTIVE item (see IsActive trigger). No per-item colours. -->
                            <Border x:Name="iconTile" Width="36" Height="36" CornerRadius="10" Margin="0,0,12,0"
                                    Background="Transparent">
                                <TextBlock Text="{TemplateBinding apexControls:NavAssist.Icon}" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource BrandSoft}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource BrandSoft}"/>
                        </Trigger>
                        <Trigger Property="apexControls:NavAssist.IsActive" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource BrandSoft}"/>
                            <Setter TargetName="iconTile" Property="Background" Value="{DynamicResource Brand}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>