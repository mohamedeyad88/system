<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- ══════════════════════════════════════════════════════════════════════════
         APEX PRINTING SYSTEM - COLOR PALETTE
         لوحة الألوان
         ══════════════════════════════════════════════════════════════════════════ -->
    
    <!-- Primary Colors - الألوان الرئيسية -->
    <Color x:Key="Color.Primary">#2563EB</Color>
    <Color x:Key="Color.Primary.Light">#3B82F6</Color>
    <Color x:Key="Color.Primary.Lighter">#60A5FA</Color>
    <Color x:Key="Color.Primary.Lightest">#DBEAFE</Color>
    <Color x:Key="Color.Primary.Dark">#1E40AF</Color>
    
    <!-- Success Colors - ألوان النجاح -->
    <Color x:Key="Color.Success">#10B981</Color>
    <Color x:Key="Color.Success.Light">#34D399</Color>
    <Color x:Key="Color.Success.Dark">#059669</Color>
    
    <!-- Warning Colors - ألوان التحذير -->
    <Color x:Key="Color.Warning">#F59E0B</Color>
    <Color x:Key="Color.Warning.Light">#FBBF24</Color>
    <Color x:Key="Color.Warning.Dark">#D97706</Color>
    
    <!-- Error Colors - ألوان الخطأ -->
    <Color x:Key="Color.Error">#EF4444</Color>
    <Color x:Key="Color.Error.Light">#F87171</Color>
    <Color x:Key="Color.Error.Dark">#DC2626</Color>
    
    <!-- Neutral Colors - الألوان المحايدة -->
    <Color x:Key="Color.Background">#F9FAFB</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.Surface.Elevated">#F3F4F6</Color>
    
    <!-- Text Colors - ألوان النص -->
    <Color x:Key="Color.Text.Primary">#111827</Color>
    <Color x:Key="Color.Text.Secondary">#6B7280</Color>
    <Color x:Key="Color.Text.Disabled">#9CA3AF</Color>
    <Color x:Key="Color.Text.OnPrimary">#FFFFFF</Color>
    
    <!-- Border Colors - ألوان الحدود -->
    <Color x:Key="Color.Border.Light">#E5E7EB</Color>
    <Color x:Key="Color.Border.Medium">#D1D5DB</Color>
    <Color x:Key="Color.Border.Dark">#9CA3AF</Color>
    
    <!-- Sidebar Colors - ألوان الشريط الجانبي -->
    <Color x:Key="Color.Sidebar.Background">#1F2937</Color>
    <Color x:Key="Color.Sidebar.Text">#D1D5DB</Color>
    <Color x:Key="Color.Sidebar.Text.Active">#FFFFFF</Color>
    <Color x:Key="Color.Sidebar.Hover">#374151</Color>
    <Color x:Key="Color.Sidebar.Active">#2563EB</Color>
    
    <!-- Interaction Colors - ألوان التفاعل -->
    <Color x:Key="Color.Hover">#F3F4F6</Color>
    <Color x:Key="Color.Active">#E5E7EB</Color>
    <Color x:Key="Color.Focus">#2563EB</Color>
    <Color x:Key="Color.Disabled">#F3F4F6</Color>
    <Color x:Key="Color.Divider">#E5E7EB</Color>
    
    <!-- ══════════════════════════════════════════════════════════════════════════
         BRUSHES - الفرش
         ══════════════════════════════════════════════════════════════════════════ -->
    
    <!-- Primary Brushes -->
    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}"/>
    <SolidColorBrush x:Key="Brush.Primary.Light" Color="{StaticResource Color.Primary.Light}"/>
    <SolidColorBrush x:Key="Brush.Primary.Lighter" Color="{StaticResource Color.Primary.Lighter}"/>
    <SolidColorBrush x:Key="Brush.Primary.Lightest" Color="{StaticResource Color.Primary.Lightest}"/>
    <SolidColorBrush x:Key="Brush.Primary.Dark" Color="{StaticResource Color.Primary.Dark}"/>
    
    <!-- Success Brushes -->
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}"/>
    <SolidColorBrush x:Key="Brush.Success.Light" Color="{StaticResource Color.Success.Light}"/>
    <SolidColorBrush x:Key="Brush.Success.Dark" Color="{StaticResource Color.Success.Dark}"/>
    
    <!-- Warning Brushes -->
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}"/>
    <SolidColorBrush x:Key="Brush.Warning.Light" Color="{StaticResource Color.Warning.Light}"/>
    <SolidColorBrush x:Key="Brush.Warning.Dark" Color="{StaticResource Color.Warning.Dark}"/>
    
    <!-- Error Brushes -->
    <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Error}"/>
    <SolidColorBrush x:Key="Brush.Error.Light" Color="{StaticResource Color.Error.Light}"/>
    <SolidColorBrush x:Key="Brush.Error.Dark" Color="{StaticResource Color.Error.Dark}"/>
    
    <!-- Surface Brushes -->
    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}"/>
    <SolidColorBrush x:Key="Brush.Surface.Elevated" Color="{StaticResource Color.Surface.Elevated}"/>
    
    <!-- Text Brushes -->
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}"/>
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}"/>
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{StaticResource Color.Text.Disabled}"/>
    <SolidColorBrush x:Key="Brush.Text.OnPrimary" Color="{StaticResource Color.Text.OnPrimary}"/>
    
    <!-- Border Brushes -->
    <SolidColorBrush x:Key="Brush.Border.Light" Color="{StaticResource Color.Border.Light}"/>
    <SolidColorBrush x:Key="Brush.Border.Medium" Color="{StaticResource Color.Border.Medium}"/>
    <SolidColorBrush x:Key="Brush.Border.Dark" Color="{StaticResource Color.Border.Dark}"/>
    
    <!-- Sidebar Brushes -->
    <SolidColorBrush x:Key="Brush.Sidebar.Background" Color="{StaticResource Color.Sidebar.Background}"/>
    <SolidColorBrush x:Key="Brush.Sidebar.Text" Color="{StaticResource Color.Sidebar.Text}"/>
    <SolidColorBrush x:Key="Brush.Sidebar.Text.Active" Color="{StaticResource Color.Sidebar.Text.Active}"/>
    <SolidColorBrush x:Key="Brush.Sidebar.Hover" Color="{StaticResource Color.Sidebar.Hover}"/>
    <SolidColorBrush x:Key="Brush.Sidebar.Active" Color="{StaticResource Color.Sidebar.Active}"/>
    
    <!-- Interaction Brushes -->
    <SolidColorBrush x:Key="Brush.Hover" Color="{StaticResource Color.Hover}"/>
    <SolidColorBrush x:Key="Brush.Active" Color="{StaticResource Color.Active}"/>
    <SolidColorBrush x:Key="Brush.Focus" Color="{StaticResource Color.Focus}"/>
    <SolidColorBrush x:Key="Brush.Disabled" Color="{StaticResource Color.Disabled}"/>
    <SolidColorBrush x:Key="Brush.Divider" Color="{StaticResource Color.Divider}"/>
    
    <!-- Gradient Brushes -->
    <LinearGradientBrush x:Key="Gradient.Card.Hover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#F9FAFB" Offset="1"/>
    </LinearGradientBrush>
    
</ResourceDictionary>
