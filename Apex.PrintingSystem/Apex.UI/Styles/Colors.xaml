<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- ========================================
         PRINT OS - MODERN COLOR SYSTEM
         Eye-friendly, professional color palette
         ======================================== -->
    
    <!-- Background Colors -->
    <SolidColorBrush x:Key="Brush.Background" Color="#F8F9FA"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#2C3E50"/>
    <SolidColorBrush x:Key="Brush.Overlay" Color="#80000000"/>
    
    <!-- Primary Accent Colors -->
    <SolidColorBrush x:Key="Brush.Primary" Color="#3B82F6"/>
    <SolidColorBrush x:Key="Brush.Primary.Dark" Color="#2563EB"/>
    <SolidColorBrush x:Key="Brush.Primary.Light" Color="#60A5FA"/>
    <SolidColorBrush x:Key="Brush.Primary.Lighter" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="Brush.Primary.Lightest" Color="#EFF6FF"/>
    
    <!-- Semantic Colors -->
    <SolidColorBrush x:Key="Brush.Success" Color="#10B981"/>
    <SolidColorBrush x:Key="Brush.Success.Dark" Color="#059669"/>
    <SolidColorBrush x:Key="Brush.Success.Light" Color="#D1FAE5"/>
    
    <SolidColorBrush x:Key="Brush.Warning" Color="#F59E0B"/>
    <SolidColorBrush x:Key="Brush.Warning.Dark" Color="#D97706"/>
    <SolidColorBrush x:Key="Brush.Warning.Light" Color="#FEF3C7"/>
    
    <SolidColorBrush x:Key="Brush.Error" Color="#EF4444"/>
    <SolidColorBrush x:Key="Brush.Error.Dark" Color="#DC2626"/>
    <SolidColorBrush x:Key="Brush.Error.Light" Color="#FEE2E2"/>
    
    <SolidColorBrush x:Key="Brush.Info" Color="#3B82F6"/>
    <SolidColorBrush x:Key="Brush.Info.Light" Color="#DBEAFE"/>
    
    <!-- Text Colors -->
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#1F2937"/>
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#6B7280"/>
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="#9CA3AF"/>
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="#D1D5DB"/>
    <SolidColorBrush x:Key="Brush.Text.OnPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Text.OnDark" Color="#FFFFFF"/>
    
    <!-- Border Colors -->
    <SolidColorBrush x:Key="Brush.Border.Light" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="Brush.Border.Medium" Color="#D1D5DB"/>
    <SolidColorBrush x:Key="Brush.Border.Dark" Color="#9CA3AF"/>
    <SolidColorBrush x:Key="Brush.Divider" Color="#F3F4F6"/>
    
    <!-- State Colors -->
    <SolidColorBrush x:Key="Brush.Hover" Color="#EFF6FF"/>
    <SolidColorBrush x:Key="Brush.Active" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="Brush.Disabled" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="Brush.Focus" Color="#3B82F6"/>
    
    <!-- Surface Variants -->
    <SolidColorBrush x:Key="Brush.Surface.Highlight" Color="#F9FAFB"/>
    <SolidColorBrush x:Key="Brush.Surface.Elevated" Color="#FFFFFF"/>
    
    <!-- Sidebar Colors -->
    <SolidColorBrush x:Key="Brush.Sidebar.Text" Color="#D1D5DB"/>
    <SolidColorBrush x:Key="Brush.Sidebar.Text.Active" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Sidebar.Hover" Color="#34495E"/>
    <SolidColorBrush x:Key="Brush.Sidebar.Active" Color="#3B82F6"/>
    
    <!-- Shadow Effects -->
    <DropShadowEffect x:Key="Shadow.Small" BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.1"/>
    <DropShadowEffect x:Key="Shadow.Medium" BlurRadius="8" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.12"/>
    <DropShadowEffect x:Key="Shadow.Large" BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.15"/>
    <DropShadowEffect x:Key="Shadow.XLarge" BlurRadius="24" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.18"/>
    
    <!-- Glow Effects for Interactive Elements -->
    <DropShadowEffect x:Key="Glow.Primary" BlurRadius="12" ShadowDepth="0" Direction="0" Color="#3B82F6" Opacity="0.4"/>
    <DropShadowEffect x:Key="Glow.Success" BlurRadius="12" ShadowDepth="0" Direction="0" Color="#10B981" Opacity="0.4"/>
    <DropShadowEffect x:Key="Glow.Warning" BlurRadius="12" ShadowDepth="0" Direction="0" Color="#F59E0B" Opacity="0.4"/>
    <DropShadowEffect x:Key="Glow.Error" BlurRadius="12" ShadowDepth="0" Direction="0" Color="#EF4444" Opacity="0.4"/>
    
    <!-- ========================================
         MODERN GRADIENTS
         Premium gradient brushes for enhanced UI
         ======================================== -->
    
    <!-- Primary Gradients -->
    <LinearGradientBrush x:Key="Gradient.Primary" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3B82F6" Offset="0"/>
        <GradientStop Color="#2563EB" Offset="1"/>
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="Gradient.Primary.Vertical" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#60A5FA" Offset="0"/>
        <GradientStop Color="#3B82F6" Offset="1"/>
    </LinearGradientBrush>
    
    <!-- Success Gradients -->
    <LinearGradientBrush x:Key="Gradient.Success" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#10B981" Offset="0"/>
        <GradientStop Color="#059669" Offset="1"/>
    </LinearGradientBrush>
    
    <!-- Warning Gradients -->
    <LinearGradientBrush x:Key="Gradient.Warning" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F59E0B" Offset="0"/>
        <GradientStop Color="#D97706" Offset="1"/>
    </LinearGradientBrush>
    
    <!-- Error Gradients -->
    <LinearGradientBrush x:Key="Gradient.Error" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EF4444" Offset="0"/>
        <GradientStop Color="#DC2626" Offset="1"/>
    </LinearGradientBrush>
    
    <!-- Background Gradients -->
    <LinearGradientBrush x:Key="Gradient.Background.Subtle" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#F9FAFB" Offset="1"/>
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="Gradient.Sidebar" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2C3E50" Offset="0"/>
        <GradientStop Color="#1F2937" Offset="1"/>
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="Gradient.Card.Hover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#F3F4F6" Offset="1"/>
    </LinearGradientBrush>
    
    <!-- ========================================
         LEGACY COMPATIBILITY
         For gradual migration - will be removed
         ======================================== -->
    
    <SolidColorBrush x:Key="AccentBlue" Color="#3B82F6"/>
    <SolidColorBrush x:Key="AccentGreen" Color="#10B981"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#1F2937"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#6B7280"/>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBg" Color="#FFFFFF"/>
    
</ResourceDictionary>
