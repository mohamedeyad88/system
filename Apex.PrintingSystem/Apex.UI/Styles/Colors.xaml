<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════════════════════════════════════════════════════════════════════
         LEGACY PALETTE — what is left of it.

         The app's colours live in Brand.xaml. This file used to be a second, parallel
         palette of 188 keys, flipped from dark to light by search-and-replace, so many names
         said the opposite of their value: a Slate scale where 100 was near-black and 800 was
         white, "Dark.*" keys holding light colours, an "Elevated" surface darker than the
         surface under it, and whole purple / pink / orange ramps nothing used.

         Every screen now reads Brand.xaml tokens. The only keys kept below are still
         referenced, and each is kept on purpose — see the note beside it. Do not add new
         colours here; add a token to Brand.xaml.
         ══════════════════════════════════════════════════════════════════════════ -->

    <!-- Screen title style, referenced by Theme.xaml, Controls.xaml and GlobalStyles.xaml. -->
    <Style x:Key="Text.PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#14181D"/>
    </Style>

    <!-- Disabled states. Deliberately NOT mapped to a readable token: a disabled control has
         to look disabled, and WCAG exempts it from the text-contrast minimum. -->
    <Color x:Key="Color.Text.Disabled">#B7B2A8</Color>
    <Color x:Key="Color.Disabled">#DDD9D3</Color>
    <Color x:Key="Color.Active">#B7B2A8</Color>
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{StaticResource Color.Text.Disabled}"/>
    <SolidColorBrush x:Key="Brush.Disabled" Color="{StaticResource Color.Disabled}"/>
    <SolidColorBrush x:Key="Brush.Active" Color="{StaticResource Color.Active}"/>

</ResourceDictionary>