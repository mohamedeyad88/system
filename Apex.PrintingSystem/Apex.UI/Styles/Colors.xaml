<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- ══════════════════════════════════════════════════════════════════════════
         APEX PRINTING SYSTEM - UNIFIED COLOR PALETTE
         لوحة الألوان الموحدة
         ══════════════════════════════════════════════════════════════════════════ -->
    
    <!-- ═══════════════════════════════════════════════════════════════════
         TEXT STYLES - MUST BE FIRST to ensure availability for StaticResource
         ═══════════════════════════════════════════════════════════════════ -->
    <Style x:Key="Text.PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#14181D"/>
    </Style>
    
    <!-- ═══════════════════════════════════════════════════════════════════
         🎨 PRIMARY BRAND COLORS - الألوان الرئيسية للعلامة التجارية
         ═══════════════════════════════════════════════════════════════════ -->
    <Color x:Key="Color.Primary">#0891B2</Color>
    <Color x:Key="Color.Primary.Light">#06B6D4</Color>
    <Color x:Key="Color.Primary.Lighter">#22D3EE</Color>
    <Color x:Key="Color.Primary.Lightest">#E6F3F6</Color>
    <Color x:Key="Color.Primary.Dark">#0E7490</Color>
    <Color x:Key="Color.Primary.Darkest">#0E7490</Color>
    
    <!-- ═══════════════════════════════════════════════════════════════════
         ✅ SUCCESS COLORS - ألوان النجاح
         ═══════════════════════════════════════════════════════════════════ -->
    <Color x:Key="Color.Success">#1B7F4C</Color>
    <Color x:Key="Color.Success.Light">#1B7F4C</Color>
    <Color x:Key="Color.Success.Lighter">#E7F3EC</Color>
    <Color x:Key="Color.Success.Dark">#1B7F4C</Color>
    <Color x:Key="Color.Success.Darkest">#0F5A34</Color>
    
    <!-- ═══════════════════════════════════════════════════════════════════
         ⚠️ WARNING COLORS - ألوان التحذير
         ═══════════════════════════════════════════════════════════════════ -->
    <Color x:Key="Color.Warning">#E08A00</Color>
    <Color x:Key="Color.Warning.Light">#E08A00</Color>
    <Color x:Key="Color.Warning.Lighter">#FDF1DC</Color>
    <Color x:Key="Color.Warning.Dark">#C2410C</Color>
    <Color x:Key="Color.Warning.Darkest">#B45309</Color>
    
    <!-- ═══════════════════════════════════════════════════════════════════
         ❌ ERROR COLORS - ألوان الخطأ
         ═══════════════════════════════════════════════════════════════════ -->
    <Color x:Key="Color.Error">#B42318</Color>
    <Color x:Key="Color.Error.Light">#B42318</Color>
    <Color x:Key="Color.Error.Lighter">#F6E4E2</Color>
    <Color x:Key="Color.Error.Dark">#B42318</Color>
    <Color x:Key="Color.Error.Darkest">#B91C1C</Color>
    
    <!-- ═══════════════════════════════════════════════════════════════════
         💜 ACCENT COLORS - ألوان إضافية
         ═══════════════════════════════════════════════════════════════════ -->
    <Color x:Key="Color.Purple">#7C3AED</Color>
    <Color x:Key="Color.Purple.Light">#A78BFA</Color>
    <Color x:Key="Color.Purple.Lighter">#EDE9FE</Color>
    <Color x:Key="Color.Purple.Dark">#6D28D9</Color>

    <Color x:Key="Color.Cyan">#06B6D4</Color>
    <Color x:Key="Color.Cyan.Light">#22D3EE</Color>
    <Color x:Key="Color.Cyan.Lighter">#CFFAFE</Color>
    <Color x:Key="Color.Cyan.Dark">#0891B2</Color>

    <Color x:Key="Color.Pink">#EC4899</Color>
    <Color x:Key="Color.Pink.Light">#F472B6</Color>
    <Color x:Key="Color.Pink.Lighter">#FCE7F3</Color>

    <!-- ═══════════════════════════════════════════════════════════════════
         🟠 ORANGE COLORS - ألوان البرتقالي
         ═══════════════════════════════════════════════════════════════════ -->
    <Color x:Key="Color.Orange">#F97316</Color>
    <Color x:Key="Color.Orange.Light">#FB923C</Color>
    <Color x:Key="Color.Orange.Lighter">#FFEDD5</Color>
    <Color x:Key="Color.Orange.Dark">#EA580C</Color>
    <Color x:Key="Color.Orange.Darkest">#C2410C</Color>
    
    <!-- ═══════════════════════════════════════════════════════════════════
         🎨 NEUTRAL / SLATE COLORS - الألوان المحايدة
         ═══════════════════════════════════════════════════════════════════ -->
    <Color x:Key="Color.Slate.50">#F8FAFC</Color>
    <Color x:Key="Color.Slate.100">#14181D</Color>
    <Color x:Key="Color.Slate.200">#14181D</Color>
    <Color x:Key="Color.Slate.300">#334155</Color>
    <Color x:Key="Color.Slate.400">#6B6864</Color>
    <Color x:Key="Color.Slate.500">#8A8783</Color>
    <Color x:Key="Color.Slate.600">#B7B2A8</Color>
    <Color x:Key="Color.Slate.700">#DDD9D3</Color>
    <Color x:Key="Color.Slate.800">#FFFFFF</Color>
    <Color x:Key="Color.Slate.900">#FAF9F7</Color>
    
    <!-- ═══════════════════════════════════════════════════════════════════
         📄 SURFACE COLORS - Dark Mode
         ═══════════════════════════════════════════════════════════════════ -->
    <Color x:Key="Color.Background">#FAF9F7</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.Surface.Elevated">#DDD9D3</Color>
    <Color x:Key="Color.Surface.Sunken">#F4F2EF</Color>
    <!-- Semantic status SURFACES (dark banner backgrounds for success/error notices) -->
    <Color x:Key="Color.Success.Surface">#052E16</Color>
    <Color x:Key="Color.Error.Surface">#450A0A</Color>
    <Color x:Key="Color.Surface.Overlay">#00000080</Color>
    
    <!-- ═══════════════════════════════════════════════════════════════════
         🌙 DARK MODE COLORS - ألوان الوضع الداكن
         ═══════════════════════════════════════════════════════════════════ -->
    <Color x:Key="Color.Dark.Background">#FAF9F7</Color>
    <Color x:Key="Color.Dark.Surface">#FFFFFF</Color>
    <Color x:Key="Color.Dark.Surface.Elevated">#DDD9D3</Color>
    <Color x:Key="Color.Dark.Border">#DDD9D3</Color>
    <Color x:Key="Color.Dark.Border.Light">#B7B2A8</Color>
    <Color x:Key="Color.Dark.Text.Primary">#FFFFFF</Color>
    <Color x:Key="Color.Dark.Text.Secondary">#6B6864</Color>
    <Color x:Key="Color.Dark.Text.Muted">#8A8783</Color>
    
    <!-- ═══════════════════════════════════════════════════════════════════
         📝 TEXT COLORS - ألوان النص
         ═══════════════════════════════════════════════════════════════════ -->
    <Color x:Key="Color.Text.Primary">#14181D</Color>
    <Color x:Key="Color.Text.Secondary">#6B6864</Color>
    <Color x:Key="Color.Text.Tertiary">#8A8783</Color>
    <Color x:Key="Color.Text.Disabled">#B7B2A8</Color>
    <Color x:Key="Color.Text.OnPrimary">#FFFFFF</Color>
    <Color x:Key="Color.Text.OnDark">#F8FAFC</Color>
    
    <!-- ═══════════════════════════════════════════════════════════════════
         🔲 BORDER COLORS - ألوان الحدود
         ═══════════════════════════════════════════════════════════════════ -->
    <Color x:Key="Color.Border.Light">#DDD9D3</Color>
    <Color x:Key="Color.Border.Medium">#B7B2A8</Color>
    <Color x:Key="Color.Border.Dark">#8A8783</Color>
    <Color x:Key="Color.Border.Focus">#0891B2</Color>
    
    <!-- ═══════════════════════════════════════════════════════════════════
         📱 SIDEBAR COLORS - ألوان الشريط الجانبي
         ═══════════════════════════════════════════════════════════════════ -->
    <Color x:Key="Color.Sidebar.Background">#FFFFFF</Color>
    <Color x:Key="Color.Sidebar.Header">#FAF9F7</Color>
    <Color x:Key="Color.Sidebar.Text">#6B6864</Color>
    <Color x:Key="Color.Sidebar.Text.Active">#FFFFFF</Color>
    <Color x:Key="Color.Sidebar.Hover">#DDD9D3</Color>
    <Color x:Key="Color.Sidebar.Active">#0891B2</Color>
    <Color x:Key="Color.Sidebar.Divider">#DDD9D3</Color>
    
    <!-- ═══════════════════════════════════════════════════════════════════
         🖱️ INTERACTION COLORS - ألوان التفاعل
         ═══════════════════════════════════════════════════════════════════ -->
    <Color x:Key="Color.Hover">#DDD9D3</Color>
    <Color x:Key="Color.Active">#B7B2A8</Color>
    <Color x:Key="Color.Focus">#0891B2</Color>
    <Color x:Key="Color.Disabled">#DDD9D3</Color>
    <Color x:Key="Color.Divider">#DDD9D3</Color>
    
    <!-- ══════════════════════════════════════════════════════════════════════════
         SOLID COLOR BRUSHES - الفرش الصلبة
         ══════════════════════════════════════════════════════════════════════════ -->
    
    <!-- Primary Brushes -->
    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}"/>
    <SolidColorBrush x:Key="Brush.Primary.Light" Color="{StaticResource Color.Primary.Light}"/>
    <SolidColorBrush x:Key="Brush.Primary.Lighter" Color="{StaticResource Color.Primary.Lighter}"/>
    <SolidColorBrush x:Key="Brush.Primary.Lightest" Color="{StaticResource Color.Primary.Lightest}"/>
    <SolidColorBrush x:Key="Brush.Primary.Dark" Color="{StaticResource Color.Primary.Dark}"/>
    <SolidColorBrush x:Key="Brush.Primary.Darkest" Color="{StaticResource Color.Primary.Darkest}"/>
    
    <!-- Success Brushes -->
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}"/>
    <SolidColorBrush x:Key="Brush.Success.Light" Color="{StaticResource Color.Success.Light}"/>
    <SolidColorBrush x:Key="Brush.Success.Lighter" Color="{StaticResource Color.Success.Lighter}"/>
    <SolidColorBrush x:Key="Brush.Success.Dark" Color="{StaticResource Color.Success.Dark}"/>
    
    <!-- Warning Brushes -->
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}"/>
    <SolidColorBrush x:Key="Brush.Warning.Light" Color="{StaticResource Color.Warning.Light}"/>
    <SolidColorBrush x:Key="Brush.Warning.Lighter" Color="{StaticResource Color.Warning.Lighter}"/>
    <SolidColorBrush x:Key="Brush.Warning.Dark" Color="{StaticResource Color.Warning.Dark}"/>
    
    <!-- Error Brushes -->
    <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Error}"/>
    <SolidColorBrush x:Key="Brush.Error.Light" Color="{StaticResource Color.Error.Light}"/>
    <SolidColorBrush x:Key="Brush.Error.Lighter" Color="{StaticResource Color.Error.Lighter}"/>
    <SolidColorBrush x:Key="Brush.Error.Dark" Color="{StaticResource Color.Error.Dark}"/>
    
    <!-- Accent Brushes -->
    <SolidColorBrush x:Key="Brush.Purple" Color="{StaticResource Color.Purple}"/>
    <SolidColorBrush x:Key="Brush.Purple.Light" Color="{StaticResource Color.Purple.Light}"/>
    <SolidColorBrush x:Key="Brush.Purple.Lighter" Color="{StaticResource Color.Purple.Lighter}"/>
    <SolidColorBrush x:Key="Brush.Cyan" Color="{StaticResource Color.Cyan}"/>
    <SolidColorBrush x:Key="Brush.Cyan.Light" Color="{StaticResource Color.Cyan.Light}"/>
    <SolidColorBrush x:Key="Brush.Cyan.Lighter" Color="{StaticResource Color.Cyan.Lighter}"/>
    <SolidColorBrush x:Key="Brush.Cyan.Dark" Color="{StaticResource Color.Cyan.Dark}"/>
    <SolidColorBrush x:Key="Brush.Pink" Color="{StaticResource Color.Pink}"/>
    <SolidColorBrush x:Key="Brush.Pink.Lighter" Color="{StaticResource Color.Pink.Lighter}"/>

    <!-- Orange Brushes -->
    <SolidColorBrush x:Key="Brush.Orange" Color="{StaticResource Color.Orange}"/>
    <SolidColorBrush x:Key="Brush.Orange.Light" Color="{StaticResource Color.Orange.Light}"/>
    <SolidColorBrush x:Key="Brush.Orange.Lighter" Color="{StaticResource Color.Orange.Lighter}"/>
    <SolidColorBrush x:Key="Brush.Orange.Dark" Color="{StaticResource Color.Orange.Dark}"/>
    
    <!-- Slate Brushes -->
    <SolidColorBrush x:Key="Brush.Slate.50" Color="{StaticResource Color.Slate.50}"/>
    <SolidColorBrush x:Key="Brush.Slate.100" Color="{StaticResource Color.Slate.100}"/>
    <SolidColorBrush x:Key="Brush.Slate.200" Color="{StaticResource Color.Slate.200}"/>
    <SolidColorBrush x:Key="Brush.Slate.300" Color="{StaticResource Color.Slate.300}"/>
    <SolidColorBrush x:Key="Brush.Slate.400" Color="{StaticResource Color.Slate.400}"/>
    <SolidColorBrush x:Key="Brush.Slate.500" Color="{StaticResource Color.Slate.500}"/>
    <SolidColorBrush x:Key="Brush.Slate.600" Color="{StaticResource Color.Slate.600}"/>
    <SolidColorBrush x:Key="Brush.Slate.700" Color="{StaticResource Color.Slate.700}"/>
    <SolidColorBrush x:Key="Brush.Slate.800" Color="{StaticResource Color.Slate.800}"/>
    <SolidColorBrush x:Key="Brush.Slate.900" Color="{StaticResource Color.Slate.900}"/>
    
    <!-- Surface Brushes -->
    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}"/>
    <SolidColorBrush x:Key="Brush.Surface.Elevated" Color="{StaticResource Color.Surface.Elevated}"/>
    <SolidColorBrush x:Key="Brush.Surface.Sunken" Color="{StaticResource Color.Surface.Sunken}"/>
    <SolidColorBrush x:Key="Brush.Success.Surface" Color="{StaticResource Color.Success.Surface}"/>
    <SolidColorBrush x:Key="Brush.Error.Surface" Color="{StaticResource Color.Error.Surface}"/>
    <SolidColorBrush x:Key="Brush.Surface.Overlay" Color="{StaticResource Color.Surface.Overlay}"/>
    
    <!-- Text Brushes -->
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}"/>
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}"/>
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="{StaticResource Color.Text.Tertiary}"/>
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{StaticResource Color.Text.Disabled}"/>

    <!--
        A step you have not reached yet is NOT a disabled control — it is information
        about where the workflow goes next, and it has to be readable. Painted with
        Text.Disabled (#B7B2A8) it measured 1.93:1 against the stepper background,
        against the 4.5:1 that small text needs to be legible at all. #6B6864 measures
        5.71:1 while still sitting clearly behind the active step.
    -->
    <SolidColorBrush x:Key="Brush.Text.StepInactive" Color="#6B6864"/>
    <SolidColorBrush x:Key="Brush.Text.OnPrimary" Color="{StaticResource Color.Text.OnPrimary}"/>
    <SolidColorBrush x:Key="Brush.Text.OnDark" Color="{StaticResource Color.Text.OnDark}"/>
    
    <!-- Border Brushes -->
    <SolidColorBrush x:Key="Brush.Border.Light" Color="{StaticResource Color.Border.Light}"/>
    <SolidColorBrush x:Key="Brush.Border.Medium" Color="{StaticResource Color.Border.Medium}"/>
    <SolidColorBrush x:Key="Brush.Border.Dark" Color="{StaticResource Color.Border.Dark}"/>
    <SolidColorBrush x:Key="Brush.Border.Focus" Color="{StaticResource Color.Border.Focus}"/>
    
    <!-- Sidebar Brushes -->
    <SolidColorBrush x:Key="Brush.Sidebar.Background" Color="{StaticResource Color.Sidebar.Background}"/>
    <SolidColorBrush x:Key="Brush.Sidebar.Header" Color="{StaticResource Color.Sidebar.Header}"/>
    <SolidColorBrush x:Key="Brush.Sidebar.Text" Color="{StaticResource Color.Sidebar.Text}"/>
    <SolidColorBrush x:Key="Brush.Sidebar.Text.Active" Color="{StaticResource Color.Sidebar.Text.Active}"/>
    <SolidColorBrush x:Key="Brush.Sidebar.Hover" Color="{StaticResource Color.Sidebar.Hover}"/>
    <SolidColorBrush x:Key="Brush.Sidebar.Active" Color="{StaticResource Color.Sidebar.Active}"/>
    <SolidColorBrush x:Key="Brush.Sidebar.Divider" Color="{StaticResource Color.Sidebar.Divider}"/>
    
    <!-- Interaction Brushes -->
    <SolidColorBrush x:Key="Brush.Hover" Color="{StaticResource Color.Hover}"/>
    <SolidColorBrush x:Key="Brush.Active" Color="{StaticResource Color.Active}"/>
    <SolidColorBrush x:Key="Brush.Focus" Color="{StaticResource Color.Focus}"/>
    <SolidColorBrush x:Key="Brush.Disabled" Color="{StaticResource Color.Disabled}"/>
    <SolidColorBrush x:Key="Brush.Divider" Color="{StaticResource Color.Divider}"/>
    
    <!-- Dark Mode Brushes -->
    <SolidColorBrush x:Key="Brush.Dark.Background" Color="{StaticResource Color.Dark.Background}"/>
    <SolidColorBrush x:Key="Brush.Dark.Surface" Color="{StaticResource Color.Dark.Surface}"/>
    <SolidColorBrush x:Key="Brush.Dark.Surface.Elevated" Color="{StaticResource Color.Dark.Surface.Elevated}"/>
    <SolidColorBrush x:Key="Brush.Dark.Border" Color="{StaticResource Color.Dark.Border}"/>
    <SolidColorBrush x:Key="Brush.Dark.Border.Light" Color="{StaticResource Color.Dark.Border.Light}"/>
    <SolidColorBrush x:Key="Brush.Dark.Text.Primary" Color="{StaticResource Color.Dark.Text.Primary}"/>
    <SolidColorBrush x:Key="Brush.Dark.Text.Secondary" Color="{StaticResource Color.Dark.Text.Secondary}"/>
    <SolidColorBrush x:Key="Brush.Dark.Text.Muted" Color="{StaticResource Color.Dark.Text.Muted}"/>
    
    <!-- ══════════════════════════════════════════════════════════════════════════
         GRADIENT BRUSHES - الفرش المتدرجة
         ══════════════════════════════════════════════════════════════════════════ -->
    
    <!-- ── Light-mode Card Gradients (legacy / light UI use) ──────────── -->
    <LinearGradientBrush x:Key="Gradient.Card.Blue" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EFF6FF" Offset="0"/>
        <GradientStop Color="#E6F3F6" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Gradient.Card.Green" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#ECFDF5" Offset="0"/>
        <GradientStop Color="#E7F3EC" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Gradient.Card.Yellow" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFBEB" Offset="0"/>
        <GradientStop Color="#FDF1DC" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Gradient.Card.Red" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FEF2F2" Offset="0"/>
        <GradientStop Color="#F6E4E2" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Gradient.Card.Purple" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F5F3FF" Offset="0"/>
        <GradientStop Color="#EDE9FE" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Gradient.Card.Cyan" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#ECFEFF" Offset="0"/>
        <GradientStop Color="#CFFAFE" Offset="1"/>
    </LinearGradientBrush>

    <!-- ── Dark-mode Card Gradients (for #FAF9F7 background) ─────────── -->
    <LinearGradientBrush x:Key="Gradient.Card.Blue.Dark" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#E6F3F6" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Gradient.Card.Green.Dark" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#14342B" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Gradient.Card.Red.Dark" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#3B1A1A" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Gradient.Card.Purple.Dark" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#2D1B4E" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Gradient.Card.Orange.Dark" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#3B2210" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Gradient.Card.Cyan.Dark" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#0F2E35" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Gradient.Card.Yellow.Dark" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#2D2008" Offset="1"/>
    </LinearGradientBrush>

    <!-- ── Button Gradients ───────────────────────────────────────────── -->
    <LinearGradientBrush x:Key="Gradient.Button.Primary" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#06B6D4" Offset="0"/>
        <GradientStop Color="#0891B2" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Gradient.Button.Success" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1B7F4C" Offset="0"/>
        <GradientStop Color="#1B7F4C" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Gradient.Button.Purple" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#A78BFA" Offset="0"/>
        <GradientStop Color="#7C3AED" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Gradient.Button.Warning" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FB923C" Offset="0"/>
        <GradientStop Color="#F97316" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Gradient.Button.Danger" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#B42318" Offset="0"/>
        <GradientStop Color="#B42318" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Gradient.Button.Cyan" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#22D3EE" Offset="0"/>
        <GradientStop Color="#06B6D4" Offset="1"/>
    </LinearGradientBrush>

    <!-- ── Header / Layout Gradients ─────────────────────────────────── -->
    <LinearGradientBrush x:Key="Gradient.Header.Dark" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#DDD9D3" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Gradient.Sidebar" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#FAF9F7" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Gradient.Dashboard.Header" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#FAF9F7" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Gradient.Dashboard.Blue" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E6F3F6" Offset="0"/>
        <GradientStop Color="#FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Gradient.Dashboard.Green" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#14342B" Offset="0"/>
        <GradientStop Color="#FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    
</ResourceDictionary>
