<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- ══════════════════════════════════════════════════════════════════════════
         APEX PRINTING SYSTEM - ANIMATIONS
         الرسوم المتحركة والتأثيرات الانتقالية
         ══════════════════════════════════════════════════════════════════════════ -->
    
    <!-- ==================== FADE ANIMATIONS - رسوم التلاشي ==================== -->
    
    <!-- Fade In -->
    <Storyboard x:Key="Anim.FadeIn">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                        From="0.0" To="1.0" 
                        Duration="0:0:0.3">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>
    
    <!-- Fade Out -->
    <Storyboard x:Key="Anim.FadeOut">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                        From="1.0" To="0.0" 
                        Duration="0:0:0.3">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseIn"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>
    
    <!-- Fast Fade In (for quick interactions) -->
    <Storyboard x:Key="Anim.FadeIn.Fast">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                        From="0.0" To="1.0" 
                        Duration="0:0:0.15"/>
    </Storyboard>
    
    <!-- Fast Fade Out -->
    <Storyboard x:Key="Anim.FadeOut.Fast">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                        From="1.0" To="0.0" 
                        Duration="0:0:0.15"/>
    </Storyboard>
    
    <!-- ==================== SLIDE ANIMATIONS - رسوم الانزلاق ==================== -->
    
    <!-- Slide Up (with Fade) -->
    <Storyboard x:Key="Anim.SlideUp">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                        From="0.0" To="1.0" 
                        Duration="0:0:0.4"/>
        <ThicknessAnimation Storyboard.TargetProperty="Margin" 
                           From="0,20,0,0" To="0" 
                           Duration="0:0:0.4">
            <ThicknessAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut"/>
            </ThicknessAnimation.EasingFunction>
        </ThicknessAnimation>
    </Storyboard>
    
    <!-- Slide Down (with Fade) -->
    <Storyboard x:Key="Anim.SlideDown">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                        From="0.0" To="1.0" 
                        Duration="0:0:0.4"/>
        <ThicknessAnimation Storyboard.TargetProperty="Margin" 
                           From="0,-20,0,0" To="0" 
                           Duration="0:0:0.4">
            <ThicknessAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut"/>
            </ThicknessAnimation.EasingFunction>
        </ThicknessAnimation>
    </Storyboard>
    
    <!-- Slide In From Left -->
    <Storyboard x:Key="Anim.SlideInLeft">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                        From="0.0" To="1.0" 
                        Duration="0:0:0.4"/>
        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(TranslateTransform.X)" 
                        From="-50" To="0" 
                        Duration="0:0:0.4">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>
    
    <!-- Slide In From Right -->
    <Storyboard x:Key="Anim.SlideInRight">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                        From="0.0" To="1.0" 
                        Duration="0:0:0.4"/>
        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(TranslateTransform.X)" 
                        From="50" To="0" 
                        Duration="0:0:0.4">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>
    
    <!-- ==================== SCALE ANIMATIONS - رسوم التكبير/التصغير ==================== -->
    
    <!-- Scale Up (Zoom In) -->
    <Storyboard x:Key="Anim.ScaleUp">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                        From="0.0" To="1.0" 
                        Duration="0:0:0.3"/>
        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)" 
                        From="0.8" To="1.0" 
                        Duration="0:0:0.3">
            <DoubleAnimation.EasingFunction>
                <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)" 
                        From="0.8" To="1.0" 
                        Duration="0:0:0.3">
            <DoubleAnimation.EasingFunction>
                <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>
    
    <!-- Scale Down (Zoom Out) -->
    <Storyboard x:Key="Anim.ScaleDown">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                        From="1.0" To="0.0" 
                        Duration="0:0:0.25"/>
        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)" 
                        From="1.0" To="0.8" 
                        Duration="0:0:0.25">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseIn"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)" 
                        From="1.0" To="0.8" 
                        Duration="0:0:0.25">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseIn"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>
    
    <!-- Bounce Scale (for success feedback) -->
    <Storyboard x:Key="Anim.Bounce">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)">
            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
            <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="1.1"/>
            <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0.95"/>
            <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="1.0"/>
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)">
            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
            <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="1.1"/>
            <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0.95"/>
            <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="1.0"/>
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>
    
    <!-- Pulse (for attention) -->
    <Storyboard x:Key="Anim.Pulse" RepeatBehavior="3x">
        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)" 
                        From="1.0" To="1.05" AutoReverse="True"
                        Duration="0:0:0.3">
            <DoubleAnimation.EasingFunction>
                <SineEase EasingMode="EaseInOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)" 
                        From="1.0" To="1.05" AutoReverse="True"
                        Duration="0:0:0.3">
            <DoubleAnimation.EasingFunction>
                <SineEase EasingMode="EaseInOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>
    
    <!-- ==================== CARD ELEVATION ANIMATIONS - رسوم ارتفاع البطاقات ==================== -->
    
    <!-- Elevate Card (on hover) -->
    <Storyboard x:Key="Anim.Elevate">
        <ThicknessAnimation Storyboard.TargetProperty="Margin" 
                           To="0,-2,0,2" 
                           Duration="0:0:0.2">
            <ThicknessAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut"/>
            </ThicknessAnimation.EasingFunction>
        </ThicknessAnimation>
    </Storyboard>
    
    <!-- Lower Card (remove hover) -->
    <Storyboard x:Key="Anim.Lower">
        <ThicknessAnimation Storyboard.TargetProperty="Margin" 
                           To="0" 
                           Duration="0:0:0.2">
            <ThicknessAnimation.EasingFunction>
                <CubicEase EasingMode="EaseIn"/>
            </ThicknessAnimation.EasingFunction>
        </ThicknessAnimation>
    </Storyboard>
    
    <!-- ==================== ROTATION ANIMATIONS - رسوم الدوران ==================== -->
    
    <!-- Spin (for loading indicators) -->
    <Storyboard x:Key="Anim.Spin" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(RotateTransform.Angle)" 
                        From="0" To="360" 
                        Duration="0:0:1"/>
    </Storyboard>
    
    <!-- Rotate 180 (for toggle icons) -->
    <Storyboard x:Key="Anim.Rotate180">
        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(RotateTransform.Angle)" 
                        From="0" To="180" 
                        Duration="0:0:0.3">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseInOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>
    
    <!-- Rotate Back (for toggle icons) -->
    <Storyboard x:Key="Anim.RotateBack">
        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(RotateTransform.Angle)" 
                        From="180" To="0" 
                        Duration="0:0:0.3">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseInOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>
    
    <!-- ==================== SHAKE ANIMATIONS - رسوم الاهتزاز ==================== -->
    
    <!-- Shake (for error feedback) -->
    <Storyboard x:Key="Anim.Shake">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(RenderTransform).(TranslateTransform.X)">
            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
            <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="-10"/>
            <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="10"/>
            <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="-10"/>
            <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="10"/>
            <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="0"/>
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>
    
    <!-- ==================== COLOR ANIMATIONS - رسوم الألوان ==================== -->
    
    <!-- Flash Success (background highlight) -->
    <Storyboard x:Key="Anim.FlashSuccess">
        <ColorAnimation Storyboard.TargetProperty="(Panel.Background).(SolidColorBrush.Color)" 
                       To="#10B981" 
                       Duration="0:0:0.2" 
                       AutoReverse="True"/>
    </Storyboard>
    
    <!-- Flash Error (background highlight) -->
    <Storyboard x:Key="Anim.FlashError">
        <ColorAnimation Storyboard.TargetProperty="(Panel.Background).(SolidColorBrush.Color)" 
                       To="#EF4444" 
                       Duration="0:0:0.2" 
                       AutoReverse="True"/>
    </Storyboard>
    
    <!-- ==================== LEGACY ALIASES - للتوافق مع الإصدارات السابقة ==================== -->
    
    <Storyboard x:Key="FadeInAnimation">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.3"/>
    </Storyboard>
    
    <Storyboard x:Key="FadeOutAnimation">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.0" Duration="0:0:0.3"/>
    </Storyboard>
    
    <Storyboard x:Key="SlideUpAnimation">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.4"/>
        <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,20,0,0" To="0" Duration="0:0:0.4"/>
    </Storyboard>
    
    <Storyboard x:Key="ElevateCard">
        <ThicknessAnimation Storyboard.TargetProperty="Margin" To="0,-2,0,2" Duration="0:0:0.2"/>
    </Storyboard>
    
    <Storyboard x:Key="LowerCard">
        <ThicknessAnimation Storyboard.TargetProperty="Margin" To="0" Duration="0:0:0.2"/>
    </Storyboard>

</ResourceDictionary>
