<Window x:Class="Apex.AdminTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Apex.AdminTool"
        Title="Apex License Tool — أداة إصدار التراخيص"
        Height="780" Width="960"
        MinHeight="700" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI">

    <Window.Resources>
        <local:InverseBoolConverter        x:Key="InvBool"/>
        <local:StringToVisibilityConverter x:Key="StrToVis"/>
        <!-- Prevent DatePicker calendar popup from inheriting RTL on columns -->
        <Style TargetType="CalendarDayButton">
            <Setter Property="Foreground" Value="#E2E8F0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="AppIcon.png" Width="38" Height="38" Margin="0,0,12,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Apex Print OS" FontSize="18" FontWeight="Bold"
                                   Foreground="#F1F5F9"/>
                        <TextBlock Text="أداة إصدار التراخيص" FontSize="11"
                                   Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="2" Background="#1E3A5F" CornerRadius="20"
                        Padding="14,6" VerticalAlignment="Center">
                    <TextBlock Text="v1.0.0  |  Internal Tool" FontSize="11"
                               Foreground="#60A5FA" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ MAIN CONTENT ═══ -->
        <TabControl Grid.Row="1" Background="#0F172A"
                    BorderBrush="#334155" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Padding" Value="20,12"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder" Background="Transparent"
                                        BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="#3B82F6"/>
                                        <Setter Property="Foreground" Value="#F1F5F9"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#CBD5E1"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- ─── TAB 1: إنشاء ترخيص ─── -->
            <TabItem Header="🔑  إنشاء ترخيص">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="24,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="320"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: Form -->
                        <StackPanel Grid.Column="0">

                            <!-- Device ID Card -->
                            <Border Background="#1E293B" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="رقم الجهاز  (Device ID)" FontSize="12"
                                               Foreground="#64748B" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding DeviceId, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="38"
                                                 FontFamily="Consolas"
                                                 FontSize="13"/>
                                        <Button Grid.Column="2" Content="📋  لصق"
                                                Height="38" Padding="14,0"
                                                Background="#334155" Foreground="#E2E8F0"
                                                BorderThickness="0" Cursor="Hand"
                                                Click="PasteDeviceId_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#475569"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="أدخل الرقم كما يظهر في قسم الترخيص بالتطبيق"
                                               FontSize="11" Foreground="#475569" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Customer Info Card -->
                            <Border Background="#1E293B" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="بيانات العميل" FontSize="14" FontWeight="SemiBold"
                                               Foreground="#F1F5F9" Margin="0,0,0,14"/>

                                    <!-- Customer Name -->
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="اسم العميل / المطبعة" FontSize="12"
                                                   Foreground="#64748B" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="38"/>
                                    </StackPanel>

                                    <!-- Order Reference -->
                                    <StackPanel>
                                        <TextBlock Text="رقم الطلب / الفاتورة (اختياري)" FontSize="12"
                                                   Foreground="#64748B" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding OrderRef, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="38"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- License Settings Card -->
                            <Border Background="#1E293B" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="إعدادات الترخيص" FontSize="14" FontWeight="SemiBold"
                                               Foreground="#F1F5F9" Margin="0,0,0,14"/>

                                    <!-- Type -->
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="نوع الترخيص" FontSize="12"
                                                   Foreground="#64748B" Margin="0,0,0,6"/>
                                        <ComboBox SelectedIndex="{Binding LicenseTypeIndex}">
                                            <ComboBoxItem Content="Full — النسخة الكاملة"/>
                                            <ComboBoxItem Content="Pro  — النسخة الاحترافية"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Expiry -->
                                    <StackPanel>
                                        <TextBlock Text="تاريخ الانتهاء" FontSize="12"
                                                   Foreground="#64748B" Margin="0,0,0,6"/>
                                        <DatePicker SelectedDate="{Binding ExpiryDate}"
                                                    FlowDirection="LeftToRight"/>

                                        <!-- Quick buttons -->
                                        <WrapPanel Margin="0,8,0,0">
                                            <WrapPanel.Resources>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#1E3A5F"/>
                                                    <Setter Property="Foreground" Value="#60A5FA"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Padding" Value="10,5"/>
                                                    <Setter Property="Margin" Value="0,0,6,6"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="FontSize" Value="11"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        CornerRadius="4"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#1D4ED8"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </WrapPanel.Resources>
                                            <Button Content="30 يوم"  Command="{Binding SetExpiry30Command}"/>
                                            <Button Content="90 يوم"  Command="{Binding SetExpiry90Command}"/>
                                            <Button Content="6 أشهر" Command="{Binding SetExpiry180Command}"/>
                                            <Button Content="سنة"    Command="{Binding SetExpiry1YCommand}"/>
                                            <Button Content="سنتان"  Command="{Binding SetExpiry2YCommand}"/>
                                            <Button Content="♾ دائم" Command="{Binding SetPerpetualCommand}"
                                                    Background="#1A2E1A" Foreground="#4ADE80"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Generate Button -->
                            <Button Command="{Binding GenerateLicenseCommand}"
                                    Height="52" Cursor="Hand"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"
                                    Margin="0,0,0,16">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" CornerRadius="10">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#2563EB" Offset="0"/>
                                                    <GradientStop Color="#1D4ED8" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔐" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="إنشاء ملف الترخيص  (.apex)"
                                               FontSize="15" FontWeight="SemiBold"
                                               Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Result Box -->
                            <Border Background="#1E293B" CornerRadius="10" Padding="16"
                                    Visibility="{Binding ResultText, Converter={StaticResource StrToVis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding ResultText}"
                                               Foreground="{Binding ResultColor}"
                                               FontFamily="Consolas" FontSize="12"
                                               TextWrapping="Wrap"/>
                                    <Button Content="📋  نسخ النتيجة"
                                            Command="{Binding CopyResultCommand}"
                                            HorizontalAlignment="Left"
                                            Margin="0,10,0,0"
                                            Padding="12,6"
                                            Background="#334155" Foreground="#94A3B8"
                                            BorderThickness="0" Cursor="Hand" FontSize="11">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#475569"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- RIGHT: Key Management -->
                        <StackPanel Grid.Column="2">

                            <!-- Key card -->
                            <Border Background="#1E293B" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="🔏  المفتاح الخاص" FontSize="14"
                                               FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,0,0,12"/>

                                    <!-- Status indicator -->
                                    <Border Background="#0F172A" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                     Fill="{Binding KeyStatusColor}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding KeyStatusText}"
                                                       Foreground="{Binding KeyStatusColor}"
                                                       FontSize="12" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Load button -->
                                    <Button Content="📂  تحميل private.pem"
                                            Command="{Binding LoadPrivateKeyCommand}"
                                            Height="38" Cursor="Hand" Foreground="#60A5FA"
                                            Margin="0,0,0,8">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#1E3A5F" CornerRadius="6" Padding="14,0">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#1D4ED8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Paste button -->
                                    <Button Content="📋  لصق من الحافظة"
                                            Command="{Binding PastePrivateKeyCommand}"
                                            Height="38" Cursor="Hand" Foreground="#94A3B8">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#334155" CornerRadius="6" Padding="14,0">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#475569"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Generate Key Pair card -->
                            <Border Background="#1A2E1A" CornerRadius="10"
                                    BorderBrush="#166534" BorderThickness="1"
                                    Padding="20" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="⚙  توليد زوج مفاتيح جديد" FontSize="13"
                                               FontWeight="SemiBold" Foreground="#4ADE80"
                                               Margin="0,0,0,8"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#86EFAC"
                                               Margin="0,0,0,10"
                                               Text="استخدم هذا فقط عند الإعداد الأولي للنظام. سيولّد المفتاحين الخاص والعام ثم انسخ العام إلى LicenseCrypto.cs"/>
                                    <Button Content="توليد private.pem + public.pem"
                                            Command="{Binding GenerateKeyPairCommand}"
                                            Height="36" Cursor="Hand" Foreground="#4ADE80">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#166534" CornerRadius="6" Padding="12,0">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#15803D"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Info card -->
                            <Border Background="#1E293B" CornerRadius="10"
                                    BorderBrush="#334155" BorderThickness="1" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="ℹ  معلومات" FontSize="12"
                                               Foreground="#64748B" FontWeight="SemiBold"
                                               Margin="0,0,0,8"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#475569"
                                               LineHeight="18">
                                        <Run Text="• ملف الترخيص (.apex) موقّع رقمياً بـ ECDSA-P256"/>
                                        <LineBreak/>
                                        <Run Text="• مرتبط بجهاز العميل — لا يعمل على جهاز آخر"/>
                                        <LineBreak/>
                                        <Run Text="• جميع الإصدارات تُسجَّل في audit.log"/>
                                        <LineBreak/>
                                        <Run Text="• احتفظ بـ private.pem سرياً في جهازك فقط"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ─── TAB 2: سجل الإصدارات ─── -->
            <TabItem Header="📋  سجل الإصدارات">
                <Grid Margin="24,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Content="🔄  تحديث السجل"
                            Command="{Binding LoadAuditLogCommand}"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,12" Padding="14,8"
                            Background="#1E3A5F" Foreground="#60A5FA"
                            BorderThickness="0" Cursor="Hand" FontSize="12">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1D4ED8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Border Grid.Row="1" Background="#1E293B" CornerRadius="10" Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding AuditLog, Mode=OneWay}"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="#94A3B8" FontFamily="Consolas"
                                     FontSize="12" IsReadOnly="True"
                                     TextWrapping="NoWrap"
                                     VerticalAlignment="Top"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ═══ STATUS BAR ═══ -->
        <Border Grid.Row="2" Background="#1E293B" BorderBrush="#334155"
                BorderThickness="0,1,0,0" Padding="24,8">
            <Grid>
                <TextBlock Text="Apex License Tool  v1.0  |  أداة داخلية — للاستخدام الرسمي فقط"
                           FontSize="11" Foreground="#475569" HorizontalAlignment="Right"/>
                <TextBlock Text="audit.log  |  جاهز"
                           FontSize="11" Foreground="#475569" HorizontalAlignment="Left"/>
            </Grid>
        </Border>
    </Grid>
</Window>
