<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <!-- Define Product Variables -->
  <?define ProductName="Apex Printing System" ?>
  <?define ProductVersion="1.0.0.0" ?>
  <?define ProductCode="*" ?>
  <?define UpgradeCode="d6e7f8a9-b0c1-4d2e-3f4g-5h6i7j8k9l0m" ?>
  <?define Manufacturer="Apex Printing Press" ?>

  <Product Id="$(var.ProductCode)" Name="$(var.ProductName)" Language="1033" Version="$(var.ProductVersion)" Manufacturer="$(var.Manufacturer)" UpgradeCode="$(var.UpgradeCode)">
    <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Feature: Main Application -->
    <Feature Id="ProductFeature" Title="Apex Printing System" Level="1">
      <ComponentGroupRef Id="PublishedComponents" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
  </Product>

  <!-- Directory Structure -->
  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <!-- Program Files Folder -->
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="ApexPrintingSystem" />
      </Directory>

      <!-- Start Menu Shortcut Folder -->
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Apex Printing System" />
      </Directory>

      <!-- Desktop Folder -->
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>
  </Fragment>

  <!-- Shortcuts -->
  <Fragment>
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="a1b2c3d4-e5f6-7890-1234-567890abcdef">
        <Shortcut Id="ApplicationStartMenuShortcut" 
                  Name="Apex Printing System" 
                  Description="Launch Apex Printing System" 
                  Target="[INSTALLFOLDER]Apex.UI.exe" 
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\ApexPrintingSystem" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="b2c3d4e5-f678-9012-3456-7890abcdef12">
        <Shortcut Id="ApplicationDesktopShortcut" 
                  Name="Apex Printing System" 
                  Description="Launch Apex Printing System" 
                  Target="[INSTALLFOLDER]Apex.UI.exe" 
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\ApexPrintingSystem" Name="desktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
