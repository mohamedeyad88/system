<Window x:Class="Apex.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Apex.Setup"
        mc:Ignorable="d"
        Title="Apex Printing System Setup" Height="450" Width="600"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Apex Printing System" FontSize="24" FontWeight="Bold" Foreground="#007ACC"/>
            <TextBlock Text="Installation Wizard" FontSize="16" Foreground="Gray"/>
        </StackPanel>

        <!-- Content -->
        <Grid Grid.Row="1">
            <!-- Step 1: Welcome & Path -->
            <StackPanel Visibility="{Binding WelcomeVisibility}">
                <TextBlock Text="Welcome to the Apex Printing System Installer." TextWrapping="Wrap" Margin="0,0,0,20" FontSize="14"/>
                <TextBlock Text="This wizard will install Apex Printing System on your computer." TextWrapping="Wrap" Margin="0,0,0,20" FontSize="14"/>
                
                <TextBlock Text="Installation Folder:" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding InstallPath}" Padding="5"/>
                <TextBlock Text="The application will be installed to your local app data folder." Foreground="Gray" FontSize="12" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Step 2: Installing -->
            <StackPanel Visibility="{Binding ProgressVisibility}" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Center" Margin="0,0,0,10" FontWeight="Bold"/>
                <ProgressBar Value="{Binding ProgressValue}" Height="20" Maximum="100"/>
            </StackPanel>

            <!-- Step 3: Complete -->
            <StackPanel Visibility="{Binding CompleteVisibility}" VerticalAlignment="Center">
                <TextBlock Text="Installation Complete!" FontSize="20" FontWeight="Bold" Foreground="Green" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <TextBlock Text="Apex Printing System has been successfully installed." HorizontalAlignment="Center"/>
                <CheckBox Content="Launch Apex Printing System" IsChecked="{Binding LaunchApp}" Margin="0,20,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Install" Command="{Binding InstallCommand}" Visibility="{Binding InstallButtonVisibility}" Width="100" Height="30" Background="#007ACC" Foreground="White" FontWeight="Bold"/>
            <Button Content="Close" Command="{Binding CloseCommand}" Visibility="{Binding CloseButtonVisibility}" Width="100" Height="30"/>
        </StackPanel>
    </Grid>
</Window>
