<UserControl x:Class="Apex.NumberedBooksEngine.UI.Controls.SlotStylePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="280"
             Background="White">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <!-- Header -->
            <TextBlock Text="Slot Properties" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>
            
            <!-- Text Settings Section -->
            <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Text Settings" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    
                    <!-- Font Family -->
                    <TextBlock Text="Font Family" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                    <ComboBox x:Name="FontFamilyCombo" Margin="0,0,0,8" SelectedIndex="0">
                        <ComboBoxItem Content="Arial"/>
                        <ComboBoxItem Content="Tahoma"/>
                        <ComboBoxItem Content="Times New Roman"/>
                        <ComboBoxItem Content="Courier New"/>
                        <ComboBoxItem Content="Georgia"/>
                    </ComboBox>
                    
                    <!-- Font Size -->
                    <TextBlock Text="Font Size" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="FontSizeSlider" Minimum="6" Maximum="72" Value="12" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding Value, ElementName=FontSizeSlider, StringFormat=N0}" 
                                 TextAlignment="Center" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </Grid>
                    
                    <!-- Font Weight -->
                    <TextBlock Text="Font Weight" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton x:Name="WeightRegular" Content="Regular" GroupName="Weight" IsChecked="True" Margin="0,0,10,0"/>
                        <RadioButton x:Name="WeightMedium" Content="Medium" GroupName="Weight" Margin="0,0,10,0"/>
                        <RadioButton x:Name="WeightBold" Content="Bold" GroupName="Weight"/>
                    </StackPanel>
                    
                    <!-- Italic -->
                    <CheckBox x:Name="ItalicCheck" Content="Italic" Margin="0,0,0,8"/>
                </StackPanel>
            </Border>
            
            <!-- Color Settings Section -->
            <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Colors" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    
                    <!-- Text Color -->
                    <TextBlock Text="Text Color" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="TextColorPreview" Background="Black" Width="24" Height="24" 
                                BorderBrush="Gray" BorderThickness="1" CornerRadius="3" Cursor="Hand"
                                MouseLeftButtonDown="TextColorPreview_Click"/>
                        <TextBox x:Name="TextColorHex" Grid.Column="1" Text="#000000" Margin="8,0,0,0" 
                                 VerticalAlignment="Center" TextChanged="TextColorHex_Changed"/>
                    </Grid>
                    
                    <!-- Background Color -->
                    <TextBlock Text="Background Color" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="BgColorPreview" Background="Transparent" Width="24" Height="24" 
                                BorderBrush="Gray" BorderThickness="1" CornerRadius="3" Cursor="Hand"
                                MouseLeftButtonDown="BgColorPreview_Click"/>
                        <TextBox x:Name="BgColorHex" Grid.Column="1" Text="" Margin="8,0,0,0" 
                                 VerticalAlignment="Center" TextChanged="BgColorHex_Changed"/>
                    </Grid>
                    
                    <!-- Opacity -->
                    <TextBlock Text="Opacity" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" Value="100" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="5,0,0,0">
                            <Run Text="{Binding Value, ElementName=OpacitySlider, StringFormat=N0}"/><Run Text="%"/>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>
            
            <!-- Alignment Section -->
            <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Alignment" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    
                    <!-- Horizontal Align -->
                    <TextBlock Text="Horizontal" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton x:Name="AlignLeft" Content="◀" GroupName="HAlign" ToolTip="Left" Margin="0,0,5,0"/>
                        <RadioButton x:Name="AlignCenter" Content="◆" GroupName="HAlign" IsChecked="True" ToolTip="Center" Margin="0,0,5,0"/>
                        <RadioButton x:Name="AlignRight" Content="▶" GroupName="HAlign" ToolTip="Right"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- Rotation Section -->
            <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Rotation" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="Rot0" Content="0°" GroupName="Rotation" IsChecked="True" Margin="0,0,10,0"/>
                        <RadioButton x:Name="Rot90" Content="90°" GroupName="Rotation" Margin="0,0,10,0"/>
                        <RadioButton x:Name="Rot180" Content="180°" GroupName="Rotation" Margin="0,0,10,0"/>
                        <RadioButton x:Name="Rot270" Content="270°" GroupName="Rotation"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- Multi-Copy Styles Section -->
            <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Copy Styles" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    
                    <!-- Original -->
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Original" VerticalAlignment="Center"/>
                        <Border x:Name="OriginalColorPreview" Grid.Column="1" Background="Black" 
                                Width="20" Height="20" BorderBrush="Gray" BorderThickness="1" CornerRadius="2"/>
                        <CheckBox x:Name="OriginalLabelCheck" Grid.Column="2" Content="أصل" Margin="8,0,0,0" 
                                  VerticalAlignment="Center" IsChecked="True"/>
                    </Grid>
                    
                    <!-- Copy 1 -->
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Copy 1" VerticalAlignment="Center"/>
                        <Border x:Name="Copy1ColorPreview" Grid.Column="1" Background="Red" 
                                Width="20" Height="20" BorderBrush="Gray" BorderThickness="1" CornerRadius="2"/>
                        <CheckBox x:Name="Copy1LabelCheck" Grid.Column="2" Content="صورة 1" Margin="8,0,0,0" 
                                  VerticalAlignment="Center"/>
                    </Grid>
                    
                    <!-- Copy 2 -->
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Copy 2" VerticalAlignment="Center"/>
                        <Border x:Name="Copy2ColorPreview" Grid.Column="1" Background="Blue" 
                                Width="20" Height="20" BorderBrush="Gray" BorderThickness="1" CornerRadius="2"/>
                        <CheckBox x:Name="Copy2LabelCheck" Grid.Column="2" Content="صورة 2" Margin="8,0,0,0" 
                                  VerticalAlignment="Center"/>
                    </Grid>
                    
                    <!-- Copy 3 -->
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Copy 3" VerticalAlignment="Center"/>
                        <Border x:Name="Copy3ColorPreview" Grid.Column="1" Background="Gray" 
                                Width="20" Height="20" BorderBrush="Gray" BorderThickness="1" CornerRadius="2"/>
                        <CheckBox x:Name="Copy3LabelCheck" Grid.Column="2" Content="صورة 3" Margin="8,0,0,0" 
                                  VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
            
            <!-- Preview -->
            <Border Background="#F5F5F5" CornerRadius="5" Padding="10" Margin="0,5,0,0">
                <StackPanel>
                    <TextBlock Text="Preview" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="PreviewText" Text="0001" FontSize="24" FontWeight="Bold" 
                               HorizontalAlignment="Center" Margin="0,5"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
