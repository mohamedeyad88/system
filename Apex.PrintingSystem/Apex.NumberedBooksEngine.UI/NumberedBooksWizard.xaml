<UserControl x:Class="Apex.NumberedBooksEngine.UI.NumberedBooksWizard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Apex.NumberedBooksEngine.UI"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
   <Grid Background="#0F172A">
       <Grid.ColumnDefinitions>
           <ColumnDefinition Width="300"/>
           <ColumnDefinition Width="*"/>
       </Grid.ColumnDefinitions>

       <!-- Sidebar -->
       <Border BorderBrush="#334155" BorderThickness="0,0,1,0" Padding="20" Background="#1E293B">
           <Grid>
               <Grid.RowDefinitions>
                   <RowDefinition Height="Auto"/>
                   <RowDefinition Height="*"/>
               </Grid.RowDefinitions>

               <StackPanel Grid.Row="0">
                   <TextBlock Text="Numbered Books" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" Foreground="White"/>

                   <TextBlock Text="Job Settings" FontWeight="SemiBold" Margin="0,10,0,5" Foreground="#94A3B8"/>
                   <TextBox x:Name="StartNumberInput" Text="1" Margin="0,0,0,10" Padding="5"
                            Background="#334155" Foreground="White" BorderBrush="#475569" CaretBrush="White"/>
                   <TextBox x:Name="TotalNumbersInput" Text="100" Margin="0,0,0,10" Padding="5"
                            Background="#334155" Foreground="White" BorderBrush="#475569" CaretBrush="White"/>

                   <!-- Numbering Mode Selection -->
                   <TextBlock Text="Numbering Mode / وضع الترقيم" FontWeight="SemiBold" Margin="0,10,0,5" Foreground="#94A3B8"/>
                   <Border BorderBrush="#334155" BorderThickness="1" CornerRadius="5" Margin="0,0,0,10" Padding="10" Background="#0F172A">
                       <StackPanel>
                           <RadioButton x:Name="AutoModeRadio" Content="🔍 Auto-detect / كشف تلقائي" GroupName="NumMode" IsChecked="True" Margin="0,5" Foreground="#E2E8F0"/>
                           <RadioButton x:Name="ShersharaRadio" Content="📄 Shershara (Linear) / ترقيم الشرشرة" GroupName="NumMode" Margin="0,5" Foreground="#E2E8F0"/>
                           <RadioButton x:Name="CuttingRadio" Content="✂ Cutting (Imposed) / ترقيم القص" GroupName="NumMode" Margin="0,5" Foreground="#E2E8F0"/>
                       </StackPanel>
                   </Border>

                   <Button Content="Load Template" Click="LoadTemplate_Click" Padding="10,5" Margin="0,10,0,10"
                           Background="#334155" Foreground="White" BorderThickness="0"/>
                   <Button Content="Add Slot" Click="AddSlot_Click" Padding="10,5" Margin="0,0,0,10"
                           Background="#334155" Foreground="White" BorderThickness="0"/>

                   <Button Content="Generate Preview" Click="GeneratePreview_Click" Padding="10,5" Background="#1D4ED8" Foreground="White" BorderThickness="0" Margin="0,20,0,0"/>

                   <Separator Margin="0,20,0,10" Background="#334155"/>

                   <TextBlock Text="Printer" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#94A3B8"/>
                   <ComboBox x:Name="PrinterCombo" Margin="0,0,0,10" Padding="5"
                             Background="#334155" Foreground="White" BorderBrush="#475569"/>

                   <Button Content="Start Print Job" Click="StartPrintJob_Click" Padding="10,5" Background="#10B981" Foreground="White" FontWeight="SemiBold" BorderThickness="0"/>

                   <Separator Margin="0,15,0,10" Background="#334155"/>

                   <TextBlock Text="Streaming Mode (Template Once)" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#94A3B8"/>
                   <CheckBox x:Name="StreamingModeCheck" Content="Use Streaming Print" IsChecked="True" Margin="0,0,0,5" Foreground="#E2E8F0"/>
                   <Button Content="⚡ Stream Print" Click="StartStreamingPrint_Click" Padding="10,5" Background="#8B5CF6" Foreground="White" FontWeight="SemiBold" BorderThickness="0"/>
               </StackPanel>

               <!-- Slot Properties Panel (Visible when a slot is selected) -->
               <ContentControl Grid.Row="1" Margin="0,20,0,0" Content="{Binding SelectedSlot}">
                   <ContentControl.ContentTemplate>
                       <DataTemplate>
                           <local:SlotPropertiesPanel/>
                       </DataTemplate>
                   </ContentControl.ContentTemplate>
               </ContentControl>
           </Grid>
       </Border>

       <!-- Canvas Area -->
       <Grid Grid.Column="1" Background="#0F172A">
           <Border Margin="20" Background="#1E293B">
               <Border.Effect>
                   <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" Color="#000"/>
               </Border.Effect>
               <Canvas x:Name="PreviewCanvas" Background="#2D3748" MouseLeftButtonDown="Canvas_MouseDown" MouseMove="Canvas_MouseMove" MouseLeftButtonUp="Canvas_MouseUp"/>
           </Border>
       </Grid>
   </Grid>
</UserControl>
