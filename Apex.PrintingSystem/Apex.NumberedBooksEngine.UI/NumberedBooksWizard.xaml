<UserControl x:Class="Apex.NumberedBooksEngine.UI.NumberedBooksWizard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Apex.NumberedBooksEngine.UI"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border BorderBrush="#E5E7EB" BorderThickness="0,0,1,0" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Numbered Books" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                    <TextBlock Text="Job Settings" FontWeight="SemiBold" Margin="0,10,0,5"/>
                    <TextBox x:Name="StartNumberInput" Text="1" Margin="0,0,0,10" Padding="5"/>
                    <TextBox x:Name="TotalNumbersInput" Text="100" Margin="0,0,0,10" Padding="5"/>
                    
                    <Button Content="Load Template" Click="LoadTemplate_Click" Padding="10,5" Margin="0,10,0,10"/>
                    <Button Content="Add Slot" Click="AddSlot_Click" Padding="10,5" Margin="0,0,0,10"/>
                    
                    <Button Content="Generate Preview" Click="GeneratePreview_Click" Padding="10,5" Background="#E0F2F1" Margin="0,20,0,0"/>

                    <Separator Margin="0,20,0,10"/>
                    
                    <TextBlock Text="Printer" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="PrinterCombo" Margin="0,0,0,10" Padding="5"/>
                    
                    <Button Content="Start Print Job" Click="StartPrintJob_Click" Padding="10,5" Background="#10B981" Foreground="White" FontWeight="SemiBold"/>
                    
                    <Separator Margin="0,15,0,10"/>
                    
                    <TextBlock Text="Streaming Mode (Template Once)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <CheckBox x:Name="StreamingModeCheck" Content="Use Streaming Print" IsChecked="True" Margin="0,0,0,5"/>
                    <Button Content="⚡ Stream Print" Click="StartStreamingPrint_Click" Padding="10,5" Background="#8B5CF6" Foreground="White" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Slot Properties Panel (Visible when a slot is selected) -->
                <ContentControl Grid.Row="1" Margin="0,20,0,0" Content="{Binding SelectedSlot}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <local:SlotPropertiesPanel/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Grid>
        </Border>

        <!-- Canvas Area -->
        <Grid Grid.Column="1" Background="#F9FAFB">
            <Border Margin="20" Background="White">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1" Color="#000"/>
                </Border.Effect>
                <Canvas x:Name="PreviewCanvas" Background="LightGray" MouseLeftButtonDown="Canvas_MouseDown" MouseMove="Canvas_MouseMove" MouseLeftButtonUp="Canvas_MouseUp"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
