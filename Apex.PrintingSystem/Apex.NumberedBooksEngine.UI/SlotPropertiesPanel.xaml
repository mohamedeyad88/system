<UserControl x:Class="Apex.NumberedBooksEngine.UI.SlotPropertiesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="300">
    <StackPanel Background="#1E293B">
        <TextBlock Text="Slot Properties" FontWeight="Bold" Margin="0,0,0,10" Foreground="White"/>

        <Grid Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="ID:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#94A3B8"/>
            <TextBox Grid.Column="1" Text="{Binding Id, Mode=OneWay}" IsReadOnly="True"
                     Background="#334155" Foreground="#94A3B8" BorderBrush="#475569"/>
        </Grid>

        <Grid Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                <TextBlock Text="X (%)" Foreground="#94A3B8"/>
                <TextBox Text="{Binding X, StringFormat=N3}"
                         Background="#334155" Foreground="White" BorderBrush="#475569" CaretBrush="White"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                <TextBlock Text="Y (%)" Foreground="#94A3B8"/>
                <TextBox Text="{Binding Y, StringFormat=N3}"
                         Background="#334155" Foreground="White" BorderBrush="#475569" CaretBrush="White"/>
            </StackPanel>
        </Grid>

        <Grid Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                <TextBlock Text="Width (%)" Foreground="#94A3B8"/>
                <TextBox Text="{Binding Width, StringFormat=N3}"
                         Background="#334155" Foreground="White" BorderBrush="#475569" CaretBrush="White"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                <TextBlock Text="Height (%)" Foreground="#94A3B8"/>
                <TextBox Text="{Binding Height, StringFormat=N3}"
                         Background="#334155" Foreground="White" BorderBrush="#475569" CaretBrush="White"/>
            </StackPanel>
        </Grid>

        <Separator Margin="0,10" Background="#334155"/>

        <TextBlock Text="Appearance" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="White"/>

        <Grid Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Font:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#94A3B8"/>
            <ComboBox Grid.Column="1" Text="{Binding FontFamily}" IsEditable="True"
                      Background="#334155" Foreground="White" BorderBrush="#475569">
                <ComboBoxItem Content="Arial"/>
                <ComboBoxItem Content="Times New Roman"/>
                <ComboBoxItem Content="Courier New"/>
                <ComboBoxItem Content="Verdana"/>
            </ComboBox>
        </Grid>

        <Grid Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Size:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#94A3B8"/>
            <TextBox Grid.Column="1" Text="{Binding FontSize}"
                     Background="#334155" Foreground="White" BorderBrush="#475569" CaretBrush="White"/>
        </Grid>

        <Grid Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Color:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#94A3B8"/>
            <TextBox Grid.Column="1" Text="{Binding FontColorHex}"
                     Background="#334155" Foreground="White" BorderBrush="#475569" CaretBrush="White"/>
        </Grid>

        <Grid Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Align:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#94A3B8"/>
            <ComboBox Grid.Column="1" SelectedValue="{Binding Align}" SelectedValuePath="Content"
                      Background="#334155" Foreground="White" BorderBrush="#475569">
                <ComboBoxItem Content="Left"/>
                <ComboBoxItem Content="Center"/>
                <ComboBoxItem Content="Right"/>
            </ComboBox>
        </Grid>

        <Grid Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Rotation:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#94A3B8"/>
            <TextBox Grid.Column="1" Text="{Binding Rotation}"
                     Background="#334155" Foreground="White" BorderBrush="#475569" CaretBrush="White"/>
        </Grid>

    </StackPanel>
</UserControl>
