<Window x:Class="Apex.NumberedBooksEngine.UI.PrintJobMonitor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print Job Monitor" Height="400" Width="500"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#0F172A">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Print Job Progress" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" Foreground="White"/>

        <!-- Progress Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <ProgressBar x:Name="ProgressBar" Height="30" Minimum="0" Maximum="100" Value="0" Foreground="#10B981" Background="#334155" BorderBrush="#475569"/>
            <TextBlock x:Name="ProgressText" Text="0%" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White"/>
        </Grid>

        <!-- Stats -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Current Page -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Current Page:" FontWeight="SemiBold" Margin="0,5" Foreground="#94A3B8"/>
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="CurrentPageText" Text="0 / 0" Margin="0,5" Foreground="White"/>

            <!-- Speed -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Speed:" FontWeight="SemiBold" Margin="0,5" Foreground="#94A3B8"/>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SpeedText" Text="0 pages/sec" Margin="0,5" Foreground="White"/>

            <!-- Elapsed Time -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Elapsed Time:" FontWeight="SemiBold" Margin="0,5" Foreground="#94A3B8"/>
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ElapsedTimeText" Text="00:00:00" Margin="0,5" Foreground="White"/>

            <!-- Status -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Status:" FontWeight="SemiBold" Margin="0,5" Foreground="#94A3B8"/>
            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="StatusText" Text="Idle" Margin="0,5" Foreground="White"/>

            <!-- Errors -->
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Errors:" FontWeight="SemiBold" Margin="0,5" Foreground="#94A3B8"/>
            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="ErrorsText" Text="None" Foreground="#EF4444" Margin="0,5"/>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button x:Name="PauseButton" Content="Pause" Width="100" Padding="10,8" Margin="0,0,10,0" Click="Pause_Click" Background="#F59E0B" Foreground="White" BorderThickness="0"/>
            <Button x:Name="ResumeButton" Content="Resume" Width="100" Padding="10,8" Margin="0,0,10,0" Click="Resume_Click" IsEnabled="False" Background="#10B981" Foreground="White" BorderThickness="0"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="100" Padding="10,8" Click="Cancel_Click" Background="#EF4444" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
